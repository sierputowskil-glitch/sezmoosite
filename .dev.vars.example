# Copy to .dev.vars for `wrangler pages dev` — do not commit real passwords.
# Key names match functions/api/contact.ts.
# (Legacy PHP SMTP_SECURE was implied by port: 465=tls, 587=starttls).
# Local: Cloudflare dummy secret that always passes (pair with invisible sitekey …BB).
# Prod: real secret via `wrangler pages secret put TURNSTILE_SECRET_KEY`.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
SMTP_HOST=smtp.cyberfolks.pl
SMTP_PORT=587
SMTP_USER=noreply@sezmoo.com
SMTP_PASS=
SMTP_FROM=noreply@sezmoo.com
SMTP_FROM_NAME=SEZMOO
MAIL_TO=biuro@sezmoo.com
