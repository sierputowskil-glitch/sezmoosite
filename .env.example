# Public (baked into static build). Local: copy to .env (gitignored).
# Map TURNSTILE_SITE_KEY from legacy config.local.php → PUBLIC_TURNSTILE_SITE_KEY
PUBLIC_SITE_URL=https://sezmoo.com
# Local tip: PUBLIC_SITE_URL=http://localhost:4321
# Prod CF Pages: PUBLIC_BASE_PATH=/
# Staging GH Pages project site: PUBLIC_BASE_PATH=/sezmoosite
PUBLIC_BASE_PATH=/
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAA...
# Same-origin on CF Pages / wrangler pages dev.
# Staging GH Pages: leave EMPTY (no Pages Functions — form is disabled client-side).
PUBLIC_CONTACT_API_URL=/api/contact

# Server secrets live in .dev.vars (Wrangler) / CF dashboard — not in .env:
# TURNSTILE_SECRET_KEY, SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS,
# SMTP_FROM, SMTP_FROM_NAME, MAIL_TO
