# Public (baked into static build)
PUBLIC_SITE_URL=https://sezmoo.com
# Prod CF Pages: leave empty or /
# Staging GH Pages project site: /sezmoosite
PUBLIC_BASE_PATH=/
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAA...
# Same-origin on CF Pages; absolute URL if API hosted elsewhere
PUBLIC_CONTACT_API_URL=/api/contact

# Cloudflare Pages Function secrets — set in dashboard or local .dev.vars (never commit real values)
# TURNSTILE_SECRET_KEY=
# SMTP_HOST=smtp.cyberfolks.pl
# SMTP_PORT=587
# SMTP_USER=no-reply@sezmoo.com
# SMTP_PASS=
