{
  "name": "sezmoosite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SEZMOO marketing site — Astro (static) + Cloudflare Pages Function for contact",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "migrate:pages": "node scripts/migrate-html-to-astro.mjs",
    "dev:functions": "wrangler pages dev ./dist --compatibility-date=2026-10-15 --compatibility-flags=nodejs_compat",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "astro": "^5.14.0",
    "cloudflare-smtp": "^0.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.42.0"
  }
}
