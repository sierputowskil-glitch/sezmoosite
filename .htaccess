# SEZMOO — Cyberfolks (Apache)
# Pretty URLs (katalogi + index.html), redirecty ze starych *.html

DirectoryIndex index.html
Options -Indexes

ErrorDocument 404 /404.html

# Blokada sekretów i logów formularza
<FilesMatch "^(config\.local\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # katalog logów formularza — niedostępny z WWW
    RewriteRule ^logs(/|$) - [F,L]

# --- Stare flat *.html → pretty URL (301) ---
RewriteRule ^blog\.html$ /blog/ [R=301,L,QSA]
RewriteRule ^artykul\.html$ /artykul/ [R=301,L,QSA]
RewriteRule ^portfolio-lista-b\.html$ /portfolio-lista-b/ [R=301,L,QSA]
RewriteRule ^realizacja\.html$ /realizacja/ [R=301,L,QSA]
RewriteRule ^realizacja-denza\.html$ /realizacja-denza/ [R=301,L,QSA]
RewriteRule ^realizacja-exlantix\.html$ /realizacja-exlantix/ [R=301,L,QSA]
RewriteRule ^realizacja-kapka\.html$ /realizacja-kapka/ [R=301,L,QSA]
RewriteRule ^realizacja-primespot\.html$ /realizacja-primespot/ [R=301,L,QSA]
RewriteRule ^realizacja-world-of-warships\.html$ /realizacja-world-of-warships/ [R=301,L,QSA]
RewriteRule ^en/realizacja\.html$ /en/realizacja/ [R=301,L,QSA]
RewriteRule ^en/realizacja-kapka\.html$ /en/realizacja-kapka/ [R=301,L,QSA]
RewriteRule ^en/realizacja-primespot\.html$ /en/realizacja-primespot/ [R=301,L,QSA]

# --- …/index.html → …/ (301) ---
RewriteCond %{THE_REQUEST} \s/+(.+/)?index\.html[\s?] [NC]
RewriteRule ^(.+/)?index\.html$ /$1 [R=301,L]

# --- Ogólnie: istniejący plik *.html → katalog bez .html (jeśli jest index) ---
# (zapas na wypadek innych stron)
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_URI} ^/(.+)\.html$ [NC]
RewriteCond %{DOCUMENT_ROOT}/%1/index.html -f
RewriteRule ^(.+)\.html$ /$1/ [R=301,L,QSA]

# --- Stare ścieżki WP / nawigacja (bez konsolidacji usług) ---
RewriteRule ^o-nas/?$ /#team [R=301,L,NE]
RewriteRule ^uslugi/?$ /uslugi-marketingowe/ [R=301,L]
RewriteRule ^kontakt/?$ /#kontakt [R=301,L,NE]
RewriteRule ^uslugi-na-abonament/?$ /uslugi-marketingowe/abonamenty/ [R=301,L]
RewriteRule ^identyfikacja-wizualna/?$ /uslugi-marketingowe/identyfikacja-wizualna/ [R=301,L]
RewriteRule ^en/services/branding/?$ /en/services/visual-identity/ [R=301,L]
RewriteRule ^en/services/digital-graphics/?$ /en/services/graphic-design/ [R=301,L]

# Rank Math / WP sitemaps → nowa
RewriteRule ^sitemap_index\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^page-sitemap\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^post-sitemap\.xml$ /sitemap.xml [R=301,L]
</IfModule>
