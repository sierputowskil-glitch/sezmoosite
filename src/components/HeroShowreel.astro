---
/**
 * Native hero background showreel — muted autoplay after LCP gate (see home.js).
 * Pattern: .docs/abonament_video_handoff.md — poster LCP, MP4 via data-src only.
 * CDN: showreel-16s.mp4 = 1080p; showreel-720-16s.mp4 = mobile; showreel-full.mp4 = master.
 *
 * Poster brightness is baked into the WebPs. Use srcset (not <picture>) so the
 * poster stays a sibling under <video> — a <picture> wrapper stacked above the
 * playing MP4 and looked like broken desktop autoplay.
 */
import { mediaUrl } from '../lib/site';

interface Props {
  title?: string;
}
const { title = 'SEZMOO showreel' } = Astro.props;

const videoSrc = mediaUrl('video/showreel-16s.mp4');
const videoSrcMobile = mediaUrl('video/showreel-720-16s.mp4');
const posterDesktop = '/assets/video/showreel-poster.webp?v=20261017b';
const posterMobile = '/assets/video/showreel-poster-m.webp?v=20261017b';
---

<div class="hero__video" data-bg-video data-bg-video-priority="hero">
  <img
    class="hero__poster"
    src={posterDesktop}
    srcset={`${posterMobile} 1080w, ${posterDesktop} 1600w`}
    sizes="100vw"
    alt=""
    width="1600"
    height="900"
    decoding="async"
    fetchpriority="high"
  />
  <video
    id="hero-video"
    muted
    playsinline
    loop
    preload="none"
    data-src={videoSrc}
    data-src-mobile={videoSrcMobile}
    aria-label={title}
    aria-hidden="true"
    disablepictureinpicture
    disableRemotePlayback
  ></video>
</div>
