---
/**
 * Native hero background showreel — muted autoplay on desktop + mobile.
 * MP4 from cdn.sezmoo.com; posters stay on Pages for LCP.
 * Real <img> poster (not CSS background) so LCP can select it; video src is
 * attached in home.js after LCP/idle so the ~15MB MP4 stays off the critical path.
 */
import { mediaUrl } from '../lib/site';

interface Props {
  title?: string;
}
const { title = 'SEZMOO showreel' } = Astro.props;

const videoSrc = mediaUrl('video/showreel.mp4');
const posterWebp = '/assets/video/showreel-poster.webp?v=20261017a';
---

<div class="hero__video">
  <img
    class="hero__poster"
    src={posterWebp}
    alt=""
    width="1600"
    height="900"
    decoding="async"
    fetchpriority="high"
  />
  <video
    id="hero-video"
    muted
    playsinline
    loop
    preload="none"
    data-src={videoSrc}
    aria-label={title}
    disablepictureinpicture
    disableRemotePlayback
  ></video>
</div>
