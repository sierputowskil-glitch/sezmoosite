---
/**
 * Shared blog article chrome: header, hero, TOC aside, content slot, CTA.
 */
interface TocItem {
  id: string;
  label: string;
}

interface Props {
  title: string;
  metaLine: string;
  lead?: string;
  heroImage?: string;
  heroAlt?: string;
  heroCaption?: string;
  backHref?: string;
  backLabel?: string;
  toc?: TocItem[];
  tocLabel?: string;
  ctaTitle?: string;
  ctaHref?: string;
  ctaLabel?: string;
  showCta?: boolean;
}

const {
  title,
  metaLine,
  lead,
  heroImage,
  heroAlt,
  heroCaption = 'SEZMOO / BLOG',
  backHref = '/blog/',
  backLabel = '← Wróć do\u00a0bloga',
  toc = [],
  tocLabel = 'W artykule',
  ctaTitle = 'Chcesz podobny efekt dla\u00a0marki?',
  ctaHref = '/#kontakt',
  ctaLabel = 'Porozmawiajmy',
  showCta = true,
} = Astro.props;
---

<article class="article shell">
  <header class="article__head">
    <a class="article__back reveal" href={backHref}>{backLabel}</a>
    <span class="blog-post__meta reveal">{metaLine}</span>
    <h1 class="article__title reveal">{title}</h1>
    {lead ? (
      <p class="article__lead reveal" data-d="1">
        {lead}
      </p>
    ) : null}
  </header>

  {
    heroImage ? (
      <div class="article__media reveal">
        <div class="frame-media">
          <img src={heroImage} alt={heroAlt || title} loading="eager" />
        </div>
        <span>{heroCaption}</span>
      </div>
    ) : null
  }

  <div class="article__layout">
    {
      toc.length > 0 ? (
        <aside class="article__aside reveal">
          <span>{tocLabel}</span>
          {toc.map((item) => (
            <a href={`#${item.id}`}>{item.label}</a>
          ))}
        </aside>
      ) : (
        <aside class="article__aside" aria-hidden="true"></aside>
      )
    }

    <div class="article__content">
      <slot />
      {
        showCta ? (
          <div class="article__cta reveal">
            <h2 set:html={ctaTitle} />
            <a href={ctaHref}>{ctaLabel}</a>
          </div>
        ) : null
      }
    </div>
  </div>
</article>
