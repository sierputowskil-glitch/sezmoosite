---
/**
 * Shared homepage. Copy in `src/data/home.ts`. Keep section ids for home.js.
 */
import type { ImageMetadata } from 'astro';
import AssetImage from '../AssetImage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../ContactForm.astro';
import OptImage from '../OptImage.astro';
import VideoBg from '../VideoBg.astro';
import HeroShowreel from '../HeroShowreel.astro';
import { homePageJsonLd } from '../../lib/schema';
import { pageUrl, PHONE_DISPLAY, PHONE_TEL } from '../../lib/site';
import {
  HOME_CLIENTS,
  SHOWREEL_POSTER_PRELOAD,
  STUDIO_VIDEO_ID,
  homeCopy,
  type HomeLang,
  type HomePillarIcon,
  type HomeWorkId,
} from '../../data/home';
import '../../styles/home.css';

import workExlantix from '../../../assets/portfolio/exlantix/exlantix-premiera-marki-gdansk-fotografia-21.jpg';
import workWow from '../../../assets/work/captains-club-int.webp';
import workK2 from '../../../assets/portfolio/k2/k2-hodowla-pstraga-zdjecie-z-drona-baseny.webp';
import workBaltic from '../../../assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-01.jpg';
import workDoraco from '../../../assets/portfolio/doraco-tvp/doraco-hala-zdjeciowa-tvp-zdjecia-z-drona-01.jpg';
import workSoho from '../../../assets/portfolio/soho-form/soho-cover.webp';

interface Props {
  lang: HomeLang;
}

const { lang } = Astro.props;
const copy = homeCopy(lang);
const canonical = pageUrl(copy.path);
const hreflangPl = pageUrl('/');
const hreflangEn = pageUrl('/en/');
const jsonLd = homePageJsonLd({
  lang,
  canonical,
  description: copy.jsonLdDescription,
});

const workSrc: Record<HomeWorkId, ImageMetadata> = {
  exlantix: workExlantix,
  wow: workWow,
  k2: workK2,
  baltic: workBaltic,
  doraco: workDoraco,
  soho: workSoho,
};

const pillarIcons: Record<HomePillarIcon, string> = {
  film: '<rect x="2.5" y="4.5" width="19" height="15" rx="1.5"/><path d="M7 4.5v15M17 4.5v15M2.5 9.5h4.5M2.5 14.5h4.5M17 9.5h4.5M17 14.5h4.5"/>',
  photo:
    '<path d="M3 8.5h3l1.6-2.4h8.8L18 8.5h3v10.5a.5.5 0 0 1-.5.5h-17a.5.5 0 0 1-.5-.5V8.5Z"/><circle cx="12" cy="13.5" r="4"/>',
  design: '<path d="M15.2 3.9l4.9 4.9M3.5 20.5l1.2-5 11-11 4.9 4.9-11 11-5.1 1.1Z"/><path d="M12.7 6.4l4.9 4.9"/>',
  social: '<rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M10.5 5.4h3"/><circle cx="12" cy="18" r="1"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.4l3.4 2.1"/>',
  web: '<circle cx="12" cy="12" r="9"/><path d="M3.2 9.6h17.6M3.2 14.4h17.6M12 3c2.4 2.4 3.6 5.4 3.6 9s-1.2 6.6-3.6 9c-2.4-2.4-3.6-5.4-3.6-9S9.6 5.4 12 3Z"/>',
};

const fmt = copy.services.formatKit;
const studioLead = copy.studio.paras.length > 1;
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.description}
  canonical={canonical}
  keywords={copy.keywords}
  ogTitle={copy.ogTitle}
  ogDescription={copy.ogDescription}
  hreflangPl={hreflangPl}
  hreflangEn={hreflangEn}
  altHref={copy.altHref}
  brandHref={copy.brandHref}
  jsonLd={jsonLd}
  extraHead={`<link rel="preload" as="image" type="image/webp" href="${SHOWREEL_POSTER_PRELOAD}" fetchpriority="high" />`}
>
  <section class="hero" id="hero" data-screen-label="Hero">
    <div class="hero__reel">
      <div class="frame-media"></div>
      <HeroShowreel title={copy.hero.showreelTitle} />
    </div>
    <div class="hero__grad"></div>

    <div class="hero__hud tr">
      <div set:html={copy.hero.hudLine1} />
      <div style="color:var(--fg-faint);margin-top:6px" set:html={copy.hero.hudLine2} />
    </div>

    <div class="shell hero__content">
      <span class="eyebrow hero__label"><span class="tick"></span><Fragment set:html={copy.hero.eyebrow} /></span>
      <div class="hero__measure">
        <h1>
          {copy.hero.h1Lines.map((line) => (
            <span class="clip"><span set:html={line} /></span>
          ))}
        </h1>
        {copy.hero.subInMeasure && <p class="hero__sub" set:html={copy.hero.subInMeasure} />}
        {copy.hero.subInMeasureLong && (
          <p class="hero__sub" style={copy.hero.subInMeasureLongStyle} set:html={copy.hero.subInMeasureLong} />
        )}
      </div>
      {/* EN long sub sits outside .hero__measure (existing layout). */}
      {copy.hero.subAfterMeasure && (
        <p class="hero__sub" style={copy.hero.subAfterMeasureStyle} set:html={copy.hero.subAfterMeasure} />
      )}
      <div class="hero__cta">
        <a href={copy.hero.ctaPrimary.href} class="btn btn--primary" data-magnetic
          ><span class="ico"></span><span class="lbl" set:html={copy.hero.ctaPrimary.label} /></a
        >
        <a href={copy.hero.ctaSecondary.href} class="btn" data-magnetic
          ><span class="lbl" set:html={copy.hero.ctaSecondary.label} /></a
        >
      </div>
    </div>
  </section>

  <section class="work shell" id="work" data-screen-label="Work">
    <div class="sec-head">
      <h2 class:list={['sec-title', 'reveal', copy.work.titleLine && 'sec-title--line']} set:html={copy.work.title} />
      <span class="sec-index reveal" set:html={copy.work.index} />
    </div>

    <div class="work-slider reveal">
      <div class="work-reel" data-bands="3">
        {copy.work.cards.map((card) => (
          <a class="card reveal" href={card.href} data-cats={card.cats} data-cursor="link">
            <div class="card__media">
              <OptImage
                class="card__video"
                src={workSrc[card.id]}
                alt={card.alt}
                widths={[360, 640, 960, 1280]}
                sizes="(max-width: 768px) 55vw, (max-width: 1100px) 40vw, 28vw"
                quality={78}
              />
              <div class="card__scan"></div><div class="card__sweep"></div>
              <div class="card__tc"><span class="rd"></span>{card.tc}</div>
              <div class="card__live" set:html={card.live} />
              <span class="card__play">CASE</span>
              <div class="card__bar"><i></i></div>
            </div>
            <div class="card__info">
              <div>
                <div class="card__client" set:html={card.client} />
                <div class="card__cat" set:html={card.cat} />
              </div>
              <span class="card__tag">CASE</span>
            </div>
          </a>
        ))}
      </div>
    </div>
    <div class="work-slider__hud reveal">
      <button class="work-nav" type="button" aria-label={copy.work.prevAria} data-reel-prev>‹</button>
      <div class="work-dots" data-reel-dots></div>
      <span class="work-reel__count" data-reel-count><b>01</b> / 02</span>
      <button class="work-nav" type="button" aria-label={copy.work.nextAria} data-reel-next>›</button>
    </div>
    <div class="reveal" style="display:flex;justify-content:center;margin-top:clamp(36px,4.5vw,64px)">
      <a href={copy.work.more.href} class="btn btn--primary" data-magnetic
        ><span class="ico"></span><span class="lbl" set:html={copy.work.more.label} /></a
      >
    </div>
  </section>

  <section class="services shell" id="services" data-screen-label="Services">
    <div class="services-static reveal">
      <div class="sec-head">
        <h2 class="sec-title reveal" set:html={copy.services.title} />
        <span class="sec-index reveal" set:html={copy.services.index} />
      </div>

      {/* EN-only “one shoot → 4 formats” kit — same CSS as the previous EN fork. */}
      {fmt && (
        <div class="fmt-wrap">
          <div class="fmt2">
            <div class="fmt2__hud">
              <span set:html={fmt.hudLeft} />
              <span set:html={fmt.hudRight} />
            </div>
            <div class="fmt2__master">
              <div class="fmt2__sprk"></div>
              <div class="fmt2__frames"><i></i><i></i><i></i><i></i><i></i></div>
              <div class="fmt2__sprk"></div>
              <span class="fmt2__mlbl" set:html={fmt.masterLabel} />
            </div>
            <div class="fmt2__split" set:html={fmt.splitLabel} />
            <div class="fmt2__outs">
              {fmt.outs.map((out) => (
                <div class="fmt2__out">
                  <span class={`fmt2__shape ${out.shape}`}></span>
                  <div>
                    <span class="r" set:html={out.ratio} />
                    <h4 set:html={out.title} />
                    <p set:html={out.p} />
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div class="fmt-copy">
            <span class="eyebrow"><span class="tick"></span><Fragment set:html={fmt.kick} /></span>
            <h3 class="fmt-copy__title" set:html={fmt.title} />
            <p class="fmt-copy__p" set:html={fmt.p} />
            <a href={fmt.cta.href} class="btn btn--primary" data-magnetic
              ><span class="ico"></span><span class="lbl" set:html={fmt.cta.label} /></a
            >
          </div>
        </div>
      )}
    </div>

    <div class="svc-grid">
      {copy.services.pillars.map((p) => (
        <a
          class="svc reveal svc--pillar"
          href={p.href}
          data-d={p.delay != null ? String(p.delay) : undefined}
          data-cursor="link"
        >
          <svg class="svc__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            ><path d="M5 19 19 5M19 5H8M19 5v11"></path></svg
          >
          <div class="svc__body">
            <svg
              class="svc__ico"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={pillarIcons[p.icon]}
            />
            <h3 class="svc__title" set:html={p.title} />
            <p class="svc__desc" set:html={p.desc} />
            <div class="svc__chips">
              {p.chips.map((c) => (
                <span>{c}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="studio shell" id="studio" data-screen-label="Studio">
    <div class="sec-head">
      <span class="sec-index reveal" style="order:2" set:html={copy.studio.index} />
      <span class="eyebrow reveal"><span class="tick"></span><Fragment set:html={copy.studio.eyebrow} /></span>
    </div>
    <div class="studio__grid">
      <div class="studio__sticky reveal">
        <div class="studio__media is-vertical" data-parallax="26">
          <div class="frame-media" style="transform:translateY(var(--py,0))"></div>
          <VideoBg videoId={STUDIO_VIDEO_ID} title={copy.studio.videoTitle} priority="lazy" />
          <div class="ovl">
            <div class="corners"><span></span><span></span><span></span><span></span></div>
            <div class="tc"><span class="d"></span><span data-tc>00:00:12:08</span></div>
          </div>
        </div>
      </div>
      <div>
        <h2 class="studio__title reveal" set:html={copy.studio.title} />
        {copy.studio.paras.map((p, i) => (
          <p class:list={['studio__copy', i === 0 && studioLead && 'studio__copy--lead']} set:html={p} />
        ))}
        <div class="studio__points">
          {copy.studio.points.map((txt, i) => (
            <div class="spt">
              <span class="spt__no">{String(i + 1).padStart(2, '0')}</span>
              <span class="spt__txt" set:html={txt} />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="team shell" id="team" data-screen-label="Team">
    <div class="sec-head">
      <h2 class="sec-title reveal" set:html={copy.team.title} />
      <span class="sec-index reveal" set:html={copy.team.index} />
    </div>

    <div class="team__grid team__grid--photos">
      {copy.team.members.map((m, i) => (
        <article class="team-card reveal" data-d={String(i % 4)}>
          <div class="team-card__photo">
            <span class="tc-ini" aria-hidden="true">{m.ini}</span>
            <AssetImage
              src={m.src}
              alt={m.alt}
              class="tc-ph"
              loading="lazy"
              decoding="async"
              widths={[160, 320, 480]}
              sizes="96px"
              quality={78}
            />
          </div>
          <div class="team-card__body">
            <span class="team-card__no">{m.no}</span>
            <h3 class="team-card__name" set:html={m.name} />
            <p class="team-card__role" set:html={m.role} />
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="process shell" id="process" data-screen-label="Process">
    <div class="sec-head">
      <h2
        class:list={['sec-title', 'reveal', copy.process.titleLine && 'sec-title--line']}
        set:html={copy.process.title}
      />
      <span class="sec-index reveal" set:html={copy.process.index} />
    </div>

    <div class="tl reveal">
      <div class="tl__ruler">
        <span>00:00</span><span>00:12</span><span>00:24</span><span>00:36</span><span>00:48</span><span>END</span>
      </div>
      <div class="tl__track">
        <div class="tl__playhead"><span class="ptc">00:00:00:00</span></div>
        <div class="tl__clips">
          {copy.process.clips.map((c) => (
            <div class="clip">
              <div class="clip__strip"></div>
              <div>
                <span class="clip__no">{c.no}</span>
                <h3 class="clip__name" set:html={c.name} />
                {c.desc && <p class="clip__desc" set:html={c.desc} />}
              </div>
              <span class="clip__dur" set:html={c.dur} />
              <div class="clip__fill"></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="clients shell" id="clients" data-screen-label="Clients">
    <div class="sec-head">
      <h2 class="sec-title reveal" set:html={copy.clients.title} />
      <span class="sec-index reveal" set:html={copy.clients.index} />
    </div>
    {copy.clients.intro && (
      <p
        class="clients__intro reveal"
        style="max-width:62ch;margin-top:clamp(16px,2.4vh,26px);font-family:var(--font-display);font-size:clamp(16px,1.5vw,21px);line-height:1.55;color:var(--fg-dim);text-wrap:pretty"
        set:html={copy.clients.intro}
      />
    )}
    <div class="logo-marquee reveal" aria-label={copy.clients.marqueeLabel}>
      <div class="logo-track">
        {[false, true].map((dup) =>
          HOME_CLIENTS.map((logo) => (
            <div class="logo-cellc" aria-hidden={dup ? 'true' : undefined}>
              {logo.kind === 'img' ? (
                <AssetImage
                  src={logo.src}
                  alt={dup ? '' : logo.alt}
                  class="logo-mark"
                  loading="lazy"
                  decoding="async"
                  widths={[200, 310, 465]}
                  sizes="155px"
                  quality={80}
                  style={`--k:${logo.k}`}
                />
              ) : (
                <img
                  class="logo-mark"
                  loading="lazy"
                  decoding="async"
                  width="155"
                  height="22"
                  style={`--k:${logo.k}`}
                  src={logo.src}
                  alt={dup ? '' : logo.alt}
                />
              )}
            </div>
          )),
        )}
      </div>
    </div>
  </section>

  <section class="tm shell" id="opinie" data-screen-label={copy.testimonials.screenLabel}>
    <div class="sec-head">
      <h2 class="sec-title reveal" set:html={copy.testimonials.title} />
      <span class="sec-index reveal" set:html={copy.testimonials.index} />
    </div>
    <div class="tm__grid">
      {copy.testimonials.items.map((t, i) => (
        <figure class="tm-card reveal" data-d={i > 0 ? String(i) : undefined}>
          <div class="tm-card__mark">"</div>
          <blockquote class="tm-card__q" set:html={t.q} />
          <figcaption class="tm-card__by">
            <span class="tm-card__av">
              {t.avImg ? (
                <AssetImage
                  src={t.avImg}
                  alt={t.name.replace(/<[^>]+>/g, '')}
                  loading="lazy"
                  decoding="async"
                  widths={[200, 310, 465]}
                  sizes="155px"
                  quality={80}
                />
              ) : (
                t.av
              )}
            </span>
            <span><span class="tm-card__name" set:html={t.name} /></span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="contact" id="kontakt" data-screen-label={copy.contact.screenLabel}>
    <div class="contact__bg"></div>
    <div class="shell">
      <div class="sec-head">
        <h2 class="sec-title reveal" set:html={copy.contact.title} />
        <span class="sec-index reveal" set:html={copy.contact.index} />
      </div>
      <div class="contact__grid">
        <div>
          <span class="eyebrow reveal"><span class="tick"></span><Fragment set:html={copy.contact.eyebrow} /></span>
          <p class="contact__lead reveal" data-d="1" set:html={copy.contact.lead} />
          <div class="cinfo reveal" data-d="2">
            <div class="cinfo__item">
              <div class="cinfo__k" set:html={copy.contact.emailLabel} />
              <div class="cinfo__v"><a href="mailto:biuro@sezmoo.com">biuro@sezmoo.com</a></div>
            </div>
            <div class="cinfo__item">
              <div class="cinfo__k" set:html={copy.contact.phoneLabel} />
              <div class="cinfo__v"><a href={`tel:${PHONE_TEL}`}>{PHONE_DISPLAY}</a></div>
            </div>
            <div class="cinfo__item">
              <div class="cinfo__k" set:html={copy.contact.studioLabel} />
              <div class="cinfo__v" set:html={copy.contact.studioValue} />
            </div>
          </div>
          <div class="cinfo__socials reveal" data-d="3">
            <a href="https://www.instagram.com/sezmoo/" target="_blank" rel="noopener" aria-label="Instagram">Instagram</a>
            <a href="https://www.facebook.com/sezmooagencja" target="_blank" rel="noopener" aria-label="Facebook">Facebook</a>
            <a href="https://www.youtube.com/@sezmooagency" target="_blank" rel="noopener" aria-label="YouTube">YouTube</a>
            <a href="https://www.linkedin.com/company/sezmoo/" target="_blank" rel="noopener" aria-label="LinkedIn">LinkedIn</a>
          </div>
        </div>
        <ContactForm lang={lang} />
      </div>
    </div>
  </section>
  <script>
    import '../../../assets/js/home.js';
  </script>
</BaseLayout>
