---
import BaseLayout from './../../layouts/BaseLayout.astro';
const pageHtml = "<header class=\"cs-hero\" data-screen-label=\"Case · Cover\">\n  <div class=\"cs-hero__media\"><img src=\"/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-01.jpg\" alt=\"Hala produkcyjna Baltic Towers – kampania rekrutacyjna\" /></div>\n  <div class=\"cs-hero__hud\"><span class=\"rec\">REKRUTACJA · WIDEO</span><span>FOTO · SOCIAL</span><span>PRZEMYSŁ / PL</span></div>\n  <div class=\"cs-hero__inner shell\">\n    <a class=\"cs-hero__back\" href=\"../portfolio/\">← Portfolio / Realizacje</a>\n    <span class=\"eyebrow cs-hero__cat\"><span class=\"tick\"></span>SEZMOO × Baltic Towers · Kampania rekrutacyjna</span>\n    <h1 class=\"cs-title\">Baltic<br><span class=\"accent\">Towers.</span></h1>\n    <p class=\"cs-hero__sub\">Kampania rekrutacyjna dla <b>Baltic Towers</b> –&nbsp;producenta wież wiatrowych z&nbsp;Gdańska. Film do&nbsp;social mediów i&nbsp;zdjęcia z&nbsp;hali produkcyjnej, które pokazują pracę taką, jaka jest naprawdę.</p>\n  </div>\n  <div class=\"cs-scroll\" aria-hidden=\"true\"><span>SCROLL</span><i></i></div>\n</header>\n\n<section class=\"cs-meta\" aria-label=\"Dane projektu\">\n  <div class=\"shell\"><div class=\"cs-meta__grid\">\n    <div class=\"cs-meta__cell\"><div class=\"cs-meta__k\">Klient</div><div class=\"cs-meta__v\">Baltic Towers<small>Wieże wiatrowe</small></div></div>\n    <div class=\"cs-meta__cell\"><div class=\"cs-meta__k\">Branża</div><div class=\"cs-meta__v\">Przemysł<small>Offshore · Energetyka</small></div></div>\n    <div class=\"cs-meta__cell\"><div class=\"cs-meta__k\">Format</div><div class=\"cs-meta__v\">Kampania<small>Rekrutacja</small></div></div>\n    <div class=\"cs-meta__cell\"><div class=\"cs-meta__k\">Zakres</div><div class=\"cs-meta__v\">Wideo + foto<small>Social media</small></div></div>\n    <div class=\"cs-meta__cell\"><div class=\"cs-meta__k\">Cel</div><div class=\"cs-meta__v\">Nowi pracownicy<small>Produkcja</small></div></div>\n  </div></div>\n</section>\n\n<section class=\"cs-sec\" data-screen-label=\"O PROJEKCIE\">\n  <div class=\"shell\"><div class=\"cs-intro__grid\">\n    <div class=\"reveal\"><span class=\"cs-sec__no\">O PROJEKCIE</span><h2 class=\"cs-sec__title\">Praca, którą<br>warto <span class=\"accent\">zobaczyć.</span></h2></div>\n    <div class=\"cs-body reveal\" data-d=\"1\"><p>Baltic Towers buduje jedną z&nbsp;największych fabryk wież wiatrowych w&nbsp;Polsce i&nbsp;potrzebuje ludzi na&nbsp;produkcję: spawaczy, operatorów, monterów. Ogłoszenie z&nbsp;listą wymagań nie&nbsp;wystarczy, żeby ich przekonać.</p><p>Postawiliśmy na&nbsp;prawdziwy obraz: hala, maszyny, skala elementów i&nbsp;ludzie, którzy już tam pracują. Krótki, pionowy film do&nbsp;social mediów i&nbsp;seria zdjęć, które firma wykorzystuje w&nbsp;ogłoszeniach i&nbsp;na&nbsp;stronie kariery.</p></div>\n  </div></div>\n</section>\n\n<section class=\"cs-sec\" style=\"padding-top:0\" data-screen-label=\"PODEJŚCIE\">\n  <div class=\"shell\">\n    <span class=\"cs-sec__no reveal\">PODEJŚCIE</span>\n    <h2 class=\"cs-sec__title reveal\">Od hali<br>do&nbsp;<span class=\"accent\">feedu.</span></h2>\n    <div class=\"cs-steps\">\n      <div class=\"cs-step reveal\"><span class=\"cs-step__no\">W1, 01</span><h3 class=\"cs-step__title\">Koncepcja</h3><p class=\"cs-step__desc\">Format pionowy, krótki i&nbsp;dynamiczny –&nbsp;pod Instagram, Facebook i&nbsp;TikTok, gdzie szuka się dziś pracowników.</p></div>\n      <div class=\"cs-step reveal\"><span class=\"cs-step__no\">W1, 02</span><h3 class=\"cs-step__title\">Zdjęcia na&nbsp;produkcji</h3><p class=\"cs-step__desc\">Nagrania i&nbsp;foto bez zatrzymywania pracy hali –&nbsp;z&nbsp;zachowaniem zasad BHP zakładu.</p></div>\n      <div class=\"cs-step reveal\"><span class=\"cs-step__no\">W1, 03</span><h3 class=\"cs-step__title\">Montaż</h3><p class=\"cs-step__desc\">Rytm cięć dopasowany do&nbsp;social mediów, napisy i&nbsp;jasny komunikat: dołącz do&nbsp;zespołu.</p></div>\n      <div class=\"cs-step reveal\"><span class=\"cs-step__no\">W1, 04</span><h3 class=\"cs-step__title\">Foto do&nbsp;ogłoszeń</h3><p class=\"cs-step__desc\">Zdjęcia ludzi i&nbsp;procesu do&nbsp;ogłoszeń, kampanii płatnych i&nbsp;zakładki kariery.</p></div>\n    </div>\n  </div>\n</section>\n\n<section class=\"cs-sec\" data-screen-label=\"FILM REKRUTACYJNY\">\n  <div class=\"shell\">\n    <span class=\"cs-sec__no reveal\">FILM REKRUTACYJNY</span>\n    <h2 class=\"cs-sec__title reveal\">Krótko, pionowo,<br><span class=\"accent\">konkretnie.</span></h2>\n    <p class=\"cs-body reveal\" data-d=\"1\" style=\"max-width:54ch;margin-top:20px\">Film, który w&nbsp;kilkanaście sekund pokazuje skalę fabryki i&nbsp;charakter pracy. Gotowy do&nbsp;publikacji i&nbsp;promowania w&nbsp;kampaniach rekrutacyjnych.</p>\n    <div class=\"cs-film reveal\" data-d=\"1\" style=\"margin-top:clamp(30px,4vh,48px)\">\n      <div class=\"cs-film__frame\" data-cursor=\"play\" data-yt=\"eBcPwtZ0eOk\" role=\"button\" tabindex=\"0\" aria-label=\"Odtwórz film rekrutacyjny Baltic Towers\" style=\"aspect-ratio:9/16;max-width:420px;margin-inline:auto\">\n        <img src=\"/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-02.jpg\" alt=\"Odtwórz film rekrutacyjny Baltic Towers\" />\n        <div class=\"cs-film__play\"><span class=\"cs-film__btn\" aria-hidden=\"true\"></span></div>\n        <div class=\"cs-film__meta\"><span class=\"rec\">● REC</span><span>BALTIC TOWERS, REKRUTACJA</span></div>\n        <div class=\"cs-film__bar\"><i></i></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"cs-sec\" style=\"padding-bottom:0\" data-screen-label=\"FOTOGRAFIA\">\n  <div class=\"shell\"><span class=\"cs-sec__no reveal\">FOTOGRAFIA</span><h2 class=\"cs-sec__title reveal\">Ludzie i&nbsp;skala<br>produkcji.</h2></div>\n</section>\n<section class=\"cs-gallery bleed\" aria-label=\"FOTOGRAFIA\">\n  <div class=\"cs-row\"><figure class=\"cs-shot reveal\" style=\"aspect-ratio:16/9\"><div class=\"frame-media cs-shot__media\"><img src=\"/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-03.jpg\" alt=\"Segmenty wież wiatrowych w hali Baltic Towers\" loading=\"lazy\" /></div><span class=\"cs-shot__tag\" style=\"white-space:nowrap\">Foto · Produkcja</span></figure></div>\n  <div class=\"cs-row cs-row--split\"><figure class=\"cs-shot reveal\" style=\"aspect-ratio:4/3\"><div class=\"frame-media cs-shot__media\"><img src=\"/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-04.jpg\" alt=\"Spawanie na produkcji Baltic Towers – zdjęcie do kampanii rekrutacyjnej\" loading=\"lazy\" /></div><span class=\"cs-shot__tag\" style=\"white-space:nowrap\">Foto · Proces</span></figure><figure class=\"cs-shot reveal\" data-d=\"1\" style=\"aspect-ratio:4/3\"><div class=\"frame-media cs-shot__media\"><img src=\"/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-05.jpg\" alt=\"Wnętrze fabryki Baltic Towers w Gdańsku\" loading=\"lazy\" /></div><span class=\"cs-shot__tag\" style=\"white-space:nowrap\">Foto · Fabryka</span></figure></div>\n  <div class=\"cs-row cs-row--split\"><figure class=\"cs-shot reveal\" style=\"aspect-ratio:4/3\"><div class=\"frame-media cs-shot__media\"><img src=\"/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-02.jpg\" alt=\"Pracownik Baltic Towers przy produkcji – fotografia przemysłowa\" loading=\"lazy\" /></div><span class=\"cs-shot__tag\" style=\"white-space:nowrap\">Foto · Ludzie</span></figure><figure class=\"cs-shot reveal\" data-d=\"1\" style=\"aspect-ratio:4/3\"><div class=\"frame-media cs-shot__media\"><img src=\"/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-01.jpg\" alt=\"Hala produkcyjna Baltic Towers – produkcja segmentów wież wiatrowych\" loading=\"lazy\" /></div><span class=\"cs-shot__tag\" style=\"white-space:nowrap\">Foto · Hala</span></figure></div>\n</section>\n\n<section class=\"cs-quote\" aria-label=\"Quote\">\n  <div class=\"shell cs-sec\"><div class=\"cs-quote__inner reveal\">\n    <blockquote><span class=\"mark\">„</span>Rekrutacja zaczyna się od&nbsp;obrazu. Pokazaliśmy fabrykę tak, żeby ludzie chcieli w&nbsp;niej pracować.<span class=\"mark\">”</span></blockquote>\n    <div class=\"cs-quote__by\">– <b>Zespół SEZMOO</b> · Wideo, foto i&nbsp;social media</div>\n  </div></div>\n</section>\n\n<a class=\"cs-next bleed\" href=\"../portfolio/\" data-cursor=\"link\" aria-label=\"Wróć do portfolio\">\n  <img src=\"/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-03.jpg\" alt=\"\" />\n  <div class=\"cs-next__inner shell\"><span class=\"cs-next__k\">Zobacz więcej →</span><span class=\"cs-next__title\">Portfolio <span class=\"arrow\">→</span></span><span class=\"cs-next__cat\">Wszystkie realizacje SEZMOO</span></div>\n</a>";
const extraHeadHtml = "<link rel=\"stylesheet\" href=\"/assets/css/case-study.css\" />";
const pageScriptsHtml = "<script>\n(function(){var f=document.querySelector('.cs-film__frame');if(!f)return;function play(){var id=f.getAttribute('data-yt');if(!id||f.querySelector('iframe'))return;var i=document.createElement('iframe');i.src='https://www.youtube-nocookie.com/embed/'+id+'?autoplay=1&rel=0&modestbranding=1&playsinline=1';i.allow='autoplay; fullscreen; picture-in-picture';i.setAttribute('allowfullscreen','');f.appendChild(i);}f.addEventListener('click',play);f.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();play();}});})();\n</script>";
---

<BaseLayout
  lang="pl"
  title="Baltic Towers · Kampania rekrutacyjna · Realizacja SEZMOO"
  description="Case study SEZMOO: kampania rekrutacyjna Baltic Towers – film do social mediów i zdjęcia z produkcji wież wiatrowych."
  canonical="https://sezmoo.com/realizacja-baltic-towers-rekrutacja/"
  extraHead={extraHeadHtml}
  pageScripts={pageScriptsHtml}
>
  <Fragment set:html={pageHtml} />
</BaseLayout>
