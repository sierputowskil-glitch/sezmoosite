---
import AssetImage from '../components/AssetImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import OptImage from '../components/OptImage.astro';
import YtBg from '../components/YtBg.astro';
import HeroShowreel from '../components/HeroShowreel.astro';
import '../styles/home.css';

import workExlantix from '../../assets/portfolio/exlantix/exlantix-premiera-marki-gdansk-fotografia-21.jpg';
import workWow from '../../assets/work/captains-club-int.webp';
import workK2 from '../../assets/portfolio/k2/k2-hodowla-pstraga-zdjecie-z-drona-baseny.webp';
import workBaltic from '../../assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-01.jpg';
import workDoraco from '../../assets/portfolio/doraco-tvp/doraco-hala-zdjeciowa-tvp-zdjecia-z-drona-01.jpg';
import workSoho from '../../assets/portfolio/soho-form/soho-cover.webp';

const lang = 'pl' as const;
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://sezmoo.com').replace(/\/$/, '');
const canonical = `${siteUrl}/`;
const hreflangPl = `${siteUrl}/`;
const hreflangEn = `${siteUrl}/en/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'SEZMOO',
  description: "Studio wideo i contentu z Gdańska. Produkcja filmów reklamowych, materiałów na social media, animacji 3D/2D i kampanii dla marek.",
  url: canonical,
  email: 'biuro@sezmoo.com',
  telephone: '+48739260450',
  image: `${siteUrl}/assets/brand/sezmoo-logo-wy.svg`,
  priceRange: '$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Zeusa 34',
    postalCode: '80-299',
    addressLocality: 'Gdańsk',
    addressCountry: 'PL',
  },
  areaServed: 'PL',
  sameAs: [
    'https://www.instagram.com/sezmoo/',
    'https://www.facebook.com/sezmooagencja',
    'https://www.youtube.com/@sezmooagency',
    'https://www.linkedin.com/company/sezmoo/',
  ],
};
---

<BaseLayout
  lang={lang}
  title="SEZMOO · produkcja wideo, content i kampanie dla marek | Gdańsk"
  description="SEZMOO to studio wideo i contentu z Gdańska. Kręcimy filmy reklamowe, materiały na social media, animacje 3D/2D i kampanie, które budują widoczność marki, od pomysłu po gotowe formaty."
  canonical={canonical}
  keywords="produkcja wideo Gdańsk, filmy reklamowe, content na social media, produkcja filmowa, animacje 3D, kampanie reklamowe, studio wideo"
  ogTitle="SEZMOO · produkcja wideo, content i kampanie dla marek"
  ogDescription="Studio wideo i contentu z Gdańska. Filmy reklamowe, materiały na social media, animacje i kampanie, które budują widoczność marki."
  hreflangPl={hreflangPl}
  hreflangEn={hreflangEn}
  altHref="/en/"
  brandHref="/#hero"
  jsonLd={jsonLd}
  extraHead={`<link rel="preload" as="image" type="image/webp" href="/assets/video/showreel-poster.webp?v=20261016k" fetchpriority="high" />`}
>
<!-- ============ 1 · HERO ============ -->
<section class="hero" id="hero" data-screen-label="Hero">
  <div class="hero__reel">
    <div class="frame-media"></div>
    <HeroShowreel title="SEZMOO showreel" />
  </div>
  <div class="hero__grad"></div>

  <div class="hero__hud tr">
    <div>SEZMOO / AGENCJA KREATYWNA</div>
    <div style="color:var(--fg-faint);margin-top:6px">4K · 25FPS · GDAŃSK / PL</div>
  </div>

  <div class="shell hero__content">
    <span class="eyebrow hero__label"><span class="tick"></span>Showreel 2026</span>
    <div class="hero__measure">
    <h1>
      <span class="clip"><span>Od pomysłu</span></span>
      <span class="clip"><span>po <em class="accent" style="font-style:normal">realizację.</em></span></span>
    </h1>
    <p class="hero__sub" style="font-size:clamp(15px,1.15vw,18px);color:var(--fg-dim);max-width:100%;margin-top:16px;line-height:1.6">Łączymy <b>produkcję filmową i&nbsp;fotografię</b>, <b>content do&nbsp;social media</b> oraz <b>komunikację wizualną offline i&nbsp;online</b>. Jesteśmy z&nbsp;Gdańska, ale&nbsp;realizacje wykonujemy w&nbsp;całym kraju i&nbsp;za&nbsp;granicą.</p>
    </div>
    <div class="hero__cta">
      <a href="/portfolio/" class="btn btn--primary" data-magnetic><span class="ico"></span><span class="lbl">Zobacz portfolio</span></a>
      <a href="#kontakt" class="btn" data-magnetic><span class="lbl">Porozmawiajmy</span></a>
    </div>
  </div>
</section>

<!-- ============ 2 · WORK / PORTFOLIO ============ -->
<section class="work shell" id="work" data-screen-label="Work">
  <div class="sec-head">
    <h2 class="sec-title sec-title--line reveal">Wybrane <span style="color:#ffd200">projekty.</span></h2>
    <span class="sec-index reveal">PORTFOLIO</span>
  </div>

  <div class="work-slider reveal">
    <div class="work-reel" data-bands="3">

    <a class="card reveal" href="/realizacja-exlantix/" data-cats="eventy" data-cursor="link">
      <div class="card__media">
        <OptImage class="card__video" src={workExlantix} alt="Premiera marki EXLANTIX w Gdańsku – event, fotografia i wideo" widths={[360, 640, 960, 1280]} sizes="(max-width: 768px) 55vw, (max-width: 1100px) 40vw, 28vw" quality={78} />
        <div class="card__scan"></div><div class="card__sweep"></div>
        <div class="card__tc"><span class="rd"></span>TC 00:10:00</div>
        <div class="card__live">▶ EVENT</div>
        <span class="card__play">CASE</span>
        <div class="card__bar"><i></i></div>
      </div>
      <div class="card__info"><div><div class="card__client">EXLANTIX</div><div class="card__cat">Premiera marki / Event</div></div><span class="card__tag">CASE</span></div>
    </a>
<a class="card reveal" href="/realizacja-world-of-warships/" data-cats="eventy" data-cursor="link">
      <div class="card__media">
        <OptImage class="card__video" src={workWow} alt="World of Warships" widths={[360, 640, 960, 1280]} sizes="(max-width: 768px) 55vw, (max-width: 1100px) 40vw, 28vw" quality={78} />
        <div class="card__scan"></div><div class="card__sweep"></div>
        <div class="card__tc"><span class="rd"></span>TC 00:23:57</div>
        <div class="card__live">▶ EVENT</div>
        <span class="card__play">CASE</span>
        <div class="card__bar"><i></i></div>
      </div>
      <div class="card__info"><div><div class="card__client">World of Warships</div><div class="card__cat">Captain's Club / Event</div></div><span class="card__tag">CASE</span></div>
    </a>
<a class="card reveal" href="/realizacja-k2/" data-cats="grafika" data-cursor="link">
      <div class="card__media">
        <OptImage class="card__video" src={workK2} alt="Hodowla Ryb K2 – rebranding, strona WWW, zdjęcia i film z drona" widths={[360, 640, 960, 1280]} sizes="(max-width: 768px) 55vw, (max-width: 1100px) 40vw, 28vw" quality={78} />
        <div class="card__scan"></div><div class="card__sweep"></div>
        <div class="card__tc"><span class="rd"></span>TC 00:14:02</div>
        <div class="card__live">▶ CASE</div>
        <span class="card__play">CASE</span>
        <div class="card__bar"><i></i></div>
      </div>
      <div class="card__info"><div><div class="card__client">Hodowla Ryb K2</div><div class="card__cat">Rebranding / WWW / Dron</div></div><span class="card__tag">CASE</span></div>
    </a>
<a class="card reveal" href="/realizacja-baltic-towers-rekrutacja/" data-cats="video" data-cursor="link">
      <div class="card__media">
        <OptImage class="card__video" src={workBaltic} alt="Baltic Towers – kampania rekrutacyjna, film i zdjęcia z produkcji" widths={[360, 640, 960, 1280]} sizes="(max-width: 768px) 55vw, (max-width: 1100px) 40vw, 28vw" quality={78} />
        <div class="card__scan"></div><div class="card__sweep"></div>
        <div class="card__tc"><span class="rd"></span>TC 00:09:41</div>
        <div class="card__live">▶ CASE</div>
        <span class="card__play">CASE</span>
        <div class="card__bar"><i></i></div>
      </div>
      <div class="card__info"><div><div class="card__client">Baltic Towers</div><div class="card__cat">Rekrutacja / Wideo / Foto</div></div><span class="card__tag">CASE</span></div>
    </a>
<a class="card reveal" href="/realizacja-doraco-hala-tvp/" data-cats="video" data-cursor="link">
      <div class="card__media">
        <OptImage class="card__video" src={workDoraco} alt="DORACO – hala zdjęciowa TVP, film i zdjęcia z drona" widths={[360, 640, 960, 1280]} sizes="(max-width: 768px) 55vw, (max-width: 1100px) 40vw, 28vw" quality={78} />
        <div class="card__scan"></div><div class="card__sweep"></div>
        <div class="card__tc"><span class="rd"></span>TC 00:09:41</div>
        <div class="card__live">▶ CASE</div>
        <span class="card__play">CASE</span>
        <div class="card__bar"><i></i></div>
      </div>
      <div class="card__info"><div><div class="card__client">DORACO × TVP</div><div class="card__cat">Film / Foto / Dron</div></div><span class="card__tag">CASE</span></div>
    </a>
<a class="card reveal" href="/realizacja-soho-form/" data-cats="grafika" data-cursor="link">
      <div class="card__media">
        <OptImage class="card__video" src={workSoho} alt="Soho Form – logo, księga znaku i strona internetowa" widths={[360, 640, 960, 1280]} sizes="(max-width: 768px) 55vw, (max-width: 1100px) 40vw, 28vw" quality={78} />
        <div class="card__scan"></div><div class="card__sweep"></div>
        <div class="card__tc"><span class="rd"></span>TC 00:21:37</div>
        <div class="card__live">▶ CASE</div>
        <span class="card__play">CASE</span>
        <div class="card__bar"><i></i></div>
      </div>
      <div class="card__info"><div><div class="card__client">Soho Form</div><div class="card__cat">Branding / Strona WWW</div></div><span class="card__tag">CASE</span></div>
    </a>


  </div>
  </div>
  <div class="work-slider__hud reveal">
    <button class="work-nav" type="button" aria-label="Poprzednie realizacje" data-reel-prev>‹</button>
    <div class="work-dots" data-reel-dots></div>
    <span class="work-reel__count" data-reel-count><b>01</b> / 02</span>
    <button class="work-nav" type="button" aria-label="Kolejne realizacje" data-reel-next>›</button>
  </div>
  <div class="reveal" style="display:flex;justify-content:center;margin-top:clamp(36px,4.5vw,64px)">
    <a href="/portfolio/" class="btn btn--primary" data-magnetic><span class="ico"></span><span class="lbl">Zobacz całe portfolio</span></a>
  </div>
</section>

<!-- ============ 3 · WHAT WE DO ============ -->
<section class="services shell" id="services" data-screen-label="Services">
  <div class="services-static reveal">
      <div class="sec-head">
        <h2 class="sec-title reveal">Nasze <span style="color:#ffd200">usługi.</span></h2>
        <span class="sec-index reveal">PRODUKCJA CONTENTU</span>
      </div>
  </div>

  <div class="svc-grid">
    <a class="svc reveal svc--pillar" href="/uslugi-marketingowe/produkcja-wideo-reels/" data-cursor="link">
      <svg class="svc__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 19 19 5M19 5H8M19 5v11"/></svg>
      <div class="svc__body">
        <svg class="svc__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="1.5"/><path d="M7 4.5v15M17 4.5v15M2.5 9.5h4.5M2.5 14.5h4.5M17 9.5h4.5M17 14.5h4.5"/></svg>
        <h3 class="svc__title">Produkcja filmowa<br />i&nbsp;motion design</h3>
        <p class="svc__desc">Produkcja wideo reklamowego, rolek i&nbsp;animacji 2D. Kręcimy, animujemy i&nbsp;eksportujemy w&nbsp;formatach pod&nbsp;kampanie i&nbsp;social media.</p>
        <div class="svc__chips"><span>wideo</span><span>spoty</span><span>reels</span><span>dron</span><span>motion</span></div>
      </div>
    </a>
    <a class="svc reveal svc--pillar" href="/uslugi-marketingowe/fotografia/" data-d="1" data-cursor="link">
      <svg class="svc__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 19 19 5M19 5H8M19 5v11"/></svg>
      <div class="svc__body">
        <svg class="svc__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5h3l1.6-2.4h8.8L18 8.5h3v10.5a.5.5 0 0 1-.5.5h-17a.5.5 0 0 1-.5-.5V8.5Z"/><circle cx="12" cy="13.5" r="4"/></svg>
        <h3 class="svc__title">Fotografia</h3>
        <p class="svc__desc">Sesje produktowe, wizerunkowe i&nbsp;eventowe. Od&nbsp;sesji w&nbsp;studio po&nbsp;reportaż z&nbsp;wydarzenia –&nbsp;zdjęcia gotowe do&nbsp;kampanii i&nbsp;social media.</p>
        <div class="svc__chips"><span>produkt</span><span>wizerunek</span><span>event</span><span>studio</span></div>
      </div>
    </a>
    <a class="svc reveal svc--pillar" href="/uslugi-marketingowe/projektowanie-graficzne/" data-d="2" data-cursor="link">
      <svg class="svc__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 19 19 5M19 5H8M19 5v11"/></svg>
      <div class="svc__body">
        <svg class="svc__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15.2 3.9l4.9 4.9M3.5 20.5l1.2-5 11-11 4.9 4.9-11 11-5.1 1.1Z"/><path d="M12.7 6.4l4.9 4.9"/></svg>
        <h3 class="svc__title">Grafika i&nbsp;branding</h3>
        <p class="svc__desc">Logotypy, key visuale i&nbsp;grafika do&nbsp;social mediów. Materiały reklamowe, katalogi i&nbsp;projekty WWW –&nbsp;od&nbsp;projektu po&nbsp;realizację.</p>
        <div class="svc__chips"><span>logo</span><span>KV</span><span>katalogi</span><span>WWW</span></div>
      </div>
    </a>
    <a class="svc reveal svc--pillar" href="/uslugi-marketingowe/obsluga-social-media/" data-d="3" data-cursor="link">
      <svg class="svc__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 19 19 5M19 5H8M19 5v11"/></svg>
      <div class="svc__body">
        <svg class="svc__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M10.5 5.4h3"/><circle cx="12" cy="18" r="1"/></svg>
        <h3 class="svc__title">Social media</h3>
        <p class="svc__desc">Strategia contentu, publikacje i&nbsp;prowadzenie profili oraz kampanie płatne –&nbsp;od&nbsp;strategii po&nbsp;codzienną obecność.</p>
        <div class="svc__chips"><span>strategia</span><span>publikacje</span><span>kampanie</span></div>
      </div>
    </a>
    <a class="svc reveal svc--pillar" href="/uslugi-marketingowe/#lista-uslug" data-d="4" data-cursor="link">
      <svg class="svc__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 19 19 5M19 5H8M19 5v11"/></svg>
      <div class="svc__body">
        <svg class="svc__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5.4l3.4 2.1"/></svg>
        <h3 class="svc__title">Abonament i&nbsp;stała współpraca</h3>
        <p class="svc__desc">Stały pakiet godzin produkcyjnych w&nbsp;miesiącu –&nbsp;Ty decydujesz, na&nbsp;co je&nbsp;przeznaczyć. Raz wideo, raz sesja foto, raz grafika. Jeden zespół, elastycznie dopasowany do&nbsp;bieżących potrzeb marki.</p>
        <div class="svc__chips"><span>godziny</span><span>elastycznie</span><span>zespół</span></div>
      </div>
    </a>
  </div>
</section>

<!-- ============ 4 · STUDIO ============ -->
<section class="studio shell" id="studio" data-screen-label="Studio">
  <div class="sec-head">
    <span class="sec-index reveal" style="order:2">STUDIO</span>
    <span class="eyebrow reveal"><span class="tick"></span>Dlaczego SEZMOO</span>
  </div>
  <div class="studio__grid">
    <div class="studio__sticky reveal">
      <div class="studio__media is-vertical" data-parallax="26">
        <div class="frame-media" style="transform:translateY(var(--py,0))"></div>
        <YtBg videoId="b_MB9qpw6jE" title="SEZMOO · zespół" priority="lazy" />
        <div class="ovl">
          <div class="corners"><span></span><span></span><span></span><span></span></div>
          <div class="tc"><span class="d"></span><span data-tc>00:00:12:08</span></div>
        </div>
      </div>
    </div>
    <div>
      <h2 class="studio__title reveal">Poznaj <span class="accent">SEZMOO.</span></h2>
      <p class="studio__copy studio__copy--lead">Agencja kreatywna SEZMOO –&nbsp;produkcja wideo, social media, branding i&nbsp;reklama.</p>
      <p class="studio__copy">Jesteśmy z&nbsp;Gdańska, ale&nbsp;realizacje wykonujemy w&nbsp;całym kraju i&nbsp;za&nbsp;granicą.</p>
      <p class="studio__copy">Film, fotografia, grafika, digital i&nbsp;produkcja offline powstają w&nbsp;jednym zespole. Dzięki temu łatwiej zachować spójność, sprawniej reagować na&nbsp;zmiany i&nbsp;prowadzić projekt od&nbsp;pierwszego pomysłu do&nbsp;gotowego wdrożenia.</p>
      <p class="studio__copy">Działamy projektowo, przy&nbsp;pojedynczych realizacjach, ale&nbsp;też abonamentowo, gdy&nbsp;marka potrzebuje stałej produkcji.</p>
      <div class="studio__points">
        <div class="spt"><span class="spt__no">01</span><span class="spt__txt">14 lat na&nbsp;rynku.</span></div>
        <div class="spt"><span class="spt__no">02</span><span class="spt__txt">Własny sprzęt filmowy i&nbsp;zaplecze produkcyjne.</span></div>
        <div class="spt"><span class="spt__no">03</span><span class="spt__txt">Stały zespół.</span></div>
        <div class="spt"><span class="spt__no">04</span><span class="spt__txt">Jesteśmy z&nbsp;Gdańska, ale&nbsp;realizacje wykonujemy w&nbsp;całym kraju i&nbsp;za&nbsp;granicą.</span></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ 5 · TEAM ============ -->
<section class="team shell" id="team" data-screen-label="Team">
  <div class="sec-head">
    <h2 class="sec-title reveal">Zespół.</h2>
    <span class="sec-index reveal">ZESPÓŁ</span>
  </div>

  <div class="team__grid team__grid--photos">
    <article class="team-card reveal" data-d="0">
      <div class="team-card__photo">
        <span class="tc-ini" aria-hidden="true">MT</span>
        <AssetImage src="/assets/team/maciej-tyma.png" alt="Maciej Tyma" class="tc-ph" loading="lazy" decoding="async" widths={[160, 320, 480]} sizes="96px" quality={78} />
      </div>
      <div class="team-card__body">
        <span class="team-card__no">T·01</span>
        <h3 class="team-card__name">Maciej Tyma</h3>
        <p class="team-card__role">Founder · Fotograf i&nbsp;producent wideo</p>
      </div>
    </article>
    <article class="team-card reveal" data-d="1">
      <div class="team-card__photo">
        <span class="tc-ini" aria-hidden="true">HF</span>
        <AssetImage src="/assets/team/hubert-fudala.png" alt="Hubert Fudała" class="tc-ph" loading="lazy" decoding="async" widths={[160, 320, 480]} sizes="96px" quality={78} />
      </div>
      <div class="team-card__body">
        <span class="team-card__no">T·02</span>
        <h3 class="team-card__name">Hubert Fudała</h3>
        <p class="team-card__role">Operator kamery i&nbsp;montażysta</p>
      </div>
    </article>
    <article class="team-card reveal" data-d="2">
      <div class="team-card__photo">
        <span class="tc-ini" aria-hidden="true">RS</span>
        <AssetImage src="/assets/team/radoslaw-schenk.png" alt="Radosław Schenk" class="tc-ph" loading="lazy" decoding="async" widths={[160, 320, 480]} sizes="96px" quality={78} />
      </div>
      <div class="team-card__body">
        <span class="team-card__no">T·03</span>
        <h3 class="team-card__name">Radosław Schenk</h3>
        <p class="team-card__role">Operator kamery i&nbsp;montażysta</p>
      </div>
    </article>
    <article class="team-card reveal" data-d="3">
      <div class="team-card__photo">
        <span class="tc-ini" aria-hidden="true">KM</span>
        <AssetImage src="/assets/team/kamil-mroz.png" alt="Kamil Mróz" class="tc-ph" loading="lazy" decoding="async" widths={[160, 320, 480]} sizes="96px" quality={78} />
      </div>
      <div class="team-card__body">
        <span class="team-card__no">T·04</span>
        <h3 class="team-card__name">Kamil Mróz</h3>
        <p class="team-card__role">Operator kamery i&nbsp;montażysta</p>
      </div>
    </article>
    <article class="team-card reveal" data-d="0">
      <div class="team-card__photo">
