---
import BaseLayout from './../layouts/BaseLayout.astro';
const pageHtml = "<!-- ============ 1 · HERO ============ -->\n<section class=\"hero\" id=\"hero\" data-screen-label=\"Hero\">\n  <div class=\"hero__reel\">\n    <div class=\"frame-media\"></div>\n    <div class=\"hero__video\">\n      <div class=\"yt-bg\">\n        <iframe\n          src=\"https://www.youtube-nocookie.com/embed/YkWCkew6OGg?autoplay=1&mute=1&controls=0&loop=1&playlist=YkWCkew6OGg&playsinline=1&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1&fs=0&origin=https://sezmoo.com\"\n          title=\"SEZMOO showreel\"\n          allow=\"autoplay; encrypted-media; picture-in-picture\"\n          referrerpolicy=\"strict-origin-when-cross-origin\"\n          loading=\"eager\"></iframe>\n      </div>\n    </div>\n  </div>\n  <div class=\"hero__grad\"></div>\n\n  <div class=\"hero__hud tr\">\n    <div>SEZMOO / AGENCJA KREATYWNA</div>\n    <div style=\"color:var(--fg-faint);margin-top:6px\">4K · 25FPS · GDAŃSK / PL</div>\n  </div>\n\n  <div class=\"shell hero__content\">\n    <span class=\"eyebrow hero__label\"><span class=\"tick\"></span>Showreel 2026</span>\n    <div class=\"hero__measure\">\n    <h1>\n      <span class=\"clip\"><span>Od pomysłu</span></span>\n      <span class=\"clip\"><span>po <em class=\"accent\" style=\"font-style:normal\">realizację.</em></span></span>\n    </h1>\n    <p class=\"hero__sub\" style=\"font-size:clamp(15px,1.15vw,18px);color:var(--fg-dim);max-width:100%;margin-top:16px;line-height:1.6\">Łączymy <b>produkcję filmową i&nbsp;fotografię</b>, <b>content do&nbsp;social media</b> oraz <b>komunikację wizualną offline i&nbsp;online</b>. Jesteśmy z&nbsp;Gdańska, ale&nbsp;realizacje wykonujemy w&nbsp;całym kraju i&nbsp;za&nbsp;granicą.</p>\n    </div>\n    <div class=\"hero__cta\">\n      <a href=\"/portfolio/\" class=\"btn btn--primary\" data-magnetic><span class=\"ico\"></span><span class=\"lbl\">Zobacz portfolio</span></a>\n      <a href=\"#kontakt\" class=\"btn\" data-magnetic><span class=\"lbl\">Porozmawiajmy</span></a>\n    </div>\n  </div>\n</section>\n\n<!-- ============ 2 · WORK / PORTFOLIO ============ -->\n<section class=\"work shell\" id=\"work\" data-screen-label=\"Work\">\n  <div class=\"sec-head\">\n    <h2 class=\"sec-title sec-title--line reveal\">Wybrane <span style=\"color:#ffd200\">projekty.</span></h2>\n    <span class=\"sec-index reveal\">PORTFOLIO</span>\n  </div>\n\n  <div class=\"work-slider reveal\">\n    <div class=\"work-reel\" data-bands=\"3\">\n\n    <a class=\"card reveal\" href=\"/realizacja-exlantix/\" data-cats=\"eventy\" data-cursor=\"link\">\n      <div class=\"card__media\">\n        <img class=\"card__video\" src=\"/assets/portfolio/exlantix/exlantix-premiera-marki-gdansk-fotografia-21.jpg\" alt=\"Premiera marki EXLANTIX w Gdańsku – event, fotografia i wideo\" loading=\"lazy\" />\n        <div class=\"card__scan\"></div><div class=\"card__sweep\"></div>\n        <div class=\"card__tc\"><span class=\"rd\"></span>TC 00:10:00</div>\n        <div class=\"card__live\">▶ EVENT</div>\n        <span class=\"card__play\">CASE</span>\n        <div class=\"card__bar\"><i></i></div>\n      </div>\n      <div class=\"card__info\"><div><div class=\"card__client\">EXLANTIX</div><div class=\"card__cat\">Premiera marki / Event</div></div><span class=\"card__tag\">CASE</span></div>\n    </a>\n<a class=\"card reveal\" href=\"/realizacja-world-of-warships/\" data-cats=\"eventy\" data-cursor=\"link\">\n      <div class=\"card__media\">\n        <img class=\"card__video\" src=\"/assets/work/captains-club-int.avif\" alt=\"World of Warships\" loading=\"lazy\" />\n        <div class=\"card__scan\"></div><div class=\"card__sweep\"></div>\n        <div class=\"card__tc\"><span class=\"rd\"></span>TC 00:23:57</div>\n        <div class=\"card__live\">▶ EVENT</div>\n        <span class=\"card__play\">CASE</span>\n        <div class=\"card__bar\"><i></i></div>\n      </div>\n      <div class=\"card__info\"><div><div class=\"card__client\">World of Warships</div><div class=\"card__cat\">Captain's Club / Event</div></div><span class=\"card__tag\">CASE</span></div>\n    </a>\n<a class=\"card reveal\" href=\"/realizacja-k2/\" data-cats=\"grafika\" data-cursor=\"link\">\n      <div class=\"card__media\">\n        <img class=\"card__video\" src=\"/assets/portfolio/k2/k2-hodowla-pstraga-zdjecie-z-drona-baseny.webp\" alt=\"Hodowla Ryb K2 – rebranding, strona WWW, zdjęcia i film z drona\" loading=\"lazy\" />\n        <div class=\"card__scan\"></div><div class=\"card__sweep\"></div>\n        <div class=\"card__tc\"><span class=\"rd\"></span>TC 00:14:02</div>\n        <div class=\"card__live\">▶ CASE</div>\n        <span class=\"card__play\">CASE</span>\n        <div class=\"card__bar\"><i></i></div>\n      </div>\n      <div class=\"card__info\"><div><div class=\"card__client\">Hodowla Ryb K2</div><div class=\"card__cat\">Rebranding / WWW / Dron</div></div><span class=\"card__tag\">CASE</span></div>\n    </a>\n<a class=\"card reveal\" href=\"/realizacja-baltic-towers-rekrutacja/\" data-cats=\"video\" data-cursor=\"link\">\n      <div class=\"card__media\">\n        <img class=\"card__video\" src=\"/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-01.jpg\" alt=\"Baltic Towers – kampania rekrutacyjna, film i zdjęcia z produkcji\" loading=\"lazy\" />\n        <div class=\"card__scan\"></div><div class=\"card__sweep\"></div>\n        <div class=\"card__tc\"><span class=\"rd\"></span>TC 00:09:41</div>\n        <div class=\"card__live\">▶ CASE</div>\n        <span class=\"card__play\">CASE</span>\n        <div class=\"card__bar\"><i></i></div>\n      </div>\n      <div class=\"card__info\"><div><div class=\"card__client\">Baltic Towers</div><div class=\"card__cat\">Rekrutacja / Wideo / Foto</div></div><span class=\"card__tag\">CASE</span></div>\n    </a>\n<a class=\"card reveal\" href=\"/realizacja-doraco-hala-tvp/\" data-cats=\"video\" data-cursor=\"link\">\n      <div class=\"card__media\">\n        <img class=\"card__video\" src=\"/assets/portfolio/doraco-tvp/doraco-hala-zdjeciowa-tvp-zdjecia-z-drona-01.jpg\" alt=\"DORACO – hala zdjęciowa TVP, film i zdjęcia z drona\" loading=\"lazy\" />\n        <div class=\"card__scan\"></div><div class=\"card__sweep\"></div>\n        <div class=\"card__tc\"><span class=\"rd\"></span>TC 00:09:41</div>\n        <div class=\"card__live\">▶ CASE</div>\n        <span class=\"card__play\">CASE</span>\n        <div class=\"card__bar\"><i></i></div>\n      </div>\n      <div class=\"card__info\"><div><div class=\"card__client\">DORACO × TVP</div><div class=\"card__cat\">Film / Foto / Dron</div></div><span class=\"card__tag\">CASE</span></div>\n    </a>\n<a class=\"card reveal\" href=\"/realizacja-soho-form/\" data-cats=\"grafika\" data-cursor=\"link\">\n      <div class=\"card__media\">\n        <img class=\"card__video\" src=\"/assets/portfolio/soho-form/soho-fotel.webp\" alt=\"Soho Form – logo, księga znaku i strona internetowa\" loading=\"lazy\" />\n        <div class=\"card__scan\"></div><div class=\"card__sweep\"></div>\n        <div class=\"card__tc\"><span class=\"rd\"></span>TC 00:21:37</div>\n        <div class=\"card__live\">▶ CASE</div>\n        <span class=\"card__play\">CASE</span>\n        <div class=\"card__bar\"><i></i></div>\n      </div>\n      <div class=\"card__info\"><div><div class=\"card__client\">Soho Form</div><div class=\"card__cat\">Branding / Strona WWW</div></div><span class=\"card__tag\">CASE</span></div>\n    </a>\n\n\n  </div>\n  </div>\n  <div class=\"work-slider__hud reveal\">\n    <button class=\"work-nav\" type=\"button\" aria-label=\"Poprzednie realizacje\" data-reel-prev>‹</button>\n    <div class=\"work-dots\" data-reel-dots></div>\n    <span class=\"work-reel__count\" data-reel-count><b>01</b> / 02</span>\n    <button class=\"work-nav\" type=\"button\" aria-label=\"Kolejne realizacje\" data-reel-next>›</button>\n  </div>\n  <div class=\"reveal\" style=\"display:flex;justify-content:center;margin-top:clamp(36px,4.5vw,64px)\">\n    <a href=\"/portfolio/\" class=\"btn btn--primary\" data-magnetic><span class=\"ico\"></span><span class=\"lbl\">Zobacz całe portfolio</span></a>\n  </div>\n</section>\n\n<!-- ============ 3 · WHAT WE DO ============ -->\n<section class=\"services shell\" id=\"services\" data-screen-label=\"Services\">\n  <div class=\"services-static reveal\">\n      <div class=\"sec-head\">\n        <h2 class=\"sec-title reveal\">Nasze <span style=\"color:#ffd200\">usługi.</span></h2>\n        <span class=\"sec-index reveal\">PRODUKCJA CONTENTU</span>\n      </div>\n      \n      </div>\n  </div>\n\n  <div class=\"svc-grid\">\n    <a class=\"svc reveal svc--pillar\" href=\"/uslugi-marketingowe/produkcja-wideo-reels/\" data-cursor=\"link\">\n      <svg class=\"svc__arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 19 19 5M19 5H8M19 5v11\"/></svg>\n      <div class=\"svc__body\">\n        <svg class=\"svc__ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"2.5\" y=\"4.5\" width=\"19\" height=\"15\" rx=\"1.5\"/><path d=\"M7 4.5v15M17 4.5v15M2.5 9.5h4.5M2.5 14.5h4.5M17 9.5h4.5M17 14.5h4.5\"/></svg>\n        <h3 class=\"svc__title\">Produkcja filmowa<br>i&nbsp;motion design</h3>\n        <p class=\"svc__desc\">Produkcja wideo reklamowego, rolek i&nbsp;animacji 2D. Kręcimy, animujemy i&nbsp;eksportujemy w&nbsp;formatach pod&nbsp;kampanie i&nbsp;social media.</p>\n        <div class=\"svc__chips\"><span>wideo</span><span>spoty</span><span>reels</span><span>dron</span><span>motion</span></div>\n      </div>\n    </a>\n    <a class=\"svc reveal svc--pillar\" href=\"/uslugi-marketingowe/fotografia/\" data-d=\"1\" data-cursor=\"link\">\n      <svg class=\"svc__arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 19 19 5M19 5H8M19 5v11\"/></svg>\n      <div class=\"svc__body\">\n        <svg class=\"svc__ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 8.5h3l1.6-2.4h8.8L18 8.5h3v10.5a.5.5 0 0 1-.5.5h-17a.5.5 0 0 1-.5-.5V8.5Z\"/><circle cx=\"12\" cy=\"13.5\" r=\"4\"/></svg>\n        <h3 class=\"svc__title\">Fotografia</h3>\n        <p class=\"svc__desc\">Sesje produktowe, wizerunkowe i&nbsp;eventowe. Od&nbsp;sesji w&nbsp;studio po&nbsp;reportaż z&nbsp;wydarzenia –&nbsp;zdjęcia gotowe do&nbsp;kampanii i&nbsp;social media.</p>\n        <div class=\"svc__chips\"><span>produkt</span><span>wizerunek</span><span>event</span><span>studio</span></div>\n      </div>\n    </a>\n    <a class=\"svc reveal svc--pillar\" href=\"/uslugi-marketingowe/projektowanie-graficzne/\" data-d=\"2\" data-cursor=\"link\">\n      <svg class=\"svc__arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 19 19 5M19 5H8M19 5v11\"/></svg>\n      <div class=\"svc__body\">\n        <svg class=\"svc__ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M15.2 3.9l4.9 4.9M3.5 20.5l1.2-5 11-11 4.9 4.9-11 11-5.1 1.1Z\"/><path d=\"M12.7 6.4l4.9 4.9\"/></svg>\n        <h3 class=\"svc__title\">Grafika i&nbsp;branding</h3>\n        <p class=\"svc__desc\">Logotypy, key visuale i&nbsp;grafika do&nbsp;social mediów. Materiały reklamowe, katalogi i&nbsp;projekty WWW –&nbsp;od&nbsp;projektu po&nbsp;realizację.</p>\n        <div class=\"svc__chips\"><span>logo</span><span>KV</span><span>katalogi</span><span>WWW</span></div>\n      </div>\n    </a>\n    <a class=\"svc reveal svc--pillar\" href=\"/uslugi-marketingowe/obsluga-social-media/\" data-d=\"3\" data-cursor=\"link\">\n      <svg class=\"svc__arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 19 19 5M19 5H8M19 5v11\"/></svg>\n      <div class=\"svc__body\">\n        <svg class=\"svc__ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"6.5\" y=\"2.5\" width=\"11\" height=\"19\" rx=\"2.5\"/><path d=\"M10.5 5.4h3\"/><circle cx=\"12\" cy=\"18\" r=\"1\"/></svg>\n        <h3 class=\"svc__title\">Social media</h3>\n        <p class=\"svc__desc\">Strategia contentu, publikacje i&nbsp;prowadzenie profili oraz kampanie płatne –&nbsp;od&nbsp;strategii po&nbsp;codzienną obecność.</p>\n        <div class=\"svc__chips\"><span>strategia</span><span>publikacje</span><span>kampanie</span></div>\n      </div>\n    </a>\n    <a class=\"svc reveal svc--pillar\" href=\"/uslugi-marketingowe/#lista-uslug\" data-d=\"4\" data-cursor=\"link\">\n      <svg class=\"svc__arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 19 19 5M19 5H8M19 5v11\"/></svg>\n      <div class=\"svc__body\">\n        <svg class=\"svc__ico\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5.4l3.4 2.1\"/></svg>\n        <h3 class=\"svc__title\">Abonament i&nbsp;stała współpraca</h3>\n        <p class=\"svc__desc\">Stały pakiet godzin produkcyjnych w&nbsp;miesiącu –&nbsp;Ty decydujesz, na&nbsp;co je&nbsp;przeznaczyć. Raz wideo, raz sesja foto, raz grafika. Jeden zespół, elastycznie dopasowany do&nbsp;bieżących potrzeb marki.</p>\n        <div class=\"svc__chips\"><span>godziny</span><span>elastycznie</span><span>zespół</span></div>\n      </div>\n    </a>\n  </div>\n</section>\n\n<!-- ============ 4 · STUDIO ============ -->\n<section class=\"studio shell\" id=\"studio\" data-screen-label=\"Studio\">\n  <div class=\"sec-head\">\n    <span class=\"sec-index reveal\" style=\"order:2\">STUDIO</span>\n    <span class=\"eyebrow reveal\"><span class=\"tick\"></span>Dlaczego SEZMOO</span>\n  </div>\n  <div class=\"studio__grid\">\n    <div class=\"studio__sticky reveal\">\n      <div class=\"studio__media is-vertical\" data-parallax=\"26\">\n        <div class=\"frame-media\" style=\"transform:translateY(var(--py,0))\"></div>\n        <div class=\"yt-bg\">\n          <iframe\n            src=\"https://www.youtube-nocookie.com/embed/b_MB9qpw6jE?autoplay=1&mute=1&controls=0&loop=1&playlist=b_MB9qpw6jE&playsinline=1&modestbranding=1&rel=0&iv_load_policy=3&disablekb=1&fs=0&origin=https://sezmoo.com\"\n            title=\"SEZMOO · zespół\"\n            allow=\"autoplay; encrypted-media; picture-in-picture\"\n            referrerpolicy=\"strict-origin-when-cross-origin\"\n            loading=\"lazy\"></iframe>\n        </div>\n        <div class=\"ovl\">\n          <div class=\"corners\"><span></span><span></span><span></span><span></span></div>\n          <div class=\"tc\"><span class=\"d\"></span><span data-tc>00:00:12:08</span></div>\n        </div>\n      </div>\n    </div>\n    <div>\n      <h2 class=\"studio__title reveal\">Poznaj <span class=\"accent\">SEZMOO.</span></h2>\n      <p class=\"studio__copy studio__copy--lead\">Agencja kreatywna SEZMOO –&nbsp;produkcja wideo, social media, branding i&nbsp;reklama.</p>\n      <p class=\"studio__copy\">Jesteśmy z&nbsp;Gdańska, ale&nbsp;realizacje wykonujemy w&nbsp;całym kraju i&nbsp;za&nbsp;granicą.</p>\n      <p class=\"studio__copy\">Film, fotografia, grafika, digital i&nbsp;produkcja offline powstają w&nbsp;jednym zespole. Dzięki temu łatwiej zachować spójność, sprawniej reagować na&nbsp;zmiany i&nbsp;prowadzić projekt od&nbsp;pierwszego pomysłu do&nbsp;gotowego wdrożenia.</p>\n      <p class=\"studio__copy\">Działamy projektowo, przy&nbsp;pojedynczych realizacjach, ale&nbsp;też abonamentowo, gdy&nbsp;marka potrzebuje stałej produkcji.</p>\n      <div class=\"studio__points\">\n        <div class=\"spt\"><span class=\"spt__no\">01</span><span class=\"spt__txt\">14 lat na&nbsp;rynku.</span></div>\n        <div class=\"spt\"><span class=\"spt__no\">02</span><span class=\"spt__txt\">Własny sprzęt filmowy i&nbsp;zaplecze produkcyjne.</span></div>\n        <div class=\"spt\"><span class=\"spt__no\">03</span><span class=\"spt__txt\">Stały zespół.</span></div>\n        <div class=\"spt\"><span class=\"spt__no\">04</span><span class=\"spt__txt\">Jesteśmy z&nbsp;Gdańska, ale&nbsp;realizacje wykonujemy w&nbsp;całym kraju i&nbsp;za&nbsp;granicą.</span></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ 5 · TEAM ============ -->\n<section class=\"team shell\" id=\"team\" data-screen-label=\"Team\">\n  <div class=\"sec-head\">\n    <h2 class=\"sec-title reveal\">Zespół.</h2>\n    <span class=\"sec-index reveal\">ZESPÓŁ</span>\n  </div>\n\n  <div class=\"team__grid team__grid--photos\">\n    <article class=\"team-card reveal\" data-d=\"0\">\n      <div class=\"team-card__photo\">\n        <span class=\"tc-ini\" aria-hidden=\"true\">MT</span>\n        <img class=\"tc-ph\" src=\"/assets/team/maciej-tyma.png\" alt=\"Maciej Tyma\" loading=\"lazy\" decoding=\"async\" />\n      </div>\n      <div class=\"team-card__body\">\n        <span class=\"team-card__no\">T·01</span>\n        <h3 class=\"team-card__name\">Maciej Tyma</h3>\n        <p class=\"team-card__role\">Founder · Fotograf i&nbsp;producent wideo</p>\n      </div>\n    </article>\n    <article class=\"team-card reveal\" data-d=\"1\">\n      <div class=\"team-card__photo\">\n        <span class=\"tc-ini\" aria-hidden=\"true\">HF</span>\n        <img class=\"tc-ph\" src=\"/assets/team/hubert-fudala.png\" alt=\"Hubert Fudała\" loading=\"lazy\" decoding=\"async\" />\n      </div>\n      <div class=\"team-card__body\">\n        <span class=\"team-card__no\">T·02</span>\n        <h3 class=\"team-card__name\">Hubert Fudała</h3>\n        <p class=\"team-card__role\">Operator kamery i&nbsp;montażysta</p>\n      </div>\n    </article>\n    <article class=\"team-card reveal\" data-d=\"2\">\n      <div class=\"team-card__photo\">\n        <span class=\"tc-ini\" aria-hidden=\"true\">RS</span>\n        <img class=\"tc-ph\" src=\"/assets/team/radoslaw-schenk.png\" alt=\"Radosław Schenk\" loading=\"lazy\" decoding=\"async\" />\n      </div>\n      <div class=\"team-card__body\">\n        <span class=\"team-card__no\">T·03</span>\n        <h3 class=\"team-card__name\">Radosław Schenk</h3>\n        <p class=\"team-card__role\">Operator kamery i&nbsp;montażysta</p>\n      </div>\n    </article>\n    <article class=\"team-card reveal\" data-d=\"3\">\n      <div class=\"team-card__photo\">\n        <span class=\"tc-ini\" aria-hidden=\"true\">KM</span>\n        <img class=\"tc-ph\" src=\"/assets/team/kamil-mroz.png\" alt=\"Kamil Mróz\" loading=\"lazy\" decoding=\"async\" />\n      </div>\n      <div class=\"team-card__body\">\n        <span class=\"team-card__no\">T·04</span>\n        <h3 class=\"team-card__name\">Kamil Mróz</h3>\n        <p class=\"team-card__role\">Operator kamery i&nbsp;montażysta</p>\n      </div>\n    </article>\n    <article class=\"team-card reveal\" data-d=\"0\">\n      <div class=\"team-card__photo\">\n        <span class=\"tc-ini\" aria-hidden=\"true\">OU</span>\n        <img class=\"tc-ph\" src=\"/assets/team/olga-urbanska.png\" alt=\"Olga Urbańska\" loading=\"lazy\" decoding=\"async\" />\n      </div>\n      <div class=\"team-card__body\">\n        <span class=\"team-card__no\">T·05</span>\n        <h3 class=\"team-card__name\">Olga Urbańska</h3>\n        <p class=\"team-card__role\">Project &amp; Digital Marketing Manager</p>\n      </div>\n    </article>\n    <article class=\"team-card reveal\" data-d=\"1\">\n      <div class=\"team-card__photo\">\n        <span class=\"tc-ini\" aria-hidden=\"true\">ŁS</span>\n        <img class=\"tc-ph\" src=\"/assets/team/lukasz-sierputowski.png\" alt=\"Łukasz Sierputowski\" loading=\"lazy\" decoding=\"async\" />\n      </div>\n      <