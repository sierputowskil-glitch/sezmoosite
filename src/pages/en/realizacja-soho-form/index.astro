---
import AssetImage from '../../../components/AssetImage.astro';
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';
import { pageUrl } from '../../../lib/site';

const lang = 'en' as const;
const canonical = pageUrl('/en/realizacja-soho-form/');
---

<CaseStudyLayout
  lang={lang}
  title="Soho Form · Logo, brand manual & website · SEZMOO case study"
  description="SEZMOO case study: logo, brand manual and website for Soho Form, a maker of made-to-order upholstered furniture."
  canonical={canonical}
>
<!-- ============ COVER ============ -->
<header class="cs-hero cs-hero--device" data-screen-label="Case · Cover">
  <div class="cs-hero__media">
    <AssetImage src="/assets/portfolio/soho-form/soho-hero-laptop.webp" alt="Soho Form website on a laptop screen" loading="eager" fetchpriority="high" widths={[720, 1080, 1440, 1920]} sizes="100vw" quality={72} />
  </div>
  <div class="cs-hero__frame" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  <div class="cs-hero__hud">
    <span class="rec">BRANDING · WEB</span>
    <span>UX/UI · LOGO</span>
    <span>FURNITURE / PL</span>
  </div>
  <div class="cs-hero__inner shell">
    <a class="cs-hero__back" href="/en/portfolio-en/">← Portfolio / Work</a>
    <span class="eyebrow cs-hero__cat"><span class="tick"></span>SEZMOO × Soho Form · Branding and website</span>
    <h1 class="cs-title">Soho<br><span class="accent">Form.</span></h1>
    <p class="cs-hero__sub">Logo, brand manual and website for <b>Soho Form</b> – a family-run maker of made-to-order upholstered furniture working with architects, hotels and restaurants across Europe.</p>
  </div>
  <div class="cs-scroll" aria-hidden="true"><span>SCROLL</span><i></i></div>
</header>

<!-- ============ META ============ -->
<section class="cs-meta" aria-label="Project details">
  <div class="shell">
    <div class="cs-meta__grid">
      <div class="cs-meta__cell">
        <div class="cs-meta__k">Client</div>
        <div class="cs-meta__v">Soho Form<small>Upholstered furniture</small></div>
      </div>
      <div class="cs-meta__cell">
        <div class="cs-meta__k">Industry</div>
        <div class="cs-meta__v">Furniture &amp; interiors<small>B2B · HoReCa</small></div>
      </div>
      <div class="cs-meta__cell">
        <div class="cs-meta__k">Format</div>
        <div class="cs-meta__v">Branding + web<small>From scratch</small></div>
      </div>
      <div class="cs-meta__cell">
        <div class="cs-meta__k">Scope</div>
        <div class="cs-meta__v">Full-service<small>Logo · Manual · Website</small></div>
      </div>
      <div class="cs-meta__cell">
        <div class="cs-meta__k">Result</div>
        <div class="cs-meta__v">A consistent brand<small>Mark · Online · Offer</small></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ O PROJEKCIE ============ -->
<section class="cs-sec" data-screen-label="ABOUT THE PROJECT">
  <div class="shell">
    <div class="cs-intro__grid">
      <div class="reveal">
        <span class="cs-sec__no">ABOUT THE PROJECT</span>
        <h2 class="cs-sec__title">Craft that<br>looks <span class="accent">premium.</span></h2>
      </div>
      <div class="cs-body reveal" data-d="1">
        <p>Soho Form is a family business with a long tradition. It makes sofas, armchairs, beds and joinery to order – for commercial and private interiors. The furniture had long been on par with premium brands, but the communication did not show it yet.</p>
        <p>We designed the brand from scratch: the mark, a brand manual with palette and typography, and then a website that presents the offer and projects the way architects and investors expect.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ ZNAK ============ -->
<section class="cs-sec" style="padding-top:0" aria-label="Logo" data-screen-label="Logo">
  <div class="shell">
    <span class="cs-sec__no reveal">THE MARK</span>
    <h2 class="cs-sec__title reveal">A simple logotype<br>with interior character.</h2>
  </div>
  <div class="cs-row cs-row--split" style="margin-top:clamp(28px,4vh,48px)">
    <figure class="cs-shot cs-shot--ad reveal" style="aspect-ratio:16/10;background:#1f2b2d"><div class="frame-media cs-shot__media" style="background:#1f2b2d;display:grid;place-items:center"><AssetImage src="/assets/portfolio/soho-form/soho-logo-white.svg" alt="Soho Form logo, white version on a dark background" loading="lazy" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, min(1100px, 85vw)" quality={72} style="position:static;width:46%;height:auto;inset:auto;object-fit:contain" /></div><span class="cs-shot__tag" style="white-space:nowrap">Logo · Reversed</span></figure>
    <figure class="cs-shot cs-shot--ad reveal" data-d="1" style="aspect-ratio:16/10;background:#dcdcdc"><div class="frame-media cs-shot__media" style="background:#dcdcdc;display:grid;place-items:center"><AssetImage src="/assets/portfolio/soho-form/soho-logo-black.svg" alt="Soho Form logo, black version on a light background" loading="lazy" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, min(1100px, 85vw)" quality={72} style="position:static;width:46%;height:auto;inset:auto;object-fit:contain" /></div><span class="cs-shot__tag" style="white-space:nowrap">Logo · Primary</span></figure>
  </div>
</section>

<!-- ============ PALETA + TYPO ============ -->
<section class="cs-sec" style="padding-top:0" data-screen-label="BRAND MANUAL">
  <div class="shell">
    <span class="cs-sec__no reveal">BRAND MANUAL</span>
    <h2 class="cs-sec__title reveal">A palette taken from<br>the materials themselves.</h2>
    <div class="reveal" style="margin-top:clamp(28px,4vh,48px);display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(10px,1.4vw,20px)">
      <div style="display:flex;flex-direction:column;gap:12px"><div style="aspect-ratio:16/9;background:#DCDCDC;border:1px solid var(--line-soft)"></div><div style="display:flex;justify-content:space-between;gap:8px;font-family:var(--font-mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase"><span>Light grey</span><span style="color:var(--fg-dim)">#DCDCDC</span></div></div>
      <div style="display:flex;flex-direction:column;gap:12px"><div style="aspect-ratio:16/9;background:#000000;border:1px solid var(--line-soft)"></div><div style="display:flex;justify-content:space-between;gap:8px;font-family:var(--font-mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase"><span>Black</span><span style="color:var(--fg-dim)">#000000</span></div></div>
      <div style="display:flex;flex-direction:column;gap:12px"><div style="aspect-ratio:16/9;background:#99A28A;border:1px solid var(--line-soft)"></div><div style="display:flex;justify-content:space-between;gap:8px;font-family:var(--font-mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase"><span>Sage</span><span style="color:var(--fg-dim)">#99A28A</span></div></div>
      <div style="display:flex;flex-direction:column;gap:12px"><div style="aspect-ratio:16/9;background:#78774C;border:1px solid var(--line-soft)"></div><div style="display:flex;justify-content:space-between;gap:8px;font-family:var(--font-mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase"><span>Olive</span><span style="color:var(--fg-dim)">#78774C</span></div></div>
      <div style="display:flex;flex-direction:column;gap:12px"><div style="aspect-ratio:16/9;background:#FFDC94;border:1px solid var(--line-soft)"></div><div style="display:flex;justify-content:space-between;gap:8px;font-family:var(--font-mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase"><span>Sand</span><span style="color:var(--fg-dim)">#FFDC94</span></div></div>
      <div style="display:flex;flex-direction:column;gap:12px"><div style="aspect-ratio:16/9;background:#E3DBCF;border:1px solid var(--line-soft)"></div><div style="display:flex;justify-content:space-between;gap:8px;font-family:var(--font-mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase"><span>Linen</span><span style="color:var(--fg-dim)">#E3DBCF</span></div></div>
    </div>
    <div class="reveal" style="margin-top:clamp(40px,6vh,72px);display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:clamp(24px,3vw,48px);align-items:end;border-top:1px solid var(--line-soft);padding-top:clamp(24px,3vh,40px)">
      <div style="font-family:'Barlow',sans-serif;font-weight:700;font-size:clamp(88px,11vw,180px);line-height:.85;letter-spacing:-.02em">Aa</div>
      <div class="cs-body"><p><strong>Barlow Bold / Regular.</strong> Barlow Bold in headings and the logotype gives the brand strength, while Barlow Regular keeps body copy readable. Together they form a modern, balanced system.</p></div>
    </div>
  </div>
</section>

<!-- ============ STRONA ============ -->
<section class="cs-sec" data-screen-label="WEBSITE">
  <div class="shell">
    <span class="cs-sec__no reveal">WEBSITE</span>
    <h2 class="cs-sec__title reveal">From structure<br>to a finished site.</h2>
    <div class="cs-steps">
      <div class="cs-step reveal">
        <span class="cs-step__no">W1, 01</span>
        <h3 class="cs-step__title">Architecture &amp; UX</h3>
        <p class="cs-step__desc">A structure that leads from the collection, through the offer for hotels, cafés and restaurants, to projects and quick contact.</p>
      </div>
      <div class="cs-step reveal">
        <span class="cs-step__no">W1, 02</span>
        <h3 class="cs-step__title">UI design</h3>
        <p class="cs-step__desc">Dark, photographic sections alternating with light offer blocks – a layout that lets the furniture do the talking.</p>
      </div>
      <div class="cs-step reveal">
        <span class="cs-step__no">W1, 03</span>
        <h3 class="cs-step__title">Content &amp; offer</h3>
        <p class="cs-step__desc">Copy for three product lines, an About section and a blog with guides that answer customer questions.</p>
      </div>
      <div class="cs-step reveal">
        <span class="cs-step__no">W1, 04</span>
        <h3 class="cs-step__title">Build</h3>
        <p class="cs-step__desc">A responsive site with a project gallery, contact form and a CMS for editing content in-house.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ GALERIA ============ -->
<section class="cs-gallery bleed" aria-label="Soho Form website">
  <div class="cs-row">
    <figure class="cs-shot cs-shot--ad reveal" style="aspect-ratio:2000/1125;background:#ffd200"><div class="frame-media cs-shot__media" style="background:#ffd200"><AssetImage src="/assets/portfolio/soho-form/soho-mockup-yellow.webp" alt="Soho Form website on a laptop and phone, yellow background" loading="lazy" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, min(1100px, 85vw)" quality={72} style="object-fit:contain" /></div><span class="cs-shot__tag" style="white-space:nowrap">Website · Desktop and mobile</span></figure>
  </div>
  <div class="cs-row cs-row--split">
    <figure class="cs-shot cs-shot--ad reveal" style="aspect-ratio:4/3;background:#141616"><div class="frame-media cs-shot__media" style="background:#141616"><AssetImage src="/assets/portfolio/soho-form/soho-imac.webp" alt="Soho Form website on a monitor – Projects section" loading="lazy" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, min(1100px, 85vw)" quality={72} style="object-fit:contain" /></div><span class="cs-shot__tag" style="white-space:nowrap">Website · Projects</span></figure>
    <figure class="cs-shot cs-shot--ad reveal" data-d="1" style="aspect-ratio:4/3;background:#141616"><div class="frame-media cs-shot__media" style="background:#141616"><AssetImage src="/assets/portfolio/soho-form/soho-mockup.webp" alt="Soho Form pages on a laptop and screens" loading="lazy" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, min(1100px, 85vw)" quality={72} style="object-fit:contain" /></div><span class="cs-shot__tag" style="white-space:nowrap">Website · Pages</span></figure>
  </div>
</section>

<!-- ============ EFEKT ============ -->
<section class="cs-quote" aria-label="Outcome">
  <div class="shell cs-sec">
    <div class="cs-quote__inner reveal">
      <blockquote><span class="mark">„</span>Soho Form got a brand that matches its furniture – calm, confident and consistent from the logo to the last page.<span class="mark">”</span></blockquote>
      <div class="cs-quote__by">– <b>SEZMOO team</b> · Branding &amp; UX/UI</div>
    </div>
  </div>
</section>

<!-- ============ NEXT PROJECT ============ -->
<a class="cs-next bleed" href="/en/portfolio-en/" data-cursor="link" aria-label="Back to portfolio">
  <AssetImage src="/assets/portfolio/soho-form/soho-mockup-yellow.webp" alt="Soho Form" loading="lazy" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, min(1100px, 85vw)" quality={72} />
  <div class="cs-next__inner shell">
    <span class="cs-next__k">See more →</span>
    <span class="cs-next__title">Portfolio <span class="arrow">→</span></span>
    <span class="cs-next__cat">All SEZMOO work</span>
  </div>
</a>
</CaseStudyLayout>
