---
import ServiceLayout from '../../../layouts/ServiceLayout.astro';
import { pageUrl } from '../../../lib/site';
import ContactForm from '../../../components/ContactForm.astro';

const lang = 'en' as const;
const canonical = pageUrl('/en/retainer/');
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Production retainer",
  "serviceType": "Ongoing marketing and production retainer",
  "url": "https://sezmoo.com/en/services/retainers/",
  "inLanguage": "en",
  "areaServed": {
    "@type": "Country",
    "name": "Poland"
  },
  "provider": {
    "@type": "Organization",
    "name": "SEZMOO",
    "url": "https://sezmoo.com/",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Gdańsk",
      "addressCountry": "PL"
    },
    "email": "biuro@sezmoo.com",
    "telephone": "+48739260450"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Retainer tiers",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Start",
          "description": "2 production days a month – steady content for one channel, usually social media."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Standard",
          "description": "4 production days a month – video, photography and design in one package."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Premium",
          "description": "6–8 production days a month – full brand coverage, scope agreed individually."
        }
      }
    ]
  }
};
---

<ServiceLayout
  lang={lang}
  title="Production retainer: steady monthly output | SEZMOO"
  description="A monthly package of production hours: video, photo, design and social media in one retainer. One team, predictable budget. SEZMOO, Gdansk."
  canonical={canonical}
  ogTitle="SEZMOO production retainer – steady output every month"
  ogDescription="A monthly package of production hours: video, photo, design and social media. One team, predictable budget."
  jsonLd={jsonLd}
>
<div class="sd">
<section class="sd__hero shell">
  <span class="sd__kick reveal"><i></i>Retainer</span>
  <h1 class="sd__h1 reveal">Steady production, <span style="color:#ffd200">without chasing jobs.</span></h1>
  <p class="sd__lead reveal" data-d="1"><b>A monthly package of production hours.</b> You decide what they go on – video one month, a photo session the next, design or channel management after that.</p>
  <p class="sd__lead reveal" data-d="1">One team works with you and knows the brand, so no job starts with explaining everything from scratch.</p>
  <div class="sd__facts reveal" data-d="2">
    <div class="sd__fact"><span>Billing</span><strong>Package of hours</strong></div>
    <div class="sd__fact"><span>Planning</span><strong>A week ahead</strong></div>
    <div class="sd__fact"><span>Contact</span><strong>One person</strong></div>
    <div class="sd__fact"><span>Production</span><strong>In-house, owned gear</strong></div>
  </div>
  <div class="sd__cta reveal" data-d="2">
    <a class="btn btn--primary" href="#abo-form"><span class="ico"></span><span class="lbl">Ask for a quote</span></a>
    <a class="btn" href="#abo-jak"><span class="lbl">See how it works</span></a>
  </div>
</section>
<div class="sd__body shell">
  <nav class="sd__toc reveal" aria-label="Page sections">
    <a href="#abo-kto"><i>01</i>Who it fits</a>
    <a href="#abo-jak"><i>02</i>How it works</a>
    <a href="#abo-war"><i>03</i>Industries</a>
    <a href="#abo-form"><i>04</i>Contact</a>
    <div class="sd__toccta"><p>Not sure which tier? Let's start with how often you publish.</p><a href="#abo-form">Let's talk →</a></div>
  </nav>
  <div>
    <section class="sd__blk" id="abo-form">
      <div class="sd__blkh reveal"><h2>Tell us how often you publish.</h2></div>
      <p class="sd__lead reveal" style="margin-top:0">Tell us what you need and how often – we'll propose a package matched to the scope. We reply within 24 hours.</p>
      <ContactForm lang="en" formId="retainer-form" />
    </section>
  </div>
</div>
</div>
</ServiceLayout>
