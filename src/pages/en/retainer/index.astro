---
import BaseLayout from './../../../layouts/BaseLayout.astro';
const pageHtml = "<div class=\"sd\">\n<section class=\"sd__hero shell\">\n  <span class=\"sd__kick reveal\"><i></i>Retainer</span>\n  <h1 class=\"sd__h1 reveal\">Steady production, <span style=\"color:#ffd200\">without chasing jobs.</span></h1>\n  <p class=\"sd__lead reveal\" data-d=\"1\"><b>A monthly package of production hours.</b> You decide what they go on – video one month, a photo session the next, design or channel management after that.</p>\n  <p class=\"sd__lead reveal\" data-d=\"1\">One team works with you and knows the brand, so no job starts with explaining everything from scratch.</p>\n  <div class=\"sd__facts reveal\" data-d=\"2\">\n    <div class=\"sd__fact\"><span>Billing</span><strong>Package of hours</strong></div>\n    <div class=\"sd__fact\"><span>Planning</span><strong>A week ahead</strong></div>\n    <div class=\"sd__fact\"><span>Contact</span><strong>One person</strong></div>\n    <div class=\"sd__fact\"><span>Production</span><strong>In-house, owned gear</strong></div>\n  </div>\n  <div class=\"sd__cta reveal\" data-d=\"2\">\n    <a class=\"btn btn--primary\" href=\"#abo-form\"><span class=\"ico\"></span><span class=\"lbl\">Ask for a quote</span></a>\n    <a class=\"btn\" href=\"#abo-jak\"><span class=\"lbl\">See how it works</span></a>\n  </div>\n</section>\n<div class=\"sd__body shell\">\n  <nav class=\"sd__toc reveal\" aria-label=\"Page sections\">\n    <a href=\"#abo-kto\"><i>01</i>Who it fits</a>\n    <a href=\"#abo-jak\"><i>02</i>How it works</a>\n    <a href=\"#abo-war\"><i>03</i>Industries</a>\n    <a href=\"#abo-form\"><i>04</i>Contact</a>\n    <div class=\"sd__toccta\"><p>Not sure which tier? Let's start with how often you publish.</p><a href=\"#abo-form\">Let's talk →</a></div>\n  </nav>\n  <div>\n    <section class=\"sd__blk\" id=\"abo-form\">\n      <div class=\"sd__blkh reveal\"><h2>Tell us how often you publish.</h2></div>\n      <p class=\"sd__lead reveal\" style=\"margin-top:0\">Tell us what you need and how often – we'll propose a package matched to the scope. We reply within 24 hours.</p>\n      <form class=\"cform reveal\" data-d=\"1\" id=\"abonament-form\" name=\"abonament\" method=\"POST\" action=\"/api/contact\" novalidate style=\"margin-top:clamp(22px,2.6vw,32px)\">\n        <input type=\"hidden\" name=\"form-name\" value=\"abonament\" />\n        <input type=\"hidden\" name=\"lang\" value=\"en\" />\n        <p hidden aria-hidden=\"true\"><label>Do not fill: <input name=\"bot-field\" tabindex=\"-1\" autocomplete=\"off\" /></label></p>\n        <div class=\"cform__row\">\n          <div class=\"cfield\"><label for=\"ab-name\">Full name</label><input id=\"ab-name\" name=\"name\" type=\"text\" placeholder=\"Jane Doe\" required /></div>\n          <div class=\"cfield\"><label for=\"ab-company\">Company</label><input id=\"ab-company\" name=\"company\" type=\"text\" placeholder=\"Company name\" /></div>\n        </div>\n        <div class=\"cform__row\">\n          <div class=\"cfield\"><label for=\"ab-email\">E-mail</label><input id=\"ab-email\" name=\"email\" type=\"email\" placeholder=\"you@company.com\" required /></div>\n          <div class=\"cfield\"><label for=\"ab-phone\">Phone</label><input id=\"ab-phone\" name=\"phone\" type=\"tel\" placeholder=\"+48 ...\" /></div>\n        </div>\n        <div class=\"cfield\">\n          <label for=\"ab-need\">What do you need most often?</label>\n          <select id=\"ab-need\" name=\"need\" required>\n            <option value=\"\">Choose an area</option>\n            <option>Video / motion</option><option>Photo</option><option>Design</option><option>Social media</option><option>A bit of everything</option>\n          </select>\n        </div>\n        <div class=\"cfield\"><label for=\"ab-msg\">Message</label><textarea id=\"ab-msg\" name=\"message\" placeholder=\"How much material a month, which channels...\" minlength=\"10\" required></textarea></div>\n        <label class=\"cconsent\"><input type=\"checkbox\" name=\"consent\" value=\"1\" required /> <span>I agree to my data being processed for contact purposes, in line with the SEZMOO <a href=\"../../en/privacy-policy/\" target=\"_blank\" rel=\"noopener\">privacy policy</a>.</span></label>\n        <button class=\"btn btn--primary\" type=\"submit\"><span class=\"ico\"></span><span class=\"lbl\">Send enquiry</span></button>\n        <p class=\"cform__note\">● REC · We reply within 24 hours</p>\n      </form>\n    </section>\n  </div>\n</div>\n</div>";
---

<BaseLayout
  lang="en"
  title="Production retainer: steady monthly output | SEZMOO"
  description="A monthly package of production hours: video, photo, design and social media in one retainer. One team, predictable budget. SEZMOO, Gdansk."
  canonical="https://sezmoo.com/en/services/retainers/"
  ogTitle="SEZMOO production retainer – steady output every month"
  ogDescription="A monthly package of production hours: video, photo, design and social media. One team, predictable budget."
  jsonLd={"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Production retainer\",\"serviceType\":\"Ongoing marketing and production retainer\",\"url\":\"https://sezmoo.com/en/services/retainers/\",\"inLanguage\":\"en\",\"areaServed\":{\"@type\":\"Country\",\"name\":\"Poland\"},\"provider\":{\"@type\":\"Organization\",\"name\":\"SEZMOO\",\"url\":\"https://sezmoo.com/\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Gdańsk\",\"addressCountry\":\"PL\"},\"email\":\"biuro@sezmoo.com\",\"telephone\":\"+48502260450\"},\"hasOfferCatalog\":{\"@type\":\"OfferCatalog\",\"name\":\"Retainer tiers\",\"itemListElement\":[{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Start\",\"description\":\"2 production days a month – steady content for one channel, usually social media.\"}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Standard\",\"description\":\"4 production days a month – video, photography and design in one package.\"}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Premium\",\"description\":\"6–8 production days a month – full brand coverage, scope agreed individually.\"}}]}}"}
>
  <Fragment set:html={pageHtml} />
</BaseLayout>
