---
/**
 * EN blog alias — content is PL-only; soft-redirect to /blog/.
 * Production may also 301 via _redirects for legacy EN category/feed URLs.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { pageUrl } from '../../../lib/site';

const canonical = pageUrl('/blog/');
const pageScripts = `<script>location.replace("/blog/");</script>`;
---

<BaseLayout lang="en" title="Blog – SEZMOO" canonical={canonical} pageScripts={pageScripts}>
  <main class="shell" style="padding:clamp(100px,18vh,160px) 0 clamp(60px,10vh,100px)">
    <h1>Blog</h1>
    <p style="margin-top:14px;color:var(--fg-dim)">
      <a href="/blog/">Go to the SEZMOO blog →</a>
    </p>
  </main>
</BaseLayout>
