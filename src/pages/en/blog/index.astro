---
/**
 * EN blog alias — content is PL-first; redirect to /blog/.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { pageUrl } from '../../../lib/site';

const canonical = pageUrl('/blog/');
const pageScripts = `<script>location.replace("/blog/");</script>`;
---

<BaseLayout lang="en" title="Blog – SEZMOO" canonical={canonical} pageScripts={pageScripts}>
  <p><a href="/blog/">Go to the SEZMOO blog →</a></p>
</BaseLayout>
