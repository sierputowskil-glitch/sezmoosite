import BaseLayout from './../../../../layouts/BaseLayout.astro';
const pageHtml = "<div class=\"sd\">\n<section class=\"sd__hero shell\">\n  <span class=\"sd__kick reveal\"><i></i>Services</span>\n  <h1 class=\"sd__h1 reveal\">2D and 3D <span style=\"color:#ffd200\">animation.</span></h1>\n  <p class=\"sd__lead reveal\" data-d=\"1\">Animation shows <b>what a camera cannot record</b> – a cutaway of a product, the flow of a process, data, or a concept that does not exist yet.</p>\n  <p class=\"sd__lead reveal\" data-d=\"1\">We do motion design for ads and social media, 3D product and technical animation, and explainers that make an offer clear in under a minute.</p>\n  <div class=\"sd__facts reveal\" data-d=\"2\">\n    <div class=\"sd__fact\"><span>Scope</span><strong>Motion · 3D · explainer</strong></div>\n    <div class=\"sd__fact\"><span>Format</span><strong>Ads, social, web</strong></div>\n    <div class=\"sd__fact\"><span>Source</span><strong>3D model or artwork</strong></div>\n    <div class=\"sd__fact\"><span>Base</span><strong>Gdańsk · remote</strong></div>\n  </div>\n  <figure class=\"sd__reel reveal\" data-d=\"1\">\n    <img src=\"/assets/work/vts-animacja.avif\" alt=\"VTS Group\" loading=\"eager\" fetchpriority=\"high\" />\n    <figcaption><b>VTS Group</b><span>3D animation / B2B content</span></figcaption>\n  </figure>\n</section>\n<div class=\"sd__body shell\">\n  <div>\n    <section class=\"sd__blk\" id=\"sd-zakres\">\n      <div class=\"sd__blkh reveal\"><h2>What we animate</h2></div>\n      <details class=\"sd__g reveal\" open><summary><h3>2D animation &amp; motion design</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Advertising animation, cards, kinetic typography, transitions, bumpers and loops – also as a graphic layer inside films.</p><div class=\"sd__tags\"><span>Advertising animation</span><span>Motion design</span><span>Kinetic typography</span><span>Bumper</span><span>Social loop</span><span>Animated logo</span><span>Graphics for film</span></div></div></details>\n      <details class=\"sd__g reveal\" open><summary><h3>3D product animation</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Product visualisation, cutaways, technical animation and presentations of things that cannot be filmed on set.</p><div class=\"sd__tags\"><span>3D product animation</span><span>Technical cutaway</span><span>Process visualisation</span><span>Product render</span><span>Machine animation</span><span>Solution walkthrough</span></div></div></details>\n      <details class=\"sd__g reveal\"><summary><h3>Explainer &amp; infographics</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Short animation that explains a process, an offer or data – for the website, sales decks and social media.</p><div class=\"sd__tags\"><span>Explainer video</span><span>Animated infographic</span><span>Data visualisation</span><span>Process animation</span><span>Animation for decks</span></div></div></details>\n      <details class=\"sd__g reveal\"><summary><h3>Campaign animation</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Motion creative built for media: vertical versions, cutdowns and format variants for Meta Ads, Google Ads and YouTube.</p><div class=\"sd__tags\"><span>Video creative for Ads</span><span>Vertical versions</span><span>Cutdowns</span><span>Animated banners</span><span>YouTube animation</span></div></div></details>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-proces\">\n      <div class=\"sd__blkh reveal\"><h2>How we work</h2></div>\n      <div class=\"sd__steps\">\n        <div class=\"sd__step reveal\"><h3>Concept</h3><p>We settle what the animation must explain and in what format.</p></div>\n        <div class=\"sd__step reveal\"><h3>Script and storyboard</h3><p>We map the flow, the copy and the key frames.</p></div>\n        <div class=\"sd__step reveal\"><h3>Artwork and 3D model</h3><p>We prepare assets, the model or the graphic layers.</p></div>\n        <div class=\"sd__step reveal\"><h3>Animation</h3><p>Movement, camera, pacing and rhythm tuned to the channel.</p></div>\n        <div class=\"sd__step reveal\"><h3>Sound and export</h3><p>Sound design, subtitles and versions for every format.</p></div>\n      </div>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-work\">\n      <div class=\"sd__blkh reveal\"><h2>Selected work</h2></div>\n      <div class=\"sd__work\">\n        <a class=\"sd__wi reveal\" href=\"../../../en/portfolio-en/?cat=animacje#pt-grid\"><div class=\"sd__wm\"><img src=\"/assets/work/animacja-3d.jpg\" alt=\"Baltic 3D\" loading=\"lazy\" /></div><span>Factory model · 3D animation</span><h3>Baltic 3D ↗</h3></a>\n        <a class=\"sd__wi reveal\" href=\"../../../en/portfolio-en/?cat=animacje#pt-grid\"><div class=\"sd__wm\"><img src=\"/assets/work/audi-a6-etron.jpg\" alt=\"Audi A6 e-tron\" loading=\"lazy\" /></div><span>Motion · Launch</span><h3>Audi A6 e-tron ↗</h3></a>\n        <a class=\"sd__wi reveal\" href=\"../../../realizacja-world-of-warships/\"><div class=\"sd__wm\"><img src=\"/assets/work/warships-container.avif\" alt=\"World of Warships\" loading=\"lazy\" /></div><span>Event content · Motion</span><h3>World of Warships ↗</h3></a>\n      </div>\n      <div class=\"sd__more reveal\">\n        <a class=\"is-lead\" href=\"../../../en/portfolio-en/#pt-grid\">Full portfolio ↗</a>\n        <a href=\"../../../en/portfolio-en/?cat=video#pt-grid\">Video</a>\n        <a href=\"../../../en/portfolio-en/?cat=animacje#pt-grid\">Animation</a>\n        <a href=\"../../../en/portfolio-en/?cat=eventy#pt-grid\">Events</a>\n        <a href=\"../../../en/portfolio-en/?cat=grafika#pt-grid\">Graphics</a>\n      </div>\n    </section>\n  </div>\n</div>\n</div>";
