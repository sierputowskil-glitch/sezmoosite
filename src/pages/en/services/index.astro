---
import BaseLayout from './../../../layouts/BaseLayout.astro';
const pageHtml = "<section class=\"sub-hero shell service-hub\">\n    <div class=\"sub-hero__grid sub-hero__grid--solo\">\n      <div>\n        <span class=\"eyebrow reveal\"><span class=\"tick\"></span>SEZMOO services</span>\n        <h1 class=\"reveal\">Services</h1>\n      </div>\n    </div>\n  </section>\n  <section class=\"sub-section shell service-index\" id=\"lista-uslug\">\n    <div class=\"svcA\">\n      <a class=\"svcA__row reveal\" href=\"../../en/services/retainers/\"><span class=\"svcA__no\">01</span><h3 class=\"svcA__t\">Retainers</h3><p class=\"svcA__d\">Need ongoing work?<br />Every service we offer is available on a monthly retainer, shaped around your needs.</p><span class=\"svcA__go\">↗</span></a>\n      <a class=\"svcA__row reveal\" href=\"../../en/services/video-production-reels/\"><span class=\"svcA__no\">02</span><h3 class=\"svcA__t\">Video</h3><p class=\"svcA__d\">Commercials, spots, reels, event recaps and animation.</p><span class=\"svcA__go\">↗</span></a>\n      <a class=\"svcA__row reveal\" href=\"../../en/services/photoghraphy/\"><span class=\"svcA__no\">03</span><h3 class=\"svcA__t\">Photo</h3><p class=\"svcA__d\">Product, brand and event shoots plus drone footage.</p><span class=\"svcA__go\">↗</span></a>\n      <a class=\"svcA__row reveal\" href=\"../../en/services/graphic-design/\"><span class=\"svcA__no\">04</span><h3 class=\"svcA__t\">Graphic design</h3><p class=\"svcA__d\">Logos, key visuals, social assets, catalogues and print.</p><span class=\"svcA__go\">↗</span></a>\n      <a class=\"svcA__row reveal\" href=\"../../en/services/ux-ui-design/\"><span class=\"svcA__no\">05</span><h3 class=\"svcA__t\">UX/UI design</h3><p class=\"svcA__d\">User journeys, information architecture, prototypes and design systems for websites, stores and apps.</p><span class=\"svcA__go\">↗</span></a>\n      <a class=\"svcA__row reveal\" href=\"../../en/services/websites-and-landing-pages/\"><span class=\"svcA__no\">06</span><h3 class=\"svcA__t\">Websites</h3><p class=\"svcA__d\">Company sites, landing pages and online stores – built in WordPress, React or any other stack.</p><span class=\"svcA__go\">↗</span></a>\n      <a class=\"svcA__row reveal\" href=\"../../en/services/social-media-management/\"><span class=\"svcA__no\">07</span><h3 class=\"svcA__t\">Social media</h3><p class=\"svcA__d\">Content strategy, publishing and profile management.</p><span class=\"svcA__go\">↗</span></a>\n      <a class=\"svcA__row reveal\" href=\"../../en/services/event-organization/\"><span class=\"svcA__no\">08</span><h3 class=\"svcA__t\">Events</h3><p class=\"svcA__d\">Launches, conferences, trade fairs and business meetings.</p><span class=\"svcA__go\">↗</span></a>\n      <a class=\"svcA__row reveal\" href=\"../../en/services/paid-campaigns/\"><span class=\"svcA__no\">09</span><h3 class=\"svcA__t\">Paid campaigns</h3><p class=\"svcA__d\">Google, Meta and TikTok Ads – creative, setup, analytics.</p><span class=\"svcA__go\">↗</span></a>\n      <a class=\"svcA__row reveal\" href=\"../../en/services/advertising-production/\"><span class=\"svcA__no\">10</span><h3 class=\"svcA__t\">Advertising production</h3><p class=\"svcA__d\">Light boxes, LED neons, 3D letters, window graphics and large-format print – from design to installation.</p><span class=\"svcA__go\">↗</span></a>\n    </div>\n    <div class=\"sub-cta reveal\">\n      <div><h2>Let's plan the production.</h2><p>Tell us what you want to show and where the material has to work. We'll match the formats without overscoping.</p></div>\n      <a href=\"../../en/#kontakt\" class=\"btn btn--primary\"><span class=\"ico\"></span><span class=\"lbl\">Get in touch</span></a>\n    </div>\n  </section>\n<section class=\"sub-section shell\" id=\"retainer\">\n  <div class=\"sd\">\n    <div class=\"sec-head\">\n      <span class=\"sd__kick reveal\"><i></i>Retainer</span>\n    </div>\n    <h2 class=\"sec-title reveal\" style=\"margin-top:clamp(10px,1.2vw,16px)\">Steady production instead of<br />one-off <span style=\"color:#ffd200\">jobs.</span></h2>\n    <p class=\"reveal\" style=\"max-width:62ch;margin:clamp(16px,1.8vw,22px) 0 0;font-size:clamp(15px,1.15vw,17px);line-height:1.62;color:var(--fg-dim)\">A monthly package of production hours you split as you need – video one month, photography the next, design after that. Scope and pricing are agreed after the brief.</p>\n    <div class=\"sd__steps reveal\" style=\"grid-template-columns:repeat(3,minmax(0,1fr));margin-top:clamp(26px,3vw,38px)\">\n      <div class=\"sd__step\"><h3>A steady publishing rhythm</h3><p>Material is made regularly, not in bursts once a quarter.</p></div>\n      <div class=\"sd__step\"><h3>In-house production</h3><p>Our own gear and team, so lead times are shorter.</p></div>\n      <div class=\"sd__step\"><h3>Predictable budget</h3><p>One known monthly amount instead of invoice after invoice.</p></div>\n    </div>\n    <div class=\"sd__more reveal\">\n      <a class=\"is-lead\" href=\"../../en/services/retainers/\">See how the retainer works ↗</a>\n      <a href=\"../../en/#kontakt\">Ask for a quote</a>\n    </div>\n  </div>\n</section>";
---

<BaseLayout
  lang="en"
  title="Services | SEZMOO"
  description="Video production, social media content, paid campaigns and landing pages by SEZMOO."
  canonical="https://sezmoo.com/en/services/"
>
  <Fragment set:html={pageHtml} />
</BaseLayout>
