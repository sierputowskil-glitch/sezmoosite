---
/**
 * Alias of paid-campaigns. Production 301 lives in public/_redirects;
 * this page is a local/preview fallback (same pattern as kampanie-reklamowe).
 */
import ServiceLayout from '../../../../layouts/ServiceLayout.astro';
import { pageUrl } from '../../../../lib/site';

const lang = 'en' as const;
const canonical = pageUrl('/en/services/paid-campaigns/');
const pageScripts = `<script>location.replace("/en/services/paid-campaigns/");</script>`;
---

<ServiceLayout
  lang={lang}
  title="Paid campaigns | SEZMOO"
  description="Paid campaigns at SEZMOO: creatives, video formats, graphics and landing pages for ads."
  canonical={canonical}
  pageScripts={pageScripts}
>
  <main class="shell" style="padding:clamp(100px,18vh,160px) 0 clamp(60px,10vh,100px)">
    <h1>Advertising campaigns.</h1>
    <p style="margin-top:14px;color:var(--fg-dim)">
      <a href="/en/services/paid-campaigns/">Paid campaigns – go to the service page →</a>
    </p>
  </main>
</ServiceLayout>
