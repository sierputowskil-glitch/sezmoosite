import BaseLayout from './../../../../layouts/BaseLayout.astro';
const pageHtml = "<div class=\"sd\">\n<section class=\"sd__hero shell\">\n  <span class=\"sd__kick reveal\"><i></i>Services</span>\n  <h1 class=\"sd__h1 reveal\">Film <span style=\"color:#ffd200\">production.</span></h1>\n  <p class=\"sd__lead reveal\" data-d=\"1\"><b>Video production is the core of SEZMOO</b> and one of the most developed areas of the agency. We own our film gear and production base, and a permanent team carries every project from the first idea to the finished material – with no dependency on subcontractors.</p>\n  <div class=\"sd__facts reveal\" data-d=\"2\">\n    <div class=\"sd__fact\"><span>Scope</span><strong>Video · drone · animation</strong></div>\n    <div class=\"sd__fact\"><span>Team</span><strong>Operators · director · edit · production</strong></div>\n    <div class=\"sd__fact\"><span>Technology</span><strong>Camera · drone · 2D/3D animation</strong></div>\n    <div class=\"sd__fact\"><span>Location</span><strong>Tricity · Poland · worldwide</strong></div>\n  </div>\n  <figure class=\"sd__reel reveal\" data-d=\"1\">\n    <video src=\"/assets/video/audi-rs5-trailer.mp4\" muted loop playsinline autoplay preload=\"metadata\" aria-label=\"Audi RS5\"></video>\n    <figcaption><b>Audi RS5</b><span>Premium film / reels / cutdowns</span></figcaption>\n  </figure>\n</section>\n<div class=\"sd__body shell\">\n  <div>\n    <section class=\"sd__blk\" id=\"sd-zakres\">\n      <div class=\"sd__blkh reveal\"><h2>What we produce</h2></div>\n      <details class=\"sd__g reveal\" open><summary><h3>Brand &amp; advertising</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>We produce commercials and campaign spots, promo and brand films, product videos and launch films for premieres. We also make branded content and video case studies.</p><div class=\"sd__tags\"><span>Commercial / spot</span><span>Promo film</span><span>Brand film</span><span>Product film</span><span>Launch video</span><span>Branded content</span><span>Sales film</span><span>Video case study</span></div></div></details>\n      <details class=\"sd__g reveal\" open><summary><h3>Social media</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>We shoot vertical video for Reels, TikTok and YouTube Shorts – single pieces and full content series. We build creative for Meta Ads, TikTok Ads and YouTube Ads.</p><div class=\"sd__tags\"><span>Reels</span><span>TikTok</span><span>YouTube Shorts</span><span>Stories</span><span>Video for Ads campaigns</span><span>Product content</span><span>Video series</span><span>Influencer material</span></div></div></details>\n      <details class=\"sd__g reveal\" open><summary><h3>Company / B2B</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>We produce corporate and business films, company profile videos, employer branding and recruitment material, plus industrial and technology films on the factory floor.</p><div class=\"sd__tags\"><span>Corporate film</span><span>Company profile</span><span>Employer branding</span><span>Recruitment film</span><span>Industrial film</span><span>Manufacturing process</span><span>Technology film</span><span>Trade fair film</span><span>Sales presentation</span></div></div></details>\n      <details class=\"sd__g reveal\" open><summary><h3>Education &amp; knowledge</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>We make how-to and training films, tutorials, explainer videos and online courses. We record webinars, video podcasts and expert interviews.</p><div class=\"sd__tags\"><span>How-to film</span><span>Training film</span><span>Tutorial</span><span>Explainer video</span><span>Online course / e-learning</span><span>Webinar</span><span>Video podcast</span><span>Expert interview</span><span>Safety training</span></div></div></details>\n      <details class=\"sd__g reveal\" open><summary><h3>Events</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>We cover conferences, trade fairs, launches and company events. Every event gives you an aftermovie, short social cutdowns and interviews with participants.</p><div class=\"sd__tags\"><span>Aftermovie</span><span>Conference film</span><span>Trade fair film</span><span>Launch film</span><span>Company event</span><span>Social cutdowns</span><span>Interviews at events</span><span>Live streaming</span></div></div></details>\n      <details class=\"sd__g reveal\" open><summary><h3>Music &amp; culture</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>We produce music videos, live sessions and concert footage, plus films promoting festivals, performances and exhibitions.</p><div class=\"sd__tags\"><span>Music videos</span><span>Live session</span><span>Concert footage</span><span>Cultural events</span></div></div></details>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-proces\">\n      <div class=\"sd__blkh reveal\"><h2>How we can deliver it</h2></div>\n      <div class=\"sd__steps\">\n        <div class=\"sd__step reveal\"><h3>Film</h3><p>Camera, light, sound, direction – from the shoot to the finished piece.</p></div>\n        <div class=\"sd__step reveal\"><h3>Drone footage</h3><p>Aerial shots – on their own or as part of a larger production.</p></div>\n        <div class=\"sd__step reveal\"><h3>2D / motion</h3><p>Graphics and animation without a shoot – from infographics to full motion design.</p></div>\n        <div class=\"sd__step reveal\"><h3>3D animation</h3><p>Product and process visualisation – independent of any film shoot.</p></div>\n        <div class=\"sd__step reveal\"><h3>Post-production</h3><p>Edit, colour grading, sound – also from your own footage.</p></div>\n      </div>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-format\">\n      <h3 class=\"fmt-lead reveal\">We start planning a film from<br />where it has to <span style=\"color:#ffd200\">land.</span></h3>\n      <p class=\"fmt-p reveal\">Social media, a paid campaign, YouTube, a website, a trade-fair screen, a TV set at the point of sale or a large screen at an event – where the film is played shapes how it is shot.</p>\n      <p class=\"fmt-p reveal\">That is why we agree on the aspect ratios, lengths and versions you need during the brief, and build them into the production plan.</p>\n      <div class=\"fmt-wrap\">\n        <div class=\"fmt2 reveal\">\n          <div class=\"fmt2__hud\"><span><span class=\"dot\"></span>1 production</span><span>4K · 25FPS · Gdańsk</span></div>\n          <div class=\"fmt2__master\">\n            <div class=\"fmt2__sprk\"></div>\n            <div class=\"fmt2__frames\"><i></i><i></i><i></i><i></i><i></i></div>\n            <div class=\"fmt2__sprk\"></div>\n            <span class=\"fmt2__mlbl\">MASTER · on set</span>\n          </div>\n          <div class=\"fmt2__split\">where the material lands</div>\n          <div class=\"fmt2__outs\">\n            <div class=\"fmt2__out\"><span class=\"fmt2__shape s-916\"></span><div><span class=\"r\">9:16</span><h4>Reels / Stories</h4></div></div>\n            <div class=\"fmt2__out\"><span class=\"fmt2__shape s-169\"></span><div><span class=\"r\">16:9</span><h4>Web / YouTube / event</h4></div></div>\n            <div class=\"fmt2__out\"><span class=\"fmt2__shape s-11\"></span><div><span class=\"r\">1:1 / 4:5</span><h4>Meta Ads</h4></div></div>\n            <div class=\"fmt2__out\"><span class=\"fmt2__shape s-ban\"></span><div><span class=\"r\">Custom</span><h4>Digital signage</h4></div></div>\n          </div>\n        </div>\n        <div class=\"fmt-copy reveal\">\n          <span class=\"fmt-copy__kick\"><i></i>Format</span>\n          <h4 class=\"fmt-copy__title\">You have a subject.<br />Let's pick the right format for it.</h4>\n          <p class=\"fmt-copy__p\">You don't need to know whether you need a 30-second spot, a series of reels or a corporate film. Let's start with the goal and the place where the material has to work.</p>\n          <a class=\"fmt-copy__cta\" href=\"../../../en/#kontakt\">Let's talk about production →</a>\n        </div>\n      </div>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-work\">\n      <div class=\"sd__blkh reveal\"><h2>See our <span style=\"color:#ffd200\">work.</span></h2></div>\n      <div class=\"sd__work\">\n        <a class=\"sd__wi reveal\" href=\"../../../en/portfolio-en/?cat=video#pt-grid\"><div class=\"sd__wm\"><img src=\"/assets/work/rs7-1.jpg\" alt=\"Audi RS7\" loading=\"lazy\" /></div><span>Spot · Automotive</span><h3>Audi RS7 ↗</h3></a>\n        <a class=\"sd__wi reveal\" href=\"../../../en/portfolio-en/?cat=video#pt-grid\"><div class=\"sd__wm\"><img src=\"/assets/work/byd.jpg\" alt=\"BYD Plichta\" loading=\"lazy\" /></div><span>Social video · Automotive</span><h3>BYD Plichta ↗</h3></a>\n        <a class=\"sd__wi reveal\" href=\"../../../en/realizacja/?v=tvTuMX3mxG4\"><div class=\"sd__wm\"><img src=\"/assets/work/baltic-robert-2.avif\" alt=\"Baltic Towers\" loading=\"lazy\" /></div><span>Opening · Video</span><h3>Baltic Towers ↗</h3></a>\n      </div>\n      <div class=\"sd__more reveal\">\n        <a class=\"is-lead\" href=\"../../../en/portfolio-en/#pt-grid\">Full portfolio ↗</a>\n        <a href=\"../../../en/portfolio-en/?cat=video#pt-grid\">Video</a>\n        <a href=\"../../../en/portfolio-en/?cat=animacje#pt-grid\">Animation</a>\n        <a href=\"../../../en/portfolio-en/?cat=eventy#pt-grid\">Events</a>\n        <a href=\"../../../en/portfolio-en/?cat=grafika#pt-grid\">Graphics</a>\n      </div>\n    </section>\n  </div>\n</div>\n</div>";
---

