---
import ServiceLayout from '../../../../layouts/ServiceLayout.astro';
import { pageUrl } from '../../../../lib/site';
import ContactForm from '../../../../components/ContactForm.astro';

const lang = 'en' as const;
const canonical = pageUrl('/en/services/retainers/');
const extraHeadHtml = "<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Marketing retainer\",\"serviceType\":\"Ongoing marketing and production retainer\",\"url\":\"https://sezmoo.com/en/services/retainers/\",\"inLanguage\":\"en\",\"areaServed\":{\"@type\":\"Country\",\"name\":\"Poland\"},\"provider\":{\"@type\":\"Organization\",\"name\":\"SEZMOO\",\"url\":\"https://sezmoo.com/\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Gdańsk\",\"addressCountry\":\"PL\"},\"email\":\"biuro@sezmoo.com\",\"telephone\":\"+48739260450\"},\"hasOfferCatalog\":{\"@type\":\"OfferCatalog\",\"name\":\"Retainer scope\",\"itemListElement\":[{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Film production and editing\",\"description\":\"Reels, corporate films, event coverage, drone footage, editing and post-production.\"}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Photography\",\"description\":\"Product, brand, business and event sessions plus aerial photography.\"}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Social media\",\"description\":\"Content planning, copywriting, post production and publishing on Facebook, Instagram, LinkedIn and TikTok.\"}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Design\",\"description\":\"Social graphics, posts and stories, leaflets, sales material and print-ready files.\"}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Website and landing pages\",\"description\":\"Campaign landing pages, new pages, content updates and ongoing site care.\"}}]}}</script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"inLanguage\":\"en\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How much does a marketing retainer cost?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Every quote is individual and depends on the scope and the amount of material needed each month. After a short brief you get a concrete monthly figure and a list of what it covers.\"}},{\"@type\":\"Question\",\"name\":\"What if I need something different this month?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The hours are not tied to one service. One month it can be a shoot day and an edit, the next a product session and a batch of social graphics.\"}},{\"@type\":\"Question\",\"name\":\"Is a retainer a long-term contract?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We usually agree on a longer engagement because a retainer works when material is produced in a steady rhythm. The minimum term and notice period are set individually with the quote.\"}},{\"@type\":\"Question\",\"name\":\"Can you take over the whole marketing?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. We work either as an outsourced marketing department or as the production arm of your in-house team. Paid campaigns and large creative concepts are run as separate projects.\"}},{\"@type\":\"Question\",\"name\":\"How do I know what the hours were spent on?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Every month ends with a breakdown: the list of material produced and the hours behind each item, sent with the invoice. Progress is visible in ClickUp during the month and priorities are approved before production.\"}},{\"@type\":\"Question\",\"name\":\"Do you work outside the Tricity?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We are based in Gdańsk and shoot across Poland and abroad.\"}}]}</script>";
---

<ServiceLayout
  lang={lang}
  title="Marketing retainer – ongoing marketing and production | SEZMOO"
  description="Marketing retainer at SEZMOO: ongoing marketing and production in a monthly package of hours – video, photography, design and social media. One team, one contact, a predictable budget. Gdańsk, projects across Poland."
  canonical={canonical}
  ogTitle="Marketing retainer – ongoing marketing and production | SEZMOO"
  ogDescription="Video, photography, design and social media in one monthly package of production hours. One team, a predictable budget."
  extraHead={extraHeadHtml}
>
<div class="sd">
<section class="sd__hero shell">
  <span class="sd__kick reveal"><i></i>Marketing retainer</span>
  <h1 class="sd__h1 reveal">Marketing on a <span style="color:#ffd200">retainer.</span></h1>
  <p class="sd__lead reveal" data-d="1"><b>A SEZMOO retainer gives you standing access to the team</b> that can take over content production and selected marketing work – without hiring an operator, a photographer, a designer and a social media person separately.</p>
  <p class="sd__lead reveal" data-d="1">We don't sell ready-made packages full of services you don't need. Scope and the monthly budget are agreed individually, combining only the skills that will actually be used.</p>
  <div class="sd__facts reveal" data-d="2">
    <div class="sd__fact"><span>Model</span><strong>Ongoing partnership</strong></div>
    <div class="sd__fact"><span>Scope</span><strong>Built around your needs</strong></div>
    <div class="sd__fact"><span>Team</span><strong>Many skills, one contact</strong></div>
    <div class="sd__fact"><span>Budget</span><strong>Agreed monthly</strong></div>
  </div>
  <div class="sd__cta reveal" data-d="2">
    <a class="btn btn--primary" href="#abo-form"><span class="ico"></span><span class="lbl">Ask about a retainer</span></a>
    <a class="btn" href="#abo-zakres"><span class="lbl">What the retainer covers</span></a>
  </div>
</section>
<div class="sd__body shell">
  <div>
    <section class="sd__blk" id="abo-zakres">
      <div class="sd__blkh reveal"><h2>What the retainer <span style="color:#ffd200">covers.</span></h2></div>
      <p class="sd__lead reveal" style="margin-top:0">One retainer instead of several suppliers. You split the package of hours across the areas that actually work for the brand that month.</p>
      <details class="sd__g reveal" open><summary><h3>Film production and editing</h3><span class="sd__pm"></span></summary><div class="sd__gin"><p>Reels and vertical video for social, corporate films, event coverage and drone footage – shot on our own gear and edited in-house.</p><div class="sd__tags"><span>Reels</span><span>Corporate film</span><span>Event coverage</span><span>Drone footage</span><span>Edit and post</span><span>Subtitles and motion</span></div></div></details>
      <details class="sd__g reveal" open><summary><h3>Photography</h3><span class="sd__pm"></span></summary><div class="sd__gin"><p>Product, brand, business and event sessions – in the studio, at your premises or alongside a video shoot day, so one trip delivers material for two channels.</p><div class="sd__tags"><span>Product photography</span><span>Packshot</span><span>Brand session</span><span>Event photography</span><span>Aerial photos</span><span>Retouch</span></div></div></details>
      <details class="sd__g reveal" open><summary><h3>Social media</h3><span class="sd__pm"></span></summary><div class="sd__gin"><p>Content planning, copywriting, post production and publishing on Facebook, Instagram, LinkedIn and TikTok. We can run the channels or simply feed your own team with material.</p><div class="sd__tags"><span>Channel management</span><span>Content plan</span><span>Copywriting</span><span>Product content</span><span>Instagram and Facebook</span><span>LinkedIn</span><span>TikTok</span></div></div></details>
      <details class="sd__g reveal" open><summary><h3>Design</h3><span class="sd__pm"></span></summary><div class="sd__gin"><p>Social graphics, posts and stories, leaflets, simple sales material and print-ready files – visuals within your existing identity, without commissioning every file separately.</p><div class="sd__tags"><span>Social graphics</span><span>Posts and stories</span><span>Leaflet</span><span>Sales material</span><span>Print-ready files</span></div></div></details>
      <details class="sd__g reveal" open><summary><h3>Website and landing pages</h3><span class="sd__pm"></span></summary><div class="sd__gin"><p>Site updates, new pages, campaign landing pages and ongoing fixes. The website stops being a once-every-few-years project and becomes part of the monthly work.</p><div class="sd__tags"><span>Landing page</span><span>Offer pages</span><span>Content updates</span><span>Site care</span></div></div></details>
      <p class="sd__note reveal">Outside the package of hours: key visuals and large campaign concepts, catalogues, 3D animation and running paid campaigns – those are quoted as separate projects</p>
    </section>
    <section class="sd__blk" id="abo-kto">
      <div class="sd__blkh reveal"><h2>When a retainer <span style="color:#ffd200">pays off.</span></h2></div>
      <details class="sd__g reveal" open><summary><h3>You publish irregularly</h3><span class="sd__pm"></span></summary><div class="sd__gin"><p>Every job means a new brief, a new quote and a new deadline. On a retainer the rhythm is set in advance – you know when the next piece is made before you order it.</p><div class="sd__tags"><span>Irregular content</span><span>Quoting from zero</span><span>Long lead times</span></div></div></details>
      <details class="sd__g reveal" open><summary><h3>Several channels, none properly covered</h3><span class="sd__pm"></span></summary><div class="sd__gin"><p>Social media, the website and sales material all need different content, and nobody is watching all of them. One team covers the whole scope instead of commissioning each channel separately.</p><div class="sd__tags"><span>Social media</span><span>Website</span><span>Sales material</span><span>Campaign assets</span></div></div></details>
      <details class="sd__g reveal"><summary><h3>You want a predictable cost</h3><span class="sd__pm"></span></summary><div class="sd__gin"><p>Instead of invoice after invoice you pay one known monthly amount – easier to plan a budget for the year.</p><div class="sd__tags"><span>Fixed amount</span><span>Annual budget</span><span>No surprises</span></div></div></details>
      <details class="sd__g reveal"><summary><h3>You don't want to re-explain the brand</h3><span class="sd__pm"></span></summary><div class="sd__gin"><p>A new supplier for every job means time lost on onboarding. Here the same team stays with you and knows the style, the product and the audience.</p><div class="sd__tags"><span>Continuity</span><span>Brand knowledge</span><span>Shorter briefs</span></div></div></details>
    </section>
    <section class="sd__blk" id="abo-jak">
      <div class="sd__blkh reveal"><h2>How the <span style="color:#ffd200">work runs.</span></h2></div>
      <div class="sd__steps">
        <div class="sd__step reveal"><h3>A plan for the month</h3><p>At the start of the month you get the list of material we will produce, with dates. You know what you are getting before work starts.</p></div>
        <div class="sd__step reveal"><h3>Your approval</h3><p>You sign off the scope and priorities before production. Nothing is made without your go-ahead.</p></div>
        <div class="sd__step reveal"><h3>Clear billing</h3><p>Every invoice comes with a breakdown: what was produced and how many hours it took. You know exactly what you are paying for.</p></div>
        <div class="sd__step reveal"><h3>One contact</h3><p>One person runs your project from brief to publishing. You talk to them, not to the whole team.</p></div>
        <div class="sd__step reveal"><h3>Less work over time</h3><p>Once we know the brand, you can leave the production calls to us and simply receive finished material.</p></div>
      </div>
    </section>
    <section class="sd__blk" id="abo-war">
      <div class="sd__blkh reveal"><h2>Where a retainer <span style="color:#ffd200">works best.</span></h2></div>
      <div class="sd__vars">
        <a class="sd__var reveal" href="#abo-form"><i>01</i><h3>Dealer groups &amp; showrooms</h3><p>Model launches, test drives, product content and reels in a steady rhythm – without commissioning each piece separately.</p><em>↗</em></a>
        <a class="sd__var reveal" href="#abo-form"><i>02</i><h3>Industry &amp; B2B</h3><p>Films from the plant, production processes, trade fair material and employer branding – one team that knows the site and its safety rules.</p><em>↗</em></a>
        <a class="sd__var reveal" href="#abo-form"><i>03</i><h3>Institutions &amp; culture</h3><p>Event coverage, teasers, season documentation and material for reports – a predictable budget for the whole year.</p><em>↗</em></a>
        <a class="sd__var reveal" href="#abo-form"><i>04</i><h3>E-commerce &amp; product brands</h3><p>Packshots, styled stills and video for product pages – a new collection every month without queuing for material.</p><em>↗</em></a>
        <a class="sd__var reveal" href="#abo-form"><i>05</i><h3>Hospitality &amp; hotels</h3><p>Seasonal menus, interiors, events and reels – content that has to go out weekly, not once a quarter.</p><em>↗</em></a>
        <a class="sd__var reveal" href="#abo-form"><i>06</i><h3>Developers &amp; real estate</h3><p>Aerial build progress, site visits and material for the sales team – documentation across the whole project.</p><em>↗</em></a>
        <a class="sd__var reveal" href="#abo-form"><i>07</i><h3>Sport &amp; clubs</h3><p>Match coverage, player profiles and material for sponsors – a steady rhythm through the whole season.</p><em>↗</em></a>
        <a class="sd__var reveal" href="#abo-form"><i>08</i><h3>Services &amp; local brands</h3><p>Clinics, schools, gyms, offices – the team, the space and the offer shown regularly, in one consistent style.</p><em>↗</em></a>
      </div>
      <p class="sd__note reveal">Scope and pricing agreed individually after the brief</p>
    </section>
    <section class="sd__blk" id="abo-faq">
      <div class="sd__blkh reveal"><h2>Frequently asked <span style="color:#ffd200">questions.</span></h2></div>
      <details class="sd__g reveal" open><summary><h3>How much does a marketing retainer cost?</h3><span class="sd__pm"></span></summary><div class="sd__gin"><p>The figure is set individually – it depends on how much material you need each month and of what kind. After a short call you get one monthly price and a list of what it includes. We do not sell off-the-shelf packages, because every brand publishes at a different pace.</p></div></details>
      <details class="sd__g reveal" open><summary><h3>What if I need something different this month?</h3><span class="sd__pm"></span></summary><div class="sd__gin"><p>The hours are not tied to one service. One month it can be a shoot day and an edit, the next a product session and a batch of social graphics. We agree the scope in the rolling plan.</p></div></details>
      <details class="sd__g reveal" open><summary><h3>Is a retainer a long-term contract?</h3><span class="sd__pm"></span></summary><div class="sd__gin"><p>A retainer works when material is produced in a rhythm and the team knows the brand, so we usually agree on a longer engagement. The minimum term and notice period are set individually with the quote.</p></div></details>
      <details class="sd__g reveal" open><summary><h3>Can you take over the whole marketing?</h3><span class="sd__pm"></span></summary><div class="sd__gin"><p>Yes. If you have no marketing department, we run the whole thing: planning, production and publishing. If you have a marketing manager, we take on the ongoing production of material while they keep strategy, campaigns and decisions.</p></div></details>
      <details class="sd__g reveal" open><summary><h3>How do I know what the hours were spent on?</h3><span class="sd__pm"></span></summary><div class="sd__gin"><p>Every month ends with a breakdown: the list of material produced and the hours behind each item, sent with the invoice. During the month you can follow progress in ClickUp, and you approve priorities before production – nothing happens without your knowledge.</p></div></details>
      <details class="sd__g reveal" open><summary><h3>Do you work outside the Tricity?</h3><span class="sd__pm"></span></summary><div class="sd__gin"><p>Yes. We are based in Gdańsk and shoot across Poland and abroad. Shoot days are planned so one trip delivers several weeks of publishing – travel does not eat into your package.</p></div></details>
    </section>
    <section class="sd__blk" id="abo-form">
      <div class="sd__blkh reveal"><h2>Ask for a <span style="color:#ffd200">retainer quote.</span></h2></div>
      <p class="sd__lead reveal" style="margin-top:0">Tell us what you publish and how often – we'll come back with a proposed scope and a monthly figure. We reply within 24 hours.</p>
      <ContactForm lang="en" formId="retainer-form" />
    </section>
  </div>
</div>
</div>
</ServiceLayout>
