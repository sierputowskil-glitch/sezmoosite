const pageHtml = "<div class=\"sd\">\n<section class=\"sd__hero shell\">\n  <span class=\"sd__kick reveal\"><i></i>Services</span>\n  <h1 class=\"sd__h1 reveal\">Promotional <span style=\"color:#ffd200\">material.</span></h1>\n  <p class=\"sd__lead reveal\" data-d=\"1\">A catalogue, folder or deck is often <b>the last thing before a decision</b> – so we treat them as sales tools, not decoration.</p>\n  <p class=\"sd__lead reveal\" data-d=\"1\">We design print and digital material: catalogues, folders, leaflets, decks, POS material and merchandise – consistent with the brand identity.</p>\n  <div class=\"sd__facts reveal\" data-d=\"2\">\n    <div class=\"sd__fact\"><span>Scope</span><strong>Print · POS · decks</strong></div>\n    <div class=\"sd__fact\"><span>Hierarchy</span><strong>Content leads to a decision</strong></div>\n    <div class=\"sd__fact\"><span>Files</span><strong>Print-ready</strong></div>\n    <div class=\"sd__fact\"><span>Adaptation</span><strong>Digital versions</strong></div>\n  </div>\n  <figure class=\"sd__reel reveal\" data-d=\"1\">\n    <img src=\"/assets/work/audi-kartka.jpg\" alt=\"Audi\" loading=\"eager\" fetchpriority=\"high\" />\n    <figcaption><b>Audi</b><span>Premium print / sales material</span></figcaption>\n  </figure>\n</section>\n<div class=\"sd__body shell\">\n  <div>\n    <section class=\"sd__blk\" id=\"sd-zakres\">\n      <div class=\"sd__blkh reveal\"><h2>What we do</h2></div>\n      <details class=\"sd__g reveal\" open><summary><h3>Catalogues &amp; folders</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Information and sales material with clear content hierarchy – from a one-page leaflet to a full product catalogue.</p><div class=\"sd__tags\"><span>Product catalogue</span><span>Advertising folder</span><span>Leaflet</span><span>Brochure</span><span>Price list</span><span>Product sheet</span></div></div></details>\n      <details class=\"sd__g reveal\" open><summary><h3>Decks &amp; offers</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Sales decks, offer presentations and partner decks – documents that sell without a rep in the room.</p><div class=\"sd__tags\"><span>Sales deck</span><span>Offer deck</span><span>Partner deck</span><span>Deck template</span><span>Report and summary</span><span>One-pager</span></div></div></details>\n      <details class=\"sd__g reveal\"><summary><h3>POS &amp; events</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Display material for the point of sale and for events: stands, walls, roll-ups and booth signage.</p><div class=\"sd__tags\"><span>Stands and displays</span><span>Roll-up</span><span>Event wall</span><span>Booth signage</span><span>Trade fair material</span><span>Stickers and windows</span></div></div></details>\n      <details class=\"sd__g reveal\"><summary><h3>Merchandise &amp; gifts</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Branded clothing and gifts with a logo – chosen so someone actually wants to use them.</p><div class=\"sd__tags\"><span>Branded clothing</span><span>Branded merchandise</span><span>Welcome kits</span><span>Client gifts</span><span>Conference material</span><span>Packaging</span></div></div></details>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-proces\">\n      <div class=\"sd__blkh reveal\"><h2>How we work</h2></div>\n      <div class=\"sd__steps\">\n        <div class=\"sd__step reveal\"><h3>Scope</h3><p>We settle who the material should help decide.</p></div>\n        <div class=\"sd__step reveal\"><h3>Content</h3><p>We order the information and the arguments.</p></div>\n        <div class=\"sd__step reveal\"><h3>Design</h3><p>Layout, type and imagery in the brand's style.</p></div>\n        <div class=\"sd__step reveal\"><h3>Preparation</h3><p>Bleeds, colour and files for the chosen technique.</p></div>\n        <div class=\"sd__step reveal\"><h3>Print</h3><p>Production oversight and digital versions.</p></div>\n      </div>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-work\">\n      <div class=\"sd__blkh reveal\"><h2>Selected work</h2></div>\n      <div class=\"sd__work\">\n        <a class=\"sd__wi reveal\" href=\"../../../en/realizacja-kapka/\"><div class=\"sd__wm\"><img src=\"/assets/portfolio/kapka/kapka-menu.jpg\" alt=\"Kapka Cafe – Menu · Print\" loading=\"lazy\" /></div><span>Menu · Print</span><h3>Kapka Cafe ↗</h3></a>\n        <a class=\"sd__wi reveal\" href=\"../../../en/portfolio-en/?cat=grafika#pt-grid\"><div class=\"sd__wm\"><img src=\"/assets/portfolio/spenner/marcin-spenner-projekt-okladki-plyty-01.avif\" alt=\"Marcin Spenner – Album cover · Design\" loading=\"lazy\" /></div><span>Album cover · Design</span><h3>Marcin Spenner ↗</h3></a>\n        <a class=\"sd__wi reveal\" href=\"../../../realizacja-world-of-warships/\"><div class=\"sd__wm\"><img src=\"/assets/work/captains-club-1.avif\" alt=\"World of Warships – Material · Event\" loading=\"lazy\" /></div><span>Material · Event</span><h3>World of Warships ↗</h3></a>\n      </div>\n      <div class=\"sd__more reveal\">\n        <a class=\"is-lead\" href=\"../../../en/portfolio-en/#pt-grid\">Full portfolio ↗</a>\n        <a href=\"../../../en/portfolio-en/?cat=video#pt-grid\">Video</a>\n        <a href=\"../../../en/portfolio-en/?cat=animacje#pt-grid\">Animation</a>\n        <a href=\"../../../en/portfolio-en/?cat=eventy#pt-grid\">Events</a>\n        <a href=\"../../../en/portfolio-en/?cat=grafika#pt-grid\">Graphics</a>\n      </div>\n    </section>\n  </div>\n</div>\n</div>";
