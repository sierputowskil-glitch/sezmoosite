import BaseLayout from './../../../../layouts/BaseLayout.astro';
const pageHtml = "<div class=\"sd\">\n<section class=\"sd__hero shell\">\n  <span class=\"sd__kick reveal\"><i></i>Services</span>\n  <h1 class=\"sd__h1 reveal\">Graphic <span style=\"color:#ffd200\">design.</span></h1>\n  <p class=\"sd__lead reveal\" data-d=\"1\"><b>Consistent communication starts with a system</b>, not with a single graphic.</p>\n  <p class=\"sd__lead reveal\" data-d=\"1\">We build visual identities and advertising material that can be developed consistently across digital, print and everything that comes next.</p>\n  <div class=\"sd__facts reveal\" data-d=\"2\">\n    <div class=\"sd__fact\"><span>Digital</span><strong>Social · ads · web</strong></div>\n    <div class=\"sd__fact\"><span>Print</span><strong>Catalogues · POS · large format</strong></div>\n    <div class=\"sd__fact\"><span>Base</span><strong>Identity and key visual</strong></div>\n    <div class=\"sd__fact\"><span>Files</span><strong>Source and production-ready</strong></div>\n  </div>\n  <figure class=\"sd__reel reveal\" data-d=\"1\" style=\"background:transparent;border:0;aspect-ratio:16/10\">\n    <img style=\"object-fit:contain;object-position:center;padding:0 0 4%;box-sizing:border-box\" src=\"/assets/img/uslugi/grafika-znakownia-imac.webp\" alt=\"Znakownia – logo design in Adobe Illustrator\" loading=\"eager\" fetchpriority=\"high\" />\n    <figcaption style=\"white-space:nowrap\"><b>Znakownia</b><span>Logo design</span></figcaption>\n  </figure>\n</section>\n<div class=\"sd__body shell\">\n  <div>\n    <section class=\"sd__blk\" id=\"sd-zakres\">\n      <div class=\"sd__blkh reveal\"><h2>What we do</h2></div>\n      <details class=\"sd__g reveal\" open><summary><h3>Visual identity</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>We build visual identity systems from scratch and develop existing brands – from the logo and key visual to the rules that keep every later piece consistent.</p><div class=\"sd__tags\"><span>Logo design</span><span>Visual identity</span><span>Key visual</span><span>Brand book</span><span>Logo guidelines</span><span>Typography</span><span>Brand colours</span><span>Logo refresh</span></div></div></details>\n      <details class=\"sd__g reveal\" open><summary><h3>Marketing &amp; advertising material</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Material for campaigns, sales and everyday communication – for use online and in print alike.</p><div class=\"sd__tags\"><span>Ad banners</span><span>Catalogues</span><span>Brochures</span><span>Leaflets</span><span>Posters</span><span>Presentations</span><span>E-books</span><span>Infographics</span><span>POS material</span></div></div></details>\n      <details class=\"sd__g reveal\" open><summary><h3>Social media &amp; digital</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Graphics for online communication, digital campaigns and social media – single pieces of creative as well as consistent systems for regular publishing.</p><div class=\"sd__tags\"><span>Social media</span><span>Meta Ads</span><span>Google Display</span><span>Web banners</span><span>Carousels</span><span>Stories</span><span>Campaign key visual</span><span>Design templates</span></div></div></details>\n      <details class=\"sd__g reveal\"><summary><h3>Packaging &amp; product</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Packaging, labels and product material designed around the brand identity and the realities of production.</p><div class=\"sd__tags\"><span>Packaging</span><span>Labels</span><span>Stickers</span><span>Boxes</span><span>Product material</span><span>Mockups</span></div></div></details>\n      <details class=\"sd__g reveal\"><summary><h3>2D &amp; 3D graphics</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Illustration, visualisation and 2D/3D graphics used in campaigns, decks, advertising material and digital.</p><div class=\"sd__tags\"><span>Illustration</span><span>2D graphics</span><span>3D graphics</span><span>Visualisations</span><span>Mockups</span><span>Infographics</span></div></div></details>\n      <details class=\"sd__g reveal\"><summary><h3>Print &amp; production files</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Typesetting, file preparation, format adaptations and production material – artwork leaves us ready for the press.</p><div class=\"sd__tags\"><span>DTP</span><span>Typesetting</span><span>Print preparation</span><span>Format adaptations</span><span>Production files</span><span>Large format</span></div></div></details>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-proces\">\n      <div class=\"sd__blkh reveal\"><h2>Design <span style=\"color:#ffd200\">capabilities.</span></h2></div>\n      <div class=\"sd__steps\">\n        <div class=\"sd__step reveal\"><h3>Branding</h3><p>Logos, visual identity, key visuals and graphic systems.</p></div>\n        <div class=\"sd__step reveal\"><h3>Digital</h3><p>Social media, paid campaigns, display and material for websites.</p></div>\n        <div class=\"sd__step reveal\"><h3>Print</h3><p>Catalogues, brochures, posters, POS material and print-ready artwork.</p></div>\n        <div class=\"sd__step reveal\"><h3>2D / 3D</h3><p>Illustration, infographics, visualisations and spatial graphics.</p></div>\n        <div class=\"sd__step reveal\"><h3>DTP and production</h3><p>Typesetting, file preparation, format adaptations and production material.</p></div>\n      </div>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-format\">\n      <h3 class=\"fmt-lead reveal\">One graphic system,<br />many points of <span style=\"color:#ffd200\">contact.</span></h3>\n      <p class=\"fmt-p reveal\">A campaign key visual can end up in social media, digital advertising, a catalogue, POS material or outdoor advertising.</p>\n      <p class=\"fmt-p reveal\">That is why we design not only for the first piece of creative, but for everything it will later be adapted into.</p>\n      <div class=\"fmt-wrap\">\n        <div class=\"fmt2 reveal\">\n          <div class=\"fmt2__hud\"><span><span class=\"dot\"></span>1 key visual</span><span>Digital · print · OOH · POS</span></div>\n          <div class=\"fmt2__master\">\n            <div class=\"fmt2__sprk\"></div>\n            <div class=\"fmt2__frames\"><i></i><i></i><i></i><i></i><i></i></div>\n            <div class=\"fmt2__sprk\"></div>\n            <span class=\"fmt2__mlbl\">MASTER · key visual and system</span>\n          </div>\n          <div class=\"fmt2__split\">where the design has to work</div>\n          <div class=\"fmt2__outs\">\n            <div class=\"fmt2__out\"><span class=\"fmt2__shape s-11\"></span><div><span class=\"r\">Social · display · web</span><h4>Digital</h4></div></div>\n            <div class=\"fmt2__out\"><span class=\"fmt2__shape s-916\"></span><div><span class=\"r\">Catalogue · leaflet · poster</span><h4>Print</h4></div></div>\n            <div class=\"fmt2__out\"><span class=\"fmt2__shape s-ban\"></span><div><span class=\"r\">Billboard · citylight · banner</span><h4>OOH</h4></div></div>\n            <div class=\"fmt2__out\"><span class=\"fmt2__shape s-169\"></span><div><span class=\"r\">Stand · sticker · sales material</span><h4>POS</h4></div></div>\n          </div>\n        </div>\n        <div class=\"fmt-copy reveal\">\n          <span class=\"fmt-copy__kick\"><i></i>Adaptations</span>\n          <h4 class=\"fmt-copy__title\">Bring the subject.<br />We'll pick the formats.</h4>\n          <p class=\"fmt-copy__p\">You don't have to know upfront how many formats you need. We start from the goal and the places the material has to work – the rest is adaptation of the same system.</p>\n          <a class=\"fmt-copy__cta\" href=\"../../../en/#kontakt\">Let's talk about the project →</a>\n        </div>\n      </div>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-work\">\n      <div class=\"sd__blkh reveal\"><h2>Selected work</h2></div>\n      <div class=\"sd__work\">\n        <a class=\"sd__wi reveal\" href=\"../../../en/realizacja-primespot/\"><div class=\"sd__wm\"><img src=\"/assets/portfolio/primespot/pjur-blue-square-1.jpg\" alt=\"PrimeSpot – Creative · Campaign\" loading=\"lazy\" /></div><span>Creative · Campaign</span><h3>PrimeSpot ↗</h3></a>\n        <a class=\"sd__wi reveal\" href=\"../../../en/portfolio-en/?cat=grafika#pt-grid\"><div class=\"sd__wm\"><img src=\"/assets/portfolio/szymichowski/szymichowski-pruszcz-park-katalog-inwestycji-01.avif\" alt=\"Szymichowski – Catalogue · Print\" loading=\"lazy\" /></div><span>Catalogue · Print</span><h3>Szymichowski ↗</h3></a>\n        <a class=\"sd__wi reveal\" href=\"../../../en/realizacja-soho-form/\"><div class=\"sd__wm\"><img src=\"/assets/portfolio/soho-form/soho-cover.webp\" alt=\"Soho Form – Logo · Brand manual\" loading=\"lazy\" /></div><span>Logo · Brand manual</span><h3>Soho Form ↗</h3></a>\n      </div>\n      <div class=\"sd__more reveal\">\n        <a class=\"is-lead\" href=\"../../../en/portfolio-en/#pt-grid\">Full portfolio ↗</a>\n        <a href=\"../../../en/portfolio-en/?cat=video#pt-grid\">Video</a>\n        <a href=\"../../../en/portfolio-en/?cat=animacje#pt-grid\">Animation</a>\n        <a href=\"../../../en/portfolio-en/?cat=eventy#pt-grid\">Events</a>\n        <a href=\"../../../en/portfolio-en/?cat=grafika#pt-grid\">Graphics</a>\n      </div>\n    </section>\n  </div>\n</div>\n</div>";
