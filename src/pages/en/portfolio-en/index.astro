      <button class="pt-navlink" type="button" data-filter="video">Video <span class="n">{'{'}23{'}'}</span></button>
      <button class="pt-navlink" type="button" data-filter="eventy">Events <span class="n">{'{'}03{'}'}</span></button>
      <button class="pt-navlink" type="button" data-filter="foto">Photography <span class="n">{'{'}12{'}'}</span></button>
      <button class="pt-navlink" type="button" data-filter="animacje">Animation <span class="n">{'{'}03{'}'}</span></button>
