---
import AssetImage from '../../../components/AssetImage.astro';
import PortfolioLayout from '../../../layouts/PortfolioLayout.astro';
import { itemListJsonLd } from '../../../lib/schema';
import { pageUrl } from '../../../lib/site';

const lang = 'en' as const;
const canonical = pageUrl('/en/portfolio-en/');
const description =
  'SEZMOO portfolio: video and photo production, social media content, 3D/2D animation and event coverage. Selected work for automotive, B2B and event brands.';

const jsonLd = itemListJsonLd({
  name: 'SEZMOO portfolio',
  description,
  canonical,
  lang,
  items: [
    { name: 'PrimeSpot', url: pageUrl('/en/realizacja-primespot/') },
    { name: 'Baltic Towers recruitment', url: pageUrl('/en/realizacja-baltic-towers-rekrutacja/') },
    { name: 'DORACO × TVP', url: pageUrl('/en/realizacja-doraco-hala-tvp/') },
    { name: 'K2 Fish Farm', url: pageUrl('/en/realizacja-k2/') },
    { name: 'Soho Form', url: pageUrl('/en/realizacja-soho-form/') },
    { name: 'Kapka Cafe', url: pageUrl('/en/realizacja-kapka/') },
    { name: 'Audi RS5', url: pageUrl('/en/realizacja/audi-rs5-trailer/') },
  ],
});
---

<PortfolioLayout
  lang={lang}
  title="Portfolio, video, social, animation and events | SEZMOO"
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
>
<section class="pt-hero">
  <div class="pt-hero__top">
    <div>
      <span class="eyebrow"><span class="tick"></span>Portfolio · Video production &amp; content</span>
      <h1>Work that<br>gets <em>seen</em>.</h1>
    </div>
  </div>
</section>

<div class="pt-shell">
  <aside class="pt-side">
    <span class="pt-side__label">Categories</span>
    <div class="pt-side__list" id="pt-filters">
