        <p class="team-card__role">Graphic &amp; Web Designer</p>
      </div>
    </article>
    <article class="team-card reveal" data-d="2">
      <div class="team-card__photo">
        <span class="tc-ini" aria-hidden="true">PW</span>
        <AssetImage src="/assets/team/pawel-wyszomirski.png" alt="Paweł Wyszomirski" class="tc-ph" loading="lazy" decoding="async" widths={[160, 320, 480]} sizes="96px" quality={78} />
      </div>
