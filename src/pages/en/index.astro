class=\"cform__row\">\n          <div class=\"cfield\"><label for=\"cf-name\">Full name</label><input id=\"cf-name\" name=\"name\" type=\"text\" placeholder=\"John Smith\" required /></div>\n          <div class=\"cfield\"><label for=\"cf-phone\">Phone</label><input id=\"cf-phone\" name=\"phone\" type=\"tel\" placeholder=\"+48 ...\" /></div>\n        </div>\n        <div class=\"cfield\"><label for=\"cf-email\">E-mail</label><input id=\"cf-email\" name=\"email\" type=\"email\" placeholder=\"you@company.com\" required /></div>\n        <div class=\"cfield\">\n          <label for=\"cf-need\">What do you need?</label>\n          <select id=\"cf-need\" name=\"need\" required>\n            <option value=\"\">Choose an area</option>\n            <option>Video / motion</option>\n            <option>Campaign / content</option>\n            <option>Social media</option>\n            <option>Design / graphics</option>\n            <option>Website / landing page</option>\n            <option>Not sure, let’s talk</option>\n          </select>\n        </div>\n        <div class=\"cfield\"><label for=\"cf-msg\">Message</label><textarea id=\"cf-msg\" name=\"message\" placeholder=\"Tell us about your project...\" minlength=\"10\" required></textarea></div>\n        <label class=\"cconsent\"><input type=\"checkbox\" name=\"consent\" value=\"1\" required /> <span>I agree to the processing of my data for contact purposes, in line with SEZMOO’s <a href=\"/../polityka-prywatnosci/\" target=\"_blank\" rel=\"noopener\">privacy policy</a>.</span></label>\n        <button class=\"btn btn--primary\" type=\"submit\"><span class=\"ico\"></span><span class=\"lbl\">Send message</span></button>\n        <p class=\"cform__note\" id=\"cf-note\">● REC · We reply within 24h</p>\n      </form>\n    </div>\n  </div>\n</section>";
const extraHeadHtml = "<style>\n/* YouTube lightbox (home) */\n.lb { position:fixed; inset:0; z-index:9800; display:grid; place-items:center;\n  padding: clamp(16px,4vw,56px); background: oklch(0.06 0.004 60 / 0.86);\n  backdrop-filter: blur(10px) saturate(1.05);\n  opacity:0; visibility:hidden; transition: opacity .4s var(--ease), visibility .4s var(--ease); }\n.lb.is-open { opacity:1; visibility:visible; }\n.lb__inner { position:relative; width:min(100%, 1180px); }\n.lb.is-short .lb__inner { width:auto; max-width:100%; }\n.lb__frame { position:relative; width:100%; aspect-ratio:16/9; background:#000;\n  border:1px solid var(--line); border-radius:6px; overflow:hidden;\n  box-shadow: 0 40px 120px oklch(0 0 0 / 0.6);\n  transform: translateY(16px) scale(.985); transition: transform .5s var(--ease); }\n.lb.is-short .lb__frame { aspect-ratio:9/16; height:min(84vh, 900px); width:auto; }\n.lb.is-open .lb__frame { transform:none; }\n.lb__frame iframe { position:absolute; inset:0; width:100%; height:100%; border:0; }\n.lb__bar { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:14px;\n  font-family:var(--font-mono); font-size:12px; letter-spacing:.12em; text-transform:uppercase; color:var(--fg-dim); }\n.lb__title { color:var(--fg); }\n.lb__title b { font-family:var(--font-display); font-weight:800; font-stretch:106%; letter-spacing:-.01em;\n  text-transform:none; font-size:16px; margin-right:12px; }\n.lb__close { font-family:var(--font-mono); font-size:12px; letter-spacing:.14em; text-transform:uppercase;\n  color:var(--fg-dim); border:1px solid var(--line); border-radius:100px; background:transparent;\n  padding:9px 18px; cursor:pointer; transition: color .3s var(--ease), background .3s var(--ease), border-color .3s var(--ease); }\n.lb__close:hover { color:var(--on-accent); background:var(--rec); border-color:var(--rec); }\n.work-reel .card[data-yt] { cursor:pointer; }\n@media (max-width:620px){ .lb.is-short .lb__frame { height:auto; width:100%; } .lb.is-short .lb__inner { width:min(100%,420px); } }\n</style>\n<style>\n      .services-static{margin-top:clamp(30px,4.5vh,60px)}\n      .svc__ico { display:block; width:30px; height:30px; color:#ffd200; margin:0 0 clamp(12px,1.2vw,18px);\n        opacity:.9; transition: transform .5s var(--ease), opacity .4s var(--ease); }\n      .svc:hover .svc__ico { opacity:1; }\n      .fmt-wrap{display:grid;grid-template-columns:1.12fr .88fr;gap:clamp(26px,4vw,66px);align-items:center;margin-top:clamp(28px,4vh,52px)}\n      .fmt2{position:relative;background:#0c0b09;border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:clamp(18px,2.1vw,28px);overflow:hidden}\n      .fmt2::before{content:\"\";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.022) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.022) 1px,transparent 1px);background-size:40px 40px;pointer-events:none}\n      .fmt2__hud{position:relative;display:flex;justify-content:space-between;align-items:center;font-family:var(--font-mono);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.55);margin-bottom:15px}\n      .fmt2__hud .dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#ffd200;margin-right:8px;vertical-align:middle}\n      .fmt2__master{position:relative;border-radius:9px;overflow:hidden;background:#111;border:1px solid rgba(255,255,255,.1)}\n      .fmt2__frames{display:flex;gap:4px;padding:9px}\n      .fmt2__frames i{flex:1;height:clamp(44px,6vw,62px);border-radius:3px;background:linear-gradient(135deg,rgba(255,210,0,.24),rgba(255,255,255,.05))}\n      .fmt2__frames i:nth-child(even){background:linear-gradient(135deg,rgba(255,255,255,.1),rgba(255,255,255,.03))}\n      .fmt2__sprk{height:11px;background:#0a0a09;background-image:repeating-linear-gradient(90deg,transparent 0 8px,rgba(255,255,255,.13) 8px 13px)}\n      .fmt2__mlbl{position:absolute;top:8px;left:10px;font-family:var(--font-mono);font-size:10px;letter-spacing:.16em;color:rgba(255,255,255,.72);background:rgba(0,0,0,.5);padding:3px 7px;border-radius:3px}\n      .fmt2__split{position:relative;display:flex;align-items:center;gap:12px;margin:14px 0;font-family:var(--font-mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:#ffd200;white-space:nowrap}\n      .fmt2__split::before,.fmt2__split::after{content:\"\";flex:1;height:1px;background:rgba(255,210,0,.26)}\n      .fmt2__outs{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:10px}\n      .fmt2__out{display:flex;align-items:center;gap:13px;padding:13px 14px;border-radius:9px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.1)}\n      .fmt2__shape{flex:none;background:rgba(255,210,0,.16);border:1px solid rgba(255,210,0,.5);border-radius:2px}\n      .s-169{width:44px;height:25px}.s-916{width:20px;height:36px}.s-11{width:32px;height:32px}.s-ban{width:48px;height:16px}\n      .fmt2__out .r{display:block;font-family:var(--font-mono);font-size:10px;letter-spacing:.12em;color:#ffd200;margin-bottom:4px}\n      .fmt2__out h4{font-family:var(--font-display);font-weight:720;font-stretch:104%;font-size:clamp(14px,1.1vw,17px);line-height:1;color:#f4f0e6;margin:0}\n      .fmt2__out p{font-size:11.5px;line-height:1.35;color:rgba(255,255,255,.45);margin:5px 0 0}\n      .fmt-copy .eyebrow{margin-bottom:18px}\n      .fmt-copy__title{font-family:var(--font-display);font-weight:800;font-stretch:104%;font-size:clamp(30px,3.6vw,52px);line-height:1;letter-spacing:-.02em;margin:0 0 clamp(16px,1.6vw,20px)}\n      .fmt-copy__p{color:var(--fg-dim);font-size:clamp(15px,1.15vw,17px);line-height:1.6;max-width:44ch;margin:0 0 clamp(22px,2.4vw,30px)}\n      @media(max-width:1000px){.fmt-wrap{grid-template-columns:1fr;gap:32px}}\n      @media(max-width:520px){.fmt2__outs{grid-template-columns:1fr}}\n      </style>";
const pageScriptsHtml = "<script>\n/* Work-reel cards: hover-preview, real duration, click -> case study */\n(function () {\n  var cards = [].slice.call(document.querySelectorAll(\".work-reel .card[data-yt]\"));\n  if (!cards.length) return;\n\n  // click / keyboard -> case-study page + hover hint label\n  cards.forEach(function (card) {\n    var id = card.getAttribute(\"data-yt\");\n    var media = card.querySelector(\".card__media\");\n    function go() { if (id) location.href = \"realizacja/?v=\" + id; }\n    card.addEventListener(\"click\", go);\n    card.addEventListener(\"keydown\", function (e) { if (e.key === \"Enter\" || e.key === \" \") { e.preventDefault(); go(); } });\n  });\n\n  // hover-preview: inject muted autoplay iframe on enter, remove on leave\n  var canHover = window.matchMedia(\"(hover:hover) and (pointer:fine)\").matches;\n  if (canHover) {\n    cards.forEach(function (card) {\n      var media = card.querySelector(\".card__media\");\n      var id = card.getAttribute(\"data-yt\");\n      if (!media || !id) return;\n      var timer = null;\n      card.addEventListener(\"mouseenter\", function () {\n        timer = setTimeout(function () {\n          if (media.querySelector(\"iframe.card__prev\")) return;\n          var ifr = document.createElement(\"iframe\");\n          ifr.className = \"card__prev\";\n          ifr.src = \"https://www.youtube-nocookie.com/embed/\" + id +\n            \"?autoplay=1&mute=1&controls=0&rel=0&modestbranding=1&playsinline=1&loop=1&playlist=\" + id + \"&origin=https://sezmoo.com\";\n          ifr.allow = \"autoplay; encrypted-media; picture-in-picture\";\n          ifr.setAttribute(\"tabindex\", \"-1\");\n          ifr.style.cssText = \"position:absolute;inset:0;width:100%;height:100%;border:0;z-index:3;pointer-events:none;\";\n          media.appendChild(ifr);\n        }, 240);\n      });\n      card.addEventListener(\"mouseleave\", function () {\n        clearTimeout(timer);\n        var ifr = media.querySelector(\"iframe.card__prev\");\n        if (ifr) ifr.remove();\n      });\n    });\n  }\n\n  // real durations via YouTube IFrame API (one hidden probe player)\n  function fmt(s) {\n    s = Math.round(s);\n    var m = Math.floor(s / 60), r = s % 60;\n    return \"TC \" + (m < 10 ? \"0\" + m : m) + \":\" + (r < 10 ? \"0\" + r : r);\n  }\n  function initDurations() {\n    var host = document.createElement(\"div\");\n    host.style.cssText = \"position:absolute;width:1px;height:1px;left:-9999px;top:-9999px;overflow:hidden;\";\n    document.body.appendChild(host);\n    var el = document.createElement(\"div\"); host.appendChild(el);\n    var queue = cards.map(function (c) {\n      return { id: c.getAttribute(\"data-yt\"), tc: c.querySelector(\".card__tc\") };\n    }).filter(function (q) { return q.id && q.tc; });\n    if (!queue.length) { host.remove(); return; }\n    var i = 0, player, guard;\n    function writeDur() {\n      var d = 0; try { d = player.getDuration(); } catch (e) {}\n      if (d && d > 0) {\n        var q = queue[i], rd = q.tc.querySelector(\".rd\");\n        q.tc.textContent = fmt(d);\n        if (rd) q.tc.insertBefore(rd, q.tc.firstChild);\n        clearTimeout(guard); i++; next();\n      }\n    }\n    function next() {\n      if (i >= queue.length) { host.remove(); return; }\n      guard = setTimeout(function () { i++; next(); }, 4000);\n      player.cueVideoById(queue[i].id);\n    }\n    window.YT.ready(function () {\n      player = new YT.Player(el, {\n        height: \"1\", width: \"1\", videoId: queue[0].id,\n        playerVars: { autoplay: 0, controls: 0 },\n        events: {\n          onReady: function () { next(); },\n          onStateChange: function (e) { if (e.data === YT.PlayerState.CUED) writeDur(); }\n        }\n      });\n    });\n  }\n  if (window.YT && window.YT.Player) {\n    initDurations();\n  } else {\n    var prev = window.onYouTubeIframeAPIReady;\n    window.onYouTubeIframeAPIReady = function () { if (prev) prev(); initDurations(); };\n    var tag = document.createElement(\"script\");\n    tag.src = \"https://www.youtube.com/iframe_api\";\n    document.head.appendChild(tag);\n  }\n})();\n</script>";
