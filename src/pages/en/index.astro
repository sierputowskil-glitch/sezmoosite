---
import AssetImage from '../../components/AssetImage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import OptImage from '../../components/OptImage.astro';
import VideoBg from '../../components/VideoBg.astro';
import HeroShowreel from '../../components/HeroShowreel.astro';
import { homePageJsonLd } from '../../lib/schema';
import '../../styles/home.css';

import workExlantix from '../../../assets/portfolio/exlantix/exlantix-premiera-marki-gdansk-fotografia-21.jpg';
import workWow from '../../../assets/work/captains-club-int.webp';
import workK2 from '../../../assets/portfolio/k2/k2-hodowla-pstraga-zdjecie-z-drona-baseny.webp';
import workBaltic from '../../../assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-01.jpg';
import workDoraco from '../../../assets/portfolio/doraco-tvp/doraco-hala-zdjeciowa-tvp-zdjecia-z-drona-01.jpg';
import workSoho from '../../../assets/portfolio/soho-form/soho-cover.webp';

const lang = 'en' as const;
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://sezmoo.com').replace(/\/$/, '');
const canonical = `${siteUrl}/en/`;
const hreflangPl = `${siteUrl}/`;
const hreflangEn = `${siteUrl}/en/`;

const jsonLd = homePageJsonLd({
  lang,
  canonical,
  description:
    'Video and content studio from Gdańsk. Commercials, social media content, 2D/3D animation and campaigns for brands.',
});
---

<BaseLayout
  lang={lang}
  title="SEZMOO · video, content & campaigns for brands | Gdańsk"
  description="SEZMOO is a video and content studio from Gdańsk, Poland. We produce commercials, social media content, 2D/3D animation and campaigns that build brand visibility, from concept to ready-to-publish formats."
  canonical={canonical}
  keywords="video production Gdansk, brand films, social media content, film production, 3D animation, advertising campaigns, video studio Poland"
  ogTitle="SEZMOO · video, content & campaigns for brands"
  ogDescription="Video and content studio from Gdańsk. Commercials, social media content, animation and campaigns that build brand visibility."
  hreflangPl={hreflangPl}
  hreflangEn={hreflangEn}
  altHref="/"
  brandHref="/en/#hero"
  jsonLd={jsonLd}
  extraHead={`<link rel="preload" as="image" type="image/webp" href="/assets/video/showreel-poster.webp?v=20261016k" fetchpriority="high" />`}
>
<!-- ============ 1 · HERO ============ -->
<section class="hero" id="hero" data-screen-label="Hero">
  <div class="hero__reel">
    <div class="frame-media"></div>
    <HeroShowreel title="SEZMOO showreel" />
  </div>
  <div class="hero__grad"></div>

  <div class="hero__hud tr">
    <div>SEZMOO / CREATIVE AGENCY</div>
    <div style="color:var(--fg-faint);margin-top:6px">4K · 25FPS · GDAŃSK / PL</div>
  </div>

  <div class="shell hero__content">
    <span class="eyebrow hero__label"><span class="tick"></span>Showreel 2026</span>
    <div class="hero__measure">
    <h1>
      <span class="clip"><span>From idea</span></span>
      <span class="clip"><span>to <em class="accent" style="font-style:normal">delivery.</em></span></span>
    </h1>
    <p class="hero__sub">Films, social media, graphics and physical production for brands that want to be seen.</p>
    </div>
    <p class="hero__sub" style="font-size:clamp(15px,1.15vw,18px);color:var(--fg-dim);max-width:min(100%,calc(10.2 * clamp(34px,6.2vw,112px)));margin-top:16px;line-height:1.6">We work end to end – from concept to finished materials ready to use in campaigns and on site. We combine <b>film production and photography</b>, <b>social media content</b> and <b>offline and online visual communication.</b> We are based in Gdańsk, but we deliver projects across the country and abroad.</p>
    <div class="hero__cta">
      <a href="/en/portfolio-en/" class="btn btn--primary" data-magnetic><span class="ico"></span><span class="lbl">See portfolio</span></a>
      <a href="#kontakt" class="btn" data-magnetic><span class="lbl">Let’s talk</span></a>
    </div>
  </div>
</section>

<!-- ============ 2 · WORK / PORTFOLIO ============ -->
<section class="work shell" id="work" data-screen-label="Work">
  <div class="sec-head">
    <h2 class="sec-title reveal">Our <span style="color:#ffd200">projects.</span><br />Recent months.</h2>
    <span class="sec-index reveal">OUR PROJECTS</span>
  </div>

  <div class="work-slider reveal">
    <div class="work-reel" data-bands="3">

    <a class="card reveal" href="/realizacja-exlantix/" data-cats="eventy" data-cursor="link">
      <div class="card__media">
        <OptImage class="card__video" src={workExlantix} alt="EXLANTIX brand launch in Gdańsk – event, photo and video" widths={[360, 640, 960, 1280]} sizes="(max-width: 768px) 55vw, (max-width: 1100px) 40vw, 28vw" quality={78} />
        <div class="card__scan"></div><div class="card__sweep"></div>
        <div class="card__tc"><span class="rd"></span>TC 00:10:00</div>
        <div class="card__live">▶ EVENT</div>
        <span class="card__play">CASE</span>
        <div class="card__bar"><i></i></div>
      </div>
      <div class="card__info"><div><div class="card__client">EXLANTIX</div><div class="card__cat">Brand premiere / Event</div></div><span class="card__tag">CASE</span></div>
    </a>
<a class="card reveal" href="/realizacja-world-of-warships/" data-cats="eventy" data-cursor="link">
      <div class="card__media">
        <OptImage class="card__video" src={workWow} alt="World of Warships" widths={[360, 640, 960, 1280]} sizes="(max-width: 768px) 55vw, (max-width: 1100px) 40vw, 28vw" quality={78} />
        <div class="card__scan"></div><div class="card__sweep"></div>
        <div class="card__tc"><span class="rd"></span>TC 00:23:57</div>
        <div class="card__live">▶ EVENT</div>
        <span class="card__play">CASE</span>
        <div class="card__bar"><i></i></div>
      </div>
      <div class="card__info"><div><div class="card__client">World of Warships</div><div class="card__cat">Captain's Club / Event</div></div><span class="card__tag">CASE</span></div>
    </a>
<a class="card reveal" href="/en/realizacja-k2/" data-cats="grafika" data-cursor="link">
      <div class="card__media">
        <OptImage class="card__video" src={workK2} alt="K2 Fish Farm – rebrand, website, photography and drone film" widths={[360, 640, 960, 1280]} sizes="(max-width: 768px) 55vw, (max-width: 1100px) 40vw, 28vw" quality={78} />
        <div class="card__scan"></div><div class="card__sweep"></div>
        <div class="card__tc"><span class="rd"></span>TC 00:14:02</div>
        <div class="card__live">▶ CASE</div>
        <span class="card__play">CASE</span>
        <div class="card__bar"><i></i></div>
      </div>
      <div class="card__info"><div><div class="card__client">Hodowla Ryb K2</div><div class="card__cat">Rebrand / Website / Drone</div></div><span class="card__tag">CASE</span></div>
    </a>
<a class="card reveal" href="/en/realizacja-baltic-towers-rekrutacja/" data-cats="video" data-cursor="link">
      <div class="card__media">
        <OptImage class="card__video" src={workBaltic} alt="Baltic Towers – recruitment campaign, film and production photography" widths={[360, 640, 960, 1280]} sizes="(max-width: 768px) 55vw, (max-width: 1100px) 40vw, 28vw" quality={78} />
        <div class="card__scan"></div><div class="card__sweep"></div>
        <div class="card__tc"><span class="rd"></span>TC 00:09:41</div>
        <div class="card__live">▶ CASE</div>
        <span class="card__play">CASE</span>
        <div class="card__bar"><i></i></div>
      </div>
      <div class="card__info"><div><div class="card__client">Baltic Towers</div><div class="card__cat">Recruitment / Video / Photo</div></div><span class="card__tag">CASE</span></div>
    </a>
<a class="card reveal" href="/en/realizacja-doraco-hala-tvp/" data-cats="video" data-cursor="link">
      <div class="card__media">
        <OptImage class="card__video" src={workDoraco} alt="DORACO – TVP studio hall, film and drone photography" widths={[360, 640, 960, 1280]} sizes="(max-width: 768px) 55vw, (max-width: 1100px) 40vw, 28vw" quality={78} />
        <div class="card__scan"></div><div class="card__sweep"></div>
        <div class="card__tc"><span class="rd"></span>TC 00:09:41</div>
        <div class="card__live">▶ CASE</div>
        <span class="card__play">CASE</span>
        <div class="card__bar"><i></i></div>
      </div>
      <div class="card__info"><div><div class="card__client">DORACO × TVP</div><div class="card__cat">Film / Photo / Drone</div></div><span class="card__tag">CASE</span></div>
    </a>
<a class="card reveal" href="/en/realizacja-soho-form/" data-cats="grafika" data-cursor="link">
      <div class="card__media">
        <OptImage class="card__video" src={workSoho} alt="Soho Form – logo, brand manual and website" widths={[360, 640, 960, 1280]} sizes="(max-width: 768px) 55vw, (max-width: 1100px) 40vw, 28vw" quality={78} />
        <div class="card__scan"></div><div class="card__sweep"></div>
        <div class="card__tc"><span class="rd"></span>TC 00:21:37</div>
        <div class="card__live">▶ CASE</div>
        <span class="card__play">CASE</span>
        <div class="card__bar"><i></i></div>
      </div>
      <div class="card__info"><div><div class="card__client">Soho Form</div><div class="card__cat">Branding / Website</div></div><span class="card__tag">CASE</span></div>
    </a>


  </div>
  </div>
  <div class="work-slider__hud reveal">
    <button class="work-nav" type="button" aria-label="Previous work" data-reel-prev>‹</button>
    <div class="work-dots" data-reel-dots></div>
    <span class="work-reel__count" data-reel-count><b>01</b> / 02</span>
    <button class="work-nav" type="button" aria-label="Next work" data-reel-next>›</button>
  </div>
  <div class="reveal" style="display:flex;justify-content:center;margin-top:clamp(36px,4.5vw,64px)">
    <a href="/en/portfolio-en/" class="btn btn--primary" data-magnetic><span class="ico"></span><span class="lbl">See full portfolio</span></a>
  </div>
</section>

<!-- ============ 3 · WHAT WE DO ============ -->
<section class="services shell" id="services" data-screen-label="Services">
  <div class="services-static reveal">
      <div class="sec-head">
        <h2 class="sec-title reveal">Our <span style="color:#ffd200">services.</span></h2>
        <span class="sec-index reveal">CONTENT SYSTEM</span>
      </div>
      
      <div class="fmt-wrap">
        <div class="fmt2">
          <div class="fmt2__hud"><span><span class="dot"></span>1 shoot</span><span>4K · 25FPS · Gdańsk</span></div>
          <div class="fmt2__master">
            <div class="fmt2__sprk"></div>
            <div class="fmt2__frames"><i></i><i></i><i></i><i></i><i></i></div>
            <div class="fmt2__sprk"></div>
            <span class="fmt2__mlbl">MASTER · on set</span>
          </div>
          <div class="fmt2__split">one shoot → 4 formats</div>
          <div class="fmt2__outs">
            <div class="fmt2__out"><span class="fmt2__shape s-169"></span><div><span class="r">16:9</span><h4>Hero film</h4><p>Website, YouTube, decks</p></div></div>
            <div class="fmt2__out"><span class="fmt2__shape s-916"></span><div><span class="r">9:16</span><h4>Reels / Shorts</h4><p>Reels, TikTok, Shorts</p></div></div>
            <div class="fmt2__out"><span class="fmt2__shape s-11"></span><div><span class="r">1:1</span><h4>Social ads</h4><p>Paid campaigns</p></div></div>
            <div class="fmt2__out"><span class="fmt2__shape s-ban"></span><div><span class="r">Billboards / Web</span><h4>Campaign creative</h4><p>Banners, thumbnails, KV</p></div></div>
          </div>
        </div>
        <div class="fmt-copy">
          <span class="eyebrow"><span class="tick"></span>What you get</span>
          <h3 class="fmt-copy__title">We never stop<br />at one film.</h3>
          <p class="fmt-copy__p">From the footage shot on set we build a full publishing kit: spots, reels, graphics, ad formats, thumbnails, landing pages and campaign design. Video is the backbone; the rest makes the content work across every channel.</p>
          <a href="/en/services/" class="btn btn--primary" data-magnetic><span class="ico"></span><span class="lbl">Plan production</span></a>
        </div>
      </div>
  </div>

  <div class="svc-grid">
    <a class="svc reveal svc--pillar" href="/en/services/video-production-reels/" data-cursor="link">
      <svg class="svc__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 19 19 5M19 5H8M19 5v11"/></svg>
      <div class="svc__body">
        <svg class="svc__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="1.5"/><path d="M7 4.5v15M17 4.5v15M2.5 9.5h4.5M2.5 14.5h4.5M17 9.5h4.5M17 14.5h4.5"/></svg>
        <h3 class="svc__title">Film production &amp; motion design</h3>
        <p class="svc__desc">Commercials, reels, event coverage, drone, editing and animation, from shoot to final export.</p>
        <div class="svc__chips"><span>video</span><span>spoty</span><span>reels</span><span>event recap</span><span>motion / 3D</span></div>
      </div>
    </a>
    <a class="svc reveal svc--pillar" href="/en/services/social-media-management/" data-d="1" data-cursor="link">
      <svg class="svc__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 19 19 5M19 5H8M19 5v11"/></svg>
      <div class="svc__body">
        <svg class="svc__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M10.5 5.4h3"/><circle cx="12" cy="18" r="1"/></svg>
        <h3 class="svc__title">Social &amp; campaign content</h3>
        <p class="svc__desc">Ongoing production of formats for social media, paid campaigns, launches, promotions and sales communication.</p>
        <div class="svc__chips"><span>content plan</span><span>ads</span><span>launch</span><span>formaty 9:16 / 1:1</span></div>
      </div>
    </a>
    <a class="svc reveal svc--pillar" href="/en/services/graphic-design/" data-d="2" data-cursor="link">
      <svg class="svc__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 19 19 5M19 5H8M19 5v11"/></svg>
      <div class="svc__body">
        <svg class="svc__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15.2 3.9l4.9 4.9M3.5 20.5l1.2-5 11-11 4.9 4.9-11 11-5.1 1.1Z"/><path d="M12.7 6.4l4.9 4.9"/></svg>
        <h3 class="svc__title">Design &amp; brand materials</h3>
        <p class="svc__desc">Graphics, key visuals, catalogues, banners, billboards, print and offline visual communication.</p>
        <div class="svc__chips"><span>KV</span><span>banery</span><span>print</span><span>social assets</span></div>
      </div>
    </a>
    <a class="svc reveal svc--pillar" href="/en/services/websites-and-landing-pages/" data-d="3" data-cursor="link">
      <svg class="svc__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 19 19 5M19 5H8M19 5v11"/></svg>
      <div class="svc__body">
        <svg class="svc__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3.2 9.6h17.6M3.2 14.4h17.6M12 3c2.4 2.4 3.6 5.4 3.6 9s-1.2 6.6-3.6 9c-2.4-2.4-3.6-5.4-3.6-9S9.6 5.4 12 3Z"/></svg>
        <h3 class="svc__title">Web &amp; digital support</h3>
        <p class="svc__desc">Landing pages, campaign sites and digital support that ties the content publishing together.</p>
        <div class="svc__chips"><span>landing</span><span>WWW</span><span>formularze</span><span>kampanie digital</span></div>
      </div>
    </a>
  </div>
</section>

<!-- ============ 4 · STUDIO ============ -->
<section class="studio shell" id="studio" data-screen-label="Studio">
  <div class="sec-head">
    <span class="sec-index reveal" style="order:2">STUDIO</span>
    <span class="eyebrow reveal"><span class="tick"></span>Why SEZMOO</span>
  </div>
  <div class="studio__grid">
    <div class="studio__sticky reveal">
      <div class="studio__media is-vertical" data-parallax="26">
        <div class="frame-media" style="transform:translateY(var(--py,0))"></div>
        <VideoBg videoId="b_MB9qpw6jE" title="SEZMOO team" priority="lazy" />
        <div class="ovl">
          <div class="corners"><span></span><span></span><span></span><span></span></div>
          <div class="tc"><span class="d"></span><span data-tc>00:00:12:08</span></div>
        </div>
      </div>
    </div>
    <div>
      <h2 class="studio__title reveal">One team.<br /><span class="accent">Full brand communication.</span></h2>
      <p class="studio__copy">SEZMOO is a creative agency with 14 years of marketing experience, based in Gdańsk. We bring every key marketing area together in one place – from photo and video production, through graphic and web design, to online marketing (social media and paid campaigns) and offline marketing with our own production. As a creative team we work project by project, but we also offer a retainer model – for brands that need ongoing production. That lets us run projects end to end: from idea and creative to finished materials rolled out in digital and in the real world.</p>
      <div class="studio__points">
        <div class="spt"><span class="spt__no">01</span><span class="spt__txt">We think in channels.</span></div>
        <div class="spt"><span class="spt__no">02</span><span class="spt__txt">We produce efficiently.</span></div>
        <div class="spt"><span class="spt__no">03</span><span class="spt__txt">We deliver the whole campaign.</span></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ 5 · TEAM ============ -->
<section class="team shell" id="team" data-screen-label="Team">
  <div class="sec-head">
    <h2 class="sec-title reveal">Team.</h2>
    <span class="sec-index reveal">TEAM</span>
  </div>

  <div class="team__grid team__grid--photos">
    <article class="team-card reveal" data-d="0">
      <div class="team-card__photo">
        <span class="tc-ini" aria-hidden="true">MT</span>
