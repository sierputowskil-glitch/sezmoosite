---
import BaseLayout from './../../../layouts/BaseLayout.astro';
const pageHtml = "<header class=\"cs-hero\" data-screen-label=\"Case · Cover\">\n  <div class=\"cs-hero__media\"><img src=\"/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-01.jpg\" alt=\"Baltic Towers production hall – recruitment campaign\" /></div>\n  <div class=\"cs-hero__hud\"><span class=\"rec\">RECRUITMENT · VIDEO</span><span>PHOTO · SOCIAL</span><span>INDUSTRY / PL</span></div>\n  <div class=\"cs-hero__inner shell\">\n    <a class=\"cs-hero__back\" href=\"../portfolio-en/\">← Portfolio / Work</a>\n    <span class=\"eyebrow cs-hero__cat\"><span class=\"tick\"></span>SEZMOO × Baltic Towers · Recruitment campaign</span>\n    <h1 class=\"cs-title\">Baltic<br><span class=\"accent\">Towers.</span></h1>\n    <p class=\"cs-hero__sub\">A recruitment campaign for <b>Baltic Towers</b>, a wind tower manufacturer in Gdańsk. A social media film and production-floor photography that show the work as it really is.</p>\n  </div>\n  <div class=\"cs-scroll\" aria-hidden=\"true\"><span>SCROLL</span><i></i></div>\n</header>\n\n<section class=\"cs-meta\" aria-label=\"Project details\">\n  <div class=\"shell\"><div class=\"cs-meta__grid\">\n    <div class=\"cs-meta__cell\"><div class=\"cs-meta__k\">Client</div><div class=\"cs-meta__v\">Baltic Towers<small>Wind towers</small></div></div>\n    <div class=\"cs-meta__cell\"><div class=\"cs-meta__k\">Industry</div><div class=\"cs-meta__v\">Manufacturing<small>Offshore · Energy</small></div></div>\n    <div class=\"cs-meta__cell\"><div class=\"cs-meta__k\">Format</div><div class=\"cs-meta__v\">Campaign<small>Recruitment</small></div></div>\n    <div class=\"cs-meta__cell\"><div class=\"cs-meta__k\">Scope</div><div class=\"cs-meta__v\">Video + photo<small>Social media</small></div></div>\n    <div class=\"cs-meta__cell\"><div class=\"cs-meta__k\">Goal</div><div class=\"cs-meta__v\">New hires<small>Production</small></div></div>\n  </div></div>\n</section>\n\n<section class=\"cs-sec\" data-screen-label=\"PROJECT\">\n  <div class=\"shell\"><div class=\"cs-intro__grid\">\n    <div class=\"reveal\"><span class=\"cs-sec__no\">PROJECT</span><h2 class=\"cs-sec__title\">Work worth<br><span class=\"accent\">seeing.</span></h2></div>\n    <div class=\"cs-body reveal\" data-d=\"1\"><p>Baltic Towers is building one of the largest wind tower factories in Poland and needs people on the floor: welders, operators, fitters. A job ad with a list of requirements is not enough to win them over.</p><p>We went for the real picture: the hall, the machines, the scale of the parts and the people who already work there. A short vertical film for social media and a photo series the company uses in job ads and on its careers page.</p></div>\n  </div></div>\n</section>\n\n<section class=\"cs-sec\" style=\"padding-top:0\" data-screen-label=\"THE APPROACH\">\n  <div class=\"shell\">\n    <span class=\"cs-sec__no reveal\">THE APPROACH</span>\n    <h2 class=\"cs-sec__title reveal\">From the factory floor<br>to the <span class=\"accent\">feed.</span></h2>\n    <div class=\"cs-steps\">\n      <div class=\"cs-step reveal\"><span class=\"cs-step__no\">W1, 01</span><h3 class=\"cs-step__title\">Concept</h3><p class=\"cs-step__desc\">Short, vertical and dynamic – made for Instagram, Facebook and TikTok, where people look for jobs today.</p></div>\n      <div class=\"cs-step reveal\"><span class=\"cs-step__no\">W1, 02</span><h3 class=\"cs-step__title\">Shooting on site</h3><p class=\"cs-step__desc\">Filming and photography without stopping production, following the plant’s safety rules.</p></div>\n      <div class=\"cs-step reveal\"><span class=\"cs-step__no\">W1, 03</span><h3 class=\"cs-step__title\">Edit</h3><p class=\"cs-step__desc\">Social-first pacing, captions and a clear message: join the team.</p></div>\n      <div class=\"cs-step reveal\"><span class=\"cs-step__no\">W1, 04</span><h3 class=\"cs-step__title\">Photos for ads</h3><p class=\"cs-step__desc\">Pictures of people and process for job ads, paid campaigns and the careers page.</p></div>\n    </div>\n  </div>\n</section>\n\n<section class=\"cs-sec\" data-screen-label=\"RECRUITMENT FILM\">\n  <div class=\"shell\">\n    <span class=\"cs-sec__no reveal\">RECRUITMENT FILM</span>\n    <h2 class=\"cs-sec__title reveal\">Short, vertical,<br><span class=\"accent\">to the point.</span></h2>\n    <p class=\"cs-body reveal\" data-d=\"1\" style=\"max-width:54ch;margin-top:20px\">A film that shows the scale of the factory and the nature of the job in a few seconds. Ready to publish and promote in recruitment campaigns.</p>\n    <div class=\"cs-film reveal\" data-d=\"1\" style=\"margin-top:clamp(30px,4vh,48px)\">\n      <div class=\"cs-film__frame\" data-cursor=\"play\" data-yt=\"eBcPwtZ0eOk\" role=\"button\" tabindex=\"0\" aria-label=\"Play the Baltic Towers recruitment film\" style=\"aspect-ratio:9/16;max-width:420px;margin-inline:auto\">\n        <img src=\"/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-02.jpg\" alt=\"Play the Baltic Towers recruitment film\" />\n        <div class=\"cs-film__play\"><span class=\"cs-film__btn\" aria-hidden=\"true\"></span></div>\n        <div class=\"cs-film__meta\"><span class=\"rec\">● REC</span><span>BALTIC TOWERS, RECRUITMENT</span></div>\n        <div class=\"cs-film__bar\"><i></i></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"cs-sec\" style=\"padding-bottom:0\" data-screen-label=\"PHOTOGRAPHY\">\n  <div class=\"shell\"><span class=\"cs-sec__no reveal\">PHOTOGRAPHY</span><h2 class=\"cs-sec__title reveal\">People and the scale<br>of production.</h2></div>\n</section>\n<section class=\"cs-gallery bleed\" aria-label=\"PHOTOGRAPHY\">\n  <div class=\"cs-row\"><figure class=\"cs-shot reveal\" style=\"aspect-ratio:16/9\"><div class=\"frame-media cs-shot__media\"><img src=\"/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-03.jpg\" alt=\"Wind tower segments inside the Baltic Towers hall\" loading=\"lazy\" /></div><span class=\"cs-shot__tag\" style=\"white-space:nowrap\">Photo · Production</span></figure></div>\n  <div class=\"cs-row cs-row--split\"><figure class=\"cs-shot reveal\" style=\"aspect-ratio:4/3\"><div class=\"frame-media cs-shot__media\"><img src=\"/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-04.jpg\" alt=\"Welding at Baltic Towers – recruitment campaign photo\" loading=\"lazy\" /></div><span class=\"cs-shot__tag\" style=\"white-space:nowrap\">Photo · Process</span></figure><figure class=\"cs-shot reveal\" data-d=\"1\" style=\"aspect-ratio:4/3\"><div class=\"frame-media cs-shot__media\"><img src=\"/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-05.jpg\" alt=\"Inside the Baltic Towers factory in Gdańsk\" loading=\"lazy\" /></div><span class=\"cs-shot__tag\" style=\"white-space:nowrap\">Photo · Factory</span></figure></div>\n  <div class=\"cs-row cs-row--split\"><figure class=\"cs-shot reveal\" style=\"aspect-ratio:4/3\"><div class=\"frame-media cs-shot__media\"><img src=\"/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-02.jpg\" alt=\"Baltic Towers worker on the production line – industrial photography\" loading=\"lazy\" /></div><span class=\"cs-shot__tag\" style=\"white-space:nowrap\">Photo · People</span></figure><figure class=\"cs-shot reveal\" data-d=\"1\" style=\"aspect-ratio:4/3\"><div class=\"frame-media cs-shot__media\"><img src=\"/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-01.jpg\" alt=\"Baltic Towers production hall – wind tower segments\" loading=\"lazy\" /></div><span class=\"cs-shot__tag\" style=\"white-space:nowrap\">Photo · Hall</span></figure></div>\n</section>\n\n<section class=\"cs-quote\" aria-label=\"Quote\">\n  <div class=\"shell cs-sec\"><div class=\"cs-quote__inner reveal\">\n    <blockquote><span class=\"mark\">„</span>Recruitment starts with a picture. We showed the factory so that people want to work there.<span class=\"mark\">”</span></blockquote>\n    <div class=\"cs-quote__by\">– <b>SEZMOO team</b> · Video, photo and social media</div>\n  </div></div>\n</section>\n\n<a class=\"cs-next bleed\" href=\"../portfolio-en/\" data-cursor=\"link\" aria-label=\"Back to portfolio\">\n  <img src=\"/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-03.jpg\" alt=\"\" />\n  <div class=\"cs-next__inner shell\"><span class=\"cs-next__k\">See more →</span><span class=\"cs-next__title\">Portfolio <span class=\"arrow\">→</span></span><span class=\"cs-next__cat\">All SEZMOO work</span></div>\n</a>";
const extraHeadHtml = "<link rel=\"stylesheet\" href=\"//assets/css/case-study.css\" />";
const pageScriptsHtml = "<script>\n(function(){var f=document.querySelector('.cs-film__frame');if(!f)return;function play(){var id=f.getAttribute('data-yt');if(!id||f.querySelector('iframe'))return;var i=document.createElement('iframe');i.src='https://www.youtube-nocookie.com/embed/'+id+'?autoplay=1&rel=0&modestbranding=1&playsinline=1';i.allow='autoplay; fullscreen; picture-in-picture';i.setAttribute('allowfullscreen','');f.appendChild(i);}f.addEventListener('click',play);f.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();play();}});})();\n</script>";
---

<BaseLayout
  lang="en"
  title="Baltic Towers · Recruitment campaign · SEZMOO case study"
  description="SEZMOO case study: Baltic Towers recruitment campaign – social media film and photography of wind tower production."
  canonical="https://sezmoo.com/en/realizacja-baltic-towers-rekrutacja/"
  extraHead={extraHeadHtml}
  pageScripts={pageScriptsHtml}
>
  <Fragment set:html={pageHtml} />
</BaseLayout>
