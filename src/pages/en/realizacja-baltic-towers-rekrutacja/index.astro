---
import AssetImage from '../../../components/AssetImage.astro';
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';
import { pageUrl } from '../../../lib/site';

const lang = 'en' as const;
const canonical = pageUrl('/en/realizacja-baltic-towers-rekrutacja/');
---

<CaseStudyLayout
  lang={lang}
  title="Baltic Towers · Recruitment campaign · SEZMOO case study"
  description="SEZMOO case study: Baltic Towers recruitment campaign – social media film and photography of wind tower production."
  canonical={canonical}
>
<header class="cs-hero" data-screen-label="Case · Cover">
  <div class="cs-hero__media"><AssetImage src="/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-01.jpg" alt="Baltic Towers production hall – recruitment campaign" loading="eager" fetchpriority="high" widths={[720, 1080, 1440, 1920]} sizes="100vw" quality={72} /></div>
  <div class="cs-hero__hud"><span class="rec">RECRUITMENT · VIDEO</span><span>PHOTO · SOCIAL</span><span>INDUSTRY / PL</span></div>
  <div class="cs-hero__inner shell">
    <a class="cs-hero__back" href="/en/portfolio-en/">← Portfolio / Work</a>
    <span class="eyebrow cs-hero__cat"><span class="tick"></span>SEZMOO × Baltic Towers · Recruitment campaign</span>
    <h1 class="cs-title">Baltic<br><span class="accent">Towers.</span></h1>
    <p class="cs-hero__sub">A recruitment campaign for <b>Baltic Towers</b>, a wind tower manufacturer in Gdańsk. A social media film and production-floor photography that show the work as it really is.</p>
  </div>
  <div class="cs-scroll" aria-hidden="true"><span>SCROLL</span><i></i></div>
</header>

<section class="cs-meta" aria-label="Project details">
  <div class="shell"><div class="cs-meta__grid">
    <div class="cs-meta__cell"><div class="cs-meta__k">Client</div><div class="cs-meta__v">Baltic Towers<small>Wind towers</small></div></div>
    <div class="cs-meta__cell"><div class="cs-meta__k">Industry</div><div class="cs-meta__v">Manufacturing<small>Offshore · Energy</small></div></div>
    <div class="cs-meta__cell"><div class="cs-meta__k">Format</div><div class="cs-meta__v">Campaign<small>Recruitment</small></div></div>
    <div class="cs-meta__cell"><div class="cs-meta__k">Scope</div><div class="cs-meta__v">Video + photo<small>Social media</small></div></div>
    <div class="cs-meta__cell"><div class="cs-meta__k">Goal</div><div class="cs-meta__v">New hires<small>Production</small></div></div>
  </div></div>
</section>

<section class="cs-sec" data-screen-label="PROJECT">
  <div class="shell"><div class="cs-intro__grid">
    <div class="reveal"><span class="cs-sec__no">PROJECT</span><h2 class="cs-sec__title">Work worth<br><span class="accent">seeing.</span></h2></div>
    <div class="cs-body reveal" data-d="1"><p>Baltic Towers is building one of the largest wind tower factories in Poland and needs people on the floor: welders, operators, fitters. A job ad with a list of requirements is not enough to win them over.</p><p>We went for the real picture: the hall, the machines, the scale of the parts and the people who already work there. A short vertical film for social media and a photo series the company uses in job ads and on its careers page.</p></div>
  </div></div>
</section>

<section class="cs-sec" style="padding-top:0" data-screen-label="THE APPROACH">
  <div class="shell">
    <span class="cs-sec__no reveal">THE APPROACH</span>
    <h2 class="cs-sec__title reveal">From the factory floor<br>to the <span class="accent">feed.</span></h2>
    <div class="cs-steps">
      <div class="cs-step reveal"><span class="cs-step__no">W1, 01</span><h3 class="cs-step__title">Concept</h3><p class="cs-step__desc">Short, vertical and dynamic – made for Instagram, Facebook and TikTok, where people look for jobs today.</p></div>
      <div class="cs-step reveal"><span class="cs-step__no">W1, 02</span><h3 class="cs-step__title">Shooting on site</h3><p class="cs-step__desc">Filming and photography without stopping production, following the plant’s safety rules.</p></div>
      <div class="cs-step reveal"><span class="cs-step__no">W1, 03</span><h3 class="cs-step__title">Edit</h3><p class="cs-step__desc">Social-first pacing, captions and a clear message: join the team.</p></div>
      <div class="cs-step reveal"><span class="cs-step__no">W1, 04</span><h3 class="cs-step__title">Photos for ads</h3><p class="cs-step__desc">Pictures of people and process for job ads, paid campaigns and the careers page.</p></div>
    </div>
  </div>
</section>

<section class="cs-sec" data-screen-label="RECRUITMENT FILM">
  <div class="shell">
    <span class="cs-sec__no reveal">RECRUITMENT FILM</span>
    <h2 class="cs-sec__title reveal">Short, vertical,<br><span class="accent">to the point.</span></h2>
    <p class="cs-body reveal" data-d="1" style="max-width:54ch;margin-top:20px">A film that shows the scale of the factory and the nature of the job in a few seconds. Ready to publish and promote in recruitment campaigns.</p>
    <div class="cs-film reveal" data-d="1" style="margin-top:clamp(30px,4vh,48px)">
      <div class="cs-film__frame" data-cursor="play" data-yt="eBcPwtZ0eOk" role="button" tabindex="0" aria-label="Play the Baltic Towers recruitment film" style="aspect-ratio:9/16;max-width:420px;margin-inline:auto">
        <AssetImage src="/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-02.jpg" alt="Play the Baltic Towers recruitment film" loading="lazy" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, min(1100px, 85vw)" quality={72} />
        <div class="cs-film__play"><span class="cs-film__btn" aria-hidden="true"></span></div>
        <div class="cs-film__meta"><span class="rec">● REC</span><span>BALTIC TOWERS, RECRUITMENT</span></div>
        <div class="cs-film__bar"><i></i></div>
      </div>
    </div>
  </div>
</section>

<section class="cs-sec" style="padding-bottom:0" data-screen-label="PHOTOGRAPHY">
  <div class="shell"><span class="cs-sec__no reveal">PHOTOGRAPHY</span><h2 class="cs-sec__title reveal">People and the scale<br>of production.</h2></div>
</section>
<section class="cs-gallery bleed" aria-label="PHOTOGRAPHY">
  <div class="cs-row"><figure class="cs-shot reveal" style="aspect-ratio:16/9"><div class="frame-media cs-shot__media"><AssetImage src="/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-03.jpg" alt="Wind tower segments inside the Baltic Towers hall" loading="lazy" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, min(1100px, 85vw)" quality={72} /></div><span class="cs-shot__tag" style="white-space:nowrap">Photo · Production</span></figure></div>
  <div class="cs-row cs-row--split"><figure class="cs-shot reveal" style="aspect-ratio:4/3"><div class="frame-media cs-shot__media"><AssetImage src="/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-04.jpg" alt="Welding at Baltic Towers – recruitment campaign photo" loading="lazy" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, min(1100px, 85vw)" quality={72} /></div><span class="cs-shot__tag" style="white-space:nowrap">Photo · Process</span></figure><figure class="cs-shot reveal" data-d="1" style="aspect-ratio:4/3"><div class="frame-media cs-shot__media"><AssetImage src="/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-05.jpg" alt="Inside the Baltic Towers factory in Gdańsk" loading="lazy" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, min(1100px, 85vw)" quality={72} /></div><span class="cs-shot__tag" style="white-space:nowrap">Photo · Factory</span></figure></div>
  <div class="cs-row cs-row--split"><figure class="cs-shot reveal" style="aspect-ratio:4/3"><div class="frame-media cs-shot__media"><AssetImage src="/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-02.jpg" alt="Baltic Towers worker on the production line – industrial photography" loading="lazy" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, min(1100px, 85vw)" quality={72} /></div><span class="cs-shot__tag" style="white-space:nowrap">Photo · People</span></figure><figure class="cs-shot reveal" data-d="1" style="aspect-ratio:4/3"><div class="frame-media cs-shot__media"><AssetImage src="/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-01.jpg" alt="Baltic Towers production hall – wind tower segments" loading="lazy" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, min(1100px, 85vw)" quality={72} /></div><span class="cs-shot__tag" style="white-space:nowrap">Photo · Hall</span></figure></div>
</section>

<section class="cs-quote" aria-label="Quote">
  <div class="shell cs-sec"><div class="cs-quote__inner reveal">
    <blockquote><span class="mark">„</span>Recruitment starts with a picture. We showed the factory so that people want to work there.<span class="mark">”</span></blockquote>
    <div class="cs-quote__by">– <b>SEZMOO team</b> · Video, photo and social media</div>
  </div></div>
</section>

<a class="cs-next bleed" href="/en/portfolio-en/" data-cursor="link" aria-label="Back to portfolio">
  <AssetImage src="/assets/portfolio/baltic-towers-foto/baltic-towers-fotografia-przemyslowa-produkcja-03.jpg" alt="" loading="lazy" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, min(1100px, 85vw)" quality={72} />
  <div class="cs-next__inner shell"><span class="cs-next__k">See more →</span><span class="cs-next__title">Portfolio <span class="arrow">→</span></span><span class="cs-next__cat">All SEZMOO work</span></div>
</a>
</CaseStudyLayout>
