---
import BaseLayout from './../../../layouts/BaseLayout.astro';
const pageHtml = "<article class=\"article shell\">\n  <header class=\"article__head\">\n    <a class=\"article__back reveal\" href=\"../../en/\">← Back to site</a>\n    <span class=\"blog-post__meta reveal\">SEZMOO · GDPR / PRIVACY</span>\n    <h1 class=\"article__title reveal\">Privacy policy</h1>\n    <p class=\"article__lead reveal\" data-d=\"1\">Information notice for clients under Art. 13(1) and (2) GDPR (Regulation (EU) 2016/679 of the European Parliament and of the Council of 27 April 2016). It explains how and why we process your personal data and what rights you have.</p>\n  </header>\n  <div class=\"article__layout\">\n    <aside class=\"article__aside reveal\">\n      <span>Sections</span>\n      <a href=\"#controller\">1 · Controller</a>\n      <a href=\"#officer\">2 · Data protection</a>\n      <a href=\"#purposes\">3 · Purposes &amp; basis</a>\n      <a href=\"#retention\">4 · Retention</a>\n      <a href=\"#recipients\">5 · Recipients</a>\n      <a href=\"#rights\">6 · Your rights</a>\n      <a href=\"#cookies\">7 · Cookies</a>\n    </aside>\n    <div class=\"article__content\">\n      <section id=\"controller\" class=\"reveal\">\n        <h2>1. Data controller.</h2>\n        <p>The controller of your personal data is <strong>Maciej Tyma SEZMOO</strong>, ul. Zeusa 34, 80-299 Gdańsk, Poland, VAT (NIP) 9581568266. Contact: <a href=\"mailto:biuro@sezmoo.com\">biuro@sezmoo.com</a>.</p>\n      </section>\n      <section id=\"officer\" class=\"reveal\">\n        <h2>2. Data protection.</h2>\n        <p>For matters concerning data protection at Maciej Tyma SEZMOO, please contact us by e-mail: <a href=\"mailto:biuro@sezmoo.com\">biuro@sezmoo.com</a>.</p>\n      </section>\n      <section id=\"purposes\" class=\"reveal\">\n        <h2>3. Purposes and legal basis.</h2>\n        <p>Data obtained through various forms of communication (direct contact, phone, e-mail, contact form) is processed:</p>\n        <ul>\n          <li>to perform a contract or take steps prior to entering into it, at your request, Art. 6(1)(b) GDPR (including keeping in touch and mutual settlements);</li>\n          <li>to comply with a legal obligation of the controller, Art. 6(1)(c) GDPR;</li>\n          <li>to handle complaints, Art. 6(1)(c) in connection with (b) GDPR;</li>\n          <li>to reply to an enquiry sent to our e-mail address, Art. 6(1)(f) GDPR (legitimate interest);</li>\n          <li>to prepare an offer and conduct negotiations in response to your request, Art. 6(1)(f) GDPR;</li>\n          <li>for purposes arising from the controller's legitimate interest: direct marketing, archival and evidential purposes, establishing, pursuing or defending claims, operational activity, statistics and reporting, and customer-satisfaction surveys, Art. 6(1)(f) GDPR;</li>\n          <li>where you give additional consent, only within the scope and for the purposes stated in that consent, Art. 6(1)(a) GDPR.</li>\n        </ul>\n      </section>\n      <section id=\"retention\" class=\"reveal\">\n        <h2>4. Data retention.</h2>\n        <p>We store data for as long as necessary to achieve the processing purposes, i.e. as a rule:</p>\n        <ul>\n          <li>where processing is necessary to perform a contract, for the term of the contract;</li>\n          <li>where processing is based on your consent, until that consent is withdrawn;</li>\n          <li>where processing arises from the controller's legitimate interests, for as long as those interests exist or until an effective objection is raised.</li>\n        </ul>\n        <p>These periods are extended where processing is necessary to establish, pursue or defend claims, or to comply with a legal obligation requiring processing for a period set out in the law applicable to the controller.</p>\n      </section>\n      <section id=\"recipients\" class=\"reveal\">\n        <h2>5. Recipients of data.</h2>\n        <p>Data may be shared with: authorised employees and associates of the controller, providers of accounting, HR and legal services, IT and software providers, hosting and e-mail providers, postal operators and couriers, the bank for payment processing, and other entities entitled to obtain data under applicable law.</p>\n      </section>\n      <section id=\"rights\" class=\"reveal\">\n        <h2>6. Your rights.</h2>\n        <p>To the extent and on the terms set out in the GDPR, you have the right to: access your data, rectify it, erase it, restrict processing, data portability, withdraw consent at any time (without affecting the lawfulness of processing before withdrawal), and object at any time, including to processing for direct-marketing purposes.</p>\n        <p><strong>Exercising your rights:</strong> to use the above rights, please contact us using the details in sections 1 and 2.</p>\n        <p><strong>Complaint to the supervisory authority:</strong> you have the right to lodge a complaint with the President of the Personal Data Protection Office (UODO) if you believe your data is processed unlawfully.</p>\n        <p><strong>Providing data:</strong> providing your data is voluntary but necessary to achieve the purposes in section 3, in particular it is a condition of concluding and performing a contract.</p>\n      </section>\n      <section id=\"cookies\" class=\"reveal\">\n        <h2>7. Cookies.</h2>\n        <p>This website uses cookies to ensure it works correctly, to remember preferences and, with your consent, for statistics and marketing. Necessary cookies are always used; the rest only after you accept them in the cookie consent banner.</p>\n        <p>You can change your cookie settings in your browser at any time or withdraw consent by clearing site data. Restricting cookies may affect some features of the site.</p>\n      </section>\n    </div>\n  </div>\n</article>";
---

<BaseLayout
  lang="en"
  title="Privacy policy | SEZMOO"
  description="Privacy policy and GDPR information notice for SEZMOO (Maciej Tyma SEZMOO)."
  canonical="https://sezmoo.com/en/privacy-policy/"
>
  <Fragment set:html={pageHtml} />
</BaseLayout>
