---
import BaseLayout from './../../../layouts/BaseLayout.astro';
const pageHtml = "<!-- ============ COVER ============ -->\n<header class=\"cs-hero\" data-screen-label=\"Case · Cover\">\n  <div class=\"cs-hero__media\">\n    <img src=\"/assets/portfolio/kapka/kapka-baner.jpg\" alt=\"Kapka Cafe mascot, a coffee drop holding a to-go cup and a sandwich, over roasted beans\" />\n  </div>\n  <div class=\"cs-hero__frame\" aria-hidden=\"true\"><span></span><span></span><span></span><span></span></div>\n  <div class=\"cs-hero__hud\">\n    <span class=\"rec\">BRANDING · LOGO</span>\n    <span>IDENTITY</span>\n    <span>COFFEE SHOP / PL</span>\n  </div>\n\n  <div class=\"cs-hero__inner shell\">\n    <a class=\"cs-hero__back\" href=\"../../en/portfolio-en/\">← Portfolio / Work</a>\n    <span class=\"eyebrow cs-hero__cat\"><span class=\"tick\"></span>SEZMOO × Kapka Cafe · Coffee shop branding</span>\n    <h1 class=\"cs-title\">Kapka<br><span class=\"accent\">Cafe.</span></h1>\n    <p class=\"cs-hero__sub\">A complete visual identity for <b>Kapka Cafe</b>: from the mark and mascot, through palette and type, to materials that work on the counter, in the window and across social media.</p>\n  </div>\n\n  <div class=\"cs-scroll\" aria-hidden=\"true\"><span>SCROLL</span><i></i></div>\n</header>\n\n<!-- ============ META ============ -->\n<section class=\"cs-meta\" aria-label=\"Project data\">\n  <div class=\"shell\">\n    <div class=\"cs-meta__grid\">\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Client</div>\n        <div class=\"cs-meta__v\">Kapka Cafe<small>Coffee shop</small></div>\n      </div>\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Industry</div>\n        <div class=\"cs-meta__v\">Hospitality<small>Coffee &amp; to-go</small></div>\n      </div>\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Format</div>\n        <div class=\"cs-meta__v\">Branding<small>From scratch</small></div>\n      </div>\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Scope</div>\n        <div class=\"cs-meta__v\">Full-service<small>Logo · Mascot · Materials</small></div>\n      </div>\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Result</div>\n        <div class=\"cs-meta__v\">One coherent look<small>Mark · Window · Social</small></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ 01 · ABOUT ============ -->\n<section class=\"cs-sec\" data-screen-label=\"About\">\n  <div class=\"shell\">\n    <div class=\"cs-intro__grid\">\n      <div class=\"reveal\">\n        <span class=\"cs-sec__no\">ABOUT THE PROJECT</span>\n        <h2 class=\"cs-sec__title\">A brand built<br>around a single <span class=\"accent\">drop.</span></h2>\n      </div>\n      <div class=\"cs-body reveal\" data-d=\"1\">\n        <p>Kapka Cafe is a small, intimate coffee shop that needed a brand to match its scale: warm, friendly and recognisable from across the street. We started from the name, <strong>“kapka”</strong>, meaning a drop, and made it the heart of the whole identity.</p>\n        <p>From one idea we built a full system: a mark with a to-go cup held by a hand, a coffee-drop mascot with real character, and a consistent palette and type carried across everything, from the menu to the in-store signage.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ LOGO SHOWCASE ============ -->\n<section class=\"cs-sec\" style=\"padding-top:0\" aria-label=\"Logo\">\n  <div class=\"shell\">\n    <span class=\"cs-sec__no reveal\">THE MARK</span>\n    <h2 class=\"cs-sec__title reveal\">A logo that instantly<br>says “coffee to go”.</h2>\n  </div>\n  <div class=\"cs-row\" style=\"margin-top:clamp(28px,4vh,48px)\">\n    <figure class=\"cs-shot cs-shot--wide reveal\" data-parallax=\"20\" style=\"background:#f3e9d6\">\n      <div class=\"frame-media cs-shot__media\" style=\"background:#f3e9d6\">\n        <img src=\"/assets/portfolio/kapka/kapka-logo.jpg\" alt=\"Kapka Cafe logo: a brown to-go cup held by a hand next to the Kapka Cafe wordmark\" loading=\"lazy\" style=\"object-fit:contain\" />\n      </div>\n      <span class=\"cs-shot__tag\">Logo · Primary lockup</span>\n    </figure>\n  </div>\n</section>\n\n<!-- ============ 03 · SYSTEM ============ -->\n<section class=\"cs-sec\" data-screen-label=\"System\">\n  <div class=\"shell\">\n    <span class=\"cs-sec__no reveal\">IDENTITY SYSTEM</span>\n    <h2 class=\"cs-sec__title reveal\">From the mark<br>to the whole venue.</h2>\n\n    <div class=\"cs-steps\">\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">B1, 01</span>\n        <h3 class=\"cs-step__title\">Mark &amp; wordmark</h3>\n        <p class=\"cs-step__desc\">A cup-and-hand symbol plus a soft, hand-drawn “Kapka Cafe” wordmark, legible on the sign, in the app and on the cup.</p>\n      </div>\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">B1, 02</span>\n        <h3 class=\"cs-step__title\">Drop mascot</h3>\n        <p class=\"cs-step__desc\">A smiling coffee drop with a cup and a sandwich, the brand character used across social media, banners and as a window sticker in the venue.</p>\n      </div>\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">B1, 03</span>\n        <h3 class=\"cs-step__title\">Palette &amp; type</h3>\n        <p class=\"cs-step__desc\">Warm roasted-coffee browns, a cream base and a soft, rounded typeface that build a friendly café character and keep everything in one tone.</p>\n      </div>\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">B1, 04</span>\n        <h3 class=\"cs-step__title\">Materials &amp; venue</h3>\n        <p class=\"cs-step__desc\">Menu, Facebook banner, sign, dimensional letters on the counter and stickers, the identity carried onto real guest touchpoints.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ GALLERY ============ -->\n<section class=\"cs-gallery bleed\" aria-label=\"Identity elements\">\n  <div class=\"cs-row cs-row--split\">\n    <figure class=\"cs-shot cs-shot--tall reveal\" data-parallax=\"24\" style=\"background:#e7dcc6\">\n      <div class=\"frame-media cs-shot__media\" style=\"background:#e7dcc6\">\n        <img src=\"/assets/portfolio/kapka/kapka-maskotka.png\" alt=\"Kapka Cafe mascot: a smiling coffee drop holding a to-go cup\" loading=\"lazy\" style=\"object-fit:contain\" />\n      </div>\n      <span class=\"cs-shot__tag\">Mascot · The drop</span>\n    </figure>\n    <figure class=\"cs-shot cs-shot--tall reveal\" data-d=\"1\" data-parallax=\"24\">\n      <div class=\"frame-media cs-shot__media\">\n        <img src=\"/assets/portfolio/kapka/kapka-menu.jpg\" alt=\"Kapka Cafe menu with prices for coffees, drinks and extras\" loading=\"lazy\" />\n      </div>\n      <span class=\"cs-shot__tag\">Materials · Menu</span>\n    </figure>\n  </div>\n\n  <div class=\"cs-row\">\n    <figure class=\"cs-shot cs-shot--full reveal\" data-parallax=\"30\">\n      <div class=\"frame-media cs-shot__media\">\n        <img src=\"/assets/portfolio/kapka/kapka-baner.jpg\" alt=\"Kapka Cafe banner with the drop mascot over roasted coffee beans\" loading=\"lazy\" />\n      </div>\n      <span class=\"cs-shot__tag\">Social · FB banner</span>\n    </figure>\n  </div>\n\n  <div class=\"cs-row cs-row--split\">\n    <figure class=\"cs-shot cs-shot--tall reveal\" data-parallax=\"24\">\n      <div class=\"frame-media cs-shot__media\">\n        <img src=\"/assets/portfolio/kapka/kapka-lokal.jpg\" alt=\"Kapka Cafe interior: counter with dimensional logo and a mascot sticker on the wall\" loading=\"lazy\" />\n      </div>\n      <span class=\"cs-shot__tag\">Venue · Counter</span>\n    </figure>\n    <figure class=\"cs-shot cs-shot--tall reveal\" data-d=\"1\" data-parallax=\"24\">\n      <div class=\"frame-media cs-shot__media\">\n        <img src=\"/assets/portfolio/kapka/kapka-witryna.jpg\" alt=\"Kapka Cafe storefront and sign from the street\" loading=\"lazy\" />\n      </div>\n      <span class=\"cs-shot__tag\">Venue · Sign</span>\n    </figure>\n  </div>\n</section>\n\n<!-- ============ CLOSING ============ -->\n<section class=\"cs-quote\" aria-label=\"Result\">\n  <div class=\"shell cs-sec\">\n    <div class=\"cs-quote__inner reveal\">\n      <blockquote><span class=\"mark\">“</span>One simple idea, a drop, gave Kapka Cafe a mark, a mascot and a coherent language that looks just as good on a cup, in the window and across social media.<span class=\"mark\">”</span></blockquote>\n      <div class=\"cs-quote__by\">– <b>SEZMOO team</b> · Branding &amp; identity</div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ NEXT PROJECT ============ -->\n<a class=\"cs-next bleed\" href=\"../../en/portfolio-en/\" data-cursor=\"link\" aria-label=\"Back to portfolio\">\n  <img src=\"/assets/portfolio/kapka/kapka-witryna.jpg\" alt=\"Kapka Cafe storefront\" />\n  <div class=\"cs-next__inner shell\">\n    <span class=\"cs-next__k\">See more →</span>\n    <span class=\"cs-next__title\">Portfolio <span class=\"arrow\">→</span></span>\n    <span class=\"cs-next__cat\">All SEZMOO work</span>\n  </div>\n</a>";
const extraHeadHtml = "<link rel=\"stylesheet\" href=\"//assets/css/case-study.css\" />";
---

<BaseLayout
  lang="en"
  title="Kapka Cafe · Logo & brand identity · SEZMOO case study"
  description="SEZMOO case study: logo, mascot and full brand identity for Kapka Cafe. Cup-and-hand mark, coffee-drop mascot, palette, menu, banner and in-store signage."
  canonical="https://sezmoo.com/en/realizacja-kapka/"
  extraHead={extraHeadHtml}
>
  <Fragment set:html={pageHtml} />
</BaseLayout>
