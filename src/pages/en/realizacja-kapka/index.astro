---
import AssetImage from '../../../components/AssetImage.astro';
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';
import { pageUrl } from '../../../lib/site';

const lang = 'en' as const;
const canonical = pageUrl('/en/realizacja-kapka/');
---

<CaseStudyLayout
  lang={lang}
  title="Kapka Cafe · Logo & brand identity · SEZMOO case study"
  description="SEZMOO case study: logo, mascot and full brand identity for Kapka Cafe. Cup-and-hand mark, coffee-drop mascot, palette, menu, banner and in-store signage."
  canonical={canonical}
>
<!-- ============ COVER ============ -->
<header class="cs-hero" data-screen-label="Case · Cover">
  <div class="cs-hero__media">
    <AssetImage src="/assets/portfolio/kapka/kapka-baner.jpg" alt="Kapka Cafe mascot, a coffee drop holding a to-go cup and a sandwich, over roasted beans" loading="eager" fetchpriority="high" widths={[720, 1080, 1440, 1920]} sizes="100vw" quality={72} />
  </div>
  <div class="cs-hero__frame" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  <div class="cs-hero__hud">
    <span class="rec">BRANDING · LOGO</span>
    <span>IDENTITY</span>
    <span>COFFEE SHOP / PL</span>
  </div>

  <div class="cs-hero__inner shell">
    <a class="cs-hero__back" href="/en/portfolio-en/">← Portfolio / Work</a>
    <span class="eyebrow cs-hero__cat"><span class="tick"></span>SEZMOO × Kapka Cafe · Coffee shop branding</span>
    <h1 class="cs-title">Kapka<br><span class="accent">Cafe.</span></h1>
    <p class="cs-hero__sub">A complete visual identity for <b>Kapka Cafe</b>: from the mark and mascot, through palette and type, to materials that work on the counter, in the window and across social media.</p>
  </div>

  <div class="cs-scroll" aria-hidden="true"><span>SCROLL</span><i></i></div>
</header>

<!-- ============ META ============ -->
<section class="cs-meta" aria-label="Project data">
  <div class="shell">
    <div class="cs-meta__grid">
      <div class="cs-meta__cell">
        <div class="cs-meta__k">Client</div>
        <div class="cs-meta__v">Kapka Cafe<small>Coffee shop</small></div>
      </div>
      <div class="cs-meta__cell">
        <div class="cs-meta__k">Industry</div>
        <div class="cs-meta__v">Hospitality<small>Coffee &amp; to-go</small></div>
      </div>
      <div class="cs-meta__cell">
        <div class="cs-meta__k">Format</div>
        <div class="cs-meta__v">Branding<small>From scratch</small></div>
      </div>
      <div class="cs-meta__cell">
        <div class="cs-meta__k">Scope</div>
        <div class="cs-meta__v">Full-service<small>Logo · Mascot · Materials</small></div>
      </div>
      <div class="cs-meta__cell">
        <div class="cs-meta__k">Result</div>
        <div class="cs-meta__v">One coherent look<small>Mark · Window · Social</small></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ 01 · ABOUT ============ -->
<section class="cs-sec" data-screen-label="About">
  <div class="shell">
    <div class="cs-intro__grid">
      <div class="reveal">
        <span class="cs-sec__no">ABOUT THE PROJECT</span>
        <h2 class="cs-sec__title">A brand built<br>around a single <span class="accent">drop.</span></h2>
      </div>
      <div class="cs-body reveal" data-d="1">
        <p>Kapka Cafe is a small, intimate coffee shop that needed a brand to match its scale: warm, friendly and recognisable from across the street. We started from the name, <strong>“kapka”</strong>, meaning a drop, and made it the heart of the whole identity.</p>
        <p>From one idea we built a full system: a mark with a to-go cup held by a hand, a coffee-drop mascot with real character, and a consistent palette and type carried across everything, from the menu to the in-store signage.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ LOGO SHOWCASE ============ -->
<section class="cs-sec" style="padding-top:0" aria-label="Logo">
  <div class="shell">
    <span class="cs-sec__no reveal">THE MARK</span>
    <h2 class="cs-sec__title reveal">A logo that instantly<br>says “coffee to go”.</h2>
  </div>
  <div class="cs-row" style="margin-top:clamp(28px,4vh,48px)">
    <figure class="cs-shot cs-shot--wide reveal" data-parallax="20" style="background:#f3e9d6">
      <div class="frame-media cs-shot__media" style="background:#f3e9d6">
        <AssetImage src="/assets/portfolio/kapka/kapka-logo.jpg" alt="Kapka Cafe logo: a brown to-go cup held by a hand next to the Kapka Cafe wordmark" loading="lazy" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, min(1100px, 85vw)" quality={72} style="object-fit:contain" />
      </div>
      <span class="cs-shot__tag">Logo · Primary lockup</span>
    </figure>
  </div>
</section>

<!-- ============ 03 · SYSTEM ============ -->
<section class="cs-sec" data-screen-label="System">
  <div class="shell">
    <span class="cs-sec__no reveal">IDENTITY SYSTEM</span>
    <h2 class="cs-sec__title reveal">From the mark<br>to the whole venue.</h2>

    <div class="cs-steps">
      <div class="cs-step reveal">
        <span class="cs-step__no">B1, 01</span>
        <h3 class="cs-step__title">Mark &amp; wordmark</h3>
        <p class="cs-step__desc">A cup-and-hand symbol plus a soft, hand-drawn “Kapka Cafe” wordmark, legible on the sign, in the app and on the cup.</p>
      </div>
      <div class="cs-step reveal">
        <span class="cs-step__no">B1, 02</span>
        <h3 class="cs-step__title">Drop mascot</h3>
        <p class="cs-step__desc">A smiling coffee drop with a cup and a sandwich, the brand character used across social media, banners and as a window sticker in the venue.</p>
      </div>
      <div class="cs-step reveal">
        <span class="cs-step__no">B1, 03</span>
        <h3 class="cs-step__title">Palette &amp; type</h3>
        <p class="cs-step__desc">Warm roasted-coffee browns, a cream base and a soft, rounded typeface that build a friendly café character and keep everything in one tone.</p>
      </div>
      <div class="cs-step reveal">
        <span class="cs-step__no">B1, 04</span>
        <h3 class="cs-step__title">Materials &amp; venue</h3>
        <p class="cs-step__desc">Menu, Facebook banner, sign, dimensional letters on the counter and stickers, the identity carried onto real guest touchpoints.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ GALLERY ============ -->
<section class="cs-gallery bleed" aria-label="Identity elements">
  <div class="cs-row cs-row--split">
    <figure class="cs-shot cs-shot--tall reveal" data-parallax="24" style="background:#e7dcc6">
      <div class="frame-media cs-shot__media" style="background:#e7dcc6">
        <AssetImage src="/assets/portfolio/kapka/kapka-maskotka.png" alt="Kapka Cafe mascot: a smiling coffee drop holding a to-go cup" loading="lazy" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, min(1100px, 85vw)" quality={72} style="object-fit:contain" />
      </div>
      <span class="cs-shot__tag">Mascot · The drop</span>
    </figure>
    <figure class="cs-shot cs-shot--tall reveal" data-d="1" data-parallax="24">
      <div class="frame-media cs-shot__media">
        <AssetImage src="/assets/portfolio/kapka/kapka-menu.jpg" alt="Kapka Cafe menu with prices for coffees, drinks and extras" loading="lazy" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, min(1100px, 85vw)" quality={72} />
      </div>
      <span class="cs-shot__tag">Materials · Menu</span>
    </figure>
  </div>

  <div class="cs-row">
    <figure class="cs-shot cs-shot--full reveal" data-parallax="30">
      <div class="frame-media cs-shot__media">
        <AssetImage src="/assets/portfolio/kapka/kapka-baner.jpg" alt="Kapka Cafe banner with the drop mascot over roasted coffee beans" loading="lazy" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, min(1100px, 85vw)" quality={72} />
      </div>
      <span class="cs-shot__tag">Social · FB banner</span>
    </figure>
  </div>

  <div class="cs-row cs-row--split">
    <figure class="cs-shot cs-shot--tall reveal" data-parallax="24">
      <div class="frame-media cs-shot__media">
        <AssetImage src="/assets/portfolio/kapka/kapka-lokal.jpg" alt="Kapka Cafe interior: counter with dimensional logo and a mascot sticker on the wall" loading="lazy" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, min(1100px, 85vw)" quality={72} />
      </div>
      <span class="cs-shot__tag">Venue · Counter</span>
    </figure>
    <figure class="cs-shot cs-shot--tall reveal" data-d="1" data-parallax="24">
      <div class="frame-media cs-shot__media">
        <AssetImage src="/assets/portfolio/kapka/kapka-witryna.jpg" alt="Kapka Cafe storefront and sign from the street" loading="lazy" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, min(1100px, 85vw)" quality={72} />
      </div>
      <span class="cs-shot__tag">Venue · Sign</span>
    </figure>
  </div>
</section>

<!-- ============ CLOSING ============ -->
<section class="cs-quote" aria-label="Result">
  <div class="shell cs-sec">
    <div class="cs-quote__inner reveal">
      <blockquote><span class="mark">“</span>One simple idea, a drop, gave Kapka Cafe a mark, a mascot and a coherent language that looks just as good on a cup, in the window and across social media.<span class="mark">”</span></blockquote>
      <div class="cs-quote__by">– <b>SEZMOO team</b> · Branding &amp; identity</div>
    </div>
  </div>
</section>

<!-- ============ NEXT PROJECT ============ -->
<a class="cs-next bleed" href="/en/portfolio-en/" data-cursor="link" aria-label="Back to portfolio">
  <AssetImage src="/assets/portfolio/kapka/kapka-witryna.jpg" alt="Kapka Cafe storefront" loading="lazy" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, min(1100px, 85vw)" quality={72} />
  <div class="cs-next__inner shell">
    <span class="cs-next__k">See more →</span>
    <span class="cs-next__title">Portfolio <span class="arrow">→</span></span>
    <span class="cs-next__cat">All SEZMOO work</span>
  </div>
</a>
</CaseStudyLayout>
