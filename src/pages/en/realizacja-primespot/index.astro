  </div>
</section>

<!-- ============ RESULT ============ -->
<section class="cs-quote" aria-label="Result">
  <div class="shell cs-sec">
    <div class="cs-quote__inner reveal">
      <blockquote><span class="mark">“</span>From a single set of visualisations we built two creative lines and a full set of Meta Ads formats, so Przystań Jurata looks consistent everywhere, from the feed to Stories.<span class="mark">”</span></blockquote>
      <div class="cs-quote__by">– <b>SEZMOO team</b> · Design &amp; campaigns</div>
    </div>
  </div>
</section>

<!-- ============ NEXT PROJECT ============ -->
<a class="cs-next bleed" href="/en/portfolio-en/" data-cursor="link" aria-label="Back to portfolio">
  <img src="/assets/portfolio/primespot/pjur-warm-wide-1.jpg" alt="PrimeSpot Przystań Jurata" />
