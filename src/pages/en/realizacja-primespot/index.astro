---
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';
import { pageUrl } from '../../../lib/site';

const lang = 'en' as const;
const canonical = pageUrl('/en/realizacja-primespot/');
const pageScriptsHtml = "<script type=\"application/json\" class=\"ad-story__data\">[{\"src\":\"/en/assets/portfolio/primespot/pjur-blue-story-1.jpg\",\"alt\":\"PrimeSpot Przystań Jurata – Instagram Stories ad 1\"},{\"src\":\"/en/assets/portfolio/primespot/primespot-przystan-jurata-instagram-stories-01.jpg\",\"alt\":\"PrimeSpot Przystań Jurata – Instagram Stories ad 2\"},{\"src\":\"/en/assets/portfolio/primespot/primespot-przystan-jurata-instagram-stories-02.png\",\"alt\":\"PrimeSpot Przystań Jurata – Instagram Stories ad 3\"},{\"src\":\"/en/assets/portfolio/primespot/primespot-przystan-jurata-instagram-stories-03.png\",\"alt\":\"PrimeSpot Przystań Jurata – Instagram Stories ad 4\"}]</script>\n<script type=\"application/json\" class=\"ad-story__data\">[{\"src\":\"/en/assets/portfolio/primespot/pjur-warm-story-1.jpg\",\"alt\":\"PrimeSpot Przystań Jurata – Instagram Stories ad 5\"},{\"src\":\"/en/assets/portfolio/primespot/primespot-przystan-jurata-instagram-stories-04.png\",\"alt\":\"PrimeSpot Przystań Jurata – Instagram Stories ad 6\"},{\"src\":\"/en/assets/portfolio/primespot/primespot-przystan-jurata-instagram-stories-05.png\",\"alt\":\"PrimeSpot Przystań Jurata – Instagram Stories ad 7\"}]</script>\n<script>/* ad-story player */\n(function(){\n  function initStory(st){\n    var data; try{ data=JSON.parse(st.querySelector('.ad-story__data').textContent);}catch(e){return;}\n    if(!data||!data.length) return;\n    var img=st.querySelector('.ad-story__img'), wrap=st.querySelector('.ad-story__bars'), cap=st.querySelector('.ad-story__cap');\n    var DUR=4200, idx=0, timer=null;\n    data.forEach(function(){ var i=document.createElement('i'); i.appendChild(document.createElement('b')); wrap.appendChild(i); });\n    var bars=[].slice.call(wrap.querySelectorAll('b'));\n    data.forEach(function(d){ var p=new Image(); p.src=d.src; });\n    function show(n){\n      idx=(n+data.length)%data.length;\n      img.src=data[idx].src; img.alt=data[idx].alt||''; if(cap&&data[idx].cap) cap.textContent=data[idx].cap;\n      bars.forEach(function(b,i){ b.style.transition='none'; b.style.width=(i<idx?'100%':'0%'); });\n      void wrap.offsetWidth;\n      var b=bars[idx]; if(b){ b.style.transition='width '+DUR+'ms linear'; b.style.width='100%'; }\n      clearTimeout(timer); timer=setTimeout(function(){ show(idx+1); }, DUR);\n    }\n    var nx=st.querySelector('.ad-story__next'), pv=st.querySelector('.ad-story__prev');\n    nx&&nx.addEventListener('click',function(){ show(idx+1); });\n    pv&&pv.addEventListener('click',function(){ show(idx-1); });\n    show(0);\n  }\n  function boot(){ document.querySelectorAll('.ad-story').forEach(initStory); }\n  if(document.readyState!=='loading') boot(); else document.addEventListener('DOMContentLoaded', boot);\n})();\n</script>\n<script type=\"application/json\" class=\"ad-story__data\">[{\"src\":\"/en/assets/portfolio/primespot/pjur-blue-story-1.jpg\",\"alt\":\"PrimeSpot Przystań Jurata – Instagram Stories ad 1\"},{\"src\":\"/en/assets/portfolio/primespot/primespot-przystan-jurata-instagram-stories-01.jpg\",\"alt\":\"PrimeSpot Przystań Jurata – Instagram Stories ad 2\"},{\"src\":\"/en/assets/portfolio/primespot/primespot-przystan-jurata-instagram-stories-02.png\",\"alt\":\"PrimeSpot Przystań Jurata – Instagram Stories ad 3\"},{\"src\":\"/en/assets/portfolio/primespot/primespot-przystan-jurata-instagram-stories-03.png\",\"alt\":\"PrimeSpot Przystań Jurata – Instagram Stories ad 4\"}]</script>\n<script type=\"application/json\" class=\"ad-story__data\">[{\"src\":\"/en/assets/portfolio/primespot/pjur-warm-story-1.jpg\",\"alt\":\"PrimeSpot Przystań Jurata – Instagram Stories ad 5\"},{\"src\":\"/en/assets/portfolio/primespot/primespot-przystan-jurata-instagram-stories-04.png\",\"alt\":\"PrimeSpot Przystań Jurata – Instagram Stories ad 6\"},{\"src\":\"/en/assets/portfolio/primespot/primespot-przystan-jurata-instagram-stories-05.png\",\"alt\":\"PrimeSpot Przystań Jurata – Instagram Stories ad 7\"}]</script>";
---

<CaseStudyLayout
  lang={lang}
  title="PrimeSpot · Przystań Jurata · Meta Ads | SEZMOO"
  description="SEZMOO case study: a Meta Ads campaign for the premium Przystań Jurata development in Jastarnia. Two creative lines and a full format set: feed, 1:1, Stories 9:16 and 4:5."
  canonical={canonical}
  pageScripts={pageScriptsHtml}
>
<!-- ============ COVER ============ -->
<header class="cs-hero" data-screen-label="Case · Cover">
  <div class="cs-hero__media">
    <img src="/assets/portfolio/primespot/pjur-blue-wide-1.jpg" alt="PrimeSpot Przystań Jurata campaign: evening visualisation of the development" />
  </div>
  <div class="cs-hero__frame" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  <div class="cs-hero__hud">
    <span class="rec">CAMPAIGN · META ADS</span>
    <span>DESIGN · FORMATS</span>
    <span>REAL ESTATE / PL</span>
  </div>

  <div class="cs-hero__inner shell">
    <a class="cs-hero__back" href="/en/portfolio-en/">← Portfolio / Work</a>
    <span class="eyebrow cs-hero__cat"><span class="tick"></span>SEZMOO × PrimeSpot · Real-estate campaign</span>
    <h1 class="cs-title">Przystań<br><span class="accent">Jurata.</span></h1>
    <p class="cs-hero__sub">A Meta Ads campaign for the premium <b>PrimeSpot</b> development in Jastarnia: two creative lines and a full set of ad formats, where a single production works consistently across the feed, Stories and paid ads.</p>
  </div>

  <div class="cs-scroll" aria-hidden="true"><span>SCROLL</span><i></i></div>
</header>

<!-- ============ META ============ -->
<section class="cs-meta" aria-label="Project data">
  <div class="shell">
    <div class="cs-meta__grid">
      <div class="cs-meta__cell">
        <div class="cs-meta__k">Client</div>
        <div class="cs-meta__v">PrimeSpot<small>Developer</small></div>
      </div>
      <div class="cs-meta__cell">
        <div class="cs-meta__k">Industry</div>
        <div class="cs-meta__v">Real estate<small>Seaside premium</small></div>
      </div>
      <div class="cs-meta__cell">
        <div class="cs-meta__k">Format</div>
        <div class="cs-meta__v">Campaign<small>Meta Ads</small></div>
      </div>
      <div class="cs-meta__cell">
        <div class="cs-meta__k">Scope</div>
        <div class="cs-meta__v">Design<small>KV · formats · web</small></div>
      </div>
      <div class="cs-meta__cell">
        <div class="cs-meta__k">Result</div>
        <div class="cs-meta__v">Przystań Jurata<small>Jastarnia</small></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ 01 · ABOUT ============ -->
<section class="cs-sec" data-screen-label="About">
  <div class="shell">
    <div class="cs-intro__grid">
      <div class="reveal">
        <span class="cs-sec__no">ABOUT THE PROJECT</span>
        <h2 class="cs-sec__title">One development,<br>every <span class="accent">format.</span></h2>
      </div>
      <div class="cs-body reveal" data-d="1">
        <p>PrimeSpot is a premium brand on the seaside real-estate market. For the <strong>Przystań Jurata</strong> development in Jastarnia we produced a social-media ad campaign built on architectural visualisations and a calm, elegant brand voice.</p>
        <p>Instead of a single graphic we built a full set of Meta Ads formats and two creative lines, so the same production works consistently on the feed, in the square, in Stories and in mobile ads, leading the viewer to the investment page.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ 02 · CREATIVE LINES ============ -->
<section class="cs-sec" style="padding-top:0" aria-label="Creative lines">
  <div class="shell">
    <span class="cs-sec__no reveal">TWO CREATIVE LINES</span>
    <h2 class="cs-sec__title reveal">Same project,<br>two moods.</h2>
  </div>
  <div class="ad-grid ad-grid--phones reveal" style="margin-top:clamp(28px,4vh,48px)">
    <figure class="ad-phone ad-story reveal">
      
      <div class="ad-phone__screen">
        <img class="ad-story__img" alt="" loading="lazy" />
        <div class="ad-phone__ui">
          <div class="ad-phone__top ad-story__bars"></div>
          <div class="ad-phone__hdr"><span class="ad-phone__av">PS</span><span><span class="ad-phone__name">primespot</span><span class="ad-phone__spon">Sponsored</span></span></div>
          <span class="ad-phone__cta">Learn more</span>
        </div>
        <button class="ad-story__zone ad-story__prev" type="button" aria-label="Previous"></button>
        <button class="ad-story__zone ad-story__next" type="button" aria-label="Next"></button>
      </div>
      <figcaption class="ad-cap">Line 1 · Stories</figcaption>
    </figure>
    <figure class="ad-phone ad-story reveal">
      
      <div class="ad-phone__screen">
        <img class="ad-story__img" alt="" loading="lazy" />
        <div class="ad-phone__ui">
          <div class="ad-phone__top ad-story__bars"></div>
          <div class="ad-phone__hdr"><span class="ad-phone__av">PS</span><span><span class="ad-phone__name">primespot</span><span class="ad-phone__spon">Sponsored</span></span></div>
          <span class="ad-phone__cta">Learn more</span>
        </div>
        <button class="ad-story__zone ad-story__prev" type="button" aria-label="Previous"></button>
        <button class="ad-story__zone ad-story__next" type="button" aria-label="Next"></button>
      </div>
      <figcaption class="ad-cap">Line 2 · Stories</figcaption>
    </figure>
  </div>
  <div class="shell">
    <div class="cs-body reveal" data-d="1" style="max-width:70ch;margin-top:clamp(20px,3vh,34px)">
      <p>The <strong>evening line</strong> plays on elegance and prestige: a cool navy render, a subtle brand neon and headlines around location and the future. The <strong>warm line</strong> is holiday calm, a golden sunset over Jastarnia, timber and an invitation to a place by the sea. Two tones, one consistent identity.</p>
    </div>
  </div>
</section>

<!-- ============ 03 · FORMAT SYSTEM ============ -->
<section class="cs-sec" data-screen-label="Formats">
  <div class="shell">
    <span class="cs-sec__no reveal">FORMAT SYSTEM</span>
    <h2 class="cs-sec__title reveal">One production,<br>every channel.</h2>

    <div class="cs-steps">
      <div class="cs-step reveal">
        <span class="cs-step__no">F, 01</span>
        <h3 class="cs-step__title">Feed 1200 × 628</h3>
        <p class="cs-step__desc">Horizontal link format for Facebook feed ads and Google Ads, with a clear headline and a strong CTA.</p>
      </div>
      <div class="cs-step reveal">
        <span class="cs-step__no">F, 02</span>
        <h3 class="cs-step__title">Square 1200 × 1200</h3>
        <p class="cs-step__desc">A 1:1 format for the Instagram and Facebook feed, with the brand logo, headline and the visualisation.</p>
      </div>
      <div class="cs-step reveal">
        <span class="cs-step__no">F, 03</span>
        <h3 class="cs-step__title">Stories 1080 × 1920</h3>
        <p class="cs-step__desc">A vertical 9:16 format for Stories and Reels, with a full-screen render and the CTA at the bottom of the frame.</p>
      </div>
      <div class="cs-step reveal">
        <span class="cs-step__no">F, 04</span>
        <h3 class="cs-step__title">Mobile 960 × 1200</h3>
        <p class="cs-step__desc">A 4:5 format maximising screen space on the mobile feed, where most of the audience watches.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ GALLERY ============ -->
<section class="cs-gallery bleed" aria-label="Campaign formats">
  <div>
    <figure class="ad-post ad-post--feed reveal">
        <div class="ad-post__head"><span class="ad-post__av">PS</span><span class="ad-post__id"><span class="ad-post__name">primespot</span><span class="ad-post__spon">Sponsored · Meta Ads</span></span><span class="ad-post__more">•••</span></div>
        <div class="ad-post__media"><img src="/assets/portfolio/primespot/pjur-blue-wide-2.jpg" alt="PrimeSpot Przystań Jurata, feed 1200×628" loading="lazy" /></div>
        <div class="ad-post__bar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 20s-7-4.4-9.3-8.5C1 8.6 2.5 5.6 5.4 5.6c1.9 0 3 1 3.6 2 .6-1 1.7-2 3.6-2 2.9 0 4.4 3 2.7 5.9C19 15.6 12 20 12 20z"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 11.5a8 8 0 0 1-11.5 7.2L3 21l2.3-6.5A8 8 0 1 1 21 11.5z"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg><span class="ad-post__cta">Learn more</span></div>
        <figcaption class="ad-cap">Feed · 1200 × 628</figcaption>
      </figure>
  </div>

  <div class="ad-grid ad-grid--2">
    <figure class="ad-post reveal">
        <div class="ad-post__head"><span class="ad-post__av">PS</span><span class="ad-post__id"><span class="ad-post__name">primespot</span><span class="ad-post__spon">Sponsored · Meta Ads</span></span><span class="ad-post__more">•••</span></div>
        <div class="ad-post__media"><img src="/assets/portfolio/primespot/pjur-blue-square-1.jpg" alt="PrimeSpot, 1:1 format" loading="lazy" /></div>
        <div class="ad-post__bar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 20s-7-4.4-9.3-8.5C1 8.6 2.5 5.6 5.4 5.6c1.9 0 3 1 3.6 2 .6-1 1.7-2 3.6-2 2.9 0 4.4 3 2.7 5.9C19 15.6 12 20 12 20z"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 11.5a8 8 0 0 1-11.5 7.2L3 21l2.3-6.5A8 8 0 1 1 21 11.5z"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg><span class="ad-post__cta">Learn more</span></div>
        <figcaption class="ad-cap">Feed · 1:1</figcaption>
      </figure>
    <figure class="ad-post reveal">
        <div class="ad-post__head"><span class="ad-post__av">PS</span><span class="ad-post__id"><span class="ad-post__name">primespot</span><span class="ad-post__spon">Sponsored · Meta Ads</span></span><span class="ad-post__more">•••</span></div>
        <div class="ad-post__media"><img src="/assets/portfolio/primespot/pjur-warm-square-1.jpg" alt="PrimeSpot, by the sea, 1:1 format" loading="lazy" /></div>
        <div class="ad-post__bar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 20s-7-4.4-9.3-8.5C1 8.6 2.5 5.6 5.4 5.6c1.9 0 3 1 3.6 2 .6-1 1.7-2 3.6-2 2.9 0 4.4 3 2.7 5.9C19 15.6 12 20 12 20z"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 11.5a8 8 0 0 1-11.5 7.2L3 21l2.3-6.5A8 8 0 1 1 21 11.5z"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg><span class="ad-post__cta">Learn more</span></div>
        <figcaption class="ad-cap">Feed · 1:1</figcaption>
      </figure>
  </div>

  <div>
    <figure class="ad-post ad-post--feed reveal">
        <div class="ad-post__head"><span class="ad-post__av">PS</span><span class="ad-post__id"><span class="ad-post__name">primespot</span><span class="ad-post__spon">Sponsored · Meta Ads</span></span><span class="ad-post__more">•••</span></div>
        <div class="ad-post__media"><img src="/assets/portfolio/primespot/pjur-warm-wide-1.jpg" alt="PrimeSpot, by the sea, Jastarnia, feed 1200×628" loading="lazy" /></div>
        <div class="ad-post__bar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 20s-7-4.4-9.3-8.5C1 8.6 2.5 5.6 5.4 5.6c1.9 0 3 1 3.6 2 .6-1 1.7-2 3.6-2 2.9 0 4.4 3 2.7 5.9C19 15.6 12 20 12 20z"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 11.5a8 8 0 0 1-11.5 7.2L3 21l2.3-6.5A8 8 0 1 1 21 11.5z"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg><span class="ad-post__cta">Learn more</span></div>
        <figcaption class="ad-cap">Feed · 1200 × 628</figcaption>
      </figure>
  </div>

  <div class="ad-grid ad-grid--2">
    <figure class="ad-post reveal">
        <div class="ad-post__head"><span class="ad-post__av">PS</span><span class="ad-post__id"><span class="ad-post__name">primespot</span><span class="ad-post__spon">Sponsored · Meta Ads</span></span><span class="ad-post__more">•••</span></div>
        <div class="ad-post__media"><img src="/assets/portfolio/primespot/pjur-blue-45-2.jpg" alt="PrimeSpot, mobile 4:5 format" loading="lazy" /></div>
        <div class="ad-post__bar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 20s-7-4.4-9.3-8.5C1 8.6 2.5 5.6 5.4 5.6c1.9 0 3 1 3.6 2 .6-1 1.7-2 3.6-2 2.9 0 4.4 3 2.7 5.9C19 15.6 12 20 12 20z"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 11.5a8 8 0 0 1-11.5 7.2L3 21l2.3-6.5A8 8 0 1 1 21 11.5z"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg><span class="ad-post__cta">Learn more</span></div>
        <figcaption class="ad-cap">Mobile · 4:5</figcaption>
      </figure>
    <figure class="ad-post reveal">
        <div class="ad-post__head"><span class="ad-post__av">PS</span><span class="ad-post__id"><span class="ad-post__name">primespot</span><span class="ad-post__spon">Sponsored · Meta Ads</span></span><span class="ad-post__more">•••</span></div>
        <div class="ad-post__media"><img src="/assets/portfolio/primespot/pjur-warm-45-1.jpg" alt="PrimeSpot, by the sea, mobile 4:5 format" loading="lazy" /></div>
        <div class="ad-post__bar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 20s-7-4.4-9.3-8.5C1 8.6 2.5 5.6 5.4 5.6c1.9 0 3 1 3.6 2 .6-1 1.7-2 3.6-2 2.9 0 4.4 3 2.7 5.9C19 15.6 12 20 12 20z"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 11.5a8 8 0 0 1-11.5 7.2L3 21l2.3-6.5A8 8 0 1 1 21 11.5z"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg><span class="ad-post__cta">Learn more</span></div>
        <figcaption class="ad-cap">Mobile · 4:5</figcaption>
