---
import { caseStudyIdRedirects } from '../../../data/case-studies';
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';
import { pageUrl } from '../../../lib/site';

const lang = 'en' as const;
const canonical = pageUrl('/en/realizacja/');
const idToSlug = Object.fromEntries(caseStudyIdRedirects().map(({ id, slug }) => [id, slug]));
const extraHeadHtml = `<style>
.rz-empty { min-height:70vh; display:grid; place-items:center; text-align:center; padding:0 24px; }
.rz-empty h1 { font-weight:760; font-stretch:106%; font-size:clamp(28px,5vw,52px); line-height:1.02; }
.rz-empty p { color:var(--fg-dim); margin-top:14px; }
.rz-empty a { color:var(--rec); }
</style>`;
/** Compat: legacy /en/realizacja/?v=YOUTUBE_ID → /en/realizacja/{slug}/ */
const pageScriptsHtml = `<script>
(function(){
  var map=${JSON.stringify(idToSlug)};
  var v=new URLSearchParams(location.search).get('v');
  if(v&&map[v]){
    location.replace('/en/realizacja/'+encodeURIComponent(map[v])+'/');
  }
})();
</script>`;
---

<CaseStudyLayout
  lang={lang}
  title="Video case studies for brands | SEZMOO"
  description="SEZMOO video case studies: the context, approach and result behind projects for automotive, B2B and event brands."
  canonical={canonical}
  hreflangPl={pageUrl('/realizacja/')}
  hreflangEn={canonical}
  altHref="/realizacja/"
  extraHead={extraHeadHtml}
  pageScripts={pageScriptsHtml}
>
  <section class="rz-empty">
    <div>
      <h1>Video case studies.</h1>
      <p>
        Pick a project from the <a href="/en/portfolio-en/">portfolio</a> to open its case study.
      </p>
    </div>
  </section>
</CaseStudyLayout>
