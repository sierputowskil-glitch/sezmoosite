 + '</span></div>' +\n          '<div class=\"cs-film__bar\"><i></i></div>' +\n        '</div>' +\n      '</div>' +\n    '</div>' +\n  '</section>' +\n\n  '<a class=\"cs-next bleed\" href=\"/en/realizacja/?v=\" + nextId + '\" data-cursor=\"link\" aria-label=\"Next case study, ' + nx.title + '\">' +\n    '<img src=\"/assets/video/yt/posters/\" + nextId + '.webp\" alt=\"' + nx.title + '\" />' +\n    '<div class=\"cs-next__inner shell\"><span class=\"cs-next__k\">Next case study →</span>' +\n      '<span class=\"cs-next__title\">' + nx.title + ' <span class=\"arrow\">→</span></span>' +\n      '<span class=\"cs-next__cat\">' + nx.cat + '</span></div>' +\n  '</a>' +\n\n  '';\n\n  // film facade -> real embed on click\n  var f = main.querySelector(\".cs-film__frame\");\n  function play() {\n    if (f.querySelector(\"iframe,video\")) return;\n    var s = window.__SEZMOO__;\n    if (s && s.mountYtEmbed) { s.mountYtEmbed(f, v); return; }\n    if (s && s.expectCmp) return;\n    var ifr = document.createElement(\"iframe\");\n    ifr.src = \"https://www.youtube-nocookie.com/embed/\" + v + \"?autoplay=1&rel=0&modestbranding=1&playsinline=1&origin=https://sezmoo.com\";\n    ifr.allow = \"autoplay; fullscreen; picture-in-picture; encrypted-media\";\n    ifr.setAttribute(\"allowfullscreen\", \"\");\n    ifr.style.cssText = \"position:absolute;inset:0;width:100%;height:100%;border:0;z-index:5;\";\n    f.appendChild(ifr);\n  }\n  f.addEventListener(\"click\", play);\n  f.addEventListener(\"keydown\", function (e) { if (e.key === \"Enter\" || e.key === \" \") { e.preventDefault(); play(); } });\n\n  // nudge the (position-based) reveal system to pick up injected nodes\n  window.dispatchEvent(new Event(\"resize\"));\n  window.dispatchEvent(new Event(\"scroll\"));\n})();\n</script>\n<script src=\"/assets/js/flowing-background.js\"></script>\n<script>\n/* Theme switcher (dark / light) */\n(function () {\n  var root = document.documentElement;\n  var opts = [].slice.call(document.querySel