import BaseLayout from './../../layouts/BaseLayout.astro';
const pageHtml = "<section class=\"blog blog--page shell\" id=\"blog\" data-screen-label=\"Blog\">\n    <div class=\"blog-hero\">\n      <div>\n        <span class=\"eyebrow reveal\"><span class=\"tick\"></span>NOTATKI SEZMOO</span>\n        <h1 class=\"blog-hero__title reveal\">Notatki z&nbsp;planu, montażu i&nbsp;feedu.</h1>\n      </div>\n      <p class=\"blog-hero__copy reveal\" data-d=\"1\">Praktyczne wpisy o&nbsp;produkcji wideo, content marketingu, social mediach i&nbsp;stronach, które wspierają sprzedaż.</p>\n    </div>\n\n    <div class=\"blog-topics reveal\">\n      <a href=\"#all\" class=\"is-active\" data-blog-filter=\"all\">Wszystko</a>\n      <a href=\"#production\" data-blog-filter=\"production\">Produkcja</a>\n      <a href=\"#social\" data-blog-filter=\"social\">Social</a>\n      <a href=\"#strategy\" data-blog-filter=\"strategy\">Strategia</a>\n    </div>\n\n    <article class=\"blog-feature reveal\" data-topic=\"strategy\">\n      <div class=\"blog-feature__media\">\n        <div class=\"frame-media\"><img src=\"/assets/blog/przewodnik-po-firmowej-stronie-www.webp\" alt=\"Przewodnik po firmowej stronie WWW, która sprzedaje\" loading=\"eager\" /></div>\n        <span>FEATURED</span>\n      </div>\n      <div class=\"blog-feature__body\">\n        <span class=\"blog-post__meta\">STRATEGIA · 06 MIN · 05.08.2026</span>\n        <h2><a class=\"blog-post__title\" href=\"../przewodnik-po-firmowej-stronie-www/\">Przewodnik po firmowej stronie WWW, która sprzedaje</a></h2>\n        <p>Przewodnik po firmowej stronie WWW: zobacz, jak zaplanować serwis, który buduje zaufanie, wspiera sprzedaż i ułatwia kontakt z marką oraz pozyskuje leady.</p>\n        <a class=\"blog-feature__cta\" href=\"../przewodnik-po-firmowej-stronie-www/\">Czytaj artykuł</a>\n      </div>\n    </article>\n\n    <div class=\"blog-layout\">\n      <div class=\"blog__list\">\n        <article class=\"blog-post reveal\" data-topic=\"strategy\">\n          <span class=\"blog-post__meta\">STRATEGIA · 05 MIN · 03.08.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../ile-trwa-stworzenie-strony-internetowej/\">Ile trwa stworzenie strony internetowej dla firmy?</a></h3>\n          <p>Ile trwa stworzenie strony? Poznaj etapy, realne terminy i decyzje, które przyspieszają wdrożenie bez niepotrzebnych poprawek oraz sprawną publikację.</p>\n          <a class=\"blog-post__more\" href=\"../ile-trwa-stworzenie-strony-internetowej/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-d=\"1\" data-topic=\"production\">\n          <span class=\"blog-post__meta\">PRODUKCJA · 06 MIN · 01.08.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../trendy-w-video-marketingu/\">Trendy w video marketingu, które sprzedają</a></h3>\n          <p>Trendy w video marketingu, które pomagają markom przyciągać uwagę, budować zaufanie i zamieniać oglądalność w konkretne wyniki sprzedażowe firm B2B.</p>\n          <a class=\"blog-post__more\" href=\"../trendy-w-video-marketingu/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-d=\"2\" data-topic=\"strategy\">\n          <span class=\"blog-post__meta\">STRATEGIA · 06 MIN · 30.07.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../jak-zaplanowac-firmowy-landing-page/\">Jak zaplanować firmowy landing page, który sprzedaje</a></h3>\n          <p>Sprawdź, jak zaplanować firmowy landing page, który prowadzi odbiorcę do działania, wspiera kampanię i dostarcza zespołowi wartościowe leady szybciej.</p>\n          <a class=\"blog-post__more\" href=\"../jak-zaplanowac-firmowy-landing-page/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-topic=\"strategy\">\n          <span class=\"blog-post__meta\">STRATEGIA · 06 MIN · 28.07.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../pomysly-na-content-b2b/\">Pomysły na content B2B, które wspierają sprzedaż</a></h3>\n          <p>Pomysły na content B2B, które budują zaufanie, skracają drogę do rozmowy handlowej i dają zespołowi sprzedaży konkretne materiały do pracy każdego dnia.</p>\n          <a class=\"blog-post__more\" href=\"../pomysly-na-content-b2b/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-d=\"1\" data-topic=\"social\">\n          <span class=\"blog-post__meta\">SOCIAL · 06 MIN · 26.07.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../plan-contentu-na-instagram/\">Plan contentu na Instagram, który wspiera sprzedaż</a></h3>\n          <p>Plan contentu na Instagram pomaga firmie publikować regularnie, budować rozpoznawalność i zamieniać uwagę odbiorców w konkretne zapytania sprzedażowe.</p>\n          <a class=\"blog-post__more\" href=\"../plan-contentu-na-instagram/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-d=\"2\" data-topic=\"strategy\">\n          <span class=\"blog-post__meta\">STRATEGIA · 06 MIN · 24.07.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../jak-mierzyc-skutecznosc-kampanii-reklamowej/\">Jak mierzyć skuteczność kampanii reklamowej?</a></h3>\n          <p>Sprawdź, jak mierzyć skuteczność kampanii reklamowej: dobieraj KPI, analizuj koszt pozyskania i podejmuj decyzje, które realnie zwiększają sprzedaż firmy.</p>\n          <a class=\"blog-post__more\" href=\"../jak-mierzyc-skutecznosc-kampanii-reklamowej/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-topic=\"strategy\">\n          <span class=\"blog-post__meta\">STRATEGIA · 06 MIN · 22.07.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../materialy-reklamowe-dla-firmy/\">Materiały reklamowe dla firmy, które sprzedają</a></h3>\n          <p>Materiały reklamowe dla firmy, które wspierają sprzedaż: od strategii i projektu po produkcję. Sprawdź, jak wybierać formaty z mierzalnym efektem na rynku</p>\n          <a class=\"blog-post__more\" href=\"../materialy-reklamowe-dla-firmy/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-d=\"1\" data-topic=\"strategy\">\n          <span class=\"blog-post__meta\">STRATEGIA · 06 MIN · 20.07.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../przyklad-landing-page-zwiekszajacego-leady/\">Przykład landing page zwiększającego leady</a></h3>\n          <p>Zobacz przykład landing page zwiększającego leady i sprawdź, które elementy strony realnie obniżają koszt pozyskania kontaktu sprzedażowego dla B2B firm.</p>\n          <a class=\"blog-post__more\" href=\"../przyklad-landing-page-zwiekszajacego-leady/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-d=\"2\" data-topic=\"production\">\n          <span class=\"blog-post__meta\">PRODUKCJA · 05 MIN · 18.07.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../animacja-3d-do-reklamy/\">Animacja 3D do reklamy, która sprzedaje</a></h3>\n          <p>Animacja 3D do reklamy pokazuje produkt, wyjaśnia jego wartość i zatrzymuje uwagę. Zobacz, kiedy działa i jak dobrze zaplanować produkcję dla Twojej marki.</p>\n          <a class=\"blog-post__more\" href=\"../animacja-3d-do-reklamy/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-topic=\"production\">\n          <span class=\"blog-post__meta\">PRODUKCJA · 05 MIN · 16.07.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../przyszlosc-contentu-wideo-w-sprzedazy-b2b/\">Przyszłość contentu wideo w sprzedaży B2B</a></h3>\n          <p>Przyszłość contentu wideo w sprzedaży to krótszy proces decyzyjny, większe zaufanie i materiały, które realnie wspierają zespół handlowy w B2B i e-commerce</p>\n          <a class=\"blog-post__more\" href=\"../przyszlosc-contentu-wideo-w-sprzedazy-b2b/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-d=\"1\" data-topic=\"strategy\">\n          <span class=\"blog-post__meta\">STRATEGIA · 05 MIN · 14.07.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../kampanie-reklamowe-dla-firm/\">Kampanie reklamowe dla firm, które sprzedają</a></h3>\n          <p>Skuteczne kampanie reklamowe dla firm łączą strategię, kreację i sprawną realizację. Zobacz, jak planować działania, które realnie wspierają sprzedaż.</p>\n          <a class=\"blog-post__more\" href=\"../kampanie-reklamowe-dla-firm/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-d=\"2\" data-topic=\"production\">\n          <span class=\"blog-post__meta\">PRODUKCJA · 06 MIN · 12.07.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../jak-przygotowac-firme-do-sesji-wizerunkowej/\">Jak przygotować firmę do sesji wizerunkowej</a></h3>\n          <p>Sprawdź, jak przygotować firmę do sesji wizerunkowej, aby zdjęcia wspierały sprzedaż, rekrutację i spójny, profesjonalny obraz marki na każdym etapie.</p>\n          <a class=\"blog-post__more\" href=\"../jak-przygotowac-firme-do-sesji-wizerunkowej/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-topic=\"social\">\n          <span class=\"blog-post__meta\">SOCIAL · 06 MIN · 10.07.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../najlepsze-formaty-reklam-w-social-media/\">Najlepsze formaty reklam w social media</a></h3>\n          <p>Najlepsze formaty reklam w social media nie zawsze są oczywiste. Sprawdź, które kreacje realnie wspierają sprzedaż, zasięg i leady.</p>\n          <a class=\"blog-post__more\" href=\"../najlepsze-formaty-reklam-w-social-media/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-d=\"1\" data-topic=\"production\">\n          <span class=\"blog-post__meta\">PRODUKCJA · 06 MIN · 08.07.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../fotografia-reklamowa-produktow-ktora-sprzedaje/\">Fotografia reklamowa produktów, która sprzedaje</a></h3>\n          <p>Fotografia reklamowa produktów wpływa na sprzedaż, wizerunek i skuteczność kampanii. Sprawdź, co decyduje o efekcie i kiedy warto zlecić ją agencji.</p>\n          <a class=\"blog-post__more\" href=\"../fotografia-reklamowa-produktow-ktora-sprzedaje/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-d=\"2\" data-topic=\"strategy\">\n          <span class=\"blog-post__meta\">STRATEGIA · 07 MIN · 06.07.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../strona-one-page-dla-firmy-kiedy-ma-sens/\">Strona one page dla firmy – kiedy ma sens?</a></h3>\n          <p>Strona one page dla firmy może sprzedawać skutecznie, jeśli pasuje do celu i modelu biznesu. Sprawdź, kiedy warto ją wdrożyć.</p>\n          <a class=\"blog-post__more\" href=\"../strona-one-page-dla-firmy-kiedy-ma-sens/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-topic=\"production\">\n          <span class=\"blog-post__meta\">PRODUKCJA · 06 MIN · 04.07.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../fotografia-produktowa-do-e-commerce/\">Fotografia produktowa do e commerce działa</a></h3>\n          <p>Fotografia produktowa do e commerce realnie wpływa na sprzedaż. Sprawdź, jak planować zdjęcia, które zwiększają konwersję i zwroty.</p>\n          <a class=\"blog-post__more\" href=\"../fotografia-produktowa-do-e-commerce/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-d=\"1\" data-topic=\"production\">\n          <span class=\"blog-post__meta\">PRODUKCJA · 06 MIN · 02.07.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../sesja-biznesowa-cennik-co-wplywa-na-koszt/\">Sesja biznesowa cennik – co wpływa na koszt</a></h3>\n          <p>Sesja biznesowa cennik zależy od celu, zakresu i wdrożenia. Sprawdź, co realnie wpływa na koszt zdjęć dla firmy i jak wybrać pakiet.</p>\n          <a class=\"blog-post__more\" href=\"../sesja-biznesowa-cennik-co-wplywa-na-koszt/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-d=\"2\" data-topic=\"social\">\n          <span class=\"blog-post__meta\">SOCIAL · 07 MIN · 30.06.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../kampanie-paid-social-ktore-sprzedaja/\">Kampanie paid social, które sprzedają</a></h3>\n          <p>Kampanie paid social pomagają szybciej docierać do klientów, testować kreacje i zwiększać sprzedaż. Sprawdź, co działa naprawdę.</p>\n          <a class=\"blog-post__more\" href=\"../kampanie-paid-social-ktore-sprzedaja/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-topic=\"production\">\n          <span class=\"blog-post__meta\">PRODUKCJA · 06 MIN · 28.06.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../wideo-produktowe-ecommerce-ktore-sprzedaje/\">Wideo produktowe ecommerce, które sprzedaje</a></h3>\n          <p>Wideo produktowe ecommerce zwiększa sprzedaż, buduje zaufanie i skraca decyzję zakupową. Sprawdź, jak tworzyć materiały, które działają.</p>\n          <a class=\"blog-post__more\" href=\"../wideo-produktowe-ecommerce-ktore-sprzedaje/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-d=\"1\" data-topic=\"production\">\n          <span class=\"blog-post__meta\">PRODUKCJA · 06 MIN · 26.06.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../fotografia-biznesowa-dla-firm/\">Fotografia biznesowa dla firm, która sprzedaje</a></h3>\n          <p>Fotografia biznesowa dla firm wzmacnia wizerunek, rekrutację i sprzedaż. Sprawdź, jak zaplanować zdjęcia, które realnie pracują na markę.</p>\n          <a class=\"blog-post__more\" href=\"../fotografia-biznesowa-dla-firm/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-d=\"2\" data-topic=\"strategy\">\n          <span class=\"blog-post__meta\">STRATEGIA · 06 MIN · 24.06.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../marketing-outsourcing-kiedy-sie-oplaca/\">Marketing outsourcing – kiedy to się opłaca</a></h3>\n          <p>Marketing outsourcing pomaga firmom rosnąć bez budowy dużego zespołu. Sprawdź, kiedy się opłaca, co zyskujesz i na co uważać.</p>\n          <a class=\"blog-post__more\" href=\"../marketing-outsourcing-kiedy-sie-oplaca/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-topic=\"production\">\n          <span class=\"blog-post__meta\">PRODUKCJA · 07 MIN · 22.06.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../sesja-wizerunkowa-firmy/\">Sesja wizerunkowa firmy, która pracuje na markę</a></h3>\n          <p>Sesja wizerunkowa firmy buduje zaufanie, porządkuje komunikację i daje gotowe materiały do sprzedaży, rekrutacji i social mediów.</p>\n          <a class=\"blog-post__more\" href=\"../sesja-wizerunkowa-firmy/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-d=\"1\" data-topic=\"production\">\n          <span class=\"blog-post__meta\">PRODUKCJA · 06 MIN · 20.06.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../ile-kosztuje-film-produktowy/\">Ile kosztuje film produktowy w 2026 roku?</a></h3>\n          <p>Ile kosztuje film produktowy? Sprawdź, od czego zależy wycena, jakie są widełki cenowe i za co realnie płacisz przy produkcji wideo.</p>\n          <a class=\"blog-post__more\" href=\"../ile-kosztuje-film-produktowy/\">Czytaj dalej</a>\n        </article>\n        <article class=\"blog-post reveal\" data-d=\"2\" data-topic=\"strategy\">\n          <span class=\"blog-post__meta\">STRATEGIA · 06 MIN · 18.06.2026</span>\n          <h3><a class=\"blog-post__title\" href=\"../kampanie-google-ads-dla-b2b-jak-je-ustawic/\">Kampanie Google Ads dla B2B – jak je ustawić</a></h3>\n          <p>Kampanie Google Ads dla B2B wymagają innego podejścia niż e-commerce. Sprawdź, jak planować lejki, s