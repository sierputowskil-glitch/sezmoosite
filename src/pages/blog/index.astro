---
import AssetImage from '../../components/AssetImage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  blogMetaLine,
  blogPath,
  getPublishedBlogPosts,
  type BlogPost,
} from '../../lib/blog';
import { itemListJsonLd } from '../../lib/schema';
import { pageUrl } from '../../lib/site';

const canonical = pageUrl('/blog/');
const posts = await getPublishedBlogPosts('pl');
const featured = posts.find((p) => p.data.featured) || posts[0];
const rest = featured ? posts.filter((p) => p.id !== featured.id) : posts;
const description =
  'Blog SEZMOO: praktyczne notatki o produkcji wideo, contentu na social media i marketingu marek, z planu, montażu i feedu.';

const jsonLd = itemListJsonLd({
  name: 'Blog SEZMOO',
  description,
  canonical,
  lang: 'pl',
  items: posts.map((post) => ({
    name: post.data.title,
    url: pageUrl(blogPath(post)),
  })),
});

function delayAttr(i: number): string | undefined {
  const d = i % 3;
  return d === 0 ? undefined : String(d);
}

const pageScripts = `<script>
(function () {
  var filters = [].slice.call(document.querySelectorAll('[data-blog-filter]'));
  var items = [].slice.call(document.querySelectorAll('[data-topic]'));
  function apply(key) {
    filters.forEach(function (a) {
      a.classList.toggle('is-active', a.getAttribute('data-blog-filter') === key);
    });
    items.forEach(function (el) {
      var show = key === 'all' || el.getAttribute('data-topic') === key;
      el.hidden = !show;
    });
  }
  filters.forEach(function (a) {
    a.addEventListener('click', function (e) {
      e.preventDefault();
      apply(a.getAttribute('data-blog-filter'));
    });
  });
})();
</script>`;
---

<BaseLayout
  lang="pl"
  title="Blog, produkcja wideo, content i marketing marek | SEZMOO"
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  pageScripts={pageScripts}
>
  <section class="blog blog--page shell" id="blog" data-screen-label="Blog">
    <div class="blog-hero">
      <div>
        <span class="eyebrow reveal"><span class="tick"></span>NOTATKI SEZMOO</span>
        <h1 class="blog-hero__title reveal">Notatki z&nbsp;planu, montażu i&nbsp;feedu.</h1>
      </div>
      <p class="blog-hero__copy reveal" data-d="1">
        Praktyczne wpisy o&nbsp;produkcji wideo, content marketingu, social mediach i&nbsp;stronach, które
        wspierają sprzedaż.
      </p>
    </div>

    <div class="blog-topics reveal">
      <a href="#all" class="is-active" data-blog-filter="all">Wszystko</a>
      <a href="#production" data-blog-filter="production">Produkcja</a>
      <a href="#social" data-blog-filter="social">Social</a>
      <a href="#strategy" data-blog-filter="strategy">Strategia</a>
    </div>

    {
      featured && (
        <article class="blog-feature reveal" data-topic={featured.data.topic}>
          <div class="blog-feature__media">
            <div class="frame-media">
              {featured.data.heroImage ? (
                <AssetImage
                  src={featured.data.heroImage}
                  alt={featured.data.heroAlt || featured.data.title}
                  loading="eager"
                  fetchpriority="high"
                  widths={[640, 960, 1200, 1600]}
                  sizes="(max-width: 1050px) 100vw, 48vw"
                  quality={78}
                />
              ) : null}
            </div>
            <span>FEATURED</span>
          </div>
          <div class="blog-feature__body">
            <span class="blog-post__meta">{blogMetaLine(featured)}</span>
            <h2>
              <a class="blog-post__title" href={blogPath(featured)}>
                {featured.data.title}
              </a>
            </h2>
            <p>{featured.data.description}</p>
            <a class="blog-feature__cta" href={blogPath(featured)}>
              Czytaj artykuł
            </a>
          </div>
        </article>
      )
    }

    <div class="blog-layout">
      <div class="blog__list">
        {
          rest.map((post: BlogPost, i: number) => {
            const d = delayAttr(i);
            return (
              <article
                class="blog-post reveal"
                data-topic={post.data.topic}
                {...(d ? { 'data-d': d } : {})}
              >
                <span class="blog-post__meta">{blogMetaLine(post)}</span>
                <h3>
                  <a class="blog-post__title" href={blogPath(post)}>
                    {post.data.title}
                  </a>
                </h3>
                <p>{post.data.description}</p>
                <a class="blog-post__more" href={blogPath(post)}>
                  Czytaj dalej
                </a>
              </article>
            );
          })
        }
      </div>

      <aside class="blog-side reveal" data-d="1">
        <span class="blog-side__label">Tematy</span>
        <a href="#production" data-blog-filter="production">Produkcja wideo</a>
        <a href="#social" data-blog-filter="social">Social / Reels / LinkedIn</a>
        <a href="#strategy" data-blog-filter="strategy">Strategia i strony</a>
        <a href="/#kontakt">Zaproponuj temat</a>
      </aside>
    </div>
  </section>
</BaseLayout>
