---
import CaseStudyPage from '../../../components/case-study/CaseStudyPage.astro';
import {
  caseStudyHref,
  caseStudyPaths,
  cdnVideoContentUrl,
  posterPath,
  type CaseStudy,
} from '../../../data/case-studies';
import CaseStudyLayout from '../../../layouts/CaseStudyLayout.astro';
import { videoObjectJsonLd } from '../../../lib/schema';
import { pageUrl } from '../../../lib/site';

export function getStaticPaths() {
  return caseStudyPaths('pl');
}

interface Props {
  study: CaseStudy;
  lang: 'pl';
}

const { study } = Astro.props;
const lang = 'pl' as const;
const id = study.videoId;
const copy = study.pl;
const canonical = pageUrl(caseStudyHref(study, lang));
const hreflangPl = canonical;
const hreflangEn = pageUrl(caseStudyHref(study, 'en'));
const thumb = pageUrl(posterPath(id));

const title = `${copy.title} · realizacja wideo | SEZMOO`;
const description = copy.lead;

const jsonLd = videoObjectJsonLd({
  name: copy.title,
  description: copy.lead || '',
  thumbnailUrl: thumb,
  contentUrl: cdnVideoContentUrl(id),
  lang,
});

const extraHeadHtml = `<link rel="preload" as="image" type="image/webp" href="${posterPath(id)}" fetchpriority="high" />`;

---

<CaseStudyLayout
  lang={lang}
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  jsonLd={jsonLd}
  hreflangPl={hreflangPl}
  hreflangEn={hreflangEn}
  altHref={caseStudyHref(study, 'en')}
  extraHead={extraHeadHtml}
>
  <CaseStudyPage lang={lang} study={study} />
</CaseStudyLayout>
