---
import { caseStudyIdRedirects } from '../../data/case-studies';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import { pageUrl } from '../../lib/site';

const lang = 'pl' as const;
const canonical = pageUrl('/realizacja/');
const idToSlug = Object.fromEntries(caseStudyIdRedirects().map(({ id, slug }) => [id, slug]));
const extraHeadHtml = `<style>
.rz-empty { min-height:70vh; display:grid; place-items:center; text-align:center; padding:0 24px; }
.rz-empty h1 { font-weight:760; font-stretch:106%; font-size:clamp(28px,5vw,52px); line-height:1.02; }
.rz-empty p { color:var(--fg-dim); margin-top:14px; }
.rz-empty a { color:var(--rec); }
</style>`;
/** Compat: legacy /realizacja/?v=YOUTUBE_ID → /realizacja/{slug}/ */
const pageScriptsHtml = `<script>
(function(){
  var map=${JSON.stringify(idToSlug)};
  var v=new URLSearchParams(location.search).get('v');
  if(v&&map[v]){
    location.replace('/realizacja/'+encodeURIComponent(map[v])+'/');
  }
})();
</script>`;
---

<CaseStudyLayout
  lang={lang}
  title="Realizacje wideo, case studies marek | SEZMOO"
  description="Case studies realizacji wideo SEZMOO: kontekst, podejście i efekt projektów dla marek motoryzacyjnych, B2B i eventowych."
  canonical={canonical}
  hreflangPl={canonical}
  hreflangEn={pageUrl('/en/realizacja/')}
  altHref="/en/realizacja/"
  extraHead={extraHeadHtml}
  pageScripts={pageScriptsHtml}
>
  <section class="rz-empty">
    <div>
      <h1>Realizacje wideo.</h1>
      <p>
        Wybierz projekt z <a href="/portfolio/#work-list">portfolio</a>, żeby otworzyć case study.
      </p>
    </div>
  </section>
</CaseStudyLayout>
