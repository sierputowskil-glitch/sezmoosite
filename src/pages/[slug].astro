---
import { getCollection, render } from 'astro:content';
import BlogArticle from '../components/blog/BlogArticle.astro';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { blogMetaLine } from '../lib/blog';
import { pageUrl } from '../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const path = `/${post.id}/`;
const canonical = pageUrl(path);
const title = post.data.title.includes('SEZMOO')
  ? post.data.title
  : `${post.data.title} | SEZMOO`;
---

<ArticleLayout
  lang={post.data.lang}
  title={title}
  description={post.data.description}
  canonical={canonical}
  ogTitle={post.data.ogTitle || title}
  ogDescription={post.data.ogDescription || post.data.description}
>
  <BlogArticle
    title={post.data.title}
    metaLine={blogMetaLine(post)}
    lead={post.data.lead}
    heroImage={post.data.heroImage}
    heroAlt={post.data.heroAlt}
    heroCaption={post.data.heroCaption}
  >
    <Content />
  </BlogArticle>
</ArticleLayout>
