---
import AssetImage from '../../components/AssetImage.astro';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import { itemListJsonLd } from '../../lib/schema';
import { pageUrl } from '../../lib/site';

const lang = 'pl' as const;
const canonical = pageUrl('/portfolio/');
const description =
  'Portfolio SEZMOO: realizacje wideo i foto, materiały na social media, animacje 3D/2D oraz relacje z eventów. Zobacz projekty dla marek motoryzacyjnych, B2B i eventowych.';

const jsonLd = itemListJsonLd({
  name: 'Portfolio SEZMOO',
  description,
  canonical,
  lang,
  items: [
    { name: 'EXLANTIX', url: pageUrl('/realizacja-exlantix/') },
    { name: 'Audi RS5', url: pageUrl('/realizacja/audi-rs5-trailer/') },
    { name: 'PrimeSpot', url: pageUrl('/realizacja-primespot/') },
    { name: 'Baltic Towers · Rekrutacja', url: pageUrl('/realizacja-baltic-towers-rekrutacja/') },
    { name: 'DORACO × TVP', url: pageUrl('/realizacja-doraco-hala-tvp/') },
    { name: 'Hodowla Ryb K2', url: pageUrl('/realizacja-k2/') },
    { name: 'Soho Form', url: pageUrl('/realizacja-soho-form/') },
    { name: 'Kapka Cafe', url: pageUrl('/realizacja-kapka/') },
    { name: 'DENZA', url: pageUrl('/realizacja-denza/') },
    { name: 'World of Warships', url: pageUrl('/realizacja-world-of-warships/') },
  ],
});
---

<PortfolioLayout
  lang={lang}
  title="Portfolio, realizacje wideo, social, animacje i eventy | SEZMOO"
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
>
<section class="pt-hero">
  <div class="pt-hero__top">
    <div>
      <span class="eyebrow"><span class="tick"></span>Portfolio · Realizacje wideo i content</span>
      <h1>Zobacz nasze<br><em>realizacje</em>.</h1>
    </div>
  </div>
</section>

<div class="pt-shell">
  <aside class="pt-side">
    <span class="pt-side__label">Kategorie</span>
    <div class="pt-side__list" id="pt-filters">
      <button class="pt-navlink is-on" type="button" data-filter="all">Wszystko <span class="n">{'{'}51{'}'}</span></button>
      <button class="pt-navlink" type="button" data-filter="video">Wideo <span class="n">{'{'}23{'}'}</span></button>
      <button class="pt-navlink" type="button" data-filter="eventy">Eventy <span class="n">{'{'}03{'}'}</span></button>
      <button class="pt-navlink" type="button" data-filter="foto">Fotografia <span class="n">{'{'}12{'}'}</span></button>
      <button class="pt-navlink" type="button" data-filter="animacje">Animacje <span class="n">{'{'}03{'}'}</span></button>
      <button class="pt-navlink" type="button" data-filter="grafika">Grafika <span class="n">{'{'}11{'}'}</span></button>
