---
import AssetImage from '../../components/AssetImage.astro';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import { pageUrl } from '../../lib/site';

const lang = 'pl' as const;
const canonical = pageUrl('/portfolio/');
const extraHeadHtml = "<style>\n/* ============================================================\n   PORTFOLIO – BIG TILES (proposal, page-scoped)\n   Large media, small category caption, staggered grid\n   ============================================================ */\n.pt-hero { max-width:var(--maxw); margin-inline:auto; padding: clamp(120px,16vh,190px) var(--shell-pad) clamp(24px,4vh,44px); }\n.pt-hero__top { display:flex; align-items:flex-end; justify-content:space-between; gap:32px; flex-wrap:wrap; }\n.pt-hero h1 { font-weight:780; font-stretch:110%; letter-spacing:-.02em; line-height:.92;\n  font-size:clamp(46px,9vw,132px); margin:clamp(14px,2vh,22px) 0 0; }\n.pt-hero h1 em { font-style:normal; color:var(--rec); }\n.pt-hero__lead { max-width:40ch; color:var(--fg-dim); font-size:clamp(15px,1.1vw,17px); line-height:1.55; }\n.pt-hero__lead b { color:var(--fg); font-weight:640; }\n\n/* ---- shell: sticky sidebar + masonry grid ---- */\n.pt-shell { display:grid; grid-template-columns:clamp(190px,17vw,270px) 1fr; align-items:start;\n  gap:clamp(28px,3.4vw,64px); max-width:var(--maxw); margin-inline:auto;\n  padding:clamp(30px,4.5vh,54px) var(--shell-pad) clamp(50px,9vh,110px); }\n.pt-side { position:sticky; top:clamp(90px,12vh,116px); }\n.pt-side__label { font-family:var(--font-mono); font-size:11px; letter-spacing:.24em; text-transform:uppercase;\n  color:var(--fg-faint); display:block; padding-bottom:16px; margin-bottom:14px; border-bottom:1px solid var(--line); }\n.pt-side__list { display:flex; flex-direction:column; }\n.pt-navlink { display:flex; align-items:flex-start; gap:6px; text-align:left; background:none; border:0; cursor:pointer;\n  font-family:var(--font-display); font-weight:770; font-stretch:106%; text-transform:uppercase; letter-spacing:-.01em;\n  font-size:clamp(20px,1.6vw,30px); line-height:1.34; color:var(--fg-faint);\n  transition:color .3s var(--ease), transform .35s var(--ease); }\n.pt-navlink .n { font-family:var(--font-mono); font-weight:400; font-size:.42em; letter-spacing:.04em;\n  color:var(--fg-faint); opacity:.75; transform:translateY(.2em); }\n.pt-navlink:hover { color:var(--fg); transform:translateX(4px); }\n.pt-navlink.is-on { color:var(--rec); }\n.pt-navlink.is-on .n { color:var(--rec); opacity:.85; }\n\n/* ---- grid (true masonry, tightly packed) ---- */\n.pt-grid { columns:2; column-gap:clamp(16px,1.8vw,30px); }\n\n.pt-tile { display:block; break-inside:avoid; margin:0 0 clamp(24px,2.4vw,42px); will-change:transform; transform:perspective(1200px); text-align:left; color:inherit; font:inherit; background:none; border:0; padding:0;\n  cursor:pointer; width:100%; }\n.pt-tile.is-hide { display:none; }\n/* podpisy NAD zdjęciem */\n.pt-tile { display:flex; flex-direction:column; }\n.pt-tile .pt-cap { order:1; }\n.pt-tile .pt-title { order:2; }\n.pt-tile .pt-media { order:3; }\n.pt-media { position:relative; overflow:hidden; border-radius:10px; background:var(--bg-3);\n  border:1px solid var(--line-soft); aspect-ratio:4/3; contain:layout paint; transform:translateZ(0); }\n.pt-tile[data-ratio=\"portrait\"] .pt-media { aspect-ratio:3/4; }\n.pt-tile[data-ratio=\"wide\"] .pt-media { aspect-ratio:16/10; }\n.pt-tile[data-ratio=\"square\"] .pt-media { aspect-ratio:1/1; }\n.pt-media img { width:100%; height:100%; object-fit:cover; transition:transform .8s var(--ease), filter .5s var(--ease); }\n.pt-media iframe { position:absolute; inset:0; width:100%; height:100%; border:0; z-index:2; pointer-events:none;\n  transform:scale(1.32); } /* zoom to hide YT chrome */\n.pt-tile:hover .pt-media img { transform:scale(1.05); }\n/* corner ticks + play badge, cosmos-ish */\n.pt-media__badge { position:absolute; left:14px; top:14px; z-index:3; display:inline-flex; align-items:center; gap:7px;\n  font-family:var(--font-mono); font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:var(--fg);\n  background:oklch(0.1 0.004 60 / .55); -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px);\n  border:1px solid var(--line-soft); border-radius:100px; padding:6px 11px; }\n.pt-media__badge .d { width:6px; height:6px; border-radius:50%; background:var(--rec); }\n.pt-media__open { position:absolute; right:14px; bottom:14px; z-index:3; width:46px; height:46px; border-radius:50%;\n  display:grid; place-items:center; background:var(--rec); color:var(--on-accent); font-size:17px; line-height:1;\n  opacity:0; transform:translateY(8px) scale(.9); transition:opacity .4s var(--ease), transform .4s var(--ease); }\n.pt-tile:hover .pt-media__open { opacity:1; transform:none; }\n\n/* caption */\n.pt-cap { display:flex; align-items:baseline; justify-content:space-between; gap:16px;\n  margin:0 2px 6px; }\n.pt-cap__tags { font-family:var(--font-mono); font-size:clamp(12.5px,1vw,15px); letter-spacing:.05em;\n  color:var(--fg-dim); }\n.pt-cap__year { font-family:var(--font-mono); font-size:clamp(12.5px,1vw,15px); letter-spacing:.05em;\n  color:var(--fg-faint); flex:0 0 auto; }\n.pt-title { margin:0 2px clamp(10px,1vw,16px); font-weight:720; font-stretch:104%; letter-spacing:-.015em; line-height:1;\n  font-size:clamp(26px,3vw,44px); transition:color .35s var(--ease); }\n.pt-tile:hover .pt-title { color:var(--rec); }\n@media (prefers-reduced-motion:reduce){ .pt-tile { transform:none !important; } }\n\n/* compact grafika/foto */\n.pt-tile[data-cats=\"grafika\"] .pt-media, .pt-tile[data-cats=\"foto\"] .pt-media { aspect-ratio:4/3; background:var(--bg-2); }\n.pt-tile[data-cats=\"grafika\"] .pt-media img { object-fit:contain; }\n\n@media (max-width:900px){\n  .pt-shell { grid-template-columns:1fr; gap:22px; }\n  .pt-side { position:static; }\n  .pt-side__label { display:none; }\n  .pt-side__list { flex-direction:row; flex-wrap:wrap; gap:8px; padding-bottom:14px;\n    border-bottom:1px solid var(--line); }\n  .pt-navlink { flex:0 0 auto; font-size:13px; letter-spacing:.08em; line-height:1; white-space:nowrap;\n    border:1px solid var(--line); border-radius:100px; padding:9px 14px; }\n  .pt-navlink .n { font-size:11px; transform:none; margin-left:2px; }\n  .pt-navlink:hover { transform:none; }\n  .pt-navlink.is-on { color:var(--on-accent); background:var(--rec); border-color:var(--rec); }\n  .pt-navlink.is-on .n { color:var(--on-accent); }\n}\n@media (max-width:760px){\n  .pt-grid { columns:1; }\n  .pt-tile[data-ratio=\"portrait\"] .pt-media { aspect-ratio:4/5; }\n}\n.portfolio-page { overflow-x:clip; width:100%; }\n@media (max-width:600px){\n  .pt-hero { padding:116px 20px 6px; }\n  .pt-hero h1 { font-size:clamp(30px,9.2vw,46px); line-height:.98; }\n  .pt-hero__top { gap:14px; }\n  .pt-hero__lead { font-size:14px; }\n  .pt-shell { padding:20px 20px 60px; gap:18px; }\n  .pt-grid { columns:1; }\n  .pt-tile { margin-bottom:20px; }\n  .pt-tile[data-ratio=\"portrait\"] .pt-media { aspect-ratio:4/5; }\n  .pt-title { font-size:26px; }\n}\n\n/* video modal */\n.pt-vlb { position:fixed; inset:0; z-index:9999; display:flex; align-items:center; justify-content:center;\n  padding:clamp(18px,5vw,70px); background:oklch(0.06 0.004 60 / .9); backdrop-filter:blur(8px); }\n.pt-vlb[hidden] { display:none; }\n.pt-vlb__frame { position:relative; width:min(1100px,100%); aspect-ratio:16/9; }\n.pt-vlb__frame.is-short { width:auto; height:min(86vh,760px); aspect-ratio:9/16; }\n.pt-vlb__frame iframe { position:absolute; inset:0; width:100%; height:100%; border:0; border-radius:6px;\n  box-shadow:0 30px 80px rgba(0,0,0,.55); }\n.pt-vlb__close { position:absolute; top:18px; right:22px; width:44px; height:44px; border-radius:50%;\n  border:1px solid rgba(255,255,255,.3); background:rgba(0,0,0,.4); color:#fff; font-size:19px; cursor:pointer; }\n\n/* image gallery modal */\n.pt-glb__stage { position:relative; display:flex; align-items:center; justify-content:center;\n  width:min(1240px,100%); height:min(82vh,900px); }\n.pt-glb__stage img { max-width:100%; max-height:100%; width:auto; height:auto; border-radius:6px;\n  box-shadow:0 30px 80px rgba(0,0,0,.55); }\n.pt-glb__yt { width:min(1240px,100%); aspect-ratio:16/9; max-height:100%; border-radius:6px; overflow:hidden; background:#000;\n  box-shadow:0 30px 80px rgba(0,0,0,.55); }\n.pt-glb__yt iframe { width:100%; height:100%; border:0; display:block; }\n.pt-glb__stage img[hidden], .pt-glb__yt[hidden] { display:none; }\n.pt-glb__nav { position:absolute; top:50%; transform:translateY(-50%); width:52px; height:52px;\n  display:grid; place-items:center; border-radius:50%; border:1px solid rgba(255,255,255,.28);\n  background:rgba(0,0,0,.45); color:#fff; font-size:22px; cursor:pointer; transition:background .2s,border-color .2s; }\n.pt-glb__nav:hover { background:#ffd200; border-color:#ffd200; color:#16130e; }\n.pt-glb__nav--prev { left:clamp(-14px,-2vw,0px); }\n.pt-glb__nav--next { right:clamp(-14px,-2vw,0px); }\n.pt-glb__count { position:absolute; bottom:-34px; left:50%; transform:translateX(-50%);\n  font:600 12px/1 ui-monospace,Menlo,monospace; letter-spacing:.16em; color:rgba(255,255,255,.62); }\n@media (max-width:700px){\n  .pt-glb__nav { width:42px; height:42px; font-size:18px; }\n  .pt-glb__nav--prev { left:-6px; } .pt-glb__nav--next { right:-6px; }\n}\n/* light: overlays on dark thumbnails — force light label + yellow CTA */\n:root[data-theme=\"light\"] .pt-media__badge {\n  color: #f4f0e6 !important;\n  background: oklch(0.1 0.004 60 / 0.72) !important;\n  border-color: oklch(0.96 0.006 80 / 0.4) !important;\n}\n:root[data-theme=\"light\"] .pt-media__badge .d { background: #ffd200 !important; }\n:root[data-theme=\"light\"] .pt-media__open {\n  background: #ffd200 !important;\n  color: #17140a !important;\n}\n</style>";
---

<PortfolioLayout
  lang={lang}
  title="Portfolio, realizacje wideo, social, animacje i eventy | SEZMOO"
  description="Portfolio SEZMOO: realizacje wideo i foto, materiały na social media, animacje 3D/2D oraz relacje z eventów. Zobacz projekty dla marek motoryzacyjnych, B2B i eventowych."
  canonical={canonical}
  extraHead={extraHeadHtml}
>
