---
import BaseLayout from './../../layouts/BaseLayout.astro';
const pageHtml = "<!-- ============ COVER ============ -->\n<header class=\"cs-hero\" data-screen-label=\"Case · Cover\">\n  <div class=\"cs-hero__media\">\n    <img src=\"/assets/portfolio/kapka/kapka-baner.jpg\" alt=\"Maskotka Kapka Cafe, kropla kawy z kubkiem na wynos i kanapką, na tle palonych ziaren\" />\n  </div>\n  <div class=\"cs-hero__frame\" aria-hidden=\"true\"><span></span><span></span><span></span><span></span></div>\n  <div class=\"cs-hero__hud\">\n    <span class=\"rec\">BRANDING · LOGO</span>\n    <span>IDENTYFIKACJA</span>\n    <span>KAWIARNIA / PL</span>\n  </div>\n\n  <div class=\"cs-hero__inner shell\">\n    <a class=\"cs-hero__back\" href=\"../portfolio/\">← Portfolio / Realizacje</a>\n    <span class=\"eyebrow cs-hero__cat\"><span class=\"tick\"></span>SEZMOO × Kapka Cafe · Branding lokalu</span>\n    <h1 class=\"cs-title\">Kapka<br><span class=\"accent\">Cafe.</span></h1>\n    <p class=\"cs-hero__sub\">Kompletna identyfikacja wizualna dla kawiarni <b>Kapka Cafe</b>: od znaku i maskotki, przez paletę i typografię, po materiały, które pracują na ladzie, w witrynie i w social mediach.</p>\n  </div>\n\n  <div class=\"cs-scroll\" aria-hidden=\"true\"><span>SCROLL</span><i></i></div>\n</header>\n\n<!-- ============ META ============ -->\n<section class=\"cs-meta\" aria-label=\"Dane projektu\">\n  <div class=\"shell\">\n    <div class=\"cs-meta__grid\">\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Klient</div>\n        <div class=\"cs-meta__v\">Kapka Cafe<small>Kawiarnia</small></div>\n      </div>\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Branża</div>\n        <div class=\"cs-meta__v\">Gastronomia<small>Coffee &amp; to-go</small></div>\n      </div>\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Format</div>\n        <div class=\"cs-meta__v\">Branding<small>Od zera</small></div>\n      </div>\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Zakres</div>\n        <div class=\"cs-meta__v\">Full-service<small>Logo · Maskotka · Materiały</small></div>\n      </div>\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Rezultat</div>\n        <div class=\"cs-meta__v\">Spójny lokal<small>Znak · Witryna · Social</small></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ 01 · O PROJEKCIE ============ -->\n<section class=\"cs-sec\" data-screen-label=\"O projekcie\">\n  <div class=\"shell\">\n    <div class=\"cs-intro__grid\">\n      <div class=\"reveal\">\n        <span class=\"cs-sec__no\">O PROJEKCIE</span>\n        <h2 class=\"cs-sec__title\">Marka zbudowana<br>wokół jednej <span class=\"accent\">kropli.</span></h2>\n      </div>\n      <div class=\"cs-body reveal\" data-d=\"1\">\n        <p>Kapka Cafe to niewielka, kameralna kawiarnia, która potrzebowała marki dopasowanej do swojej skali: ciepłej, przyjaznej i rozpoznawalnej z drugiej strony ulicy. Zaczęliśmy od nazwy, <strong>„kapka”</strong>, czyli kropla, i to ona stała się sercem całej identyfikacji.</p>\n        <p>Z jednej idei zbudowaliśmy pełny system: znak z kubkiem na wynos trzymanym przez dłoń, maskotkę-kroplę z charakterem oraz spójną paletę i typografię, które przenieśliśmy na wszystkie materiały, od menu po oznakowanie lokalu.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ LOGO SHOWCASE ============ -->\n<section class=\"cs-sec\" style=\"padding-top:0\" aria-label=\"Logo\">\n  <div class=\"shell\">\n    <span class=\"cs-sec__no reveal\">ZNAK</span>\n    <h2 class=\"cs-sec__title reveal\">Logo, które od razu<br>mówi „kawa na wynos”.</h2>\n  </div>\n  <div class=\"cs-row\" style=\"margin-top:clamp(28px,4vh,48px)\">\n    <figure class=\"cs-shot cs-shot--wide reveal\" data-parallax=\"20\" style=\"background:#f3e9d6\">\n      <div class=\"frame-media cs-shot__media\" style=\"background:#f3e9d6\">\n        <img src=\"/assets/portfolio/kapka/kapka-logo.jpg\" alt=\"Logo Kapka Cafe: brązowy kubek na wynos trzymany przez dłoń obok napisu Kapka Cafe\" loading=\"lazy\" style=\"object-fit:contain\" />\n      </div>\n      <span class=\"cs-shot__tag\">Logo · Wersja podstawowa</span>\n    </figure>\n  </div>\n</section>\n\n<!-- ============ 03 · SYSTEM ============ -->\n<section class=\"cs-sec\" data-screen-label=\"System\">\n  <div class=\"shell\">\n    <span class=\"cs-sec__no reveal\">SYSTEM IDENTYFIKACJI</span>\n    <h2 class=\"cs-sec__title reveal\">Od znaku<br>po materiały lokalu.</h2>\n\n    <div class=\"cs-steps\">\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">B1, 01</span>\n        <h3 class=\"cs-step__title\">Znak i logotyp</h3>\n        <p class=\"cs-step__desc\">Sygnet z kubkiem na wynos trzymanym przez dłoń oraz miękki, odręczny logotyp „Kapka Cafe”, czytelny na szyldzie, w aplikacji i na kubku.</p>\n      </div>\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">B1, 02</span>\n        <h3 class=\"cs-step__title\">Maskotka-kropla</h3>\n        <p class=\"cs-step__desc\">Uśmiechnięta kropla kawy z kubkiem i kanapką, bohater marki używany w social mediach, na banerach i jako naklejka witrynowa w lokalu.</p>\n      </div>\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">B1, 03</span>\n        <h3 class=\"cs-step__title\">Paleta i typografia</h3>\n        <p class=\"cs-step__desc\">Ciepłe brązy palonej kawy, kremowe tło i miękki, zaokrąglony krój, które budują przyjazny, kawiarniany charakter i trzymają całość w jednym tonie.</p>\n      </div>\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">B1, 04</span>\n        <h3 class=\"cs-step__title\">Materiały i lokal</h3>\n        <p class=\"cs-step__desc\">Menu, baner na Facebooka, szyld, litery przestrzenne na ladzie i naklejki, czyli identyfikacja przeniesiona na realne punkty styku z gościem.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ GALLERY ============ -->\n<section class=\"cs-gallery bleed\" aria-label=\"Elementy identyfikacji\">\n  <div class=\"cs-row cs-row--split\">\n    <figure class=\"cs-shot cs-shot--tall reveal\" data-parallax=\"24\" style=\"background:#e7dcc6\">\n      <div class=\"frame-media cs-shot__media\" style=\"background:#e7dcc6\">\n        <img src=\"/assets/portfolio/kapka/kapka-maskotka.png\" alt=\"Maskotka Kapka Cafe: uśmiechnięta kropla kawy z kubkiem na wynos\" loading=\"lazy\" style=\"object-fit:contain\" />\n      </div>\n      <span class=\"cs-shot__tag\">Maskotka · Kropla</span>\n    </figure>\n    <figure class=\"cs-shot cs-shot--tall reveal\" data-d=\"1\" data-parallax=\"24\">\n      <div class=\"frame-media cs-shot__media\">\n        <img src=\"/assets/portfolio/kapka/kapka-menu.jpg\" alt=\"Menu Kapka Cafe z cennikiem kaw, napojów i dodatków\" loading=\"lazy\" />\n      </div>\n      <span class=\"cs-shot__tag\">Materiały · Menu</span>\n    </figure>\n  </div>\n\n  <div class=\"cs-row\">\n    <figure class=\"cs-shot cs-shot--full reveal\" data-parallax=\"30\">\n      <div class=\"frame-media cs-shot__media\">\n        <img src=\"/assets/portfolio/kapka/kapka-baner.jpg\" alt=\"Baner Kapka Cafe z maskotką-kroplą na tle palonych ziaren kawy\" loading=\"lazy\" />\n      </div>\n      <span class=\"cs-shot__tag\">Social · Baner FB</span>\n    </figure>\n  </div>\n\n  <div class=\"cs-row cs-row--split\">\n    <figure class=\"cs-shot cs-shot--tall reveal\" data-parallax=\"24\">\n      <div class=\"frame-media cs-shot__media\">\n        <img src=\"/assets/portfolio/kapka/kapka-lokal.jpg\" alt=\"Wnętrze Kapka Cafe: lada z przestrzennym logo i naklejka z maskotką na ścianie\" loading=\"lazy\" />\n      </div>\n      <span class=\"cs-shot__tag\">Lokal · Lada</span>\n    </figure>\n    <figure class=\"cs-shot cs-shot--tall reveal\" data-d=\"1\" data-parallax=\"24\">\n      <div class=\"frame-media cs-shot__media\">\n        <img src=\"/assets/portfolio/kapka/kapka-witryna.jpg\" alt=\"Witryna i szyld Kapka Cafe od strony ulicy\" loading=\"lazy\" />\n      </div>\n      <span class=\"cs-shot__tag\">Lokal · Szyld</span>\n    </figure>\n  </div>\n</section>\n\n<!-- ============ EFEKT KOŃCOWY ============ -->\n<section class=\"cs-quote\" aria-label=\"Efekt końcowy\">\n  <div class=\"shell cs-sec\">\n    <div class=\"cs-quote__inner reveal\">\n      <blockquote><span class=\"mark\">„</span>Jedna prosta idea, kropla, dała Kapka Cafe znak, maskotkę i spójny język, który wygląda tak samo dobrze na kubku, w witrynie i w social mediach.<span class=\"mark\">”</span></blockquote>\n      <div class=\"cs-quote__by\">– <b>Zespół SEZMOO</b> · Branding &amp; identyfikacja</div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ NEXT PROJECT ============ -->\n<a class=\"cs-next bleed\" href=\"../portfolio/\" data-cursor=\"link\" aria-label=\"Wróć do portfolio\">\n  <img src=\"/assets/portfolio/kapka/kapka-witryna.jpg\" alt=\"Witryna Kapka Cafe\" />\n  <div class=\"cs-next__inner shell\">\n    <span class=\"cs-next__k\">Zobacz więcej →</span>\n    <span class=\"cs-next__title\">Portfolio <span class=\"arrow\">→</span></span>\n    <span class=\"cs-next__cat\">Wszystkie realizacje SEZMOO</span>\n  </div>\n</a>";
const extraHeadHtml = "<link rel=\"stylesheet\" href=\"/assets/css/case-study.css\" />";
---

<BaseLayout
  lang="pl"
  title="Kapka Cafe · Logo i branding lokalu · Realizacja SEZMOO"
  description="Case study SEZMOO: logo, maskotka i pełny branding kawiarni Kapka Cafe. Znak z kubkiem, maskotka-kropla, paleta, menu, baner i oznakowanie lokalu."
  canonical="https://sezmoo.com/realizacja-kapka/"
  extraHead={extraHeadHtml}
>
  <Fragment set:html={pageHtml} />
</BaseLayout>
