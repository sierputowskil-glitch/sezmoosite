import BaseLayout from './../../layouts/BaseLayout.astro';
const pageHtml = "<section class=\"pt-hero\">\n  <div class=\"pt-hero__top\">\n    <div>\n      <span class=\"eyebrow\"><span class=\"tick\"></span>Portfolio · Propozycja układu</span>\n      <h1>Realizacje,<br>które <em>widać</em>.</h1>\n    </div>\n  </div>\n</section>\n\n<div class=\"pt-shell\">\n  <aside class=\"pt-side\">\n    <span class=\"pt-side__label\">Kategorie</span>\n    <div class=\"pt-side__list\" id=\"pt-filters\">\n      <button class=\"pt-navlink is-on\" type=\"button\" data-filter=\"all\">Wszystko <span class=\"n\">{12}</span></button>\n      <button class=\"pt-navlink\" type=\"button\" data-filter=\"video\">Wideo <span class=\"n\">{03}</span></button>\n      <button class=\"pt-navlink\" type=\"button\" data-filter=\"social\">Social <span class=\"n\">{03}</span></button>\n      <button class=\"pt-navlink\" type=\"button\" data-filter=\"eventy\">Eventy <span class=\"n\">{04}</span></button>\n      <button class=\"pt-navlink\" type=\"button\" data-filter=\"animacje\">Animacje <span class=\"n\">{01}</span></button>\n      <button class=\"pt-navlink\" type=\"button\" data-filter=\"grafika\">Grafika <span class=\"n\">{01}</span></button>\n    </div>\n  </aside>\n\n  <section class=\"pt-grid\" id=\"pt-grid\" data-screen-label=\"Portfolio kafle\">\n  <a class=\"pt-tile\" data-ratio=\"wide\" data-cats=\"video\" data-media=\"yt\" data-id=\"jco18tIaCT0\" data-case=\"1\">\n    <div class=\"pt-media\"><img src=\"https://i.ytimg.com/vi/jco18tIaCT0/maxresdefault.jpg\" onerror=\"this.onerror=null;this.src='https://i.ytimg.com/vi/jco18tIaCT0/hqdefault.jpg'\" alt=\"CRT\" loading=\"lazy\" /><span class=\"pt-media__badge\"><span class=\"d\"></span>Film</span><span class=\"pt-media__open\" aria-hidden=\"true\">→</span></div>\n    <div class=\"pt-cap\"><span class=\"pt-cap__tags\">Film wizerunkowy · Wideo</span><span class=\"pt-cap__year\">2024</span></div>\n    <h3 class=\"pt-title\">CRT</h3>\n  </a>\n  <a class=\"pt-tile\" data-ratio=\"portrait\" data-cats=\"eventy\" data-media=\"yt\" data-id=\"tgcCHgkOM4I\" data-short=\"1\" href=\"../realizacja-exlantix/\">\n    <div class=\"pt-media\"><img src=\"https://i.ytimg.com/vi/tgcCHgkOM4I/maxresdefault.jpg\" onerror=\"this.onerror=null;this.src='https://i.ytimg.com/vi/tgcCHgkOM4I/hqdefault.jpg'\" alt=\"Premiera marki EXLANTIX w Gdańsku – event, fotografia i wideo\" loading=\"lazy\" /><span class=\"pt-media__badge\"><span class=\"d\"></span>Case study</span><span class=\"pt-media__open\" aria-hidden=\"true\">→</span></div>\n    <div class=\"pt-cap\"><span class=\"pt-cap__tags\">Premiera marki · Event</span><span class=\"pt-cap__year\">2025</span></div>\n    <h3 class=\"pt-title\">EXLANTIX</h3>\n  </a>\n  <a class=\"pt-tile\" data-ratio=\"wide\" data-cats=\"video\" data-media=\"yt\" data-id=\"NHEIfdgr9mI\" data-case=\"1\">\n    <div class=\"pt-media\"><img src=\"https://i.ytimg.com/vi/NHEIfdgr9mI/maxresdefault.jpg\" onerror=\"this.onerror=null;this.src='https://i.ytimg.com/vi/NHEIfdgr9mI/hqdefault.jpg'\" alt=\"IZIPAK\" loading=\"lazy\" /><span class=\"pt-media__badge\"><span class=\"d\"></span>Film</span><span class=\"pt-media__open\" aria-hidden=\"true\">→</span></div>\n    <div class=\"pt-cap\"><span class=\"pt-cap__tags\">Film produktowy · Wideo</span><span class=\"pt-cap__year\">2024</span></div>\n    <h3 class=\"pt-title\">IZIPAK</h3>\n  </a>\n  <a class=\"pt-tile\" data-ratio=\"portrait\" data-cats=\"eventy\" data-media=\"yt\" data-id=\"OJnUGJdFk9w\" data-short=\"1\" href=\"../realizacja-denza/\">\n    <div class=\"pt-media\"><img src=\"https://i.ytimg.com/vi/OJnUGJdFk9w/maxresdefault.jpg\" onerror=\"this.onerror=null;this.src='https://i.ytimg.com/vi/OJnUGJdFk9w/hqdefault.jpg'\" alt=\"DENZA\" loading=\"lazy\" /><span class=\"pt-media__badge\"><span class=\"d\"></span>Case study</span><span class=\"pt-media__open\" aria-hidden=\"true\">→</span></div>\n    <div class=\"pt-cap\"><span class=\"pt-cap__tags\">Premiera Z9 GT · Event</span><span class=\"pt-cap__year\">2025</span></div>\n    <h3 class=\"pt-title\">DENZA</h3>\n  </a>\n  <a class=\"pt-tile\" data-ratio=\"portrait\" data-cats=\"social\" data-media=\"yt\" data-id=\"Hdnf6zcn3bA\" data-short=\"1\" data-case=\"1\">\n    <div class=\"pt-media\"><img src=\"https://i.ytimg.com/vi/Hdnf6zcn3bA/maxresdefault.jpg\" onerror=\"this.onerror=null;this.src='https://i.ytimg.com/vi/Hdnf6zcn3bA/hqdefault.jpg'\" alt=\"JAECOO 8\" loading=\"lazy\" /><span class=\"pt-media__badge\"><span class=\"d\"></span>Short</span><span class=\"pt-media__open\" aria-hidden=\"true\">→</span></div>\n    <div class=\"pt-cap\"><span class=\"pt-cap__tags\">Lifestyle · Social</span><span class=\"pt-cap__year\">2025</span></div>\n    <h3 class=\"pt-title\">JAECOO 8</h3>\n  </a>\n  <a class=\"pt-tile\" data-ratio=\"portrait\" data-cats=\"social\" data-media=\"yt\" data-id=\"WG5ufZMfjQ8\" data-short=\"1\" data-case=\"1\">\n    <div class=\"pt-media\"><img src=\"https://i.ytimg.com/vi/WG5ufZMfjQ8/maxresdefault.jpg\" onerror=\"this.onerror=null;this.src='https://i.ytimg.com/vi/WG5ufZMfjQ8/hqdefault.jpg'\" alt=\"Audi RS5\" loading=\"lazy\" /><span class=\"pt-media__badge\"><span class=\"d\"></span>Short</span><span class=\"pt-media__open\" aria-hidden=\"true\">→</span></div>\n    <div class=\"pt-cap\"><span class=\"pt-cap__tags\">Trailer · Social</span><span class=\"pt-cap__year\">2024</span></div>\n    <h3 class=\"pt-title\">Audi RS5</h3>\n  </a>\n  <a class=\"pt-tile\" data-ratio=\"wide\" data-cats=\"eventy\" data-media=\"yt\" data-id=\"tvTuMX3mxG4\" data-case=\"1\">\n    <div class=\"pt-media\"><img src=\"https://i.ytimg.com/vi/tvTuMX3mxG4/maxresdefault.jpg\" onerror=\"this.onerror=null;this.src='https://i.ytimg.com/vi/tvTuMX3mxG4/hqdefault.jpg'\" alt=\"Baltic Towers\" loading=\"lazy\" /><span class=\"pt-media__badge\"><span class=\"d\"></span>Event</span><span class=\"pt-media__open\" aria-hidden=\"true\">→</span></div>\n    <div class=\"pt-cap\"><span class=\"pt-cap__tags\">Otwarcie · Event</span><span class=\"pt-cap__year\">2024</span></div>\n    <h3 class=\"pt-title\">Baltic Towers</h3>\n  </a>\n  <a class=\"pt-tile\" data-ratio=\"portrait\" data-cats=\"social\" data-media=\"yt\" data-id=\"X8-hf_cyZxE\" data-short=\"1\" data-case=\"1\">\n    <div class=\"pt-media\"><img src=\"https://i.ytimg.com/vi/X8-hf_cyZxE/maxresdefault.jpg\" onerror=\"this.onerror=null;this.src='https://i.ytimg.com/vi/X8-hf_cyZxE/hqdefault.jpg'\" alt=\"BYD Dolphin\" loading=\"lazy\" /><span class=\"pt-media__badge\"><span class=\"d\"></span>Short</span><span class=\"pt-media__open\" aria-hidden=\"true\">→</span></div>\n    <div class=\"pt-cap\"><span class=\"pt-cap__tags\">Automotive · Social</span><span class=\"pt-cap__year\">2024</span></div>\n    <h3 class=\"pt-title\">BYD Dolphin</h3>\n  </a>\n  <a class=\"pt-tile\" data-ratio=\"wide\" data-cats=\"video\" data-media=\"yt\" data-id=\"iknT-xURZag\" data-case=\"1\">\n    <div class=\"pt-media\"><img src=\"https://i.ytimg.com/vi/iknT-xURZag/maxresdefault.jpg\" onerror=\"this.onerror=null;this.src='https://i.ytimg.com/vi/iknT-xURZag/hqdefault.jpg'\" alt=\"Gdańsk Miastem Kultury\" loading=\"lazy\" /><span class=\"pt-media__badge\"><span class=\"d\"></span>Wideo</span><span class=\"pt-media__open\" aria-hidden=\"true\">→</span></div>\n    <div class=\"pt-cap\"><span class=\"pt-cap__tags\">Miastem Kultury · Wideo</span><span class=\"pt-cap__year\">2023</span></div>\n    <h3 class=\"pt-title\">Gdańsk</h3>\n  </a>\n  <a class=\"pt-tile\" data-ratio=\"wide\" data-cats=\"eventy\" data-media=\"yt\" data-id=\"wVy04YYnbRM\" data-case=\"1\">\n    <div class=\"pt-media\"><img src=\"https://i.ytimg.com/vi/wVy04YYnbRM/maxresdefault.jpg\" onerror=\"this.onerror=null;this.src='https://i.ytimg.com/vi/wVy04YYnbRM/hqdefault.jpg'\" alt=\"PISF\" loading=\"lazy\" /><span class=\"pt-media__badge\"><span class=\"d\"></span>Event</span><span class=\"pt-media__open\" aria-hidden=\"true\">→</span></div>\n    <div class=\"pt-cap\"><span class=\"pt-cap__tags\">Relacja · Event</span><span class=\"pt-cap__year\">2024</span></div>\n    <h3 class=\"pt-title\">PISF</h3>\n  </a>\n  <a class=\"pt-tile\" data-ratio=\"wide\" data-cats=\"animacje\" data-media=\"yt\" data-id=\"WszuntCE51c\" data-case=\"1\">\n    <div class=\"pt-media\"><img src=\"https://i.ytimg.com/vi/WszuntCE51c/maxresdefault.jpg\" onerror=\"this.onerror=null;this.src='https://i.ytimg.com/vi/WszuntCE51c/hqdefault.jpg'\" alt=\"Baltic 3D\" loading=\"lazy\" /><span class=\"pt-media__badge\"><span class=\"d\"></span>3D</span><span class=\"pt-media__open\" aria-hidden=\"true\">→</span></div>\n    <div class=\"pt-cap\"><span class=\"pt-cap__tags\">Model fabryki · Animacja 3D</span><span class=\"pt-cap__year\">2024</span></div>\n    <h3 class=\"pt-title\">Baltic 3D</h3>\n  </a>\n  <a class=\"pt-tile\" data-ratio=\"square\" data-cats=\"grafika\" data-media=\"img\" data-src=\"/assets/portfolio/primespot/pjur-blue-square-1.jpg\" href=\"../realizacja-primespot/\">\n    <div class=\"pt-media\"><img src=\"/assets/portfolio/primespot/pjur-blue-square-1.jpg\" alt=\"PrimeSpot Przystań Jurata – kreacje reklamowe kampanii inwestycji\" loading=\"lazy\" /><span class=\"pt-media__badge\"><span class=\"d\"></span>Case study</span><span class=\"pt-media__open\" aria-hidden=\"true\">→</span></div>\n    <div class=\"pt-cap\"><span class=\"pt-cap__tags\">Przystań Jurata · Kampania Meta Ads</span><span class=\"pt-cap__year\">2025</span></div>\n    <h3 class=\"pt-title\">PrimeSpot</h3>\n  </a>\n  </section>\n</div>";
const extraHeadHtml = "<style>\n/* ============================================================\n   PORTFOLIO – BIG TILES (proposal, page-scoped)\n   Large media, small category caption, staggered grid\n   ============================================================ */\n.pt-hero { max-width:var(--maxw); margin-inline:auto; padding: clamp(120px,16vh,190px) var(--shell-pad) clamp(24px,4vh,44px); }\n.pt-hero__top { display:flex; align-items:flex-end; justify-content:space-between; gap:32px; flex-wrap:wrap; }\n.pt-hero h1 { font-weight:820; font-stretch:112%; letter-spacing:-.03em; line-height:.9;\n  font-size:clamp(46px,9vw,132px); text-transform:uppercase; margin:clamp(14px,2vh,22px) 0 0; }\n.pt-hero h1 em { font-style:normal; color:var(--rec); }\n.pt-hero__lead { max-width:40ch; color:var(--fg-dim); font-size:clamp(15px,1.1vw,17px); line-height:1.55; }\n.pt-hero__lead b { color:var(--fg); font-weight:640; }\n\n/* ---- shell: sticky sidebar + masonry grid ---- */\n.pt-shell { display:grid; grid-template-columns:clamp(190px,17vw,270px) 1fr; align-items:start;\n  gap:clamp(28px,3.4vw,64px); max-width:var(--maxw); margin-inline:auto;\n  padding:clamp(30px,4.5vh,54px) var(--shell-pad) clamp(50px,9vh,110px); }\n.pt-side { position:sticky; top:clamp(90px,12vh,116px); }\n.pt-side__label { font-family:var(--font-mono); font-size:11px; letter-spacing:.24em; text-transform:uppercase;\n  color:var(--fg-faint); display:block; padding-bottom:16px; margin-bottom:14px; border-bottom:1px solid var(--line); }\n.pt-side__list { display:flex; flex-direction:column; }\n.pt-navlink { display:flex; align-items:flex-start; gap:6px; text-align:left; background:none; border:0; cursor:pointer;\n  font-family:var(--font-display); font-weight:770; font-stretch:106%; text-transform:uppercase; letter-spacing:-.01em;\n  font-size:clamp(20px,1.6vw,30px); line-height:1.34; color:var(--fg-faint);\n  transition:color .3s var(--ease), transform .35s var(--ease); }\n.pt-navlink .n { font-family:var(--font-mono); font-weight:400; font-size:.42em; letter-spacing:.04em;\n  color:var(--fg-faint); opacity:.75; transform:translateY(.2em); }\n.pt-navlink:hover { color:var(--fg); transform:translateX(4px); }\n.pt-navlink.is-on { color:var(--rec); }\n.pt-navlink.is-on .n { color:var(--rec); opacity:.85; }\n\n/* ---- grid (true masonry, tightly packed) ---- */\n.pt-grid { column-count:2; column-gap:clamp(16px,1.8vw,30px); }\n\n.pt-tile { display:block; break-inside:avoid; margin:0 0 clamp(24px,2.4vw,42px); will-change:transform; transform:perspective(1200px); text-align:left; color:inherit; font:inherit; background:none; border:0; padding:0;\n  cursor:pointer; width:100%; }\n.pt-tile.is-hide { display:none; }\n.pt-media { position:relative; overflow:hidden; border-radius:10px; background:var(--bg-3);\n  border:1px solid var(--line-soft); aspect-ratio:4/3; }\n.pt-tile[data-ratio=\"portrait\"] .pt-media { aspect-ratio:3/4; }\n.pt-tile[data-ratio=\"wide\"] .pt-media { aspect-ratio:16/10; }\n.pt-tile[data-ratio=\"square\"] .pt-media { aspect-ratio:1/1; }\n.pt-media img { width:100%; height:100%; object-fit:cover; transition:transform .8s var(--ease), filter .5s var(--ease); }\n.pt-media iframe { position:absolute; inset:0; width:100%; height:100%; border:0; z-index:2; pointer-events:none;\n  transform:scale(1.32); } /* zoom to hide YT chrome */\n.pt-tile:hover .pt-media img { transform:scale(1.05); }\n/* corner ticks + play badge, cosmos-ish */\n.pt-media__badge { position:absolute; left:14px; top:14px; z-index:3; display:inline-flex; align-items:center; gap:7px;\n  font-family:var(--font-mono); font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:var(--fg);\n  background:oklch(0.1 0.004 60 / .55); -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px);\n  border:1px solid var(--line-soft); border-radius:100px; padding:6px 11px; }\n.pt-media__badge .d { width:6px; height:6px; border-radius:50%; background:var(--rec); }\n.pt-media__open { position:absolute; right:14px; bottom:14px; z-index:3; width:46px; height:46px; border-radius:50%;\n  display:grid; place-items:center; background:var(--rec); color:var(--on-accent); font-size:17px; line-height:1;\n  opacity:0; transform:translateY(8px) scale(.9); transition:opacity .4s var(--ease), transform .4s var(--ease); }\n.pt-tile:hover .pt-media__open { opacity:1; transform:none; }\n\n/* caption */\n.pt-cap { display:flex; align-items:baseline; justify-content:space-between; gap:16px;\n  margin:clamp(14px,1.4vw,20px) 2px 0; }\n.pt-cap__tags { font-family:var(--font-mono); font-size:clamp(11px,0.85vw,13px); letter-spacing:.05em;\n  color:var(--fg-faint); }\n.pt-cap__year { font-family:var(--font-mono); font-size:clamp(11px,0.85vw,13px); letter-spacing:.05em;\n  color:var(--fg-faint); flex:0 0 auto; }\n.pt-title { margin:6px 2px 0; font-weight:720; font-stretch:104%; letter-spacing:-.015em; line-height:1;\n  font-size:clamp(26px,3vw,44px); transition:color .35s var(--ease); }\n.pt-tile:hover .pt-title { color:var(--rec); }\n@media (prefers-reduced-motion:reduce){ .pt-tile { transform:none !important; } }\n\n@media (max-width:900px){\n  .pt-shell { grid-template-columns:1fr; gap:22px; }\n  .pt-side { position:static; }\n  .pt-side__label { display:none; }\n  .pt-side__list { flex-direction:row; flex-wrap:nowrap; gap:8px; overflow-x:auto; padding-bottom:14px;\n    border-bottom:1px solid var(--line); -webkit-overflow-scrolling:touch; scrollbar-width:none; }\n  .pt-side__list::-webkit-scrollbar { display:none; }\n  .pt-navlink { flex:0 0 auto; font-size:13px; letter-spacing:.1em; line-height:1; white-space:nowrap;\n    border:1px solid var(--line); border-radius:100px; padding:10px 16px; }\n  .pt-navlink .n { font-size:11px; transform:none; margin-left:2px; }\n  .pt-navlink:hover { transform:none; }\n  .pt-navlink.is-on { color:var(--on-accent); background:var(--rec); border-color:var(--rec); }\n  .pt-navlink.is-on .n { color:var(--on-accent); }\n}\n@media (max-width:760px){\n  .pt-grid { column-count:1; }\n  .pt-tile[data-ratio=\"portrait\"] .pt-media { aspect-ratio:4/5; }\n}\n\n/* video modal */\n.pt-vlb { position:fixed; inset:0; z-index:9999; display:flex; align-items:center; justify-content:center;\n  padding:clamp(18px,5vw,70px); background:oklch(0.06 0.004 60 / .9); backdrop-filter:blur(8px); }\n.pt-vlb[hidden] { display:none; }\n.pt-vlb__frame { position:relative; width:min(1100px,100%); aspect-ratio:16/9; }\n.pt-vlb__frame.is-short { width:auto; height:min(86vh,760px); aspect-ratio:9/16; }\n.pt-vlb__frame iframe { position:absolute; inset:0; width:100%; height:100%; border:0; border-radius:6px;\n  box-shadow:0 30px 80px rgba(0,0,0,.55); }\n.pt-vlb__close { position:absolute; top:18px; right:22px; width:44px; height:44px; border-radius:50%;\n  border:1px solid rgba(255,255,255,.3); background:rgba(0,0,0,.4); color:#fff; font-size:19px; cursor:pointer; }\n</style>";
const pageScriptsHtml = "<script>\n(function () {\n  var CASE_IDS = [\"WG5ufZMfjQ8\",\"Hdnf6zcn3bA\",\"X8-hf_cyZxE\",\"jco18tIaCT0\",\"NHEIfdgr9mI\",\"wVy04YYnbRM\",\"iknT-xURZag\",\"tvTuMX3mxG4\",\"WszuntCE51c\"];\n  var tiles = [].slice.call(document.querySelectorAll(\".pt-tile\"));\n\n  /* filters */\n  var chips = [].slice.call(document.querySelectorAll(\".pt-navlink\"));\n  chips.forEach(function (chip) {\n    chip.addEventListener(\"click\", function () {\n      var f = chip.dataset.filter || \"all\";\n      chips.forEach(function (c) { c.classList.toggle(\"is-on\", c === chip); });\n      tiles.forEach(function (t) {\n        var list = (t.getAttribute(\"data-cats\") || \"\").split(/[\\s,]+/);\n        t.classList.toggle(\"is-hide\", !(f === \"all\" || list.indexOf(f) > -1));\n      });\n    });\n  });\n\n  /* video modal */\n  var vlb = null;\n  function openVideo(id, short) {\n    if (!vlb) {\n      vlb = document.createElement(\"div\"); vlb.className = \"pt-vlb\"; vlb.hidden = true;\n      vlb.innerHTML = '<button class=\"pt-vlb__close\" type=\"button\" aria-label=\"Zamknij\">\\u2715</button><div class=\"pt-vlb__frame\"></div>';\n      document.body.appendChild(vlb);\n      vlb.addEventListener(\"click\", function (e) { if (e.target === vlb || e.target.classList.contains(\"pt-vlb__close\")) closeVideo(); });\n      document.addEventListener(\"keydown\", function (e) { if (!vlb.hidden && e.key === \"Escape\") closeVideo(); });\n    }\n    var frame = vlb.querySelector(\".pt-vlb__frame\");\n    frame.className = \"pt-vlb__frame\" + (short ? \" is-short\" : \"\");\n    frame.innerHTML = '<iframe src=\"https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0&modestbranding=1&playsinline=1\" allow=\"autoplay; fullscreen; picture-in-picture; encrypted-media\" allowfullscreen></iframe>';\n    vlb.hidden = false; document.body.style.overflow = \"hidden\";\n  }\n  function closeVideo() { if (!vlb) return; vlb.hidden = true; vlb.querySelector(\".pt-vlb__frame\").innerHTML = \"\"; document.body.style.overflow = \"\"; }\n\n  /* click routing */\n  tiles.forEach(function (t) {\n    t.addEventListener(\"click\", function (e) {\n      if (t.getAttribute(\"href\")) return;\n      e.preventDefault();\n      var id = t.getAttribute(\"data-id\");\n      if (!id) return;\n      if (CASE_IDS.indexOf(id) > -1) { location.href = \"../realizacja/?v=\" + id; return; }\n      openVideo(id, t.getAttribute(\"data-short\") === \"1\");\n    });\n  });\n\n  /* in-tile hover video */\n  var canHover = window.matchMedia(\"(hover:hover) and (pointer:fine)\").matches;\n  if (canHover) {\n    tiles.forEach(function (t) {\n      if (t.getAttribute(\"data-media\") !== \"yt\") return;\n      var media = t.querySelector(\".pt-media\"), id = t.getAttribute(\"data-id\"), timer = null;\n      t.addEventListener(\"mouseenter\", function () {\n        timer = setTimeout(function () {\n          if (media.querySelector(\"iframe\")) return;\n          var ifr = document.createElement(\"iframe\");\n          ifr.src = \"https://www.youtube-nocookie.com/embed/\" + id + \"?autoplay=1&mute=1&controls=0&rel=0&modestbranding=1&playsinline=1&loop=1&playlist=\" + id;\n          ifr.allow = \"autoplay; encrypted-media; picture-in-picture\";\n          ifr.tabIndex = -1;\n          media.appendChild(ifr);\n        }, 240);\n      });\n      t.addEventListener(\"mouseleave\", function () {\n        clearTimeout(timer);\n        var ifr = media.querySelector(\"iframe\");\n        if (ifr) ifr.remove();\n      });\n    });\n  }\n\n  /* ---- scroll depth: tiles grow toward viewport centre + subtle 3D tilt ---- */\n  /* desktop only: on narrow screens the scale-up would cause horizontal scroll */\n  if (window.matchMedia(\"(min-width:900px)\").matches && !window.matchMedia(\"(prefers-reduced-motion:reduce)\").matches) {\n    var ticking = false;\n    function depthFrame() {\n      var vh = window.innerHeight;\n      tiles.forEach(function (t) {\n        if (t.classList.contains(\"is-hide\")) return;\n        var r = t.getBoundingClientRect();\n        if (r.bottom < -240 || r.top > vh + 240) return;\n        var d = ((r.top + r.height / 2) - vh / 2) / vh;   /* 0 = centred */\n        d = Math.max(-1, Math.min(1, d));\n        var s = 1.04 - Math.abs(d) * 0.14;                 /* grow near centre */\n        var rx = d * 7;                                     /* tilt for depth */\n        t.style.transform = \"perspective(1200px) rotateX(\" + rx + \"deg) scale(\" + s.toFixed(4) + \")\";\n      });\n      ticking = false;\n    }\n    function reqDepth() { if (!ticking) { ticking = true; requestAnimationFrame(depthFrame); } }\n    window.addEventListener(\"scroll\", reqDepth, { passive: true });\n    window.addEventListener(\"resize\", reqDepth);\n    reqDepth();\n  }\n})();\n</script>";
