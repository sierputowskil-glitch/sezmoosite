    <div class="pt-cap"><span class="pt-cap__tags">Lifestyle · Social</span><span class="pt-cap__year">2025</span></div>
    <h3 class="pt-title">JAECOO 8</h3>
  </a>
  <a class="pt-tile" data-ratio="portrait" data-cats="social" data-media="yt" data-id="WG5ufZMfjQ8" data-short="1" data-case="1">
    <div class="pt-media"><img src="https://i.ytimg.com/vi/WG5ufZMfjQ8/maxresdefault.jpg" onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/WG5ufZMfjQ8/hqdefault.jpg'" alt="Audi RS5" loading="lazy" /><span class="pt-media__badge"><span class="d"></span>Short</span><span class="pt-media__open" aria-hidden="true">→</span></div>
