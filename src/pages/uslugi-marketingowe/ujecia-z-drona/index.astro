import BaseLayout from './../../../layouts/BaseLayout.astro';
const pageHtml = "<div class=\"sd\">\n<section class=\"sd__hero shell\">\n  <span class=\"sd__kick reveal\"><i></i>Usługi</span>\n  <h1 class=\"sd__h1 reveal\">Ujęcia z&nbsp;<span style=\"color:#ffd200\">drona.</span></h1>\n  <p class=\"sd__lead reveal\" data-d=\"1\">Ujęcia lotnicze traktujemy jako <b>część produkcji filmowej</b>, a&nbsp;nie ozdobnik – latamy wtedy, gdy kadr z&nbsp;powietrza realnie wnosi coś do&nbsp;montażu.</p>\n  <p class=\"sd__lead reveal\" data-d=\"1\">Realizujemy zdjęcia i&nbsp;wideo z&nbsp;drona dla inwestycji, przemysłu, automotive, eventów i&nbsp;materiałów wizerunkowych. Plan lotu ustalamy razem z&nbsp;planem zdjęciowym.</p>\n  <div class=\"sd__facts reveal\" data-d=\"2\">\n    <div class=\"sd__fact\"><span>Zakres</span><strong>Wideo i&nbsp;foto z&nbsp;powietrza</strong></div>\n    <div class=\"sd__fact\"><span>Sprzęt</span><strong>Własny, 4K</strong></div>\n    <div class=\"sd__fact\"><span>Loty</span><strong>Zgodnie z&nbsp;przepisami</strong></div>\n    <div class=\"sd__fact\"><span>Baza</span><strong>Gdańsk · cała Polska</strong></div>\n  </div>\n  <figure class=\"sd__reel reveal\" data-d=\"1\">\n    <img src=\"/assets/photo/pruszcz-park-4.avif\" alt=\"Pruszcz Park\" loading=\"eager\" fetchpriority=\"high\" />\n    <figcaption><b>Pruszcz Park</b><span>Ujęcia lotnicze / inwestycja</span></figcaption>\n  </figure>\n</section>\n<div class=\"sd__body shell\">\n  <div>\n    <section class=\"sd__blk\" id=\"sd-zakres\">\n      <div class=\"sd__blkh reveal\"><h2>Co filmujemy</h2></div>\n      <details class=\"sd__g reveal\" open><summary><h3>Inwestycje i&nbsp;nieruchomości</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Pokazujemy skalę inwestycji, osiedla, hali albo terenu – od&nbsp;postępu budowy po&nbsp;gotowy obiekt w&nbsp;kontekście otoczenia.</p><div class=\"sd__tags\"><span>Osiedla i inwestycje</span><span>Postęp budowy</span><span>Tereny inwestycyjne</span><span>Hale i zakłady</span><span>Nieruchomości premium</span><span>Kontekst otoczenia</span></div></div></details>\n      <details class=\"sd__g reveal\" open><summary><h3>Automotive</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Jazdy, przeloty nad samochodem i&nbsp;prezentacje modeli – kadry, które budują premium look marki.</p><div class=\"sd__tags\"><span>Ujęcia jazdy</span><span>Przelot nad autem</span><span>Prezentacja modelu</span><span>Salon i plac</span><span>Eventy automotive</span></div></div></details>\n      <details class=\"sd__g reveal\"><summary><h3>Eventy i&nbsp;wydarzenia</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Rejestrujemy skalę wydarzenia z&nbsp;powietrza: publiczność, scenę i&nbsp;przestrzeń, których nie widać z&nbsp;poziomu ziemi.</p><div class=\"sd__tags\"><span>Aftermovie z powietrza</span><span>Festiwale</span><span>Targi i wystawy</span><span>Wydarzenia sportowe</span><span>Koncerty</span></div></div></details>\n      <details class=\"sd__g reveal\"><summary><h3>Przemysł i&nbsp;infrastruktura</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Dokumentujemy zakłady, port, infrastrukturę i&nbsp;instalacje – do&nbsp;materiałów wizerunkowych i&nbsp;inspekcji wizualnych.</p><div class=\"sd__tags\"><span>Zakłady produkcyjne</span><span>Port i logistyka</span><span>Infrastruktura drogowa</span><span>Farmy fotowoltaiczne</span><span>Inspekcje wizualne</span></div></div></details>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-proces\">\n      <div class=\"sd__blkh reveal\"><h2>Jak pracujemy</h2></div>\n      <div class=\"sd__steps\">\n        <div class=\"sd__step reveal\"><h3>Scouting</h3><p>Sprawdzamy lokalizację, przestrzeń powietrzną i&nbsp;warunki lotu.</p></div>\n        <div class=\"sd__step reveal\"><h3>Zgody i&nbsp;przepisy</h3><p>Ustalamy strefy, pozwolenia i&nbsp;zasady bezpieczeństwa.</p></div>\n        <div class=\"sd__step reveal\"><h3>Lot</h3><p>Przeloty, najazdy, reveal i&nbsp;kadry przygotowane pod&nbsp;montaż.</p></div>\n        <div class=\"sd__step reveal\"><h3>Foto z&nbsp;powietrza</h3><p>Zdjęcia lotnicze do&nbsp;materiałów sprzedażowych i&nbsp;na&nbsp;stronę.</p></div>\n        <div class=\"sd__step reveal\"><h3>Wpięcie w&nbsp;montaż</h3><p>Materiał gotowy do&nbsp;połączenia z&nbsp;filmem i&nbsp;socialami.</p></div>\n      </div>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-work\">\n      <div class=\"sd__blkh reveal\"><h2>Realizacje</h2></div>\n      <div class=\"sd__work\">\n        <a class=\"sd__wi reveal\" href=\"../../portfolio/?cat=video#pt-grid\"><div class=\"sd__wm\"><img src=\"/assets/portfolio/doraco-tvp/doraco-hala-zdjeciowa-tvp-zdjecia-z-drona-02.jpg\" alt=\"DORACO – Hala TVP · Ujęcia z drona\" loading=\"lazy\" /></div><span>Hala TVP · Ujęcia z&nbsp;drona</span><h3>DORACO ↗</h3></a>\n        <a class=\"sd__wi reveal\" href=\"../../portfolio/?cat=video#pt-grid\"><div class=\"sd__wm\"><img src=\"/assets/work/landrover.jpg\" alt=\"Land Rover – Automotive · Teren\" loading=\"lazy\" /></div><span>Automotive · Teren</span><h3>Land Rover ↗</h3></a>\n        <a class=\"sd__wi reveal\" href=\"../../realizacja/?v=tvTuMX3mxG4\"><div class=\"sd__wm\"><img src=\"/assets/work/baltic-robert-3.avif\" alt=\"Baltic Towers – Inwestycja · Wideo\" loading=\"lazy\" /></div><span>Inwestycja · Wideo</span><h3>Baltic Towers ↗</h3></a>\n      </div>\n      <div class=\"sd__more reveal\">\n        <a class=\"is-lead\" href=\"../../portfolio/#pt-grid\">Całe portfolio ↗</a>\n        <a href=\"../../portfolio/?cat=video#pt-grid\">Wideo</a>\n        <a href=\"../../portfolio/?cat=animacje#pt-grid\">Animacje</a>\n        <a href=\"../../portfolio/?cat=eventy#pt-grid\">Eventy</a>\n        <a href=\"../../portfolio/?cat=grafika#pt-grid\">Grafika</a>\n      </div>\n    </section>\n  </div>\n</div>\n</div>";
