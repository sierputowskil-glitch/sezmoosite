---
import BaseLayout from './../../../layouts/BaseLayout.astro';
const pageHtml = "<div class=\"sd\">\n<section class=\"sd__hero shell\">\n  <span class=\"sd__kick reveal\"><i></i>Usługi</span>\n  <h1 class=\"sd__h1 reveal\"><span style=\"color:#ffd200\">Fotografia.</span></h1>\n  <p class=\"sd__lead reveal\" data-d=\"1\"><b>Zdjęcia są jednym z&nbsp;najdłużej pracujących assetów marki</b> – trafiają na&nbsp;stronę internetową, do&nbsp;reklam, social media i&nbsp;materiałów sprzedażowych, często pozostając w&nbsp;użyciu przez lata.</p>\n  <p class=\"sd__lead reveal\" data-d=\"1\">Realizujemy sesje produktowe, wizerunkowe, eventowe, motoryzacyjne i&nbsp;architektoniczne – jako osobną produkcję lub&nbsp;równolegle z&nbsp;wideo, na&nbsp;jednym planie zdjęciowym.</p>\n  <div class=\"sd__facts reveal\" data-d=\"2\">\n    <div class=\"sd__fact\"><span>Plan</span><strong>Sesje studyjne i&nbsp;terenowe</strong></div>\n    <div class=\"sd__fact\"><span>Dron</span><strong>Zdjęcia z&nbsp;ziemi i&nbsp;z&nbsp;lotu ptaka</strong></div>\n    <div class=\"sd__fact\"><span>Rodzaj</span><strong>Produktowe, wizerunkowe, eventowe</strong></div>\n    <div class=\"sd__fact\"><span>Lokalizacja</span><strong>Gdańsk, Polska i&nbsp;Europa</strong></div>\n  </div>\n  <figure class=\"sd__reel reveal\" data-d=\"1\">\n    <img src=\"/assets/photo/audi-sesja.avif\" alt=\"Audi\" loading=\"eager\" fetchpriority=\"high\" />\n    <figcaption><b>Audi</b><span>Sesja / automotive detail</span></figcaption>\n  </figure>\n</section>\n<div class=\"sd__body shell\">\n  <div>\n    <section class=\"sd__blk\" id=\"sd-zakres\">\n      <div class=\"sd__blkh reveal\"><h2>Co fotografujemy</h2></div>\n      <details class=\"sd__g reveal\" open><summary><h3>Produkt i&nbsp;e-commerce</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Fotografia produktowa na&nbsp;czystym tle i&nbsp;w&nbsp;scenografii – pod&nbsp;e-commerce, prezentację produktu, materiały sprzedażowe i&nbsp;kampanie.</p><div class=\"sd__tags\"><span>Zdjęcia produktowe</span><span>Packshot</span><span>Detal produktu</span><span>Lifestyle</span><span>Zdjęcia do e-commerce</span><span>Zdjęcia do katalogu</span></div></div></details>\n      <details class=\"sd__g reveal\" open><summary><h3>Wizerunek i&nbsp;biznes</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Sesje wizerunkowe firm i&nbsp;zespołów, portrety biznesowe, zdjęcia do&nbsp;LinkedIna, materiałów rekrutacyjnych i&nbsp;employer brandingu.</p><div class=\"sd__tags\"><span>Sesja wizerunkowa</span><span>Portret biznesowy</span><span>Zdjęcia zespołu</span><span>Employer branding</span><span>Zdjęcia do LinkedIna</span><span>Reportaż z firmy</span></div></div></details>\n      <details class=\"sd__g reveal\" open><summary><h3>Event i&nbsp;reportaż</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Fotografia eventowa: konferencje, targi, premiery i&nbsp;wydarzenia firmowe – ludzie, atmosfera i&nbsp;dokumentacja gotowa do&nbsp;publikacji.</p><div class=\"sd__tags\"><span>Fotografia eventowa</span><span>Konferencje</span><span>Targi</span><span>Premiery</span><span>Wydarzenia firmowe</span><span>Relacja na social media</span></div></div></details>\n      <details class=\"sd__g reveal\" open><summary><h3>Architektura i&nbsp;wnętrza</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Zdjęcia inwestycji, wnętrz, obiektów i&nbsp;przestrzeni komercyjnych – do&nbsp;materiałów sprzedażowych, na&nbsp;stronę i&nbsp;do&nbsp;portali.</p><div class=\"sd__tags\"><span>Fotografia architektury</span><span>Wnętrza</span><span>Inwestycje</span><span>Hotele i gastronomia</span><span>Obiekty komercyjne</span><span>Zdjęcia nieruchomości</span></div></div></details>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-proces\">\n      <div class=\"sd__blkh reveal\"><h2>Nasze możliwości <span style=\"color:#ffd200\">fotograficzne.</span></h2></div>\n      <div class=\"sd__steps\">\n        <div class=\"sd__step reveal\"><h3>Fotografia</h3><p>Sesje produktowe, reklamowe, biznesowe, wizerunkowe i&nbsp;eventowe.</p></div>\n        <div class=\"sd__step reveal\"><h3>Studio</h3><p>Kontrolowane światło, fotografia produktowa, packshoty i&nbsp;sesje wizerunkowe.</p></div>\n        <div class=\"sd__step reveal\"><h3>Fotografia w&nbsp;lokalizacji</h3><p>Sesje w&nbsp;siedzibie firmy, przestrzeni miejskiej, wnętrzach i&nbsp;plenerze.</p></div>\n        <div class=\"sd__step reveal\"><h3>Fotografia z&nbsp;drona</h3><p>Zdjęcia lotnicze inwestycji, nieruchomości, przemysłu, eventów i&nbsp;motoryzacji.</p></div>\n        <div class=\"sd__step reveal\"><h3>Postprodukcja</h3><p>Selekcja, korekcja kolorystyczna, retusz i&nbsp;przygotowanie gotowych plików.</p></div>\n      </div>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-work\">\n      <div class=\"sd__blkh reveal\"><h2>Realizacje</h2></div>\n      <div class=\"sd__work\">\n        <a class=\"sd__wi reveal\" href=\"../../realizacja-exlantix/\"><div class=\"sd__wm\"><img src=\"/assets/portfolio/exlantix/exlantix-premiera-marki-gdansk-fotografia-18.jpg\" alt=\"EXLANTIX – Event · Fotografia\" loading=\"lazy\" /></div><span>Event · Fotografia</span><h3>EXLANTIX ↗</h3></a>\n        <a class=\"sd__wi reveal\" href=\"../../realizacja-denza/\"><div class=\"sd__wm\"><img src=\"/assets/portfolio/denza/denza-z9-gt-premiera-fotografia-06.jpg\" alt=\"DENZA – Premiera · Fotografia\" loading=\"lazy\" /></div><span>Premiera · Fotografia</span><h3>DENZA ↗</h3></a>\n        <a class=\"sd__wi reveal\" href=\"../../portfolio/?cat=foto#pt-grid\"><div class=\"sd__wm\"><img src=\"/assets/portfolio/nfm/nfm-fotografia-wydarzenia-01.avif\" alt=\"NFM – NFM · Fotografia wydarzenia\" loading=\"lazy\" /></div><span>NFM · Fotografia wydarzenia</span><h3>NFM ↗</h3></a>\n      </div>\n      <div class=\"sd__more reveal\">\n        <a class=\"is-lead\" href=\"../../portfolio/#pt-grid\">Całe portfolio ↗</a>\n        <a href=\"../../portfolio/?cat=video#pt-grid\">Wideo</a>\n        <a href=\"../../portfolio/?cat=animacje#pt-grid\">Animacje</a>\n        <a href=\"../../portfolio/?cat=eventy#pt-grid\">Eventy</a>\n        <a href=\"../../portfolio/?cat=grafika#pt-grid\">Grafika</a>\n      </div>\n    </section>\n  </div>\n</div>\n</div>";
---

