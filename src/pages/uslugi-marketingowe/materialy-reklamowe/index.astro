---
import BaseLayout from './../../../layouts/BaseLayout.astro';
const pageHtml = "<div class=\"sd\">\n<section class=\"sd__hero shell\">\n  <span class=\"sd__kick reveal\"><i></i>Usługi</span>\n  <h1 class=\"sd__h1 reveal\">Materiały <span style=\"color:#ffd200\">reklamowe.</span></h1>\n  <p class=\"sd__lead reveal\" data-d=\"1\">Katalog, folder i&nbsp;prezentacja to&nbsp;często <b>ostatnia rzecz przed decyzją</b> klienta – dlatego traktujemy je&nbsp;jak narzędzie sprzedaży, nie&nbsp;jak ozdobę.</p>\n  <p class=\"sd__lead reveal\" data-d=\"1\">Projektujemy materiały drukowane i&nbsp;cyfrowe: katalogi, foldery, ulotki, prezentacje, materiały POS i&nbsp;gadżety – spójne z&nbsp;identyfikacją marki.</p>\n  <div class=\"sd__facts reveal\" data-d=\"2\">\n    <div class=\"sd__fact\"><span>Zakres</span><strong>Print · POS · prezentacje</strong></div>\n    <div class=\"sd__fact\"><span>Hierarchia</span><strong>Treść prowadzi do&nbsp;decyzji</strong></div>\n    <div class=\"sd__fact\"><span>Pliki</span><strong>Gotowe do&nbsp;druku</strong></div>\n    <div class=\"sd__fact\"><span>Adaptacje</span><strong>Wersje digital</strong></div>\n  </div>\n  <figure class=\"sd__reel reveal\" data-d=\"1\">\n    <img src=\"/assets/work/audi-kartka.jpg\" alt=\"Audi\" loading=\"eager\" fetchpriority=\"high\" />\n    <figcaption><b>Audi</b><span>Premium print / materiały sprzedażowe</span></figcaption>\n  </figure>\n</section>\n<div class=\"sd__body shell\">\n  <div>\n    <section class=\"sd__blk\" id=\"sd-zakres\">\n      <div class=\"sd__blkh reveal\"><h2>Co robimy</h2></div>\n      <details class=\"sd__g reveal\" open><summary><h3>Katalogi i&nbsp;foldery</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Materiały informacyjne i&nbsp;sprzedażowe z&nbsp;czytelną hierarchią treści – od&nbsp;jednostronicowej ulotki po&nbsp;katalog produktowy.</p><div class=\"sd__tags\"><span>Katalog produktowy</span><span>Folder reklamowy</span><span>Ulotka</span><span>Broszura</span><span>Cennik</span><span>Karta produktu</span></div></div></details>\n      <details class=\"sd__g reveal\" open><summary><h3>Prezentacje i&nbsp;oferty</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Decki sprzedażowe, prezentacje ofertowe i&nbsp;partner decki – dokumenty, które sprzedają bez&nbsp;obecności handlowca.</p><div class=\"sd__tags\"><span>Prezentacja sprzedażowa</span><span>Deck ofertowy</span><span>Partner deck</span><span>Szablon prezentacji</span><span>Raport i podsumowanie</span><span>One-pager</span></div></div></details>\n      <details class=\"sd__g reveal\"><summary><h3>POS i&nbsp;event</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Nośniki do&nbsp;ekspozycji w&nbsp;punkcie sprzedaży i&nbsp;na&nbsp;wydarzeniach: standy, ścianki, roll-upy i&nbsp;oznakowanie stoiska.</p><div class=\"sd__tags\"><span>Standy i ekspozytory</span><span>Roll-up</span><span>Ścianka eventowa</span><span>Oznakowanie stoiska</span><span>Materiały na targi</span><span>Naklejki i witryny</span></div></div></details>\n      <details class=\"sd__g reveal\"><summary><h3>Gadżety i&nbsp;upominki</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Odzież firmowa i&nbsp;upominki z&nbsp;logo – dobrane tak, żeby&nbsp;ktoś realnie chciał ich używać.</p><div class=\"sd__tags\"><span>Odzież firmowa</span><span>Gadżety z logo</span><span>Zestawy powitalne</span><span>Upominki dla klientów</span><span>Materiały konferencyjne</span><span>Opakowania</span></div></div></details>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-proces\">\n      <div class=\"sd__blkh reveal\"><h2>Jak pracujemy</h2></div>\n      <div class=\"sd__steps\">\n        <div class=\"sd__step reveal\"><h3>Zakres</h3><p>Ustalamy, komu materiał ma&nbsp;pomóc podjąć decyzję.</p></div>\n        <div class=\"sd__step reveal\"><h3>Treść</h3><p>Porządkujemy informacje i&nbsp;hierarchię argumentów.</p></div>\n        <div class=\"sd__step reveal\"><h3>Projekt</h3><p>Układ, typografia i&nbsp;zdjęcia w&nbsp;stylu marki.</p></div>\n        <div class=\"sd__step reveal\"><h3>Przygotowanie</h3><p>Spady, kolory i&nbsp;pliki pod&nbsp;wybraną technikę.</p></div>\n        <div class=\"sd__step reveal\"><h3>Druk</h3><p>Nadzór nad&nbsp;produkcją i&nbsp;wersje cyfrowe.</p></div>\n      </div>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-work\">\n      <div class=\"sd__blkh reveal\"><h2>Realizacje</h2></div>\n      <div class=\"sd__work\">\n        <a class=\"sd__wi reveal\" href=\"../../realizacja-kapka/\"><div class=\"sd__wm\"><img src=\"/assets/portfolio/kapka/kapka-menu.jpg\" alt=\"Kapka Cafe – Menu · Print\" loading=\"lazy\" /></div><span>Menu · Print</span><h3>Kapka Cafe ↗</h3></a>\n        <a class=\"sd__wi reveal\" href=\"../../portfolio/?cat=grafika#pt-grid\"><div class=\"sd__wm\"><img src=\"/assets/portfolio/spenner/marcin-spenner-projekt-okladki-plyty-01.avif\" alt=\"Marcin Spenner – Okładka płyty · Projekt\" loading=\"lazy\" /></div><span>Okładka płyty · Projekt</span><h3>Marcin Spenner ↗</h3></a>\n        <a class=\"sd__wi reveal\" href=\"../../realizacja-world-of-warships/\"><div class=\"sd__wm\"><img src=\"/assets/work/captains-club-1.avif\" alt=\"World of Warships – Materiały · Event\" loading=\"lazy\" /></div><span>Materiały · Event</span><h3>World of Warships ↗</h3></a>\n      </div>\n      <div class=\"sd__more reveal\">\n        <a class=\"is-lead\" href=\"../../portfolio/#pt-grid\">Całe portfolio ↗</a>\n        <a href=\"../../portfolio/?cat=video#pt-grid\">Wideo</a>\n        <a href=\"../../portfolio/?cat=animacje#pt-grid\">Animacje</a>\n        <a href=\"../../portfolio/?cat=eventy#pt-grid\">Eventy</a>\n        <a href=\"../../portfolio/?cat=grafika#pt-grid\">Grafika</a>\n      </div>\n    </section>\n  </div>\n</div>\n</div>";
---

