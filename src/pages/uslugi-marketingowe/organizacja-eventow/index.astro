---
import BaseLayout from './../../../layouts/BaseLayout.astro';
const pageHtml = "<div class=\"sd\">\n<section class=\"sd__hero shell\">\n  <span class=\"sd__kick reveal\"><i></i>Usługi</span>\n  <h1 class=\"sd__h1 reveal\">Organizacja <span style=\"color:#ffd200\">eventów.</span></h1>\n  <p class=\"sd__lead reveal\" data-d=\"1\"><b>Event to&nbsp;więcej niż dzień wydarzenia.</b> Zajmujemy się całym procesem – od&nbsp;koncepcji i&nbsp;organizacji, przez scenografię, branding i&nbsp;produkcję materiałów, po&nbsp;obsługę wydarzenia, foto, wideo i&nbsp;komunikację.</p>\n  <p class=\"sd__lead reveal\" data-d=\"1\">Konferencje, premiery, targi, eventy firmowe i&nbsp;wydarzenia specjalne realizujemy kompleksowo lub przejmujemy wybrany zakres produkcji.</p>\n  <div class=\"sd__facts reveal\" data-d=\"2\">\n    <div class=\"sd__fact\"><span>Koncepcja</span><strong>Pomysł i&nbsp;format wydarzenia</strong></div>\n    <div class=\"sd__fact\"><span>Organizacja</span><strong>Logistyka i&nbsp;przygotowanie</strong></div>\n    <div class=\"sd__fact\"><span>Koordynacja</span><strong>Obsługa wydarzenia na&nbsp;miejscu</strong></div>\n    <div class=\"sd__fact\"><span>Foto + wideo</span><strong>Fotorelacja i&nbsp;wideorelacja</strong></div>\n  </div>\n  <figure class=\"sd__reel reveal\" data-d=\"1\">\n    <img src=\"/assets/work/balet.avif\" alt=\"Widowisko\" loading=\"eager\" fetchpriority=\"high\" />\n    <figcaption><b>Widowisko</b><span>Event / relacja live</span></figcaption>\n  </figure>\n</section>\n<div class=\"sd__body shell\">\n  <div>\n    <section class=\"sd__blk\" id=\"sd-zakres\">\n      <div class=\"sd__blkh reveal\"><h2>Co organizujemy</h2></div>\n      <details class=\"sd__g reveal\" open><summary><h3>Konferencje i&nbsp;spotkania biznesowe</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Kompleksowa organizacja konferencji, seminariów, warsztatów i&nbsp;spotkań biznesowych – od&nbsp;koncepcji i&nbsp;lokalizacji po&nbsp;obsługę na&nbsp;miejscu.</p><div class=\"sd__tags\"><span>Konferencje</span><span>Seminaria</span><span>Warsztaty</span><span>Spotkania biznesowe</span><span>Kongresy</span><span>Panele dyskusyjne</span></div></div></details>\n      <details class=\"sd__g reveal\" open><summary><h3>Targi i&nbsp;wystawy</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Przygotowujemy obecność marek na&nbsp;targach i&nbsp;wystawach. Projektujemy przestrzeń, materiały, komunikację oraz content wykorzystywany podczas wydarzenia.</p><div class=\"sd__tags\"><span>Targi branżowe</span><span>Wystawy</span><span>Stoiska targowe</span><span>Zabudowa</span><span>Materiały POS</span><span>Multimedia</span></div></div></details>\n      <details class=\"sd__g reveal\" open><summary><h3>Premiery i&nbsp;eventy marek</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Organizujemy premiery produktów, otwarcia, wydarzenia promocyjne i&nbsp;spotkania dla&nbsp;klientów, tworząc spójną koncepcję wydarzenia i&nbsp;jego oprawy.</p><div class=\"sd__tags\"><span>Premiery produktów</span><span>Otwarcia</span><span>Eventy promocyjne</span><span>Eventy dla klientów</span><span>Aktywacje marki</span><span>Roadshow</span></div></div></details>\n      <details class=\"sd__g reveal\"><summary><h3>Eventy firmowe</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Realizujemy wydarzenia wewnętrzne i&nbsp;integracyjne – od&nbsp;kameralnych spotkań zespołu po&nbsp;większe wydarzenia firmowe.</p><div class=\"sd__tags\"><span>Eventy firmowe</span><span>Integracje</span><span>Jubileusze</span><span>Gale</span><span>Spotkania pracownicze</span><span>Employer branding</span></div></div></details>\n      <details class=\"sd__g reveal\"><summary><h3>Wydarzenia specjalne</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Produkujemy niestandardowe projekty wymagające indywidualnej koncepcji oraz zaplecza produkcyjnego.</p><div class=\"sd__tags\"><span>Wydarzenia kulturalne</span><span>Koncerty</span><span>Eventy plenerowe</span><span>Akcje specjalne</span></div></div></details>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-proces\">\n      <div class=\"sd__blkh reveal\"><h2>Kompleksowa produkcja <span style=\"color:#ffd200\">eventu.</span></h2></div>\n      <div class=\"sd__steps\">\n        <div class=\"sd__step reveal\"><h3>Koncepcja</h3><p>Pomysł, motyw wydarzenia, scenariusz i&nbsp;harmonogram.</p></div>\n        <div class=\"sd__step reveal\"><h3>Organizacja</h3><p>Lokalizacja, logistyka, podwykonawcy i&nbsp;koordynacja produkcji.</p></div>\n        <div class=\"sd__step reveal\"><h3>Scenografia i&nbsp;materiały</h3><p>Projekt przestrzeni, oznakowanie, zabudowa, wydruki i&nbsp;materiały eventowe.</p></div>\n        <div class=\"sd__step reveal\"><h3>Technika</h3><p>Scena, światło, dźwięk, multimedia i&nbsp;rozwiązania techniczne.</p></div>\n        <div class=\"sd__step reveal\"><h3>Foto i&nbsp;wideo</h3><p>Fotorelacja, aftermovie, reels, wywiady, streaming i&nbsp;materiały do&nbsp;dalszej komunikacji.</p></div>\n        <div class=\"sd__step reveal\"><h3>Promocja i&nbsp;komunikacja</h3><p>Zapowiedzi, kreacje, social media, kampanie i&nbsp;komunikacja wydarzenia.</p></div>\n      </div>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-work\">\n      <div class=\"sd__blkh reveal\"><h2>Realizacje</h2></div>\n      <div class=\"sd__work\">\n        <a class=\"sd__wi reveal\" href=\"../../realizacja-exlantix/\"><div class=\"sd__wm\"><img src=\"/assets/portfolio/exlantix/exlantix-premiera-marki-gdansk-fotografia-21.jpg\" alt=\"EXLANTIX – Premiera marki · Event\" loading=\"lazy\" /></div><span>Premiera marki · Event</span><h3>EXLANTIX ↗</h3></a>\n        <a class=\"sd__wi reveal\" href=\"../../realizacja-denza/\"><div class=\"sd__wm\"><img src=\"/assets/portfolio/denza/denza-z9-gt-premiera-fotografia-03.jpg\" alt=\"DENZA – Premiera Z9 GT · Event\" loading=\"lazy\" /></div><span>Premiera Z9 GT · Event</span><h3>DENZA ↗</h3></a>\n        <a class=\"sd__wi reveal\" href=\"../../realizacja-world-of-warships/\"><div class=\"sd__wm\"><img src=\"/assets/work/captains-club-int.avif\" alt=\"World of Warships – Captain's Club · Event\" loading=\"lazy\" /></div><span>Captain's Club · Event</span><h3>World of Warships ↗</h3></a>\n      </div>\n      <div class=\"sd__more reveal\">\n        <a class=\"is-lead\" href=\"../../portfolio/#pt-grid\">Całe portfolio ↗</a>\n        <a href=\"../../portfolio/?cat=video#pt-grid\">Wideo</a>\n        <a href=\"../../portfolio/?cat=animacje#pt-grid\">Animacje</a>\n        <a href=\"../../portfolio/?cat=eventy#pt-grid\">Eventy</a>\n        <a href=\"../../portfolio/?cat=grafika#pt-grid\">Grafika</a>\n      </div>\n    </section>\n  </div>\n</div>\n</div>";
---

