import BaseLayout from './../../../layouts/BaseLayout.astro';
const pageHtml = "<div class=\"sd\">\n<section class=\"sd__hero shell\">\n  <span class=\"sd__kick reveal\"><i></i>Usługi</span>\n  <h1 class=\"sd__h1 reveal\">Identyfikacja <span style=\"color:#ffd200\">wizualna.</span></h1>\n  <p class=\"sd__lead reveal\" data-d=\"1\">Identyfikacja to&nbsp;nie samo logo, a&nbsp;<b>zestaw decyzji</b>, które sprawiają, że&nbsp;marka wygląda tak samo na&nbsp;stronie, w&nbsp;reklamie, na&nbsp;fakturze i&nbsp;na&nbsp;banerze przed budynkiem.</p>\n  <p class=\"sd__lead reveal\" data-d=\"1\">Projektujemy znak, kolory, typografię i&nbsp;zasady użycia, a&nbsp;potem materiały startowe, żeby&nbsp;system od&nbsp;razu wszedł do&nbsp;codziennej pracy.</p>\n  <div class=\"sd__facts reveal\" data-d=\"2\">\n    <div class=\"sd__fact\"><span>Zakres</span><strong>Logo · system · guidelines</strong></div>\n    <div class=\"sd__fact\"><span>Wynik</span><strong>Księga znaku</strong></div>\n    <div class=\"sd__fact\"><span>Start</span><strong>Materiały bazowe</strong></div>\n    <div class=\"sd__fact\"><span>Rozwój</span><strong>Przełożenie na&nbsp;kampanie</strong></div>\n  </div>\n  <figure class=\"sd__reel reveal\" data-d=\"1\">\n    <img src=\"/assets/work/captains-club-1.avif\" alt=\"Captain's Club\" loading=\"eager\" fetchpriority=\"high\" />\n    <figcaption><b>Captain's Club</b><span>Event identity / system wizualny</span></figcaption>\n  </figure>\n</section>\n<div class=\"sd__body shell\">\n  <div>\n    <section class=\"sd__blk\" id=\"sd-zakres\">\n      <div class=\"sd__blkh reveal\"><h2>Co robimy</h2></div>\n      <details class=\"sd__g reveal\" open><summary><h3>Znak i&nbsp;jego warianty</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Projekt logo z&nbsp;wersjami użytkowymi: poziomą, pionową, uproszczoną, monochromatyczną i&nbsp;sygnetem do&nbsp;małych rozmiarów.</p><div class=\"sd__tags\"><span>Projekt logo</span><span>Warianty logo</span><span>Sygnet</span><span>Wersja monochromatyczna</span><span>Pole ochronne</span><span>Minimalny rozmiar</span></div></div></details>\n      <details class=\"sd__g reveal\" open><summary><h3>System wizualny</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Kolory, typografia, siatki, styl grafiki i&nbsp;zdjęć – komplet zasad, które trzymają markę razem.</p><div class=\"sd__tags\"><span>Paleta kolorów</span><span>Typografia</span><span>Siatki i układy</span><span>Styl fotografii</span><span>Elementy graficzne</span><span>Ikonografia</span></div></div></details>\n      <details class=\"sd__g reveal\"><summary><h3>Księga znaku</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Dokument z&nbsp;zasadami użycia: co&nbsp;wolno, czego nie&nbsp;wolno i&nbsp;jak marka ma&nbsp;wyglądać w&nbsp;praktyce.</p><div class=\"sd__tags\"><span>Księga znaku</span><span>Brand guidelines</span><span>Zasady użycia</span><span>Przykłady zastosowań</span><span>Wersje plików</span><span>Instrukcja dla podwykonawców</span></div></div></details>\n      <details class=\"sd__g reveal\"><summary><h3>Materiały startowe</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Pierwszy zestaw nośników, żeby&nbsp;nowa identyfikacja od&nbsp;razu pracowała: firmówka, social, dokumenty i&nbsp;oznakowanie.</p><div class=\"sd__tags\"><span>Wizytówki</span><span>Papier firmowy</span><span>Szablony social media</span><span>Prezentacja firmowa</span><span>Oznakowanie</span><span>Materiały sprzedażowe</span></div></div></details>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-proces\">\n      <div class=\"sd__blkh reveal\"><h2>Jak pracujemy</h2></div>\n      <div class=\"sd__steps\">\n        <div class=\"sd__step reveal\"><h3>Rozpoznanie</h3><p>Rozmawiamy o&nbsp;marce, rynku i&nbsp;konkurencji.</p></div>\n        <div class=\"sd__step reveal\"><h3>Kierunki</h3><p>Pokazujemy różne drogi wizualne, nie&nbsp;jeden wariant.</p></div>\n        <div class=\"sd__step reveal\"><h3>Znak</h3><p>Dopracowujemy logo i&nbsp;jego wersje użytkowe.</p></div>\n        <div class=\"sd__step reveal\"><h3>System</h3><p>Ustalamy kolory, typografię i&nbsp;zasady.</p></div>\n        <div class=\"sd__step reveal\"><h3>Wdrożenie</h3><p>Przekładamy identyfikację na&nbsp;realne nośniki.</p></div>\n      </div>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-work\">\n      <div class=\"sd__blkh reveal\"><h2>Realizacje</h2></div>\n      <div class=\"sd__work\">\n        <a class=\"sd__wi reveal\" href=\"../../realizacja-kapka/\"><div class=\"sd__wm\"><img src=\"/assets/portfolio/kapka/kapka-logo.jpg\" alt=\"Kapka Cafe – Logo · Identyfikacja\" loading=\"lazy\" /></div><span>Logo · Identyfikacja</span><h3>Kapka Cafe ↗</h3></a>\n        <a class=\"sd__wi reveal\" href=\"../../realizacja-soho-form/\"><div class=\"sd__wm\"><img src=\"/assets/portfolio/soho-form/soho-cover.webp\" alt=\"Soho Form – Logo · Księga znaku\" loading=\"lazy\" /></div><span>Logo · Księga znaku</span><h3>Soho Form ↗</h3></a>\n        <a class=\"sd__wi reveal\" href=\"../../portfolio/?cat=grafika#pt-grid\"><div class=\"sd__wm\"><img src=\"/assets/portfolio/el-molo/el-molo-restauracja-projekt-logo.avif\" alt=\"El Molo – Logo · Restauracja\" loading=\"lazy\" /></div><span>Logo · Restauracja</span><h3>El Molo ↗</h3></a>\n      </div>\n      <div class=\"sd__more reveal\">\n        <a class=\"is-lead\" href=\"../../portfolio/#pt-grid\">Całe portfolio ↗</a>\n        <a href=\"../../portfolio/?cat=video#pt-grid\">Wideo</a>\n        <a href=\"../../portfolio/?cat=animacje#pt-grid\">Animacje</a>\n        <a href=\"../../portfolio/?cat=eventy#pt-grid\">Eventy</a>\n        <a href=\"../../portfolio/?cat=grafika#pt-grid\">Grafika</a>\n      </div>\n    </section>\n  </div>\n</div>\n</div>";
---

