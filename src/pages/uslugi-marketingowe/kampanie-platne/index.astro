import BaseLayout from './../../../layouts/BaseLayout.astro';
const pageHtml = "<div class=\"sd\">\n<section class=\"sd__hero shell\">\n  <span class=\"sd__kick reveal\"><i></i>Usługi</span>\n  <h1 class=\"sd__h1 reveal\">Kampanie <span style=\"color:#ffd200\">płatne.</span></h1>\n  <p class=\"sd__lead reveal\" data-d=\"1\"><b>Kampania zaczyna się przed uruchomieniem reklamy.</b> Najpierw określamy cel, odbiorców i&nbsp;komunikację, następnie przygotowujemy kreacje i&nbsp;konfigurujemy kampanię. Po&nbsp;starcie analizujemy wyniki i&nbsp;optymalizujemy działania.</p>\n  <p class=\"sd__lead reveal\" data-d=\"1\">Prowadzimy kampanie Google Ads, Meta Ads i&nbsp;TikTok Ads, a&nbsp;dzięki własnemu zapleczu produkcyjnemu przygotujemy również potrzebne zdjęcia, wideo, grafikę i&nbsp;landing page.</p>\n  <div class=\"sd__facts reveal\" data-d=\"2\">\n    <div class=\"sd__fact\"><span>Meta · Google · TikTok</span><strong>Kampanie dopasowane do&nbsp;kanału</strong></div>\n    <div class=\"sd__fact\"><span>Konfiguracja + emisja</span><strong>Uruchomienie i&nbsp;prowadzenie</strong></div>\n    <div class=\"sd__fact\"><span>Analityka + optymalizacja</span><strong>Wyniki i&nbsp;dalsze działania</strong></div>\n    <div class=\"sd__fact\"><span>Kreacja</span><strong>Tworzenie materiałów</strong></div>\n  </div>\n  <figure class=\"sd__reel reveal\" data-d=\"1\">\n    <img src=\"/assets/work/audi-a6-etron.jpg\" alt=\"Audi A6 e-tron\" loading=\"eager\" fetchpriority=\"high\" />\n    <figcaption><b>Audi A6 e-tron</b><span>Premiera / digital campaign</span></figcaption>\n  </figure>\n</section>\n<div class=\"sd__body shell\">\n  <div>\n    <section class=\"sd__blk\" id=\"sd-zakres\">\n      <div class=\"sd__blkh reveal\"><h2>Co robimy</h2></div>\n      <details class=\"sd__g reveal\" open><summary><h3>Meta Ads</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Prowadzimy kampanie reklamowe na&nbsp;Facebooku i&nbsp;Instagramie – kampanie zasięgowe i&nbsp;sprzedażowe oraz działania nastawione na&nbsp;pozyskiwanie leadów.</p><div class=\"sd__tags\"><span>Meta Ads</span><span>Facebook Ads</span><span>Instagram Ads</span><span>Lead Ads</span><span>Remarketing</span><span>Kampanie sprzedażowe</span><span>Kampanie zasięgowe</span></div></div></details>\n      <details class=\"sd__g reveal\" open><summary><h3>Google Ads</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Planujemy i&nbsp;prowadzimy kampanie Google Ads dopasowane do&nbsp;celu: obecność w&nbsp;wyszukiwarce, kampanie display i&nbsp;remarketing.</p><div class=\"sd__tags\"><span>Google Ads</span><span>Search</span><span>Display</span><span>Performance Max</span><span>Remarketing</span><span>YouTube Ads</span></div></div></details>\n      <details class=\"sd__g reveal\" open><summary><h3>TikTok Ads</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Przygotowujemy i&nbsp;prowadzimy kampanie TikTok Ads, wykorzystując formaty i&nbsp;kreacje dopasowane do&nbsp;sposobu, w&nbsp;jaki użytkownicy konsumują treści na&nbsp;platformie.</p><div class=\"sd__tags\"><span>TikTok Ads</span><span>Video Ads</span><span>Kampanie zasięgowe</span><span>Kampanie performance</span></div></div></details>\n      <details class=\"sd__g reveal\"><summary><h3>Kreacje reklamowe</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Kreacje przygotowujemy we&nbsp;własnym zespole – od&nbsp;koncepcji i&nbsp;copywritingu po&nbsp;grafikę, fotografię, animację i&nbsp;produkcję wideo.</p><div class=\"sd__tags\"><span>Wideo reklamowe</span><span>Social ads</span><span>Grafika</span><span>Fotografia</span><span>Animacja</span><span>Copywriting</span><span>Banery display</span></div></div></details>\n      <details class=\"sd__g reveal\"><summary><h3>Landing page</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Projektujemy landing page dopasowane do&nbsp;celu kampanii, komunikacji i&nbsp;ścieżki użytkownika tak, aby reklama prowadziła do&nbsp;miejsca przygotowanego pod konkretną konwersję.</p><div class=\"sd__tags\"><span>Landing page</span><span>Strony kampanijne</span><span>Lead generation</span><span>UX/UI</span><span>Copywriting</span></div></div></details>\n      <details class=\"sd__g reveal\"><summary><h3>Analityka i&nbsp;optymalizacja</h3><span class=\"sd__pm\"></span></summary><div class=\"sd__gin\"><p>Monitorujemy wyniki kampanii, analizujemy skuteczność kreacji i&nbsp;wykorzystujemy dane do&nbsp;optymalizacji kolejnych działań.</p><div class=\"sd__tags\"><span>Analityka</span><span>Optymalizacja kampanii</span><span>Raportowanie</span><span>Konwersje</span><span>Testy A/B</span></div></div></details>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-proces\">\n      <div class=\"sd__blkh reveal\"><h2>Od celu do&nbsp;<span style=\"color:#ffd200\">wyniku.</span></h2></div>\n      <div class=\"sd__steps\">\n        <div class=\"sd__step reveal\"><h3>Cel i&nbsp;strategia</h3><p>Ustalamy, co kampania ma osiągnąć i&nbsp;do kogo ma trafić.</p></div>\n        <div class=\"sd__step reveal\"><h3>Koncepcja</h3><p>Budujemy komunikację i&nbsp;kierunek kreacji.</p></div>\n        <div class=\"sd__step reveal\"><h3>Produkcja</h3><p>Przygotowujemy wideo, zdjęcia, grafikę, copy i&nbsp;landing page.</p></div>\n        <div class=\"sd__step reveal\"><h3>Emisja</h3><p>Konfigurujemy i&nbsp;uruchamiamy kampanię.</p></div>\n        <div class=\"sd__step reveal\"><h3>Optymalizacja</h3><p>Analizujemy dane i&nbsp;rozwijamy działania na&nbsp;podstawie wyników.</p></div>\n      </div>\n    </section>\n    <section class=\"sd__blk\" id=\"sd-work\">\n      <div class=\"sd__blkh reveal\"><h2>Realizacje</h2></div>\n      <div class=\"sd__work\">\n        <a class=\"sd__wi reveal\" href=\"../../realizacja-primespot/\"><div class=\"sd__wm\"><img src=\"/assets/portfolio/primespot/pjur-blue-wide-1.jpg\" alt=\"PrimeSpot – Meta Ads · Kampania\" loading=\"lazy\" /></div><span>Meta Ads · Kampania</span><h3>PrimeSpot ↗</h3></a>\n        <a class=\"sd__wi reveal\" href=\"../../portfolio/