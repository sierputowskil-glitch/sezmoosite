---
import BaseLayout from './../../layouts/BaseLayout.astro';
const pageHtml = "<!-- ============ COVER ============ -->\n<header class=\"cs-hero\" data-screen-label=\"Case · Cover\">\n  <div class=\"cs-hero__media\">\n    <img src=\"/assets/portfolio/denza/denza-z9-gt-premiera-fotografia-01.jpg\" alt=\"DENZA Z9 GT w kolorze morskim na białym podeście, pole golfowe w Tokarach\" />\n  </div>\n  <div class=\"cs-hero__frame\" aria-hidden=\"true\"><span></span><span></span><span></span><span></span></div>\n  <div class=\"cs-hero__hud\">\n    <span class=\"rec\">REC · 4K · 25FPS</span>\n    <span data-tc>00:00:12:08</span>\n    <span>TOKARY / PL</span>\n  </div>\n\n  <div class=\"cs-hero__inner shell\">\n    <a class=\"cs-hero__back\" href=\"../portfolio/\">← Portfolio / Realizacje</a>\n    <span class=\"eyebrow cs-hero__cat\"><span class=\"tick\"></span>SEZMOO × Grupa Plichta × DENZA · Premiera Z9 GT</span>\n    <h1 class=\"cs-title\">DENZA<br><span class=\"accent\">Z9 GT.</span></h1>\n    <p class=\"cs-hero__sub\">Plenerowa premiera flagowego <b>DENZA Z9 GT</b> na polu golfowym w Tokarach pod Gdańskiem. Elektryczny gran turismo w scenerii, która podkreśla jego elegancję.</p>\n  </div>\n\n  <div class=\"cs-scroll\" aria-hidden=\"true\"><span>SCROLL</span><i></i></div>\n</header>\n\n<!-- ============ META ============ -->\n<section class=\"cs-meta\" aria-label=\"Dane projektu\">\n  <div class=\"shell\">\n    <div class=\"cs-meta__grid\">\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Klient</div>\n        <div class=\"cs-meta__v\">Grupa Plichta<small>DENZA Gdańsk</small></div>\n      </div>\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Lokalizacja</div>\n        <div class=\"cs-meta__v\">Pole golfowe<small>Tokary k. Gdańska</small></div>\n      </div>\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Model</div>\n        <div class=\"cs-meta__v\">Z9 GT<small>Elektryczne GT</small></div>\n      </div>\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Format</div>\n        <div class=\"cs-meta__v\">Premiera<small>Event plenerowy</small></div>\n      </div>\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Zakres</div>\n        <div class=\"cs-meta__v\">Full-service<small>Scenografia · Foto/wideo</small></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ 01 · O PROJEKCIE ============ -->\n<section class=\"cs-sec\" data-screen-label=\"O projekcie\">\n  <div class=\"shell\">\n    <div class=\"cs-intro__grid\">\n      <div class=\"reveal\">\n        <span class=\"cs-sec__no\">O PROJEKCIE</span>\n        <h2 class=\"cs-sec__title\">Elegancki debiut<br>w plenerowej <span class=\"accent\">scenerii.</span></h2>\n      </div>\n      <div class=\"cs-body reveal\" data-d=\"1\">\n        <p>Dla naszego wieloletniego partnera, <strong>Grupy Plichta</strong>, zrealizowaliśmy plenerową premierę flagowego DENZA Z9 GT. Marka premium potrzebowała oprawy, która połączy technologiczny charakter auta z lekką, letnią atmosferą wydarzenia.</p>\n        <p>Zamiast sali wystawowej postawiliśmy na pole golfowe w Tokarach: zieleń, białe podesty ekspozycyjne, hortensje i elegancki wystrój ogrodowy, na których morskie i srebrne nadwozia Z9 GT wyglądały jak na wybiegu.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ 02 · REALIZACJA ============ -->\n<section class=\"cs-sec\" style=\"padding-top:0\" data-screen-label=\"Realizacja\">\n  <div class=\"shell\">\n    <span class=\"cs-sec__no reveal\">REALIZACJA</span>\n    <h2 class=\"cs-sec__title reveal\">Od scenografii<br>po materiały na żywo.</h2>\n\n    <div class=\"cs-steps\">\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">V1, 01</span>\n        <h3 class=\"cs-step__title\">Scenografia i podesty</h3>\n        <p class=\"cs-step__desc\">Białe, lakierowane podesty ekspozycyjne, ścianka premierowa Z9 GT, tablice ze specyfikacją i dekoracje kwiatowe wkomponowane w zieleń pola golfowego.</p>\n      </div>\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">V1, 02</span>\n        <h3 class=\"cs-step__title\">Ekspozycja modeli</h3>\n        <p class=\"cs-step__desc\">Prezentacja dwóch wersji kolorystycznych Z9 GT, morskiej i srebrnej, ustawionych tak, by pokazać sylwetkę, detale nadwozia i 21-calowe felgi z pełną czytelnością.</p>\n      </div>\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">V1, 03</span>\n        <h3 class=\"cs-step__title\">Detale i wnętrze</h3>\n        <p class=\"cs-step__desc\">Zdjęcia detali: reflektorów, felg, bordowej i ciemnej tapicerki oraz centralnego ekranu, pokazujące poziom wykończenia auta segmentu premium.</p>\n      </div>\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">V1, 04</span>\n        <h3 class=\"cs-step__title\">Content production na żywo</h3>\n        <p class=\"cs-step__desc\">Pełna obsługa foto i wideo podczas wydarzenia: reportaż, ujęcia produktowe i materiały social gotowe do publikacji tuż po premierze.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ GALLERY ============ -->\n<section class=\"cs-gallery bleed\" aria-label=\"Kadry z realizacji\">\n  <div class=\"cs-row\">\n    <figure class=\"cs-shot cs-shot--wide reveal\" data-parallax=\"30\">\n      <div class=\"frame-media cs-shot__media\">\n        <img src=\"/assets/portfolio/denza/denza-z9-gt-premiera-fotografia-12.jpg\" alt=\"DENZA Z9 GT w kolorze morskim z otwartymi drzwiami na scenie premierowej z tablicą specyfikacji\" loading=\"lazy\" />\n      </div>\n      <span class=\"cs-shot__tag\">Scena · Premiera</span>\n      <span class=\"cs-shot__tc\" data-tc>00:01:04:11</span>\n    </figure>\n  </div>\n\n  <div class=\"cs-row cs-row--split\">\n    <figure class=\"cs-shot cs-shot--tall reveal\" data-parallax=\"24\">\n      <div class=\"frame-media cs-shot__media\">\n        <img src=\"/assets/portfolio/denza/denza-z9-gt-premiera-fotografia-03.jpg\" alt=\"Srebrny DENZA Z9 GT na trawie pola golfowego przed drewnianą wiatą\" loading=\"lazy\" />\n      </div>\n      <span class=\"cs-shot__tag\">EXT · Srebrny</span>\n      <span class=\"cs-shot__tc\" data-tc>00:02:18:03</span>\n    </figure>\n    <figure class=\"cs-shot cs-shot--tall reveal\" data-d=\"1\" data-parallax=\"24\">\n      <div class=\"frame-media cs-shot__media\">\n        <img src=\"/assets/portfolio/denza/denza-z9-gt-premiera-fotografia-07.jpg\" alt=\"Wnętrze DENZA Z9 GT z bordową tapicerką i centralnym ekranem\" loading=\"lazy\" />\n      </div>\n      <span class=\"cs-shot__tag\">INT · Bordo</span>\n      <span class=\"cs-shot__tc\" data-tc>00:03:41:22</span>\n    </figure>\n  </div>\n\n  <div class=\"cs-row\">\n    <figure class=\"cs-shot cs-shot--full reveal\" data-parallax=\"30\">\n      <div class=\"frame-media cs-shot__media\">\n        <img src=\"/assets/portfolio/denza/denza-z9-gt-premiera-fotografia-04.jpg\" alt=\"Srebrny DENZA Z9 GT z boku na tle wiaty pola golfowego\" loading=\"lazy\" />\n      </div>\n      <span class=\"cs-shot__tag\">EXT · Sylwetka</span>\n      <span class=\"cs-shot__tc\" data-tc>00:05:09:14</span>\n    </figure>\n  </div>\n\n  <div class=\"cs-row cs-row--split\">\n    <figure class=\"cs-shot cs-shot--tall reveal\" data-parallax=\"24\">\n      <div class=\"frame-media cs-shot__media\">\n        <img src=\"/assets/portfolio/denza/denza-z9-gt-premiera-fotografia-05.jpg\" alt=\"Zbliżenie na front morskiego DENZA Z9 GT przy ściance premierowej\" loading=\"lazy\" />\n      </div>\n      <span class=\"cs-shot__tag\">Detal · Front</span>\n      <span class=\"cs-shot__tc\" data-tc>00:06:33:09</span>\n    </figure>\n    <figure class=\"cs-shot cs-shot--tall reveal\" data-d=\"1\" data-parallax=\"24\">\n      <div class=\"frame-media cs-shot__media\">\n        <img src=\"/assets/portfolio/denza/denza-z9-gt-premiera-fotografia-11.jpg\" alt=\"Zbliżenie na 21-calową felgę srebrnego DENZA Z9 GT\" loading=\"lazy\" />\n      </div>\n      <span class=\"cs-shot__tag\">Detal · Felga</span>\n      <span class=\"cs-shot__tc\" data-tc>00:07:21:05</span>\n    </figure>\n  </div>\n\n  <div class=\"cs-row\">\n    <figure class=\"cs-shot cs-shot--full reveal\" data-parallax=\"30\">\n      <div class=\"frame-media cs-shot__media\">\n        <img src=\"/assets/portfolio/denza/denza-z9-gt-premiera-fotografia-09.jpg\" alt=\"Przygotowanie ekspozycji morskiego DENZA Z9 GT na podeście przy ściance premierowej\" loading=\"lazy\" />\n      </div>\n      <span class=\"cs-shot__tag\">Behind · Setup</span>\n      <span class=\"cs-shot__tc\" data-tc>00:08:44:20</span>\n    </figure>\n  </div>\n</section>\n\n<!-- ============ EFEKT KOŃCOWY ============ -->\n<section class=\"cs-quote\" aria-label=\"Efekt końcowy\">\n  <div class=\"shell cs-sec\">\n    <div class=\"cs-quote__inner reveal\">\n      <blockquote><span class=\"mark\">„</span>Plenerowa sceneria pola golfowego i dopracowana ekspozycja pozwoliły pokazać DENZA Z9 GT dokładnie tak, jak zasługuje marka premium: elegancko, spokojnie i z dbałością o każdy detal.<span class=\"mark\">”</span></blockquote>\n      <div class=\"cs-quote__by\">– <b>Zespół SEZMOO</b> · Realizacja full-service</div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ NEXT PROJECT ============ -->\n<a class=\"cs-next bleed\" href=\"../realizacja-exlantix/\" data-cursor=\"link\" aria-label=\"Następna realizacja, EXLANTIX\">\n  <img src=\"/assets/portfolio/exlantix/exlantix-premiera-marki-gdansk-fotografia-21.jpg\" alt=\"Premiera marki EXLANTIX w Gdańsku\" />\n  <div class=\"cs-next__inner shell\">\n    <span class=\"cs-next__k\">Następna realizacja →</span>\n    <span class=\"cs-next__title\">EXLANTIX <span class=\"arrow\">→</span></span>\n    <span class=\"cs-next__cat\">Event · Premiera marki</span>\n  </div>\n</a>";
const extraHeadHtml = "<link rel=\"stylesheet\" href=\"/assets/css/case-study.css\" />";
---

<BaseLayout
  lang="pl"
  title="Premiera DENZA Z9 GT w Tokarach · Realizacja SEZMOO"
  description="Case study SEZMOO: plenerowa premiera DENZA Z9 GT na polu golfowym w Tokarach pod Gdańskiem. Scenografia, ekspozycja modeli, oprawa eventu oraz produkcja foto i wideo."
  canonical="https://sezmoo.com/realizacja-denza/"
  extraHead={extraHeadHtml}
>
  <Fragment set:html={pageHtml} />
</BaseLayout>
