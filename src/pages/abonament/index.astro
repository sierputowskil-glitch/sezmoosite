x,2vw,26px);font-weight:800;letter-spacing:-.015em;margin-top:4px}\n.packs__foot{display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap;margin-top:clamp(48px,6vw,72px)}\n.packs__foot p{font-size:clamp(24px,2.6vw,38px);letter-spacing:-.015em;line-height:1.15;max-width:720px;text-wrap:pretty}\n@media (max-width:760px){\n  .packs{margin-inline:-20px}\n  .pack{grid-template-columns:1fr!important;gap:6px;padding:26px 28px}\n  .pack__p{text-align:left;margin-top:10px}\n}\n\n/* realizacje (ciemna) */\n.dark{background:var(--ink);color:var(--ink-fg)}\n.dark .lead,.dark .muted{color:var(--ink-dim)}\n.works{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;list-style:none}\n.work__img{position:relative;aspect-ratio:3/2;border-radius:4px;overflow:hidden;background:var(--ink-2)}\n.work__img img{width:100%;height:100%;object-fit:cover;filter:saturate(.9) brightness(.92);transition:transform .6s cubic-bezier(.2,.7,.2,1),filter .4s}\n.work{display:block}\n.work:hover .work__img img{transform:scale(1.04);filter:none}\n.work__meta h3{transition:color .3s}\n.work:hover h3{color:var(--y)}\n.work__tag{position:absolute;left:14px;top:14px;font-family:var(--mono);font-size:11px;letter-spacing:.16em;background:var(--y);color:var(--on-y);padding:5px 9px;border-radius:2px}\n.work__meta{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-top:14px}\n.work__meta h3{font-size:22px;font-weight:800;letter-spacing:-.015em;font-stretch:108%}\n.work__meta p{font-size:15px;color:var(--ink-dim);text-align:right}\n@media (max-width:980px){.works{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media (max-width:560px){.works{grid-template-columns:1fr}}\n\n/* dlaczego */\n.why__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--fg);list-style:none}\n.why__grid li{padding:32px 28px 36px;border-bottom:1px solid var(--line);border-right:1px solid var(--line);display:flex;flex-direction:column;gap:10px}\n.why__grid li:nth-child(3n){border-right:0}\n.why__grid li:nth-child(3n+1){padding-left:0}\n.why__grid h3{font-size:clamp(21px,1.9vw,26px);font-weight:800;letter-spacing:-.015em}\n.why__grid p{color:var(--fg-dim);font-size:17px}\n@media (max-width:980px){.why__grid{grid-template-columns:1fr 1fr}.why__grid li{padding-left:0!important;padding-right:20px}.why__grid li:nth-child(3n){border-right:1px solid var(--line)}.why__grid li:nth-child(2n){border-right:0;padding-left:20px!important}}\n@media (max-width:560px){.why__grid{grid-template-columns:1fr}.why__grid li{border-right:0!important;padding-left:0!important}}\n\n/* zakres */\n.scope{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;list-style:none}\n.scope__img{aspect-ratio:4/5;border-radius:4px;overflow:hidden;background:var(--bg-3)}\n.scope__img img{width:100%;height:100%;object-fit:cover}\n.scope h3{font-size:24px;font-weight:800;letter-spacing:-.015em;margin-top:18px}\n.scope p{color:var(--fg-dim);font-size:16px;margin-top:6px}\n@media (min-width:981px){.scope li:nth-child(even){margin-top:56px}}\n.works__more{display:flex;justify-content:center;margin-top:clamp(40px,5vw,64px)}\n.btn--ghost-y{border-color:var(--y);color:var(--y)}\n.btn--ghost-y:hover{background:var(--y);color:var(--on-y)}\n.dark .em.y{color:var(--y)}\n.scope__note{margin-top:28px;font-size:15px;color:var(--fg-dim);max-width:760px}\n@media (max-width:980px){.scope{grid-template-columns:1fr 1fr}}\n@media (max-width:480px){.scope{grid-template-columns:1fr}.scope__img{aspect-ratio:3/2}}\n\n/* dla kogo */\n.fit{display:grid;grid-template-columns:1fr 1fr;gap:24px}\n.fit__box{padding:clamp(32px,4vw,56px);border-radius:4px;display:flex;flex-direction:column;gap:20px}\n.fit__box--y{background:var(--y)}\n.fit__box--o{border:1.5px solid var(--fg)}\n.fit__box h2{font-size:clamp(28px,3vw,44px);letter-spacing:-.015em;line-height:1.05}\n.fit__box p{font-size:18px;line-height:1.55}\n@media (max-width:980px){.fit{grid-template-columns:1fr}}\n\n/* opinie */\n.quotes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;list-style:none}\n.quote{background:var(--paper);border:1px solid var(--line);border-radius:4px;padding:clamp(28px,3vw,40px);display:flex;flex-direction:column;justify-content:space-between;gap:28px}\n.quote blockquote{font-size:clamp(18px,1.5vw,21px);line-height:1.45;letter-spacing:-.01em}\n.quote cite{font-style:normal;font-weight:700;font-size:16px}\n@media (max-width:980px){.quotes{grid-template-columns:1fr}}\n\n/* zespół */\n.team{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;list-style:none}\n.tm{border:1px solid var(--line);border-radius:4px;background:var(--bg-2);overflow:hidden}\n.tm__ph{aspect-ratio:4/4.45;background:var(--bg-3);border-bottom:1px solid var(--line);overflow:hidden}\n.tm__ph img{width:100%;height:100%;object-fit:cover;filter:saturate(.86) contrast(1.04)}\n.tm__b{padding:18px 18px 20px;display:flex;flex-direction:column;gap:8px}\n.tm__no{font-family:var(--mono);font-size:11px;letter-spacing:.16em;color:var(--fg-faint)}\n.tm h3{font-size:clamp(19px,1.6vw,24px);font-weight:800;font-stretch:112%;letter-spacing:-.02em;line-height:1}\n.tm__r{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;line-height:1.45;color:var(--fg-dim)}\n.team-sec .tm{background:#14110d;border-color:rgba(243,239,233,.12)}\n.team-sec .tm__ph{background:#1c1813;border-bottom-color:rgba(243,239,233,.12)}\n.team-sec .tm__no{color:rgba(243,239,233,.45)}\n.team-sec .tm__r,.team-sec .sec__head .mono{color:rgba(243,239,233,.7)}\n@media (max-width:980px){.team{grid-template-columns:repeat(2,minmax(0,1fr))}}\n\n/* proces */\n.steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;list-style:none}\n.steps li{border-top:6px solid var(--fg);padding-top:26px;display:flex;flex-direction:column;gap:10px}\n.steps li:last-child{border-color:var(--y)}\n.steps b{font-size:clamp(56px,5vw,72px);font-weight:800;font-stretch:112%;letter-spacing:-.02em;line-height:1}\n.steps h3{font-size:24px;font-weight:800}\n.steps p{color:var(--fg-dim);font-size:17px}\n@media (max-width:760px){.steps{grid-template-columns:1fr;gap:36px}}\n\n/* FAQ */\n.faq{display:grid;grid-template-columns:minmax(0,420px) minmax(0,1fr);gap:clamp(32px,6vw,80px)}\n.faq__list{border-top:1px solid var(--fg)}\n.faq details{border-bottom:1px solid var(--line)}\n.faq summary{list-style:none;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:24px 0;font-size:clamp(18px,1.6vw,22px);font-weight:700;cursor:pointer}\n.faq summary::-webkit-details-marker{display:none}\n.faq summary svg{width:22px;height:22px;flex:none;transition:transform .3s}\n.faq details[open] summary svg{transform:rotate(45deg)}\n.faq details p{padding:0 40px 26px 0;color:var(--fg-dim);font-size:17px;line-height:1.6}\n@media (max-width:980px){.faq{grid-template-columns:1fr}}\n\n/* kontakt */\n.contact{padding-top:clamp(110px,11vw,150px)}\n.contact__grid{display:grid;grid-template-columns:1.05fr 1fr;gap:clamp(36px,5vw,76px);align-items:start}\n.contact .h2{font-size:clamp(40px,6.2vw,92px);font-weight:780;font-stretch:110%}\n.contact .h2 span{color:var(--y)}\n.cinfo{margin-top:clamp(32px,5vw,48px);list-style:none}\n.cinfo li{padding:18px 0;border-top:1px solid var(--ink-line)}\n.cinfo li:last-child{border-bottom:1px solid var(--ink-line)}\n.cinfo .mono{font-size:11px;letter-spacing:.16em;color:var(--ink-faint)}\n.cinfo a,.cinfo p{display:block;margin-top:8px;font-size:clamp(19px,1.7vw,25px);font-weight:700;font-stretch:104%;letter-spacing:-.01em}\n.cinfo a:hover{color:var(--y)}\n.cform{border:1px solid var(--ink-line);border-radius:5px;background:var(--ink-2);padding:clamp(22px,3vw,38px);display:grid;gap:16px;position:relative}\n.cform__row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;align-items:end}\n.cfield{display:flex;flex-direction:column;gap:9px}\n.cfield label{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-faint)}\n.cfield input,.cfield select,.cfield textarea{width:100%;background:var(--ink);border:1px solid var(--ink-line);border-radius:4px;padding:14px 16px;color:var(--ink-fg);font-family:var(--display);font-size:16px}\n.cfield select{appearance:none;padding-right:44px;background-image:linear-gradient(45deg,transparent 50%,var(--y) 50%),linear-gradient(135deg,var(--y) 50%,transparent 50%);background-position:calc(100% - 21px) 50%,calc(100% - 15px) 50%;background-size:6px 6px;background-repeat:no-repeat}\n.cfield textarea{min-height:120px;resize:vertical}\n.cfield input:focus,.cfield select:focus,.cfield textarea:focus{outline:none;border-color:var(--y)}\n.cfield input::placeholder,.cfield textarea::placeholder{color:var(--ink-faint)}\n.cconsent{display:flex;gap:12px;align-items:flex-start;font-size:13px;line-height:1.5;color:var(--ink-dim)}\n.cconsent input{width:18px;height:18px;margin-top:2px;flex:none;accent-color:var(--y)}\n.cconsent a{text-decoration:underline}\n.cform .btn{width:100%;margin-top:4px}\n.cform .btn .ico{width:7px;height:7px;border-radius:50%;background:currentColor}\n.cform__note{font-family:var(--mono);font-size:10px;letter-spacing:.08em;color:var(--ink-faint);text-align:center;--rec:var(--y)}\n@media (max-width:980px){.contact__grid{grid-template-columns:1fr}}\n@media (max-width:560px){.cform__row{grid-template-columns:1fr}}\n\n.foot{background:var(--ink);color:var(--ink-dim);border-top:1px solid var(--ink-line);padding-block:36px calc(36px + env(safe-area-inset-bottom,0px))}\n.foot__in{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}\n.foot img{height:20px;width:auto}\n.foot a{text-decoration:underline}\n\n/* sticky CTA (mobile) */\n.mbar{display:none}\n@media (max-width:980px){\n  .mbar{display:flex;gap:10px;position:fixed;left:0;right:0;bottom:0;z-index:50;padding:12px 16px calc(12px + env(safe-area-inset-bottom,0px));background:rgb(245 243 239 / .96);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);border-top:1px solid var(--line);transition:transform .35s}\n  .mbar .btn{flex:1;min-height:54px}\n  .mbar__tel{width:54px;height:54px;flex:none;display:grid;place-items:center;border-radius:50%;background:var(--fg);color:#fff}\n  .mbar__tel svg{width:22px;height:22px}\n  .mbar.is-hidden{transform:translateY(110%)}\n  body{padding-bottom:calc(78px + env(safe-area-inset-bottom,0px))}\n}\n</style>";
