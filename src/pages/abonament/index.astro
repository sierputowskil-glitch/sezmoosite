---
import BaseLayout from './../../layouts/BaseLayout.astro';
const pageHtml = "<!-- HERO -->\n<section class=\"hero\" id=\"top\">\n  <div class=\"shell hero__grid\">\n    <div class=\"hero__copy\">\n      <p class=\"mono\">Abonament · grafika / wideo / fotografia</p>\n      <h1 class=\"h1\">Twój dział marketingu <span class=\"thin\">nie musi być <span class=\"hl\">na&nbsp;etacie.</span></span></h1>\n      <p class=\"lead\">Stały zespół wideo, foto i grafiki z Gdańska. Kupujesz pakiet godzin w miesiącu i sam decydujesz, na co go przeznaczyć: raz film, raz sesja, raz kampania graficzna.</p>\n      <ul class=\"hero__bul\">\n        <li><svg aria-hidden=\"true\"><use href=\"#i-check\"/></svg><span><b>Dedykowany zespół</b> – bez szukania podwykonawców i pilnowania terminów.</span></li>\n        <li><svg aria-hidden=\"true\"><use href=\"#i-check\"/></svg><span><b>Pełna elastyczność</b> – wideo, foto i design w ramach jednej umowy.</span></li>\n        <li><svg aria-hidden=\"true\"><use href=\"#i-check\"/></svg><span><b>Własne studio i sprzęt</b> – oraz archiwizacja wszystkich materiałów.</span></li>\n      </ul>\n      <div class=\"hero__cta\">\n        <a class=\"btn btn--y btn--xl\" href=\"#kontakt\" data-cta=\"hero\">Bezpłatna rozmowa brief – 30&nbsp;min <svg aria-hidden=\"true\"><use href=\"#i-arrow\"/></svg></a>\n        <p class=\"hero__micro\">Niezobowiązująca rozmowa.<br />Odpowiadamy w ciągu 24h.</p>\n      </div>\n    </div>\n    <div class=\"hero__media\">\n      <div class=\"hero__frame\">\n        <img src=\"/assets/abonament/showreel-poster.webp\" alt=\"\" aria-hidden=\"true\" />\n        <iframe src=\"https://www.youtube-nocookie.com/embed/YkWCkew6OGg?autoplay=1&amp;mute=1&amp;controls=0&amp;loop=1&amp;playlist=YkWCkew6OGg&amp;playsinline=1&amp;modestbranding=1&amp;rel=0&amp;iv_load_policy=3&amp;disablekb=1&amp;fs=0\" title=\"SEZMOO showreel\" allow=\"autoplay; encrypted-media; picture-in-picture\" referrerpolicy=\"strict-origin-when-cross-origin\" tabindex=\"-1\" loading=\"eager\"></iframe>\n      </div>\n      <span class=\"hero__tc\"><span class=\"dot\"></span>SEZMOO · SHOWREEL 2026</span>\n      <svg class=\"hero__tear\" fill=\"#F5F3EF\" aria-hidden=\"true\"><use href=\"#tear\"/></svg>\n      <p class=\"hero__strip\"><span>Może być</span><b>w abonamencie.</b></p>\n    </div>\n  </div>\n  <div class=\"shell\">\n    <ul class=\"hero__bul hero__bul--m\">\n      <li><svg aria-hidden=\"true\"><use href=\"#i-check\"/></svg><span><b>Dedykowany zespół</b> – bez szukania podwykonawców i pilnowania terminów.</span></li>\n      <li><svg aria-hidden=\"true\"><use href=\"#i-check\"/></svg><span><b>Pełna elastyczność</b> – wideo, foto i design w ramach jednej umowy.</span></li>\n      <li><svg aria-hidden=\"true\"><use href=\"#i-check\"/></svg><span><b>Własne studio i sprzęt</b> – oraz archiwizacja wszystkich materiałów.</span></li>\n    </ul>\n  </div>\n</section>\n\n<!-- 5 ETATÓW -->\n<section class=\"sec\" aria-labelledby=\"jobs-h\">\n  <div class=\"shell jobs\">\n    <div class=\"jobs__intro\">\n      <h2 class=\"h2\" id=\"jobs-h\">Potrzebujesz działu <span class=\"em\">marketingu.</span> Nie potrzebujesz 5&nbsp;nowych etatów.</h2>\n      <p class=\"lead\">Własny dział to pięć rekrutacji, pięć umów, sprzęt i ciągła koordynacja. W abonamencie wszystkie te kompetencje dostajesz od jednego, zgranego zespołu.</p>\n    </div>\n    <div>\n      <ul class=\"jobs__list\" aria-label=\"Etaty, których nie musisz tworzyć\">\n        <li><s>Grafik</s><span class=\"mono\">Etat 01</span></li>\n        <li><s>Operator kamery</s><span class=\"mono\">Etat 02</span></li>\n        <li><s>Montażysta</s><span class=\"mono\">Etat 03</span></li>\n        <li><s>Fotograf</s><span class=\"mono\">Etat 04</span></li>\n        <li><s>Social media manager</s><span class=\"mono\">Etat 05</span></li>\n      </ul>\n      <div class=\"jobs__one\"><b>1 abonament SEZMOO</b><span class=\"mono\">Stały zespół<br />Dedykowany opiekun</span></div>\n    </div>\n  </div>\n</section>\n\n<!-- PROCES -->\n<section class=\"sec\" aria-labelledby=\"steps-h\" style=\"padding-top:0\">\n  <div class=\"shell\">\n    <h2 class=\"h2\" id=\"steps-h\" style=\"margin-bottom:clamp(32px,4vw,48px)\">Jak wygląda <span class=\"em\">pierwszy krok?</span></h2>\n    <ol class=\"steps\">\n      <li><b>01</b><h3>Bezpłatna rozmowa</h3><p>Do&nbsp;30 minut: poznajemy Twoje potrzeby i&nbsp;cele.</p></li>\n      <li><b>02</b><h3>Dobór pakietu</h3><p>Proponujemy pakiet godzin albo wycenę projektu testowego.</p></li>\n      <li><b>03</b><h3>Realizacja</h3><p>Produkujemy i przekazujemy gotowe materiały.</p></li>\n    </ol>\n  </div>\n</section>\n\n<!-- PAKIETY -->\n<section class=\"sec\" id=\"pakiety\" aria-labelledby=\"packs-h\">\n  <div class=\"shell\">\n    <div class=\"sec__head\">\n      <div>\n        <p class=\"mono\" style=\"margin-bottom:18px\">Pakiety godzin</p>\n        <h2 class=\"h2\" id=\"packs-h\"><span class=\"em\">Abonament.</span> Pakiet marketingowy.</h2>\n      </div>\n      <p class=\"lead\">Godziny wykorzystujesz na dowolne działania: film, foto, grafikę, social media. Zmieniasz proporcje co miesiąc, zespół zostaje ten sam.</p>\n    </div>\n    <ul class=\"packs\">\n      <li class=\"pack\"><p class=\"pack__h\">30h</p><div><h3 class=\"pack__t\">Dla mniejszych potrzeb</h3><p class=\"pack__d\">Regularne grafiki i krótkie formy wideo co miesiąc.</p></div><div class=\"pack__p\"><span class=\"mono\">Miesięcznie</span><b>Wycena indywidualna</b></div></li>\n      <li class=\"pack pack--hi pack--top\"><span class=\"pack__badge\">Najczęściej wybierany</span><p class=\"pack__h\">60h</p><div><h3 class=\"pack__t\">Dla regularnych działań</h3><p class=\"pack__d\">Stały content do&nbsp;social mediów plus sesje i&nbsp;rolki.</p></div><div class=\"pack__p\"><span class=\"mono\">Miesięcznie</span><b>Wycena indywidualna</b><a class=\"btn btn--ink pack__cta\" href=\"#kontakt\" data-cta=\"pack-60\">Chcę pakiet 60h <svg aria-hidden=\"true\"><use href=\"#i-arrow\"/></svg></a></div></li>\n      <li class=\"pack\"><p class=\"pack__h\">120h</p><div><h3 class=\"pack__t\">Dla rozwoju marki</h3><p class=\"pack__d\">Filmy, sesje i&nbsp;pełna obsługa contentu we&nbsp;wszystkich kanałach. Twój zewnętrzny dział marketingu w&nbsp;pełnym wymiarze.</p></div><div class=\"pack__p\"><span class=\"mono\">Miesięcznie</span><b>Wycena indywidualna</b></div></li>\n      <li class=\"pack\"><p class=\"pack__h\">250h</p><div><h3 class=\"pack__t\">Dla dużych projektów</h3><p class=\"pack__d\">Pełny zewnętrzny dział produkcji dla Twojej marki.</p></div><div class=\"pack__p\"><span class=\"mono\">Miesięcznie</span><b>Wycena indywidualna</b></div></li>\n    </ul>\n    <div class=\"packs__foot\">\n      <p>Darmowa konsultacja pozwoli Ci dowiedzieć się, jaki pakiet jest dla&nbsp;Ciebie.</p>\n      <a class=\"btn btn--y btn--xl\" href=\"#kontakt\" data-cta=\"packages\">Umów się <svg aria-hidden=\"true\"><use href=\"#i-arrow\"/></svg></a>\n    </div>\n  </div>\n</section>\n\n<!-- REALIZACJE -->\n<section class=\"sec dark\" aria-labelledby=\"works-h\" style=\"padding-top:clamp(110px,11vw,150px)\">\n  <svg class=\"tear\" fill=\"#F5F3EF\" aria-hidden=\"true\"><use href=\"#tear\"/></svg>\n  <div class=\"shell\">\n    <div class=\"sec__head\">\n      <h2 class=\"h2\" id=\"works-h\">Zobacz, co stworzyliśmy dla <span class=\"em y\">naszych klientów.</span></h2>\n      <p class=\"mono muted\">Wideo / foto / grafika / eventy</p>\n    </div>\n    <ul class=\"works\">\n      <li><a class=\"work\" href=\"../realizacja-denza/\" data-cta=\"work-denza\"><div class=\"work__img\"><img src=\"/assets/abonament/realizacja-denza.webp\" alt=\"Premiera DENZA Z9 GT – stoisko i goście podczas eventu, fotorelacja SEZMOO\" width=\"900\" height=\"600\" loading=\"lazy\" /><span class=\"work__tag\">EVENT</span></div><div class=\"work__meta\"><h3>DENZA</h3><p>Premiera Z9 GT</p></div></a></li>\n      <li><a class=\"work\" href=\"../portfolio/\" data-cta=\"work-audi-rs5\"><div class=\"work__img\"><img src=\"/assets/abonament/realizacja-audi-rs5.webp\" alt=\"Audi RS5 – studyjna sesja zdjęciowa\" width=\"900\" height=\"600\" loading=\"lazy\" /><span class=\"work__tag\">FOTO + WIDEO</span></div><div class=\"work__meta\"><h3>Audi RS5</h3><p>Sesja studyjna</p></div></a></li>\n      <li><a class=\"work\" href=\"../realizacja-baltic-towers-rekrutacja/\" data-cta=\"work-baltic-towers\"><div class=\"work__img\"><img src=\"/assets/abonament/realizacja-baltic-towers.webp\" alt=\"Baltic Towers – fotografia produkcji przemysłowej\" width=\"900\" height=\"600\" loading=\"lazy\" /><span class=\"work__tag\">FOTO + WIDEO</span></div><div class=\"work__meta\"><h3>Baltic Towers</h3><p>Produkcja</p></div></a></li>\n      <li><a class=\"work\" href=\"../realizacja-primespot/\" data-cta=\"work-primespot\"><div class=\"work__img\"><img src=\"/assets/abonament/realizacja-primespot.webp\" alt=\"PrimeSpot – kreacje reklamowe do kampanii Meta Ads dla inwestycji w Jastarni\" width=\"1200\" height=\"800\" loading=\"lazy\" /><span class=\"work__tag\">KAMPANIA</span></div><div class=\"work__meta\"><h3>PrimeSpot</h3><p>Kampania Meta Ads</p></div></a></li>\n      <li><a class=\"work\" href=\"../realizacja-soho-form/\" data-cta=\"work-soho-form\"><div class=\"work__img\"><img src=\"/assets/abonament/realizacja-soho-form.webp\" alt=\"Soho Form – branding i strona internetowa\" width=\"900\" height=\"506\" loading=\"lazy\" /><span class=\"work__tag\">GRAFIKA</span></div><div class=\"work__meta\"><h3>Soho Form</h3><p>Branding / WWW</p></div></a></li>\n      <li><a class=\"work\" href=\"../realizacja-doraco-hala-tvp/\" data-cta=\"work-doraco-tvp\"><div class=\"work__img\"><img src=\"/assets/abonament/realizacja-doraco-tvp.webp\" alt=\"DORACO – realizacja dla TVP\" width=\"900\" height=\"674\" loading=\"lazy\" /><span class=\"work__tag\">WIDEO</span></div><div class=\"work__meta\"><h3>DORACO</h3><p>Realizacja dla TVP</p></div></a></li>\n    </ul>\n    <div class=\"works__more\"><a class=\"btn btn--ghost-y btn--xl\" href=\"../portfolio/\" data-cta=\"portfolio\">Zobacz nasze portfolio <svg aria-hidden=\"true\"><use href=\"#i-arrow\"/></svg></a></div>\n  </div>\n</section>\n\n<!-- DLACZEGO -->\n<section class=\"sec\" aria-labelledby=\"why-h\" style=\"padding-top:clamp(110px,11vw,150px)\">\n  <svg class=\"tear\" fill=\"#0A0806\" aria-hidden=\"true\"><use href=\"#tear\"/></svg>\n  <div class=\"shell\">\n    <div class=\"sec__head\">\n      <h2 class=\"h2\" id=\"why-h\">Dlaczego abonament <span class=\"em hl\">SEZMOO?</span></h2>\n      <p class=\"lead\">Zamiast szukać kilku podwykonawców i&nbsp;spinać ich kalendarze oraz umowy, masz jeden zespół, który zna Twoją markę i&nbsp;pracuje dla niej co miesiąc.</p>\n    </div>\n    <ul class=\"why__grid\">\n      <li><span class=\"mono\">01</span><h3>14 lat i stały zespół</h3><p>Nie ma ryzyka, że twórca zniknie w trakcie realizacji.</p></li>\n      <li><span class=\"mono\">02</span><h3>Jasne rozliczenie</h3><p>Stała kwota miesięczna, a do faktury zestawienie: co powstało i ile godzin zajęło.</p></li>\n      <li><span class=\"mono\">03</span><h3>Dedykowany opiekun</h3><p>Do Twojej marki przypisujemy jedną osobę, która jest z&nbsp;Tobą w&nbsp;stałym kontakcie i&nbsp;prowadzi Twoje zlecenia.</p></li>\n      <li><span class=\"mono\">04</span><h3>Własny sprzęt</h3><p>Szybsze realizacje z&nbsp;profesjonalnym wyposażeniem.</p></li>\n      <li><span class=\"mono\">05</span><h3>Regularna produkcja</h3><p>Nie musisz się obawiać braku materiałów do&nbsp;publikacji. Dostarczamy Twój content systematycznie.</p></li>\n      <li><span class=\"mono\">06</span><h3>Podgląd w ClickUp</h3><p>Postęp zadań widzisz na bieżąco, a priorytety zatwierdzasz przed produkcją.</p></li>\n    </ul>\n  </div>\n</section>\n\n<!-- ZAKRES -->\n<section class=\"sec\" aria-labelledby=\"scope-h\" style=\"padding-top:0\">\n  <div class=\"shell\">\n    <div class=\"sec__head\">\n      <h2 class=\"h2\" id=\"scope-h\">Kompleksowa produkcja <span class=\"em\">pod jednym adresem.</span></h2>\n      <p class=\"lead\">Jeden zespół. Pełna produkcja wizualna. Zamawiasz abonament, a&nbsp;my dostarczamy komplet materiałów foto, wideo, graficznych i&nbsp;WWW.</p>\n    </div>\n    <ul class=\"scope\">\n      <li><div class=\"scope__img\"><img src=\"/assets/abonament/zakres-wideo.webp\" alt=\"Konferencja DORACO – publiczność podczas eventu, realizacja wideo i foto SEZMOO\" width=\"720\" height=\"900\" loading=\"lazy\" /></div><h3>Wideo</h3><p>Filmy, rolki, relacje, ujęcia z drona i montaż.</p></li>\n      <li><div class=\"scope__img\"><img src=\"/assets/abonament/zakres-foto.webp\" alt=\"Reflektor LED Audi RS5 w czerwonym świetle – studyjna sesja zdjęciowa samochodu SEZMOO\" width=\"720\" height=\"900\" loading=\"lazy\" /></div><h3>Fotografia</h3><p>Sesje wizerunkowe, produktowe i eventowe.</p></li>\n      <li><div class=\"scope__img\"><img src=\"/assets/abonament/zakres-grafika.webp\" alt=\"Strona internetowa Soho Form na monitorze – projekt WWW SEZMOO\" width=\"720\" height=\"900\" loading=\"lazy\" /></div><h3>Grafika i WWW</h3><p>Grafiki do social mediów, materiały sprzedażowe, druk, aktualizacje strony i landing page.</p></li>\n      <li><div class=\"scope__img\"><img src=\"/assets/abonament/zakres-social.webp\" alt=\"Grafika do social media BESTUNE T77 dla Plichta – kreacja SEZMOO\" width=\"720\" height=\"900\" loading=\"lazy\" /></div><h3>Social media</h3><p>Strategia contentu, posty, stories i publikacje.</p></li>\n    </ul>\n    <p class=\"scope__note\">Poza pakietem godzin, jako osobne projekty: key visuale i duże koncepty kampanii, katalogi, animacje 3D oraz prowadzenie kampanii płatnych.</p>\n  </div>\n</section>\n\n<!-- DLA KOGO -->\n<section class=\"sec\" aria-label=\"Dla kogo jest abonament\" style=\"padding-top:0\">\n  <div class=\"shell fit\">\n    <div class=\"fit__box fit__box--y\">\n      <p class=\"mono\">Dla kogo</p>\n      <h2 class=\"h2\">Czy abonamenty SEZMOO są dla&nbsp;Ciebie?</h2>\n      <p>Średnie i duże firmy B2B, dyrektorzy i managerowie marketingu, branża przemysłowa i marki, które potrzebują stałego dopływu wideo, foto i designu.</p>\n      <p><b>Realizujemy pakiety z&nbsp;budżetem od&nbsp;8&nbsp;100&nbsp;zł miesięcznie.</b></p>\n    </div>\n    <div class=\"fit__box fit__box--o\">\n      <p class=\"mono\">Jednorazowy projekt?</p>\n      <h2 class=\"h2\">Potrzebujesz pojedynczej realizacji?</h2>\n      <p class=\"muted\">Realizujemy także jednorazowe projekty – od&nbsp;dużych wideo po&nbsp;wdrożenia WWW. Zobacz nasze dotychczasowe prace i&nbsp;sprawdź pełną ofertę na&nbsp;naszej stronie głównej.</p>\n      <div><a class=\"btn btn--ink\" href=\"../\" data-cta=\"home\">Odwiedź SEZMOO <svg aria-hidden=\"true\"><use href=\"#i-arrow\"/></svg></a></div>\n    </div>\n  </div>\n</section>\n\n<!-- LOGOTYPY -->\n<section class=\"logos\" aria-labelledby=\"logos-h\">\n  <div class=\"shell\">\n    <div class=\"logos__top\"><h2 class=\"mono\" id=\"logos-h\">Zaufali nam</h2><p class=\"mono\">Wideo / foto / grafika</p></div>\n    <ul class=\"logos__grid\">\n      <li><img src=\"/assets/clients/audi.svg\" alt=\"Audi\" width=\"126\" height=\"40\" loading=\"lazy\" /></li>\n      <li><img class=\"logo--wide\" src=\"/assets/clients/byd.svg\" alt=\"BYD\" width=\"246\" height=\"20\" loading=\"lazy\" /></li>\n      <li><span class=\"logos__word\">Netto</span></li>\n      <li><img src=\"/assets/clients/omoda-jaecoo.svg\" alt=\"OMODA &amp; JAECOO\" width=\"118\" height=\"28\" loading=\"lazy\" /></li>\n      <li><img class=\"logo--wide\" src=\"/assets/clients/cherry.svg\" alt=\"Chery\" width=\"262\" height=\"20\" loading=\"lazy\" /></li>\n      <li><img src=\"/assets/clients/vls.svg\" alt=\"VLS\" width=\"70\" height=\"38\" loading=\"lazy\" /></li>\n      <li><img class=\"logo--wide\" src=\"/assets/clients/doraco.svg\" alt=\"Doraco\" width=\"119\" height=\"20\" loading=\"lazy\" /></li>\n      <li><img src=\"/assets/clients/velo-bank.svg\" alt=\"VeloBank\" width=\"34\" height=\"40\" loading=\"lazy\" /></li>\n      <li><span class=\"logos__word\">Baltic Towers</span></li>\n      <li><img src=\"/assets/clients/q4rail.svg\" alt=\"Q4rail\" width=\"120\" height=\"34\" loading=\"lazy\" /></li>\n      <li><img src=\"/assets/clients/2track.svg\" alt=\"2track\" width=\"50\" height=\"40\" loading=\"lazy\" /></li>\n      <li><img src=\"/assets/clients/life-dom-seniora.svg\" alt=\"Life Dom Seniora\" width=\"82\" height=\"40\" loading=\"lazy\" /></li>\n    </ul>\n  </div>\n</section>\n\n<!-- OPINIE -->\n<section class=\"sec\" aria-labelledby=\"quotes-h\" style=\"padding-top:0\">\n  <div class=\"shell\">\n    <h2 class=\"h2\" id=\"quotes-h\" style=\"margin-bottom:clamp(32px,4vw,48px)\">Co mówią <span class=\"em\">nasi klienci.</span></h2>\n    <ul class=\"quotes\">\n      <li class=\"quote\"><blockquote>„SEZMOO rozumie obraz i tempo social mediów. Materiały dostaliśmy na czas i dokładnie w stylu, jakiego potrzebowaliśmy.”</blockquote><cite>Audi Grupa Plichta</cite></li>\n      <li class=\"quote\"><blockquote>„Profesjonalne podejście od briefu po montaż. Film employer brandingowy realnie pomógł nam w rekrutacji.”</blockquote><cite>Baltic Towers</cite></li>\n      <li class=\"quote\"><blockquote>„Kreatywni, szybcy i konkretni. Współpraca, do której chętnie wracamy przy kolejnych projektach.”</blockquote><cite>33 indeed</cite></li>\n    </ul>\n  </div>\n</section>\n\n<!-- ZESPÓŁ -->\n<section class=\"sec dark team-sec\" aria-labelledby=\"team-h\" style=\"padding-top:clamp(110px,11vw,150px)\">\n  <svg class=\"tear\" fill=\"#F5F3EF\" aria-hidden=\"true\"><use href=\"#tear\"/></svg>\n  <div class=\"shell\">\n    <div class=\"sec__head\">\n      <h2 class=\"h2\" id=\"team-h\">Poznaj zespół, który <span class=\"em\">zrealizuje Twoje projekty.</span></h2>\n      <p class=\"mono\">Stały zespół · Gdańsk / PL</p>\n    </div>\n    <ul class=\"team\">\n      <li class=\"tm\"><div class=\"tm__ph\"><img src=\"/assets/abonament/team/maciej-tyma.webp\" alt=\"Maciej Tyma\" width=\"600\" height=\"466\" loading=\"lazy\" /></div><div class=\"tm__b\"><span class=\"tm__no\">T·01</span><h3>Maciej Tyma</h3><p class=\"tm__r\">Founder · Fotograf i producent wideo</p></div></li>\n      <li class=\"tm\"><div class=\"tm__ph\"><img src=\"/assets/abonament/team/hubert-fudala.webp\" alt=\"Hubert Fudała\" width=\"600\" height=\"457\" loading=\"lazy\" /></div><div class=\"tm__b\"><span class=\"tm__no\">T·02</span><h3>Hubert Fudała</h3><p class=\"tm__r\">Operator kamery i montażysta</p></div></li>\n      <li class=\"tm\"><div class=\"tm__ph\"><img src=\"/assets/abonament/team/radoslaw-schenk.webp\" alt=\"Radosław Schenk\" width=\"600\" height=\"466\" loading=\"lazy\" /></div><div class=\"tm__b\"><span class=\"tm__no\">T·03</span><h3>Radosław Schenk</h3><p class=\"tm__r\">Operator kamery i montażysta</p></div></li>\n      <li class=\"tm\"><div class=\"tm__ph\"><img src=\"/assets/abonament/team/kamil-mroz.webp\" alt=\"Kamil Mróz\" width=\"600\" height=\"457\" loading=\"lazy\" /></div><div class=\"tm__b\"><span class=\"tm__no\">T·04</span><h3>Kamil Mróz</h3><p class=\"tm__r\">Operator kamery i montażysta</p></div></li>\n      <li class=\"tm\"><div class=\"tm__ph\"><img src=\"/assets/abonament/team/olga-urbanska.webp\" alt=\"Olga Urbańska\" width=\"600\" height=\"456\" loading=\"lazy\" /></div><div class=\"tm__b\"><span class=\"tm__no\">T·05</span><h3>Olga Urbańska</h3><p class=\"tm__r\">Project &amp; Digital Marketing Manager</p></div></li>\n      <li class=\"tm\"><div class=\"tm__ph\"><img src=\"/assets/abonament/team/lukasz-sierputowski.webp\" alt=\"Łukasz Sierputowski\" width=\"600\" height=\"457\" loading=\"lazy\" /></div><div class=\"tm__b\"><span class=\"tm__no\">T·06</span><h3>Łukasz Sierputowski</h3><p class=\"tm__r\">Grafik, web designer</p></div></li>\n      <li class=\"tm\"><div class=\"tm__ph\"><img src=\"/assets/abonament/team/pawel-wyszomirski.webp\" alt=\"Paweł Wyszomirski\" width=\"600\" height=\"457\" loading=\"lazy\" /></div><div class=\"tm__b\"><span class=\"tm__no\">T·07</span><h3>Paweł Wyszomirski</h3><p class=\"tm__r\">Reżyser</p></div></li>\n      <li class=\"tm\"><div class=\"tm__ph\"><img src=\"/assets/abonament/team/dakar.webp\" alt=\"Dakar, pies studia SEZMOO\" width=\"600\" height=\"456\" loading=\"lazy\" /></div><div class=\"tm__b\"><span class=\"tm__no\">T·08</span><h3>Dakar</h3><p class=\"tm__r\">Ochrona</p></div></li>\n    </ul>\n  </div>\n</section>\n\n<!-- FAQ -->\n<section class=\"sec\" aria-labelledby=\"faq-h\" style=\"padding-top:clamp(110px,11vw,150px)\">\n  <svg class=\"tear\" fill=\"#0A0806\" aria-hidden=\"true\"><use href=\"#tear\"/></svg>\n  <div class=\"shell faq\">\n    <h2 class=\"h2\" id=\"faq-h\">Najczęściej <span class=\"em\">zadawane pytania.</span></h2>\n    <div class=\"faq__list\">\n      <details open><summary>Ile kosztuje abonament?<svg aria-hidden=\"true\"><use href=\"#i-plus\"/></svg></summary><p>Wycena jest indywidualna i zależy od pakietu godzin oraz zakresu. Po krótkim briefie dostajesz konkretną kwotę miesięczną wraz z listą tego, co się w niej zawiera. Pracujemy z&nbsp;budżetami od&nbsp;8&nbsp;100&nbsp;zł miesięcznie.</p></details>\n      <details><summary>Co, jeśli w danym miesiącu potrzebuję czegoś innego?<svg aria-hidden=\"true\"><use href=\"#i-plus\"/></svg></summary><p>Godziny nie są przypisane do jednej usługi. W jednym miesiącu może to być dzień zdjęciowy i montaż, w kolejnym sesja produktowa i paczka grafik na social media. Zakres ustalamy w planie na najbliższe tygodnie.</p></details>\n      <details><summary>Czy abonament to umowa na dłużej?<svg aria-hidden=\"true\"><use href=\"#i-plus\"/></svg></summary><p>Tak, nastawiamy się na&nbsp;dłuższą współpracę – abonament przynosi najlepsze efekty, gdy materiały powstają w&nbsp;stałym, przewidywalnym rytmie.<br /><br />Dajemy Ci jednak pełne bezpieczeństwo na&nbsp;start: zaczynamy od&nbsp;3-miesięcznego okresu próbnego. W&nbsp;tym czasie my poznajemy Twoją markę od&nbsp;podszewki, a&nbsp;Ty sprawdzasz, jak pracuje się z&nbsp;naszym zespołem. Szczegółowe warunki i&nbsp;minimalny okres umowy ustalamy indywidualnie na&nbsp;etapie wyceny.</p></details>\n      <details><summary>Skąd wiem, na co poszły godziny z pakietu?<svg aria-hidden=\"true\"><use href=\"#i-plus\"/></svg></summary><p>Każdy miesiąc kończy się zestawieniem: lista materiałów, które powstały, i liczba godzin przy każdym z nich, wysyłane razem z fakturą. W trakcie miesiąca postęp zadań widzisz w ClickUp, a priorytety zatwierdzasz przed produkcją.</p></details>\n      <details><summary>Czy możecie przejąć cały marketing?<svg aria-hidden=\"true\"><use href=\"#i-plus\"/></svg></summary><p>Tak. Działamy jako zewnętrzny dział marketingu albo jako zaplecze produkcyjne dla wewnętrznego zespołu klienta. Kampanie płatne i duże koncepty kreatywne prowadzimy jako osobne projekty.</p></details>\n      <details><summary>Czy pracujecie poza Trójmiastem?<svg aria-hidden=\"true\"><use href=\"#i-plus\"/></svg></summary><p>Baza jest w Gdańsku, a realizacje prowadzimy w całej Polsce i za granicą.</p></details>\n    </div>\n  </div>\n</section>\n\n<!-- KONTAKT -->\n<section class=\"sec dark contact\" id=\"kontakt\" aria-labelledby=\"contact-h\">\n  <svg class=\"tear\" fill=\"#F5F3EF\" aria-hidden=\"true\"><use href=\"#tear\"/></svg>\n  <div class=\"shell contact__grid\">\n    <div>\n      <p class=\"mono muted\" style=\"display:flex;align-items:center;gap:10px\"><span class=\"dot\"></span>Kontakt · gotowy do działania?</p>\n      <h2 class=\"h2\" id=\"contact-h\" style=\"margin-top:24px\">Porozmawiajmy o <span>Twojej marce.</span></h2>\n      <p class=\"lead\" style=\"margin-top:22px\">Napisz, czego potrzebujesz. Odezwiemy się w ciągu 24h i umówimy krótką, bezpłatną rozmowę o abonamencie.</p>\n      <ul class=\"cinfo\">\n        <li><span class=\"mono\">E-mail</span><a href=\"mailto:biuro@sezmoo.com\" data-cta=\"contact-mail\">biuro@sezmoo.com</a></li>\n        <li><span class=\"mono\">Telefon</span><a href=\"tel:+48739260450\" data-cta=\"contact-tel\">+48 739 260 450</a></li>\n        <li><span class=\"mono\">Studio</span><p>Zeusa 34, 80-299 Gdańsk</p></li>\n      </ul>\n    </div>\n    <form class=\"cform\" id=\"abonament-form\" name=\"abonament\" method=\"POST\" action=\"/api/contact\" novalidate>\n      <input type=\"hidden\" name=\"form-name\" value=\"abonament\" />\n      <input type=\"hidden\" name=\"lang\" value=\"pl\" />\n      <p hidden aria-hidden=\"true\"><label>Nie wypełniaj: <input name=\"bot-field\" tabindex=\"-1\" autocomplete=\"off\" /></label></p>\n      <div class=\"cform__row\">\n        <div class=\"cfield\"><label for=\"ab-name\">Imię i nazwisko</label><input id=\"ab-name\" name=\"name\" type=\"text\" autocomplete=\"name\" placeholder=\"Jan Kowalski\" required /></div>\n        <div class=\"cfield\"><label for=\"ab-company\">Firma</label><input id=\"ab-company\" name=\"company\" type=\"text\" autocomplete=\"organization\" placeholder=\"Nazwa firmy\" /></div>\n      </div>\n      <div class=\"cform__row\">\n        <div class=\"cfield\"><label for=\"ab-email\">E-mail</label><input id=\"ab-email\" name=\"email\" type=\"email\" autocomplete=\"email\" inputmode=\"email\" placeholder=\"ty@firma.pl\" required /></div>\n        <div class=\"cfield\"><label for=\"ab-phone\">Telefon</label><input id=\"ab-phone\" name=\"phone\" type=\"tel\" autocomplete=\"tel\" inputmode=\"tel\" placeholder=\"+48 ...\" /></div>\n      </div>\n      <div class=\"cform__row\">\n        <div class=\"cfield\">\n          <label for=\"ab-need\">Obszar</label>\n          <select id=\"ab-need\" name=\"need\" required>\n            <option value=\"\">Wybierz obszar</option>\n            <option>Wideo / motion</option><option>Foto</option><option>Grafika</option><option>Social media</option><option>Wszystko po trochu</option>\n          </select>\n        </div>\n        <div class=\"cfield\">\n          <label for=\"ab-package\">Pakiet</label>\n          <select id=\"ab-package\" name=\"package\">\n            <option>Nie wiem – doradźcie</option><option>30h</option><option selected>60h</option><option>120h</option><option>250h</option>\n          </select>\n        </div>\n      </div>\n      <div class=\"cfield\"><label for=\"ab-msg\">Wiadomość</label><textarea id=\"ab-msg\" name=\"message\" placeholder=\"Ile materiałów miesięcznie, jakie kanały...\" minlength=\"10\" required></textarea></div>\n      <label class=\"cconsent\"><input type=\"checkbox\" name=\"consent\" value=\"1\" required /> <span>Wyrażam zgodę na&nbsp;przetwarzanie moich danych w&nbsp;celu kontaktu, zgodnie z&nbsp;<a href=\"../polityka-prywatnosci/\" target=\"_blank\" rel=\"noopener\">polityką prywatności</a> SEZMOO.</span></label>\n      <button class=\"btn btn--y\" type=\"submit\"><span class=\"ico\"></span><span class=\"lbl\">Umawiam rozmowę</span></button>\n      <p class=\"cform__note\" role=\"status\" aria-live=\"polite\">● REC · Odpowiadamy w ciągu 24h</p>\n    </form>\n  </div>\n</section>";
const extraHeadHtml = "<style>\n:root{\n  --bg:#F5F3EF; --bg-2:#EAE8E3; --bg-3:#DDDAD3; --paper:#FBFAF7;\n  --line:#C2BDB7; --fg:#231D18; --fg-dim:#534B46; --fg-faint:#6E665F;\n  --ink:#0A0806; --ink-2:#13100E; --ink-line:#292624; --ink-fg:#F4F1ED; --ink-dim:#AEAAA5; --ink-faint:#8A857F;\n  --y:#FFD200; --on-y:#17140A; --rec:#7A5E00;\n  --pad:clamp(20px,5.5vw,80px); --maxw:1440px;\n  --display:\"Archivo\",system-ui,sans-serif; --mono:\"Space Mono\",ui-monospace,monospace;\n}\n*{box-sizing:border-box;margin:0;padding:0}\nhtml{overflow-x:clip;scroll-behavior:smooth;scroll-padding-top:90px;-webkit-text-size-adjust:100%;text-size-adjust:100%}\n@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}\nbody{background:var(--bg);color:var(--fg);font-family:var(--display);line-height:1.5;-webkit-font-smoothing:antialiased;overflow-x:clip}\nimg,video,svg{display:block;max-width:100%}\na{color:inherit;text-decoration:none}\nbutton{font:inherit;cursor:pointer}\n.shell{max-width:var(--maxw);margin:0 auto;padding-inline:var(--pad)}\n.mono{font-family:var(--mono);font-size:12px;letter-spacing:.2em;text-transform:uppercase}\n.muted{color:var(--fg-dim)}\n.skip{position:absolute;left:-999px;top:0;background:var(--y);color:var(--on-y);padding:10px 14px;z-index:100}\n.skip:focus{left:8px;top:8px}\n:focus-visible{outline:2px solid var(--fg);outline-offset:3px}\n\n/* headings */\n.h1,.h2{font-weight:720;font-stretch:104%;letter-spacing:-.02em;line-height:1.06;text-wrap:balance}\n.h1{font-size:clamp(40px,5.6vw,84px)}\n.hero .h1{font-size:clamp(44px,6.2vw,96px);font-weight:820;font-stretch:112%;letter-spacing:-.03em;line-height:.98}\n.hero .h1 .thin{display:block;font-weight:380;font-stretch:100%;letter-spacing:-.025em;margin-top:.08em}\n.hl{background:var(--y);color:var(--on-y);padding:0 .14em;box-decoration-break:clone;-webkit-box-decoration-break:clone}\n.btn--xl{min-height:64px;padding:0 36px;font-size:15px}\n.h2{font-size:clamp(32px,4.4vw,64px)}\n.em{font-weight:820;font-stretch:112%}\n.lead{font-size:clamp(17px,1.4vw,20px);line-height:1.5;color:var(--fg-dim);max-width:560px}\n\n/* buttons (jak na sezmoo.com) */\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:52px;padding:0 28px;border-radius:100px;border:1px solid var(--fg);\n  font-family:var(--mono);font-size:13px;letter-spacing:.12em;text-transform:uppercase;transition:background .3s,color .3s,border-color .3s}\n.btn svg{width:18px;height:18px;flex:none}\n.btn--y{background:var(--y);border-color:var(--y);color:var(--on-y)}\n.btn--y:hover{background:var(--fg);border-color:var(--fg);color:#fff}\n.btn--ink{background:var(--fg);color:#fff}\n.btn--ink:hover{background:var(--y);border-color:var(--y);color:var(--on-y)}\n\n/* torn edge dividers */\n.tear{position:absolute;left:0;top:-1px;width:100%;height:40px;pointer-events:none}\n\n/* header */\n.hdr{position:sticky;top:0;z-index:40;background:rgb(245 243 239 / .92);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);padding-top:env(safe-area-inset-top,0px)}\n.hdr__in{display:flex;align-items:center;justify-content:space-between;height:76px;gap:16px}\n.hdr__logo img{height:22px;width:auto}\n.hdr__nav{display:flex;align-items:center;gap:28px}\n.hdr__link{display:flex;align-items:center;gap:9px;font-weight:600;font-size:16px}\n.hdr__link svg{width:19px;height:19px}\n.hdr__ico{display:none}\n@media (max-width:980px){\n  .hdr__in{height:62px}\n  .hdr__logo img{height:18px}\n  .hdr__link span,.hdr__nav .btn{display:none}\n  .hdr__nav{gap:8px}\n  .hdr__link{width:44px;height:44px;justify-content:center;border:1px solid var(--fg);border-radius:50%}\n  .hdr__link--tel{background:var(--fg);color:#fff}\n}\n\n/* hero */\n.hero{padding-block:clamp(28px,5vw,72px) clamp(56px,7vw,100px)}\n.hero__grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,4.5vw,64px);align-items:center}\n.hero__copy{display:flex;flex-direction:column;gap:clamp(16px,2vw,26px)}\n.hero__bul{list-style:none;display:flex;flex-direction:column;gap:12px}\n.hero__bul li{display:flex;gap:12px;align-items:flex-start;font-size:17px;line-height:1.4}\n.hero__bul svg{width:22px;height:22px;flex:none;margin-top:1px}\n.hero__cta{display:flex;align-items:center;gap:22px;flex-wrap:wrap;margin-top:6px}\n.hero__micro{font-size:15px;color:var(--fg-dim);line-height:1.4}\n.hero__media{position:relative;aspect-ratio:1/1.02;min-height:320px}\n.hero__frame{position:absolute;inset:30px 0 0 0;border-radius:4px;overflow:hidden;background:var(--ink-2)}\n.hero__frame{container-type:size}\n.hero__frame img{width:100%;height:100%;object-fit:cover}\n.hero__frame iframe{position:absolute;top:50%;left:50%;width:max(100%,177.78cqh);height:max(100%,56.25cqw);transform:translate(-50%,-50%);border:0;pointer-events:none}\n.hero__tc{position:absolute;left:14px;top:48px;display:flex;align-items:center;gap:8px;font-family:var(--mono);font-size:11px;letter-spacing:.12em;color:var(--ink-fg);background:rgb(10 8 6 / .6);padding:5px 9px;border-radius:3px;z-index:2}\n.dot{width:7px;height:7px;border-radius:50%;background:var(--y);flex:none}\n.hero__tc .dot{animation:rec 1.6s infinite}\n@keyframes rec{50%{opacity:.25}}\n@media (prefers-reduced-motion:reduce){.hero__tc .dot{animation:none}}\n.hero__tear{position:absolute;left:0;top:0;width:100%;height:64px;z-index:1}\n.hero__strip{position:absolute;left:-6%;right:-10%;bottom:12%;background:var(--y);transform:rotate(-3deg);padding:clamp(16px,2vw,26px) 0 clamp(16px,2vw,26px) clamp(40px,10%,90px);box-shadow:0 10px 30px rgb(0 0 0 / .18);z-index:2}\n.hero__strip b{display:block;font-size:clamp(34px,4.4vw,64px);font-weight:820;font-stretch:112%;letter-spacing:-.02em;line-height:1}\n.hero__strip span{display:block;font-size:clamp(20px,2.6vw,38px);letter-spacing:-.015em;line-height:1.05}\n@media (max-width:980px){\n  .hero{padding-top:20px}\n  .hero__grid{grid-template-columns:1fr;gap:20px}\n  .hero__copy{gap:14px}\n  .hero__bul,.hero__cta .btn{display:none}\n  .hero__media{aspect-ratio:auto;height:clamp(200px,30vh,300px);min-height:0;order:2}\n  .hero__frame{inset:20px 0 0 0}\n  .hero__tc{top:32px}\n  .hero__tear{height:40px}\n  .hero__strip{bottom:14%;left:-20px;right:-20px}\n  .hero__cta{order:3;margin-top:0}\n  .hero__bul--m{display:flex;margin-top:28px}\n}\n.hero__bul--m{display:none}\n\n/* logotypy */\n.logos{padding-block:clamp(48px,6vw,72px);border-top:1px solid var(--line)}\n.logos__top{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:24px;color:var(--fg-dim)}\n.logos__grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));border:1px solid var(--line);border-radius:4px;overflow:hidden;list-style:none}\n.logos__grid li{display:grid;place-items:center;min-height:116px;padding:18px 24px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);margin:0 -1px -1px 0}\n.logos__grid img{max-height:40px;max-width:130px;width:auto;height:auto;filter:brightness(0);opacity:.6}\n.logos__grid .logo--wide{max-height:20px}\n.logos__word{font-weight:800;font-stretch:104%;font-size:17px;color:var(--fg-dim);white-space:nowrap}\n@media (max-width:980px){.logos__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}\n@media (max-width:560px){.logos__grid{grid-template-columns:repeat(2,minmax(0,1fr))}.logos__grid li{min-height:92px}}\n\n/* sections */\n.sec{padding-block:clamp(72px,9vw,120px);position:relative}\n.sec__head{display:flex;justify-content:space-between;align-items:flex-end;gap:32px;flex-wrap:wrap;margin-bottom:clamp(32px,4vw,56px)}\n.sec__head .lead{max-width:440px}\n\n/* etaty */\n.jobs{display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,6vw,80px)}\n.jobs__intro{display:flex;flex-direction:column;gap:28px}\n.jobs__list{list-style:none}\n.jobs__list li{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:18px 0;border-bottom:1px solid var(--line);font-size:clamp(22px,2.2vw,30px);font-weight:500;letter-spacing:-.015em;color:var(-