---
import BaseLayout from './../../layouts/BaseLayout.astro';
const pageHtml = "<!-- ============ COVER ============ -->\n<header class=\"cs-hero cs-hero--device\" data-screen-label=\"Case · Cover\">\n  <div class=\"cs-hero__media\">\n    <img src=\"/assets/portfolio/soho-form/soho-hero-laptop.webp\" alt=\"Strona Soho Form na ekranie laptopa\" />\n  </div>\n  <div class=\"cs-hero__frame\" aria-hidden=\"true\"><span></span><span></span><span></span><span></span></div>\n  <div class=\"cs-hero__hud\">\n    <span class=\"rec\">BRANDING · WWW</span>\n    <span>UX/UI · LOGO</span>\n    <span>MEBLE / PL</span>\n  </div>\n  <div class=\"cs-hero__inner shell\">\n    <a class=\"cs-hero__back\" href=\"../portfolio/\">← Portfolio / Realizacje</a>\n    <span class=\"eyebrow cs-hero__cat\"><span class=\"tick\"></span>SEZMOO × Soho Form · Branding i strona internetowa</span>\n    <h1 class=\"cs-title\">Soho<br><span class=\"accent\">Form.</span></h1>\n    <p class=\"cs-hero__sub\">Logo, księga znaku i&nbsp;strona internetowa dla <b>Soho Form</b> –&nbsp;rodzinnego producenta mebli tapicerowanych na&nbsp;zamówienie, który pracuje z&nbsp;architektami, hotelami i&nbsp;restauracjami w&nbsp;całej Europie.</p>\n  </div>\n  <div class=\"cs-scroll\" aria-hidden=\"true\"><span>SCROLL</span><i></i></div>\n</header>\n\n<!-- ============ META ============ -->\n<section class=\"cs-meta\" aria-label=\"Dane projektu\">\n  <div class=\"shell\">\n    <div class=\"cs-meta__grid\">\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Klient</div>\n        <div class=\"cs-meta__v\">Soho Form<small>Meble tapicerowane</small></div>\n      </div>\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Branża</div>\n        <div class=\"cs-meta__v\">Meble i wnętrza<small>B2B · HoReCa</small></div>\n      </div>\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Format</div>\n        <div class=\"cs-meta__v\">Branding + WWW<small>Od zera</small></div>\n      </div>\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Zakres</div>\n        <div class=\"cs-meta__v\">Full-service<small>Logo · Księga · Strona</small></div>\n      </div>\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Rezultat</div>\n        <div class=\"cs-meta__v\">Spójna marka<small>Znak · Online · Oferta</small></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ O PROJEKCIE ============ -->\n<section class=\"cs-sec\" data-screen-label=\"O PROJEKCIE\">\n  <div class=\"shell\">\n    <div class=\"cs-intro__grid\">\n      <div class=\"reveal\">\n        <span class=\"cs-sec__no\">O PROJEKCIE</span>\n        <h2 class=\"cs-sec__title\">Rzemiosło, które<br>wygląda <span class=\"accent\">premium.</span></h2>\n      </div>\n      <div class=\"cs-body reveal\" data-d=\"1\">\n        <p>Soho Form to&nbsp;rodzinna firma z&nbsp;wieloletnią tradycją. Produkuje sofy, fotele, łóżka i&nbsp;zabudowy stolarskie na&nbsp;zamówienie –&nbsp;dla wnętrz komercyjnych i&nbsp;prywatnych. Jakość mebli była od&nbsp;lat na&nbsp;poziomie marek premium, ale komunikacja jeszcze tego nie&nbsp;pokazywała.</p>\n        <p>Zaprojektowaliśmy markę od&nbsp;podstaw: znak, księgę znaku z&nbsp;paletą i&nbsp;typografią, a&nbsp;następnie stronę internetową, która prezentuje ofertę i&nbsp;realizacje tak, jak&nbsp;oczekują tego architekci i&nbsp;inwestorzy.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ ZNAK ============ -->\n<section class=\"cs-sec\" style=\"padding-top:0\" aria-label=\"Logo\" data-screen-label=\"Logo\">\n  <div class=\"shell\">\n    <span class=\"cs-sec__no reveal\">ZNAK</span>\n    <h2 class=\"cs-sec__title reveal\">Prosty logotyp<br>z charakterem wnętrza.</h2>\n  </div>\n  <div class=\"cs-row cs-row--split\" style=\"margin-top:clamp(28px,4vh,48px)\">\n    <figure class=\"cs-shot cs-shot--ad reveal\" style=\"aspect-ratio:16/10;background:#1f2b2d\"><div class=\"frame-media cs-shot__media\" style=\"background:#1f2b2d;display:grid;place-items:center\"><img src=\"/assets/portfolio/soho-form/soho-logo-white.svg\" alt=\"Logo Soho Form w wersji białej na ciemnym tle\" loading=\"lazy\" style=\"position:static;width:46%;height:auto;inset:auto;object-fit:contain\" /></div><span class=\"cs-shot__tag\" style=\"white-space:nowrap\">Logo · Negatyw</span></figure>\n    <figure class=\"cs-shot cs-shot--ad reveal\" data-d=\"1\" style=\"aspect-ratio:16/10;background:#dcdcdc\"><div class=\"frame-media cs-shot__media\" style=\"background:#dcdcdc;display:grid;place-items:center\"><img src=\"/assets/portfolio/soho-form/soho-logo-black.svg\" alt=\"Logo Soho Form w wersji czarnej na jasnym tle\" loading=\"lazy\" style=\"position:static;width:46%;height:auto;inset:auto;object-fit:contain\" /></div><span class=\"cs-shot__tag\" style=\"white-space:nowrap\">Logo · Podstawowe</span></figure>\n  </div>\n</section>\n\n<!-- ============ PALETA + TYPO ============ -->\n<section class=\"cs-sec\" style=\"padding-top:0\" data-screen-label=\"KSIĘGA ZNAKU\">\n  <div class=\"shell\">\n    <span class=\"cs-sec__no reveal\">KSIĘGA ZNAKU</span>\n    <h2 class=\"cs-sec__title reveal\">Paleta z materiałów,<br>z których powstają meble.</h2>\n    <div class=\"reveal\" style=\"margin-top:clamp(28px,4vh,48px);display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(10px,1.4vw,20px)\">\n      <div style=\"display:flex;flex-direction:column;gap:12px\"><div style=\"aspect-ratio:16/9;background:#DCDCDC;border:1px solid var(--line-soft)\"></div><div style=\"display:flex;justify-content:space-between;gap:8px;font-family:var(--font-mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase\"><span>Szarość</span><span style=\"color:var(--fg-dim)\">#DCDCDC</span></div></div>\n      <div style=\"display:flex;flex-direction:column;gap:12px\"><div style=\"aspect-ratio:16/9;background:#000000;border:1px solid var(--line-soft)\"></div><div style=\"display:flex;justify-content:space-between;gap:8px;font-family:var(--font-mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase\"><span>Czerń</span><span style=\"color:var(--fg-dim)\">#000000</span></div></div>\n      <div style=\"display:flex;flex-direction:column;gap:12px\"><div style=\"aspect-ratio:16/9;background:#99A28A;border:1px solid var(--line-soft)\"></div><div style=\"display:flex;justify-content:space-between;gap:8px;font-family:var(--font-mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase\"><span>Szałwia</span><span style=\"color:var(--fg-dim)\">#99A28A</span></div></div>\n      <div style=\"display:flex;flex-direction:column;gap:12px\"><div style=\"aspect-ratio:16/9;background:#78774C;border:1px solid var(--line-soft)\"></div><div style=\"display:flex;justify-content:space-between;gap:8px;font-family:var(--font-mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase\"><span>Oliwka</span><span style=\"color:var(--fg-dim)\">#78774C</span></div></div>\n      <div style=\"display:flex;flex-direction:column;gap:12px\"><div style=\"aspect-ratio:16/9;background:#FFDC94;border:1px solid var(--line-soft)\"></div><div style=\"display:flex;justify-content:space-between;gap:8px;font-family:var(--font-mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase\"><span>Piasek</span><span style=\"color:var(--fg-dim)\">#FFDC94</span></div></div>\n      <div style=\"display:flex;flex-direction:column;gap:12px\"><div style=\"aspect-ratio:16/9;background:#E3DBCF;border:1px solid var(--line-soft)\"></div><div style=\"display:flex;justify-content:space-between;gap:8px;font-family:var(--font-mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase\"><span>Len</span><span style=\"color:var(--fg-dim)\">#E3DBCF</span></div></div>\n    </div>\n    <div class=\"reveal\" style=\"margin-top:clamp(40px,6vh,72px);display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:clamp(24px,3vw,48px);align-items:end;border-top:1px solid var(--line-soft);padding-top:clamp(24px,3vh,40px)\">\n      <div style=\"font-family:'Barlow',sans-serif;font-weight:700;font-size:clamp(88px,11vw,180px);line-height:.85;letter-spacing:-.02em\">Aa</div>\n      <div class=\"cs-body\"><p><strong>Barlow Bold / Regular.</strong> Barlow Bold w&nbsp;nagłówkach i&nbsp;logotypie podkreśla siłę marki, a&nbsp;Barlow Regular w&nbsp;treściach dba o&nbsp;czytelność. Razem tworzą nowoczesny, zrównoważony system komunikacji.</p></div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ STRONA ============ -->\n<section class=\"cs-sec\" data-screen-label=\"STRONA INTERNETOWA\">\n  <div class=\"shell\">\n    <span class=\"cs-sec__no reveal\">STRONA INTERNETOWA</span>\n    <h2 class=\"cs-sec__title reveal\">Od struktury<br>po gotową stronę.</h2>\n    <div class=\"cs-steps\">\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">W1, 01</span>\n        <h3 class=\"cs-step__title\">Architektura i&nbsp;UX</h3>\n        <p class=\"cs-step__desc\">Struktura prowadząca od&nbsp;kolekcji, przez ofertę dla&nbsp;hoteli, kawiarni i&nbsp;restauracji, po&nbsp;realizacje i&nbsp;szybki kontakt.</p>\n      </div>\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">W1, 02</span>\n        <h3 class=\"cs-step__title\">UI design</h3>\n        <p class=\"cs-step__desc\">Ciemne, fotograficzne sekcje przeplatane jasnymi blokami oferty –&nbsp;układ, który pozwala mówić przede wszystkim meblom.</p>\n      </div>\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">W1, 03</span>\n        <h3 class=\"cs-step__title\">Treści i&nbsp;oferta</h3>\n        <p class=\"cs-step__desc\">Opisy trzech linii oferty, sekcja „O nas” i&nbsp;blog z&nbsp;poradnikami, które odpowiadają na&nbsp;pytania klientów.</p>\n      </div>\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">W1, 04</span>\n        <h3 class=\"cs-step__title\">Wdrożenie</h3>\n        <p class=\"cs-step__desc\">Responsywna strona z&nbsp;galerią realizacji, formularzem kontaktowym i&nbsp;panelem do&nbsp;samodzielnej edycji treści.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ GALERIA ============ -->\n<section class=\"cs-gallery bleed\" aria-label=\"Strona Soho Form\">\n  <div class=\"cs-row\">\n    <figure class=\"cs-shot cs-shot--ad reveal\" style=\"aspect-ratio:2000/1125;background:#ffd200\"><div class=\"frame-media cs-shot__media\" style=\"background:#ffd200\"><img src=\"/assets/portfolio/soho-form/soho-mockup-yellow.webp\" alt=\"Strona Soho Form na laptopie i telefonie, żółte tło\" loading=\"lazy\" style=\"object-fit:contain\" /></div><span class=\"cs-shot__tag\" style=\"white-space:nowrap\">Strona · Desktop i mobile</span></figure>\n  </div>\n  <div class=\"cs-row cs-row--split\">\n    <figure class=\"cs-shot cs-shot--ad reveal\" style=\"aspect-ratio:4/3;background:#141616\"><div class=\"frame-media cs-shot__media\" style=\"background:#141616\"><img src=\"/assets/portfolio/soho-form/soho-imac.webp\" alt=\"Strona Soho Form na monitorze – sekcja Realizacje\" loading=\"lazy\" style=\"object-fit:contain\" /></div><span class=\"cs-shot__tag\" style=\"white-space:nowrap\">Strona · Realizacje</span></figure>\n    <figure class=\"cs-shot cs-shot--ad reveal\" data-d=\"1\" style=\"aspect-ratio:4/3;background:#141616\"><div class=\"frame-media cs-shot__media\" style=\"background:#141616\"><img src=\"/assets/portfolio/soho-form/soho-mockup.webp\" alt=\"Podstrony Soho Form na laptopie i ekranach\" loading=\"lazy\" style=\"object-fit:contain\" /></div><span class=\"cs-shot__tag\" style=\"white-space:nowrap\">Strona · Podstrony</span></figure>\n  </div>\n</section>\n\n<!-- ============ EFEKT ============ -->\n<section class=\"cs-quote\" aria-label=\"Efekt końcowy\">\n  <div class=\"shell cs-sec\">\n    <div class=\"cs-quote__inner reveal\">\n      <blockquote><span class=\"mark\">„</span>Soho Form dostało markę na&nbsp;miarę swoich mebli –&nbsp;spokojną, pewną siebie i&nbsp;spójną od&nbsp;logo po&nbsp;ostatnią podstronę.<span class=\"mark\">”</span></blockquote>\n      <div class=\"cs-quote__by\">– <b>Zespół SEZMOO</b> · Branding &amp; UX/UI</div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ NEXT PROJECT ============ -->\n<a class=\"cs-next bleed\" href=\"../portfolio/\" data-cursor=\"link\" aria-label=\"Wróć do portfolio\">\n  <img src=\"/assets/portfolio/soho-form/soho-mockup-yellow.webp\" alt=\"Soho Form\" />\n  <div class=\"cs-next__inner shell\">\n    <span class=\"cs-next__k\">Zobacz więcej →</span>\n    <span class=\"cs-next__title\">Portfolio <span class=\"arrow\">→</span></span>\n    <span class=\"cs-next__cat\">Wszystkie realizacje SEZMOO</span>\n  </div>\n</a>";
const extraHeadHtml = "<link rel=\"stylesheet\" href=\"/assets/css/case-study.css\" />";
---

<BaseLayout
  lang="pl"
  title="Soho Form · Logo, księga znaku i strona WWW · Realizacja SEZMOO"
  description="Case study SEZMOO: logo, księga znaku i strona internetowa dla Soho Form, producenta mebli tapicerowanych na zamówienie."
  canonical="https://sezmoo.com/realizacja-soho-form/"
  extraHead={extraHeadHtml}
>
  <Fragment set:html={pageHtml} />
</BaseLayout>
