---
import BaseLayout from './../../layouts/BaseLayout.astro';
const pageHtml = "<!-- ============ COVER ============ -->\n<header class=\"cs-hero\" data-screen-label=\"Case · Cover\">\n  <div class=\"cs-hero__media\">\n    <img src=\"/assets/work/captains-club-ext.avif\" alt=\"Captain's Club, podświetlony kontener World of Warships nocą w Gdyni\" />\n  </div>\n  <div class=\"cs-hero__frame\" aria-hidden=\"true\"><span></span><span></span><span></span><span></span></div>\n  <div class=\"cs-hero__hud\">\n    <span class=\"rec\">REC · 4K · 25FPS</span>\n    <span data-tc>00:00:12:08</span>\n    <span>GDYNIA / PL</span>\n  </div>\n\n  <div class=\"cs-hero__inner shell\">\n    <a class=\"cs-hero__back\" href=\"../#work\">← Portfolio / Realizacje</a>\n    <span class=\"eyebrow cs-hero__cat\"><span class=\"tick\"></span>SEZMOO × Wargaming × Muzeum MW · Captain's Club</span>\n    <h1 class=\"cs-title\">10 lat<br>World of <span class=\"accent\">Warships.</span></h1>\n    <p class=\"cs-hero__sub\">Od pustego kontenera do w pełni wyposażonego pokoju gier. Stała Strefa Gracza, <b>Captain's Club</b>, w Muzeum Marynarki Wojennej w Gdyni, i event otwierający <span style=\"white-space:nowrap\">10-lecie</span> marki.</p>\n  </div>\n\n  <div class=\"cs-scroll\" aria-hidden=\"true\"><span>SCROLL</span><i></i></div>\n</header>\n\n<!-- ============ META ============ -->\n<section class=\"cs-meta\" aria-label=\"Dane projektu\">\n  <div class=\"shell\">\n    <div class=\"cs-meta__grid\">\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Klient</div>\n        <div class=\"cs-meta__v\">World of Warships<small>Wargaming</small></div>\n      </div>\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Partner</div>\n        <div class=\"cs-meta__v\">Muzeum MW<small>Gdynia</small></div>\n      </div>\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Okazja</div>\n        <div class=\"cs-meta__v\">10-lecie<small>World of Warships</small></div>\n      </div>\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Rok</div>\n        <div class=\"cs-meta__v\">2025<small>Strefa Gracza</small></div>\n      </div>\n      <div class=\"cs-meta__cell\">\n        <div class=\"cs-meta__k\">Zakres</div>\n        <div class=\"cs-meta__v\">Budowa · Film · Event<small>Produkcja end-to-end</small></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ 01 · WYZWANIE ============ -->\n<section class=\"cs-sec\" data-screen-label=\"Wyzwanie\">\n  <div class=\"shell\">\n    <div class=\"cs-intro__grid\">\n      <div class=\"reveal\">\n        <span class=\"cs-sec__no\">WYZWANIE</span>\n        <h2 class=\"cs-sec__title\">Od pustego kontenera<br>do pełnego <span class=\"accent\">pokoju gier.</span></h2>\n      </div>\n      <div class=\"cs-body reveal\" data-d=\"1\">\n        <p>Jeden z najbardziej złożonych projektów, jakie realizowaliśmy. <strong>SEZMOO odpowiadało za całość</strong>, od koordynacji budowy, przez materiały wideo przed wydarzeniem i dokumentację foto-wideo, po organizację i przeprowadzenie eventu inauguracyjnego.</p>\n        <p>Pokój gier, Captain's Club, zaprojektowali Jarosław Chodoniuk i Agnieszka Hinca, a samo wydarzenie otwierające trafiło do naszego kalendarza zaledwie <strong>cztery tygodnie</strong> przed oficjalnym otwarciem w Muzeum Marynarki Wojennej w Gdyni.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ 02 · PROCES ============ -->\n<section class=\"cs-sec\" style=\"padding-top:0\" data-screen-label=\"Proces\">\n  <div class=\"shell\">\n    <span class=\"cs-sec__no reveal\">PROCES</span>\n    <h2 class=\"cs-sec__title reveal\">Od koordynacji budowy<br>po wieczór otwarcia.</h2>\n\n    <div class=\"cs-steps\">\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">V1, 01</span>\n        <h3 class=\"cs-step__title\">Koordynacja budowy</h3>\n        <p class=\"cs-step__desc\">Od pustego kontenera po gotowy pokój gier. Projekt wnętrza: Jarosław Chodoniuk i Agnieszka Hinca, konstrukcja, Jarek.</p>\n      </div>\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">V1, 02</span>\n        <h3 class=\"cs-step__title\">Materiały zapowiadające</h3>\n        <p class=\"cs-step__desc\">Produkcja wideo jeszcze przed wydarzeniem, budowanie zasięgu i napięcia przed otwarciem Strefy Gracza.</p>\n      </div>\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">V1, 03</span>\n        <h3 class=\"cs-step__title\">Dokumentacja</h3>\n        <p class=\"cs-step__desc\">Foto i wideo z budowy oraz wieczoru otwarcia, pełna dokumentacja zarówno procesu, jak i efektu.</p>\n      </div>\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">V1, 04</span>\n        <h3 class=\"cs-step__title\">Event otwarcia</h3>\n        <p class=\"cs-step__desc\">Organizacja i przeprowadzenie wieczoru inauguracyjnego. Na przygotowanie całości mieliśmy cztery tygodnie.</p>\n      </div>\n      <div class=\"cs-step reveal\">\n        <span class=\"cs-step__no\">V1, 05</span>\n        <h3 class=\"cs-step__title\">Postprodukcja</h3>\n        <p class=\"cs-step__desc\">Montaż i finalne formaty pod kanały marki i partnerów. Część materiału wciąż jest w obróbce.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ GALLERY ============ -->\n<section class=\"cs-gallery bleed\" aria-label=\"Kadry z realizacji\">\n  <div class=\"cs-row\">\n    <figure class=\"cs-shot cs-shot--wide reveal\" data-parallax=\"30\">\n      <div class=\"frame-media cs-shot__media\">\n        <img src=\"/assets/work/warships-container.avif\" alt=\"Kontener World of Warships za dnia przy Bulwarze w Gdyni\" />\n      </div>\n      <span class=\"cs-shot__tag\">EXT · Dzień</span>\n      <span class=\"cs-shot__tc\" data-tc>00:01:04:11</span>\n    </figure>\n  </div>\n\n  <div class=\"cs-row cs-row--split\">\n    <figure class=\"cs-shot cs-shot--tall reveal\" data-parallax=\"24\">\n      <div class=\"frame-media cs-shot__media\">\n        <img src=\"/assets/work/captains-club-int.avif\" alt=\"Wnętrze Captain's Club, stanowiska gamingowe w kontenerze\" />\n      </div>\n      <span class=\"cs-shot__tag\">INT · Stanowiska</span>\n      <span class=\"cs-shot__tc\" data-tc>00:02:18:03</span>\n    </figure>\n    <figure class=\"cs-shot cs-shot--tall reveal\" data-d=\"1\" data-parallax=\"24\">\n      <div class=\"frame-media cs-shot__media\">\n        <img src=\"/assets/work/captains-club-1.avif\" alt=\"Neon Captain's Club i ekran z rozgrywką World of Warships\" />\n      </div>\n      <span class=\"cs-shot__tag\">INT · Detal</span>\n      <span class=\"cs-shot__tc\" data-tc>00:03:41:22</span>\n    </figure>\n  </div>\n\n  <div class=\"cs-row\">\n    <figure class=\"cs-shot cs-shot--full reveal\" data-parallax=\"30\">\n      <div class=\"frame-media cs-shot__media\">\n        <img src=\"/assets/work/captains-club-ext.avif\" alt=\"Captain's Club nocą, podświetlony kontener w barwach marki\" />\n      </div>\n      <span class=\"cs-shot__tag\">EXT · Noc</span>\n      <span class=\"cs-shot__tc\" data-tc>00:05:09:14</span>\n    </figure>\n  </div>\n</section>\n\n<!-- ============ 03 · FILM ============ -->\n<section class=\"cs-sec\" data-screen-label=\"Film\">\n  <div class=\"shell\">\n    <span class=\"cs-sec__no reveal\">FILM</span>\n    <h2 class=\"cs-sec__title reveal\">Zobacz, jak to <span class=\"accent\">żyje</span> w ruchu.</h2>\n    <p class=\"cs-body reveal\" data-d=\"1\" style=\"max-width:54ch;margin-top:20px\">Materiał z budowy i wieczoru otwarcia Strefy Gracza, naval'owa opowieść o miejscu, które powstało od zera.</p>\n\n    <!-- Player: podmień data-yt na ID filmu z YouTube, aby aktywować odtwarzanie -->\n    <div class=\"cs-film reveal\" data-d=\"1\" style=\"margin-top:clamp(30px,4vh,48px)\">\n      <div class=\"cs-film__frame\" data-cursor=\"play\" data-yt=\"\" role=\"button\" tabindex=\"0\" aria-label=\"Odtwórz film Captain's Club\">\n        <img src=\"/assets/work/captains-club-ext.avif\" alt=\"Kadr otwierający film Captain's Club\" />\n        <div class=\"cs-film__play\"><span class=\"cs-film__btn\" aria-hidden=\"true\"></span></div>\n        <div class=\"cs-film__meta\">\n          <span class=\"rec\">● REC</span>\n          <span>CAPTAIN'S CLUB, AFTERMOVIE</span>\n          <span>01:48</span>\n          <span>4K · 25FPS</span>\n        </div>\n        <div class=\"cs-film__bar\"><i></i></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ QUOTE ============ -->\n<section class=\"cs-quote\" aria-label=\"Opinia klienta\">\n  <div class=\"shell cs-sec\">\n    <div class=\"cs-quote__inner reveal\">\n      <blockquote><span class=\"mark\">„</span>Od pustego kontenera do w pełni wyposażonego pokoju gier, droga była długa i pełna wyzwań. Efekt jest dokładnie taki, jak sobie wyobrażaliśmy.<span class=\"mark\">”</span></blockquote>\n      <div class=\"cs-quote__by\">– <b>Maciej Tyma</b> · SEZMOO Creative Agency</div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ NEXT PROJECT ============ -->\n<!-- Podmień href na podstronę kolejnej realizacji, gdy powstanie -->\n<a class=\"cs-next bleed\" href=\"../#work\" data-cursor=\"link\" aria-label=\"Następna realizacja, Audi RS\">\n  <img src=\"/assets/work/audi-a6-etron.jpg\" alt=\"Audi RS, premium film\" />\n  <div class=\"cs-next__inner shell\">\n    <span class=\"cs-next__k\">Następna realizacja →</span>\n    <span class=\"cs-next__title\">Audi RS <span class=\"arrow\">→</span></span>\n    <span class=\"cs-next__cat\">Automotive · Premium film</span>\n  </div>\n</a>";
const extraHeadHtml = "<link rel=\"stylesheet\" href=\"/assets/css/case-study.css\" />";
const pageScriptsHtml = "<script>\n/* Film facade, wstaw odtwarzacz YouTube po kliknięciu, jeśli ustawiono data-yt */\n(function(){\n  var f = document.querySelector('.cs-film__frame');\n  if(!f) return;\n  function play(){\n    var id = f.getAttribute('data-yt');\n    if(!id) return; // brak linku, placeholder pozostaje\n    var ifr = document.createElement('iframe');\n    ifr.src = 'https://www.youtube-nocookie.com/embed/'+id+'?autoplay=1&rel=0&modestbranding=1&playsinline=1&origin=https://sezmoo.com';\n    ifr.allow = 'autoplay; fullscreen; picture-in-picture';\n    ifr.setAttribute('allowfullscreen','');\n    f.appendChild(ifr);\n  }\n  f.addEventListener('click', play);\n  f.addEventListener('keydown', function(e){ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); play(); } });\n})();\n</script>";
---

<BaseLayout
  lang="pl"
  title="10 lat World of Warships, Strefa Gracza · Realizacja SEZMOO"
  description="Case study SEZMOO: budowa Strefy Gracza (Captain"
  canonical="https://sezmoo.com/realizacja-world-of-warships/"
  extraHead={extraHeadHtml}
  pageScripts={pageScriptsHtml}
>
  <Fragment set:html={pageHtml} />
</BaseLayout>
