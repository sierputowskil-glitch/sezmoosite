---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import { pageUrl } from '../../lib/site';

const lang = 'pl' as const;
const canonical = pageUrl('/realizacja-primespot/');
const pageScriptsHtml = "<script type=\"application/json\" class=\"ad-story__data\">[{\"src\":\"assets/portfolio/primespot/pjur-blue-story-1.jpg\",\"alt\":\"PrimeSpot Przystań Jurata – kreacja Instagram Stories 1\"},{\"src\":\"assets/portfolio/primespot/primespot-przystan-jurata-instagram-stories-01.jpg\",\"alt\":\"PrimeSpot Przystań Jurata – kreacja Instagram Stories 2\"},{\"src\":\"assets/portfolio/primespot/primespot-przystan-jurata-instagram-stories-02.png\",\"alt\":\"PrimeSpot Przystań Jurata – kreacja Instagram Stories 3\"},{\"src\":\"assets/portfolio/primespot/primespot-przystan-jurata-instagram-stories-03.png\",\"alt\":\"PrimeSpot Przystań Jurata – kreacja Instagram Stories 4\"}]</script>\n<script type=\"application/json\" class=\"ad-story__data\">[{\"src\":\"assets/portfolio/primespot/pjur-warm-story-1.jpg\",\"alt\":\"PrimeSpot Przystań Jurata – kreacja Instagram Stories 5\"},{\"src\":\"assets/portfolio/primespot/primespot-przystan-jurata-instagram-stories-04.png\",\"alt\":\"PrimeSpot Przystań Jurata – kreacja Instagram Stories 6\"},{\"src\":\"assets/portfolio/primespot/primespot-przystan-jurata-instagram-stories-05.png\",\"alt\":\"PrimeSpot Przystań Jurata – kreacja Instagram Stories 7\"}]</script>\n<script>/* ad-story player */\n(function(){\n  function initStory(st){\n    var data; try{ data=JSON.parse(st.querySelector('.ad-story__data').textContent);}catch(e){return;}\n    if(!data||!data.length) return;\n    var img=st.querySelector('.ad-story__img'), wrap=st.querySelector('.ad-story__bars'), cap=st.querySelector('.ad-story__cap');\n    var DUR=4200, idx=0, timer=null;\n    data.forEach(function(){ var i=document.createElement('i'); i.appendChild(document.createElement('b')); wrap.appendChild(i); });\n    var bars=[].slice.call(wrap.querySelectorAll('b'));\n    data.forEach(function(d){ var p=new Image(); p.src=d.src; });\n    function show(n){\n      idx=(n+data.length)%data.length;\n      img.src=data[idx].src; img.alt=data[idx].alt||''; if(cap&&data[idx].cap) cap.textContent=data[idx].cap;\n      bars.forEach(function(b,i){ b.style.transition='none'; b.style.width=(i<idx?'100%':'0%'); });\n      void wrap.offsetWidth;\n      var b=bars[idx]; if(b){ b.style.transition='width '+DUR+'ms linear'; b.style.width='100%'; }\n      clearTimeout(timer); timer=setTimeout(function(){ show(idx+1); }, DUR);\n    }\n    var nx=st.querySelector('.ad-story__next'), pv=st.querySelector('.ad-story__prev');\n    nx&&nx.addEventListener('click',function(){ show(idx+1); });\n    pv&&pv.addEventListener('click',function(){ show(idx-1); });\n    show(0);\n  }\n  function boot(){ document.querySelectorAll('.ad-story').forEach(initStory); }\n  if(document.readyState!=='loading') boot(); else document.addEventListener('DOMContentLoaded', boot);\n})();\n</script>\n<script type=\"application/json\" class=\"ad-story__data\">[{\"src\":\"assets/portfolio/primespot/pjur-blue-story-1.jpg\",\"alt\":\"PrimeSpot Przystań Jurata – kreacja Instagram Stories 1\"},{\"src\":\"assets/portfolio/primespot/primespot-przystan-jurata-instagram-stories-01.jpg\",\"alt\":\"PrimeSpot Przystań Jurata – kreacja Instagram Stories 2\"},{\"src\":\"assets/portfolio/primespot/primespot-przystan-jurata-instagram-stories-02.png\",\"alt\":\"PrimeSpot Przystań Jurata – kreacja Instagram Stories 3\"},{\"src\":\"assets/portfolio/primespot/primespot-przystan-jurata-instagram-stories-03.png\",\"alt\":\"PrimeSpot Przystań Jurata – kreacja Instagram Stories 4\"}]</script>\n<script type=\"application/json\" class=\"ad-story__data\">[{\"src\":\"assets/portfolio/primespot/pjur-warm-story-1.jpg\",\"alt\":\"PrimeSpot Przystań Jurata – kreacja Instagram Stories 5\"},{\"src\":\"assets/portfolio/primespot/primespot-przystan-jurata-instagram-stories-04.png\",\"alt\":\"PrimeSpot Przystań Jurata – kreacja Instagram Stories 6\"},{\"src\":\"assets/portfolio/primespot/primespot-przystan-jurata-instagram-stories-05.png\",\"alt\":\"PrimeSpot Przystań Jurata – kreacja Instagram Stories 7\"}]</script>";
---

<CaseStudyLayout
  lang={lang}
  title="PrimeSpot · Przystań Jurata · Kampania Meta Ads · Realizacja SEZMOO"
  description="Case study SEZMOO: kampania Meta Ads dla inwestycji premium Przystań Jurata w Jastarni. Dwie linie kreatywne i pełen zestaw formatów: feed, 1:1, Stories 9:16 i 4:5."
  canonical={canonical}
  pageScripts={pageScriptsHtml}
>
<!-- ============ COVER ============ -->
<header class="cs-hero" data-screen-label="Case · Cover">
  <div class="cs-hero__media">
    <img src="/assets/portfolio/primespot/pjur-blue-wide-1.jpg" alt="Kampania PrimeSpot Przystań Jurata: wieczorna wizualizacja inwestycji z hasłem Lokalizacja, która procentuje" />
  </div>
  <div class="cs-hero__frame" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
  <div class="cs-hero__hud">
    <span class="rec">KAMPANIA · META ADS</span>
    <span>GRAFIKA · FORMATY</span>
    <span>NIERUCHOMOŚCI / PL</span>
  </div>

  <div class="cs-hero__inner shell">
    <a class="cs-hero__back" href="/portfolio/">← Portfolio / Realizacje</a>
    <span class="eyebrow cs-hero__cat"><span class="tick"></span>SEZMOO × PrimeSpot · Kampania nieruchomości</span>
    <h1 class="cs-title">Przystań<br><span class="accent">Jurata.</span></h1>
    <p class="cs-hero__sub">Kampania Meta Ads dla premium inwestycji <b>PrimeSpot</b> w Jastarni: dwie linie kreatywne i komplet formatów reklamowych, w których jedna produkcja pracuje spójnie na feedzie, w Stories i w reklamie.</p>
  </div>

  <div class="cs-scroll" aria-hidden="true"><span>SCROLL</span><i></i></div>
</header>

<!-- ============ META ============ -->
<section class="cs-meta" aria-label="Dane projektu">
  <div class="shell">
    <div class="cs-meta__grid">
      <div class="cs-meta__cell">
        <div class="cs-meta__k">Klient</div>
        <div class="cs-meta__v">PrimeSpot<small>Deweloper</small></div>
      </div>
      <div class="cs-meta__cell">
        <div class="cs-meta__k">Branża</div>
        <div class="cs-meta__v">Nieruchomości<small>Premium nad morzem</small></div>
      </div>
      <div class="cs-meta__cell">
        <div class="cs-meta__k">Format</div>
        <div class="cs-meta__v">Kampania<small>Meta Ads</small></div>
      </div>
      <div class="cs-meta__cell">
        <div class="cs-meta__k">Zakres</div>
        <div class="cs-meta__v">Grafika<small>KV · formaty · web</small></div>
      </div>
      <div class="cs-meta__cell">
        <div class="cs-meta__k">Rezultat</div>
        <div class="cs-meta__v">Przystań Jurata<small>Jastarnia</small></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ 01 · O PROJEKCIE ============ -->
<section class="cs-sec" data-screen-label="O projekcie">
  <div class="shell">
    <div class="cs-intro__grid">
      <div class="reveal">
        <span class="cs-sec__no">O PROJEKCIE</span>
        <h2 class="cs-sec__title">Jedna inwestycja,<br>komplet <span class="accent">formatów.</span></h2>
      </div>
      <div class="cs-body reveal" data-d="1">
        <p>PrimeSpot to marka premium na rynku nieruchomości nadmorskich. Dla inwestycji <strong>Przystań Jurata</strong> w Jastarni przygotowaliśmy kampanię reklamową w mediach społecznościowych, opartą na wizualizacjach architektonicznych i eleganckim, spokojnym języku marki.</p>
        <p>Zamiast pojedynczej grafiki zbudowaliśmy pełen zestaw formatów Meta Ads i dwie linie kreatywne, tak aby ta sama produkcja pracowała spójnie na feedzie, w kwadracie, w Stories i w reklamie mobilnej, prowadząc odbiorcę do strony inwestycji.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ 02 · KONCEPTY ============ -->
<section class="cs-sec" style="padding-top:0" aria-label="Linie kreatywne">
  <div class="shell">
    <span class="cs-sec__no reveal">DWIE LINIE KREATYWNE</span>
    <h2 class="cs-sec__title reveal">Ten sam projekt,<br>dwa nastroje.</h2>
  </div>
  <div class="ad-grid ad-grid--phones reveal" style="margin-top:clamp(28px,4vh,48px)">
    <figure class="ad-phone ad-story reveal">
      
      <div class="ad-phone__screen">
        <img class="ad-story__img" alt="" loading="lazy" />
        <div class="ad-phone__ui">
          <div class="ad-phone__top ad-story__bars"></div>
          <div class="ad-phone__hdr"><span class="ad-phone__av">PS</span><span><span class="ad-phone__name">primespot</span><span class="ad-phone__spon">Sponsorowane</span></span></div>
          <span class="ad-phone__cta">Dowiedz się więcej</span>
        </div>
        <button class="ad-story__zone ad-story__prev" type="button" aria-label="Poprzednia"></button>
        <button class="ad-story__zone ad-story__next" type="button" aria-label="Następna"></button>
      </div>
      <figcaption class="ad-cap">Linia 1 · Stories</figcaption>
    </figure>
    <figure class="ad-phone ad-story reveal">
      
      <div class="ad-phone__screen">
        <img class="ad-story__img" alt="" loading="lazy" />
        <div class="ad-phone__ui">
          <div class="ad-phone__top ad-story__bars"></div>
          <div class="ad-phone__hdr"><span class="ad-phone__av">PS</span><span><span class="ad-phone__name">primespot</span><span class="ad-phone__spon">Sponsorowane</span></span></div>
          <span class="ad-phone__cta">Dowiedz się więcej</span>
        </div>
        <button class="ad-story__zone ad-story__prev" type="button" aria-label="Poprzednia"></button>
        <button class="ad-story__zone ad-story__next" type="button" aria-label="Następna"></button>
      </div>
      <figcaption class="ad-cap">Linia 2 · Stories</figcaption>
    </figure>
  </div>
  <div class="shell">
    <div class="cs-body reveal" data-d="1" style="max-width:70ch;margin-top:clamp(20px,3vh,34px)">
      <p><strong>Linia wieczorna</strong> gra elegancją i prestiżem: chłodny, granatowy render, delikatny neon marki i hasła „Lokalizacja, która procentuje” oraz „Przystań z widokiem na przyszłość”. <strong>Linia ciepła</strong> to wakacyjny spokój, złoty zachód nad Jastarnią, drewno i zaproszenie „Miejsce nad morzem”. Dwa tony, jedna spójna identyfikacja.</p>
    </div>
  </div>
</section>

<!-- ============ 03 · SYSTEM FORMATÓW ============ -->
<section class="cs-sec" data-screen-label="Formaty">
  <div class="shell">
    <span class="cs-sec__no reveal">SYSTEM FORMATÓW</span>
    <h2 class="cs-sec__title reveal">Jedna produkcja,<br>każdy kanał.</h2>

    <div class="cs-steps">
      <div class="cs-step reveal">
        <span class="cs-step__no">F, 01</span>
        <h3 class="cs-step__title">Feed 1200 × 628</h3>
        <p class="cs-step__desc">Poziomy format linkowy pod reklamy na feedzie Facebooka i w Google Ads, z czytelnym hasłem i wyraźnym CTA.</p>
      </div>
      <div class="cs-step reveal">
        <span class="cs-step__no">F, 02</span>
        <h3 class="cs-step__title">Kwadrat 1200 × 1200</h3>
        <p class="cs-step__desc">Format 1:1 pod feed Instagrama i Facebooka, z logo marki, hasłem i wizualizacją inwestycji.</p>
      </div>
      <div class="cs-step reveal">
        <span class="cs-step__no">F, 03</span>
        <h3 class="cs-step__title">Stories 1080 × 1920</h3>
        <p class="cs-step__desc">Pionowy format 9:16 pod Stories i Reels, z pełnoekranowym renderem i CTA na dole kadru.</p>
      </div>
      <div class="cs-step reveal">
        <span class="cs-step__no">F, 04</span>
        <h3 class="cs-step__title">Mobile 960 × 1200</h3>
        <p class="cs-step__desc">Format 4:5 maksymalizujący powierzchnię na feedzie mobilnym, gdzie ogląda większość odbiorców.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ GALLERY ============ -->
<section class="cs-sec cs-gallery" aria-label="Formaty kampanii"><div class="shell ad-grid" style="gap:clamp(28px,4vw,52px)">
  <div>
    <figure class="ad-post ad-post--feed reveal">
        <div class="ad-post__head"><span class="ad-post__av">PS</span><span class="ad-post__id"><span class="ad-post__name">primespot</span><span class="ad-post__spon">Sponsorowane · Meta Ads</span></span><span class="ad-post__more">•••</span></div>
        <div class="ad-post__media"><img src="/assets/portfolio/primespot/pjur-blue-wide-2.jpg" alt="PrimeSpot Przystań Jurata: Przystań z widokiem na przyszłość, format feed 1200×628" loading="lazy" /></div>
        <div class="ad-post__bar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 20s-7-4.4-9.3-8.5C1 8.6 2.5 5.6 5.4 5.6c1.9 0 3 1 3.6 2 .6-1 1.7-2 3.6-2 2.9 0 4.4 3 2.7 5.9C19 15.6 12 20 12 20z"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 11.5a8 8 0 0 1-11.5 7.2L3 21l2.3-6.5A8 8 0 1 1 21 11.5z"/></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg><span class="ad-post__cta">Sprawdź ofertę</span></div>
