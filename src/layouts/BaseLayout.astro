---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/fonts.css';
import '../styles/perf.css';
import '../styles/cookieyes.css';
import stylesHref from '../../assets/css/styles.css?url';

interface Props {
  lang?: 'pl' | 'en';
  title: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogLocale?: string;
  keywords?: string;
  jsonLd?: string | Record<string, unknown> | Array<Record<string, unknown>>;
  hreflangPl?: string;
  hreflangEn?: string;
  altHref?: string;
  brandHref?: string;
  bodyClass?: string;
  bodyId?: string;
  extraHead?: string;
  includeFooter?: boolean;
  pageScripts?: string;
}

const {
  lang = 'pl',
  title,
  description = '',
  canonical,
  ogTitle,
  ogDescription,
  ogType = 'website',
  ogLocale = lang === 'pl' ? 'pl_PL' : 'en_US',
  keywords,
  jsonLd,
  hreflangPl,
  hreflangEn,
  altHref,
  brandHref,
  bodyClass = '',
  bodyId = 'top',
  extraHead = '',
  includeFooter = true,
  pageScripts = '',
} = Astro.props;

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://sezmoo.com').replace(/\/$/, '');
// Empty string = form disabled (GH Pages staging has no Pages Functions).
const contactApiRaw = import.meta.env.PUBLIC_CONTACT_API_URL;
const contactApi =
  contactApiRaw === undefined || contactApiRaw === null
    ? '/api/contact'
    : String(contactApiRaw);
// Cloudflare dummy keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
// `…BB` = always passes, invisible. Pair with secret `1x0000000000000000000000000000000AA` in .dev.vars.
const TURNSTILE_TEST_INVISIBLE = '1x00000000000000000000BB';
const turnstileKey = import.meta.env.DEV
  ? TURNSTILE_TEST_INVISIBLE
  : import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const canon = canonical || new URL(Astro.url.pathname, siteUrl + '/').href;
const ogImg = `${siteUrl}/assets/og-image.png`;
// GTM only when explicitly enabled (prod CI / staging smoke). Never local by default.
const enableGtm = import.meta.env.PUBLIC_ENABLE_GTM === 'true';
const gtmId = (import.meta.env.PUBLIC_GTM_ID || 'GTM-KJFG8DZL').trim();

const jsonLdBlocks: string[] = [];
if (typeof jsonLd === 'string' && jsonLd.trim()) {
  jsonLdBlocks.push(jsonLd);
} else if (jsonLd && typeof jsonLd === 'object') {
  jsonLdBlocks.push(JSON.stringify(jsonLd));
}
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {/* Theme BEFORE any paint — prevents dark→light FOUC when styles.css loads async */}
  <script is:inline>
    try {
      var t = localStorage.getItem('sezmoo-theme');
      if (t) document.documentElement.setAttribute('data-theme', t);
    } catch (_e) {}
  </script>
  {/* Google Search: ICO/PNG ≥48px — SVG is not reliably used in SERP */}
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/assets/favicon-48.png" type="image/png" sizes="48x48" />
  <link rel="icon" href="/assets/favicon.png" type="image/png" sizes="512x512" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#16130e" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#f4f0e6" media="(prefers-color-scheme: light)" />
  <meta property="og:image" content={ogImg} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImg} />
  {hreflangPl && <link rel="alternate" hreflang="pl" href={hreflangPl} />}
  {hreflangEn && <link rel="alternate" hreflang="en" href={hreflangEn} />}
  {(hreflangPl || hreflangEn) && (
    <link rel="alternate" hreflang="x-default" href={hreflangPl || hreflangEn} />
  )}
  <title>{title}</title>
  <meta name="title" content={title} />
  {description && <meta name="description" content={description} />}
  {keywords && <meta name="keywords" content={keywords} />}
  <link rel="canonical" href={canon} />
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:site_name" content="SEZMOO" />
  <meta property="og:title" content={ogTitle || title} />
  {ogDescription || description ? (
    <meta property="og:description" content={ogDescription || description} />
  ) : null}
  <meta property="og:url" content={canon} />
  {/* No font preload: with font-display:optional, preload extends LCP render-delay on Slow 4G */}
  {/* Critical above-the-fold — full sheet loads async to unblock LCP */}
  <style is:inline>
    :root{color-scheme:dark;--bg:oklch(.1 .004 60);--bg-2:oklch(.135 .005 60);--fg:oklch(.96 .006 80);--fg-dim:oklch(.74 .008 75);--fg-faint:oklch(.55 .008 70);--rec:#ffd200;--on-accent:#17140a;--line:oklch(.27 .006 60);--line-soft:oklch(.27 .006 60 / .55);--font-display:"Archivo Variable",system-ui,sans-serif;--font-mono:"Space Mono",ui-monospace,monospace;--shell-pad:clamp(26px,4vw,56px);--maxw:1640px}
    /* Must mirror styles.css light tokens — async sheet previously caused a global dark→light flash */
    :root[data-theme="light"]{color-scheme:light;--bg:oklch(.965 .006 85);--bg-2:oklch(.930 .007 85);--fg:oklch(.235 .014 60);--fg-dim:oklch(.42 .014 60);--fg-faint:oklch(.545 .014 60);--rec:oklch(.47 .006 70);--on-accent:#17140a;--line:oklch(.80 .010 75);--line-soft:oklch(.80 .010 75 / .5)}
    *{box-sizing:border-box;margin:0;padding:0}
    html{overflow-x:clip}
    body{background:var(--bg);color:var(--fg);font-family:var(--font-display);line-height:1.5;-webkit-font-smoothing:antialiased;overflow-x:clip}
    img,video,svg{display:block;max-width:100%;height:auto}
    a{color:inherit;text-decoration:none}
    button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
    .shell{width:min(100% - var(--shell-pad) * 2,var(--maxw));margin-inline:auto}
    /* Nav — must match full CSS or logo SVG paints at viewBox width ≈ viewport */
    /* border-bottom must match final CSS — otherwise border-color transition flashes currentColor (cream line) */
    .nav{position:fixed;inset:0 0 auto;z-index:9400;height:auto;min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px var(--shell-pad);background:transparent;border-bottom:1px solid transparent;transition:none}
    .brand{display:flex;align-items:center;flex:0 0 auto;margin-right:auto}
    .brand__logo{width:clamp(112px,10vw,154px);height:auto;max-width:154px}
    .nav__right{display:flex;align-items:center;gap:16px;flex:0 0 auto;margin-left:auto}
    .nav__tc{font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;white-space:nowrap}
    .nav__tc .live{color:var(--rec);font-weight:700}
    .nav__theme,.nav__lang{display:inline-flex;align-items:center;border:1px solid var(--line-soft);border-radius:100px;overflow:hidden}
    .nav__theme-opt,.nav__lang-opt{font-family:var(--font-mono);font-size:11px;letter-spacing:.1em;padding:6px 10px;color:var(--fg-dim)}
    .nav__theme-opt.is-active,.nav__lang-opt.is-active{color:var(--on-accent);background:var(--rec)}
    /* Match mobile drawer (opacity:0) before full CSS — prevents CLS from menu links */
    .nav__menu{position:fixed;inset:0;opacity:0;visibility:hidden;pointer-events:none;z-index:95}
    .nav__burger{display:grid;place-content:center;place-items:center;gap:5px;width:42px;height:42px;order:4}
    .nav__burger span{display:block;width:20px;height:2px;margin:0;background:var(--fg)}
    .nav__menu-logo,.nav__social{display:none}
    @media (min-width:1101px){
      .nav__menu{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);inset:auto;opacity:1;visibility:visible;pointer-events:auto;display:flex;align-items:center;gap:clamp(18px,2vw,38px)}
      .nav__menu a{font-family:var(--font-mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--fg-dim);padding:4px 0}
      .nav__burger{display:none}
    }
    @media (max-width:1100px){
      .nav__tc .label{display:none}
    }
    .hero{position:relative;min-height:100svh;display:grid;align-content:end;padding:clamp(100px,14vh,160px) 0 clamp(48px,8vh,90px);overflow:clip}
    /* Do NOT absolute-position bare .video-bg — without a relative parent it covers the viewport and IO mounts early */
    .hero__reel,.hero__video{position:absolute;inset:0;overflow:hidden}
    .hero__video{background-size:cover;background-position:center;background-repeat:no-repeat;background-color:#0a0a0c}
    .hero__video video{position:absolute;inset:0;width:100%;height:100%;max-width:none;object-fit:cover;opacity:0;pointer-events:none;filter:brightness(.78) saturate(1.05)}
    .hero__video.is-playing video{opacity:1}
    .studio__media{position:relative;aspect-ratio:9/16;max-height:min(82vh,860px);overflow:hidden;background:#0a0a0c}
    .studio__media .video-bg{position:absolute;inset:0;overflow:hidden;background-size:cover;background-position:center;background-repeat:no-repeat}
    .hero__grad{position:absolute;inset:0;z-index:2;background:linear-gradient(to top,var(--bg) 8%,transparent 58%)}
    .hero__content{position:relative;z-index:5;width:100%}
    .hero h1{font-family:var(--font-display);font-weight:780;font-stretch:110%;font-size:clamp(34px,6.2vw,112px);line-height:.92;letter-spacing:-.02em;max-width:15ch}
    .hero h1 .clip{display:block;overflow:hidden}
    .hero h1 .clip>span{display:block;transform:none}
    .hero h1 .accent{color:var(--rec)}
    .hero__measure{font-size:clamp(34px,6.2vw,112px);width:15ch;max-width:100%}
    .hero__measure>*{font-size:initial;font-weight:initial;font-stretch:initial;letter-spacing:initial}
    .hero__measure>h1{font-weight:780;font-stretch:110%;letter-spacing:-.02em;font-size:clamp(34px,6.2vw,112px)}
    .hero__sub{margin-top:16px;max-width:100%;font-size:clamp(15px,1.15vw,18px);color:var(--fg-dim);line-height:1.6}
    .hero__sub b{color:var(--fg);font-weight:700}
    .hero__cta{display:flex;flex-wrap:wrap;gap:14px;margin-top:clamp(26px,4vh,44px)}
    .hero__hud,.hero__corners,.hero__play{display:none}
    .btn{display:inline-flex;align-items:center;padding:17px 28px;border:1px solid var(--line);border-radius:100px;font-size:13px;letter-spacing:.12em;text-transform:uppercase}
    .btn--primary{background:var(--rec);border-color:var(--rec);color:var(--on-accent)}
    /* Article critical — without this, hero img FOUCs under body text until styles.css applies */
    .article{padding:clamp(110px,16vh,160px) 0 clamp(72px,12vh,120px)}
    .article__head{max-width:52ch}
    .article__title{font-weight:800;font-stretch:110%;font-size:clamp(34px,5vw,72px);line-height:1.02;letter-spacing:-.02em}
    .article__lead{color:var(--fg-dim);font-size:clamp(17px,1.25vw,20px);line-height:1.65;margin-top:clamp(18px,3vh,28px)}
    .article__media{position:relative;min-height:clamp(300px,50vw,620px);margin-top:clamp(38px,6vh,76px);border:1px solid var(--line-soft);border-radius:4px;overflow:hidden;background:#0a0a0c}
    .article__media .frame-media{position:absolute;inset:0}
    .article__media .frame-media img{width:100%;height:100%;max-width:none;object-fit:cover;display:block}
    .article__layout{display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(28px,5vw,86px);margin-top:clamp(50px,8vh,96px)}
    @media (min-width:1051px){.article__layout{grid-template-columns:240px minmax(0,760px)}}
    /* Blog listing critical — featured img otherwise paints full-size above the fold before styles.css */
    .blog--page{padding:clamp(110px,16vh,160px) 0 clamp(72px,12vh,120px)}
    .blog-feature{display:grid;grid-template-columns:1fr;gap:1px;margin-top:clamp(28px,4vh,48px);border:1px solid var(--line-soft);border-radius:4px;overflow:hidden;background:var(--line-soft);align-items:stretch}
    @media (min-width:1051px){.blog-feature{grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr)}}
    .blog-feature__media{position:relative;min-width:0;width:100%;height:100%;min-height:clamp(260px,34vw,480px);overflow:hidden;background:#0a0a0c}
    .blog-feature__media .frame-media{position:absolute;inset:0}
    .blog-feature__media .frame-media img{width:100%;height:100%;max-width:none;object-fit:cover;display:block}
    .blog-feature__body{background:var(--bg-2);padding:clamp(28px,4vw,62px);min-width:0}
    /* Hide chrome until full CSS — no !important so styles.css can reveal */
    .grain,.vignette,.cursor,.cursor-dot,.scrubber,.flow-bg-canvas,.floating-socials,.scroll-top{display:none}
  </style>
  {/* Render-blocking Vite-hashed CSS (critical tokens above prevent FOUC). */}
  <link rel="stylesheet" href={stylesHref} />
  <script is:inline>
    document.documentElement.classList.add('html-css-ready');
  </script>
  {jsonLdBlocks.map((block) => (
    <script type="application/ld+json" set:html={block} />
  ))}
  {extraHead && <Fragment set:html={extraHead} />}
  <script is:inline define:vars={{ turnstileKey, contactApi, enableGtm }}>
    window.__SEZMOO__ = {
      turnstileSiteKey: turnstileKey,
      contactApiUrl: contactApi,
      expectCmp: !!enableGtm,
    };
  </script>
</head>
<body id={bodyId} class={bodyClass}>
  {enableGtm && gtmId && (
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
  )}

  <div class="grain"></div>
  <div class="vignette"></div>
  <div class="cursor">PLAY</div>
  <div class="cursor-dot"></div>
  <div class="scrubber"><div class="scrubber__fill"><span class="scrubber__head"></span></div></div>
  <canvas class="flow-bg-canvas" id="flow-bg-canvas" aria-hidden="true"></canvas>

  <div class="floating-socials" aria-label="Social media">
    <a href="https://www.instagram.com/sezmoo/" target="_blank" rel="noopener" aria-label="Instagram">IG</a>
    <a href="https://www.facebook.com/sezmooagencja" target="_blank" rel="noopener" aria-label="Facebook">FB</a>
    <a href="https://www.youtube.com/@sezmooagency" target="_blank" rel="noopener" aria-label="YouTube">YT</a>
    <a href="https://www.linkedin.com/company/sezmoo/" target="_blank" rel="noopener" aria-label="LinkedIn">IN</a>
  </div>
  <a class="scroll-top" href="#top" aria-label={lang === 'pl' ? 'Przewiń do góry' : 'Back to top'}>↑</a>

  <Nav lang={lang} altHref={altHref} brandHref={brandHref} />

  <main>
    <slot />
    {includeFooter && <Footer lang={lang} />}
  </main>

  <script is:inline>
  /* Heavy desktop FX only — skip on touch / reduced-motion */
  (function () {
    try {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (reduce || !fine) return;
      var s = document.createElement('script');
      s.src = '/assets/js/flowing-background.js';
      s.async = true;
      document.body.appendChild(s);
    } catch (_e) {}
  })();
  </script>
  {/* Vite-bundled site JS (hashed). Lenis + flowing-background stay public URLs. */}
  <script>
    import '../../assets/js/cdn-video-map.js';
    import '../../assets/js/app.js';
  </script>
  <script is:inline>
  /* Background video: local poster first, then first-party CDN MP4 (no YouTube iframe).
     Touch / coarse pointer: poster only. */
  (function () {
    var finePointer = false;
    try {
      finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches
        && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    } catch (_e) {}
    function applyPoster(el) {
      var poster = el.getAttribute('data-video-poster');
      if (poster && !el.style.backgroundImage) {
        el.style.backgroundImage = 'url("' + poster + '")';
      }
    }
    function mountCdnBg(el, id) {
      var s = window.__SEZMOO__;
      if (!s || !s.mountCdnVideo || !s.cdnVideoUrl || !s.cdnVideoUrl(id)) return false;
      if (el.dataset.videoMounted) return true;
      el.dataset.videoMounted = '1';
      s.mountCdnVideo(el, id, {
        muted: true,
        loop: true,
        autoplay: true,
        preload: 'metadata',
        className: 'video-bg__video',
        title: el.getAttribute('data-video-title') || '',
      });
      return true;
    }
    function mount(el) {
      if (!el || el.dataset.videoMounted) return;
      applyPoster(el);
      if (!finePointer) {
        el.dataset.videoMounted = '1';
        return;
      }
      var id = el.getAttribute('data-video-id');
      if (!id) return;
      if (mountCdnBg(el, id)) return;
      if (!window.__SEZMOO__ || !window.__SEZMOO__.cdnVideoMap) {
        var tries = 0;
        var t = setInterval(function () {
          tries++;
          if (mountCdnBg(el, id) || tries > 40) {
            clearInterval(t);
            if (!el.dataset.videoMounted) el.dataset.videoMounted = '1';
          }
        }, 50);
        return;
      }
      el.dataset.videoMounted = '1';
    }
    function playBgMedia(el) {
      var v = el.querySelector('video');
      if (!v) return;
      var p = v.play();
      if (p && typeof p.catch === 'function') p.catch(function () {});
    }
    function pauseBgMedia(el) {
      var v = el.querySelector('video');
      if (v && !v.paused) v.pause();
    }
    function whenIdle(fn) {
      if ('requestIdleCallback' in window) requestIdleCallback(fn, { timeout: 2200 });
      else if (document.readyState === 'complete') setTimeout(fn, 1);
      else window.addEventListener('load', function () { setTimeout(fn, 1); });
    }
    function whenNear(el) {
      if (!('IntersectionObserver' in window)) {
        whenIdle(function () { mount(el); });
        return;
      }
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            var target = e.target;
            if (e.isIntersecting) {
              applyPoster(target);
              if (!target.dataset.videoMounted) mount(target);
              else playBgMedia(target);
            } else {
              pauseBgMedia(target);
            }
          });
        },
        { rootMargin: '120px 0px', threshold: 0.15 }
      );
      io.observe(el);
    }
    document.querySelectorAll('[data-video-bg]').forEach(function (el) {
      applyPoster(el);
      if (!finePointer) {
        el.dataset.videoMounted = '1';
        return;
      }
      if (el.getAttribute('data-video-priority') === 'hero') whenIdle(function () { mount(el); });
      else whenNear(el);
    });
  })();
  </script>
  <script is:inline>
  (function () {
    var root = document.documentElement;
    var opts = [].slice.call(document.querySelectorAll('[data-theme-set]'));
    function apply(t) {
      root.setAttribute('data-theme', t);
      try { localStorage.setItem('sezmoo-theme', t); } catch (_e) {}
      opts.forEach(function (b) {
        var on = b.getAttribute('data-theme-set') === t;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    }
    opts.forEach(function (b) {
      b.addEventListener('click', function () { apply(b.getAttribute('data-theme-set')); });
    });
    apply(root.getAttribute('data-theme') || 'dark');
  })();
  </script>
  {enableGtm && gtmId && (
    <script is:inline set:html={`
    (function () {
      var GTM_ID = ${JSON.stringify(gtmId)};
      function loadGtm() {
        if (window.__SEZMOO_GTM__ || !GTM_ID) return;
        window.__SEZMOO_GTM__ = true;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
        var f = document.getElementsByTagName('script')[0];
        var j = document.createElement('script');
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + GTM_ID;
        f.parentNode.insertBefore(j, f);
      }
      if (document.readyState === 'complete') {
        if ('requestIdleCallback' in window) requestIdleCallback(loadGtm, { timeout: 3000 });
        else setTimeout(loadGtm, 1);
      } else {
        window.addEventListener('load', function () {
          if ('requestIdleCallback' in window) requestIdleCallback(loadGtm, { timeout: 3000 });
          else setTimeout(loadGtm, 1);
        });
      }
    })();
    `} />
  )}
  {pageScripts && <Fragment set:html={pageScripts} />}
</body>
</html>
