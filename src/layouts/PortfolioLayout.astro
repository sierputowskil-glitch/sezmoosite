---
/**
 * Portfolio listing pages (filters, masonry tiles, lightbox scripts via pageScripts).
 */
import BaseLayout from './BaseLayout.astro';
import portfolioCssUrl from '../../assets/css/portfolio.css?url';

interface Props {
  lang?: 'pl' | 'en';
  title: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogLocale?: string;
  keywords?: string;
  jsonLd?: string | Record<string, unknown> | Array<Record<string, unknown>>;
  hreflangPl?: string;
  hreflangEn?: string;
  altHref?: string;
  brandHref?: string;
  bodyClass?: string;
  bodyId?: string;
  extraHead?: string;
  pageScripts?: string;
}

const props = Astro.props;
const portfolioCss = `<link rel="stylesheet" href="${portfolioCssUrl}" />`;
const extraHead = [portfolioCss, props.extraHead].filter(Boolean).join('\n');
---

<BaseLayout
  {...props}
  bodyClass={[props.bodyClass, 'portfolio-page'].filter(Boolean).join(' ')}
  extraHead={extraHead}
  pageScripts={props.pageScripts}
>
  <slot />
  <script>
    import '../../assets/js/portfolio-page.js';
  </script>
</BaseLayout>
