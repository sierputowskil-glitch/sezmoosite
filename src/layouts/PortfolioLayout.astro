---
/**
 * Portfolio listing pages (filters, masonry tiles, lightbox scripts via pageScripts).
 */
import BaseLayout from './BaseLayout.astro';

interface Props {
  lang?: 'pl' | 'en';
  title: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogLocale?: string;
  keywords?: string;
  jsonLd?: string | Record<string, unknown> | Array<Record<string, unknown>>;
  hreflangPl?: string;
  hreflangEn?: string;
  altHref?: string;
  brandHref?: string;
  bodyClass?: string;
  bodyId?: string;
  extraHead?: string;
  pageScripts?: string;
}

const props = Astro.props;
---

<BaseLayout
  {...props}
  bodyClass={[props.bodyClass, 'portfolio-page'].filter(Boolean).join(' ')}
  pageScripts={[
    props.pageScripts,
    '<script src="/assets/js/portfolio-page.js" defer></script>',
  ]
    .filter(Boolean)
    .join('\n')}
>
  <slot />
</BaseLayout>
