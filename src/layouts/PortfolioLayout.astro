---
/**
 * Portfolio listing pages (filters, masonry tiles, lightbox scripts via pageScripts).
 */
import BaseLayout from './BaseLayout.astro';

interface Props {
  lang?: 'pl' | 'en';
  title: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogLocale?: string;
  keywords?: string;
  jsonLd?: string | Record<string, unknown> | Array<Record<string, unknown>>;
  hreflangPl?: string;
  hreflangEn?: string;
  altHref?: string;
  brandHref?: string;
  bodyClass?: string;
  bodyId?: string;
  extraHead?: string;
  pageScripts?: string;
}

const props = Astro.props;
---

<BaseLayout
  {...props}
  bodyClass={[props.bodyClass, 'portfolio-page'].filter(Boolean).join(' ')}
  extraHead={[
    props.extraHead,
    `<style>
.pt-media video.cdn-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border:0;z-index:2;pointer-events:none}
.pt-vlb__frame video.cdn-video{position:absolute;inset:0;width:100%;height:100%;border:0;border-radius:6px;background:#000;box-shadow:0 30px 80px rgba(0,0,0,.55)}
.pt-glb__video video.cdn-video{width:100%;height:100%;border:0;display:block;object-fit:contain;background:#000}
</style>`,
  ]
    .filter(Boolean)
    .join('\n')}
  pageScripts={props.pageScripts}
>
  <slot />
  <script>
    import '../../assets/js/portfolio-page.js';
  </script>
</BaseLayout>
